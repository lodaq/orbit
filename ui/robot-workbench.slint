import { Theme } from "theme.slint";
import { Panel, AddOption, AddField, OrbitText, TextDirection } from "controls.slint";
export struct RobotChoice { id: string, name: string }
export struct RobotActivity { heading: string, text: string }
export global RobotWorkbench {
    in-out property <bool> visible;
    in-out property <bool> editing;
    in-out property <bool> adding;
    in-out property <bool> busy;
    in-out property <bool> running;
    in-out property <string> error;
    in-out property <string> status;
    in-out property <string> profile-id;
    in-out property <string> name;
    in-out property <string> project;
    in-out property <int> provider;
    in-out property <string> model;
    in-out property <string> address: "http://127.0.0.1:11434";
    in-out property <string> role-id;
    in-out property <string> role-name;
    in-out property <string> instructions;
    in-out property <string> skills;
    in-out property <[RobotChoice]> profiles;
    in-out property <[RobotChoice]> roles;
    in-out property <[RobotChoice]> history;
    in-out property <[RobotActivity]> activity;
    in-out property <string> conversation;
    in-out property <int> history-page;
    in-out property <int> rating;
    in-out property <string> command;
    in-out property <string> context;
    in-out property <string> approval;
    in-out property <string> approval-id;
    in-out property <[RobotChoice]> servers;
    in-out property <string> server-id;
    in-out property <string> server-command;
    in-out property <string> server-arguments;
    in-out property <string> server-environment;
    in-out property <string> server-tools;
    in-out property <string> discovered;
    in-out property <string> credential-name: "brave-search";
    in-out property <string> credential-value;
    callback open(string, bool);
    callback save-profile();
    callback select-role(string);
    callback save-role();
    callback select-server(string);
    callback save-server();
    callback discover();
    callback save-credential();
    callback select-conversation(string);
    callback load-history(int);
    callback submit();
    callback cancel();
    callback approve(bool);
    callback rate(int);
    callback delete-conversation();
    callback add-to-canvas();
}

export component RobotPanel inherits Rectangle {
    background: Theme.backdrop;
    init => { initial-focus.focus(); }
    initial-focus := FocusScope { }
    private property <length> content-width: min(1100px, root.width - 32px) - 284px;
    private property <int> tab;
    private property <bool> confirm-delete;
    TouchArea { clicked => { RobotWorkbench.visible = false; } }
    Panel {
        x: max(16px, (parent.width - 1100px) / 2); y: 24px;
        width: parent.width - 2 * self.x; height: parent.height - 48px;
        TouchArea { }
        VerticalLayout {
            width: parent.width; height: parent.height;
            padding: 24px; spacing: 12px;
            HorizontalLayout {
                height: 48px;
                Image { width: 48px; source: @image-url("assets/robot.svg"); image-fit: contain; }
                OrbitText { text: RobotWorkbench.name == "" ? "Robots" : RobotWorkbench.name; color: Theme.text; font-size: Theme.type-title; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                AddOption { label: RobotWorkbench.editing ? "Workbench" : "Settings"; enabled: RobotWorkbench.profile-id != ""; clicked => { RobotWorkbench.editing = !RobotWorkbench.editing; } }
                AddOption { label: "×"; accessible-label: "Close workbench"; option-width: 40px; clicked => { RobotWorkbench.visible = false; } }
            }
            if RobotWorkbench.error != "": OrbitText { text: RobotWorkbench.error; color: Theme.error; wrap: word-wrap; }
            if RobotWorkbench.status != "": OrbitText { text: RobotWorkbench.status; color: Theme.secondary; wrap: word-wrap; }
            Rectangle {
                height: root.height - 180px;
              HorizontalLayout {
                width: parent.width; height: parent.height;
                spacing: 16px;
                VerticalLayout {
                    width: 220px; height: parent.height; spacing: 8px;
                    if RobotWorkbench.editing: AddOption { label: "New Robot"; full-width: true; available-width: 220px; clicked => { RobotWorkbench.open("", true); } }
                    if !RobotWorkbench.editing: AddOption { label: "New conversation"; full-width: true; available-width: 220px; clicked => { RobotWorkbench.select-conversation(""); root.confirm-delete = false; } }
                    Flickable {
                        vertical-stretch: 1; min-height: 100px;
                        content-width: self.width;
                        content-height: choices.preferred-height;
                        choices := VerticalLayout { width: parent.width; height: self.preferred-height; spacing: 6px; padding: 0px;
                            for entry in RobotWorkbench.editing ? RobotWorkbench.profiles : RobotWorkbench.history: AddOption {
                                label: entry.name; full-width: true; available-width: 220px;
                                selected: entry.id == (RobotWorkbench.editing ? RobotWorkbench.profile-id : RobotWorkbench.conversation);
                                clicked => { root.confirm-delete = false; if RobotWorkbench.editing { RobotWorkbench.open(entry.id, true); } else { RobotWorkbench.select-conversation(entry.id); } }
                            }
                        }
                    }
                    if !RobotWorkbench.editing: HorizontalLayout {
                        AddOption { label: "Previous"; option-width: 96px; enabled: RobotWorkbench.history-page > 0; clicked => { RobotWorkbench.load-history(RobotWorkbench.history-page - 1); } }
                        AddOption { label: "Next"; option-width: 80px; enabled: RobotWorkbench.history.length == 50; clicked => { RobotWorkbench.load-history(RobotWorkbench.history-page + 1); } }
                    }
                }
                Rectangle {
                  horizontal-stretch: 1; height: parent.height;
                  if RobotWorkbench.editing: VerticalLayout {
                    width: parent.width; height: parent.height;
                    spacing: 12px;
                    HorizontalLayout {
                        for label[i] in ["Profile", "Roles", "MCP", "Credentials"] : AddOption { label: label; option-width: 110px; selected: root.tab == i; clicked => { root.tab = i; } }
                    }
                    Flickable {
                        vertical-stretch: 1; min-height: 100px;
                        width: root.content-width;
                        content-width: self.width; content-height: form.preferred-height;
                        form := VerticalLayout {
                            width: root.content-width; height: self.preferred-height;
                            spacing: 12px; padding: 0px; alignment: start;
                            if root.tab == 0: VerticalLayout {
                                width: root.content-width;
                                spacing: 12px;
                                AddField { label: "Name"; text <=> RobotWorkbench.name; }
                                AddField { label: "Project"; placeholder: "Absolute project directory"; text <=> RobotWorkbench.project; }
                                HorizontalLayout {
                                    for label[i] in ["Ollama", "OpenAI", "Gemini"] : AddOption { label: label; selected: RobotWorkbench.provider == i; clicked => { RobotWorkbench.provider = i; } }
                                }
                                AddField { label: "Model ID"; placeholder: "An installed or available model"; text <=> RobotWorkbench.model; }
                                if RobotWorkbench.provider == 0: AddField { label: "Ollama address"; text <=> RobotWorkbench.address; }
                                OrbitText { text: "Role: " + (RobotWorkbench.role-name == "" ? "None" : RobotWorkbench.role-name); color: Theme.secondary; }
                                HorizontalLayout {
                                    AddOption { label: "None"; selected: RobotWorkbench.role-id == ""; clicked => { RobotWorkbench.select-role(""); } }
                                    AddOption { label: "Choose Role"; option-width: 120px; clicked => { root.tab = 1; } }
                                }
                                AddField { label: "Skills"; placeholder: "One absolute installed SKILL.md path per line"; text <=> RobotWorkbench.skills; multiline: true; accept-newlines: true; }
                                OrbitText { text: "Skills use Orbit tools. Loading each Skill and accessing local files requires approval."; color: Theme.secondary; wrap: word-wrap; }
                            }
                            if root.tab == 1: VerticalLayout {
                                width: root.content-width;
                                spacing: 12px;
                                for role in RobotWorkbench.roles: AddOption { label: role.name; selected: role.id == RobotWorkbench.role-id; full-width: true; available-width: 220px; clicked => { RobotWorkbench.select-role(role.id); } }
                                AddOption { label: "New Role"; clicked => { RobotWorkbench.select-role(""); } }
                                AddField { label: "Role name"; text <=> RobotWorkbench.role-name; }
                                AddField { label: "Instructions"; text <=> RobotWorkbench.instructions; multiline: true; accept-newlines: true; multiline-height: 180px; }
                                AddOption { label: "Save Role"; enabled: !RobotWorkbench.busy; clicked => { RobotWorkbench.save-role(); } }
                                OrbitText { text: "Saved Roles are reusable. Choose a Role here, then save the Robot profile. Existing conversations keep their starting instructions."; color: Theme.secondary; wrap: word-wrap; }
                            }
                            if root.tab == 2: VerticalLayout {
                                width: root.content-width;
                                spacing: 12px;
                                OrbitText { text: "Enabled MCP tools run automatically and may access your machine. Discover starts the configured program. Save each server before saving the profile."; color: Theme.secondary; wrap: word-wrap; }
                                for server in RobotWorkbench.servers: AddOption { label: server.name; selected: server.id == RobotWorkbench.server-id; clicked => { RobotWorkbench.select-server(server.id); } }
                                AddOption { label: "New server"; clicked => { RobotWorkbench.select-server(""); } }
                                AddField { label: "Server ID"; text <=> RobotWorkbench.server-id; }
                                AddField { label: "Program"; text <=> RobotWorkbench.server-command; }
                                AddField { label: "Arguments (one per line)"; text <=> RobotWorkbench.server-arguments; multiline: true; accept-newlines: true; }
                                AddField { label: "Secret environment (NAME=credential reference, one per line)"; text <=> RobotWorkbench.server-environment; multiline: true; accept-newlines: true; }
                                AddOption { label: "Discover tools"; option-width: 140px; enabled: !RobotWorkbench.busy; clicked => { RobotWorkbench.discover(); } }
                                OrbitText { text: RobotWorkbench.discovered; color: Theme.secondary; wrap: word-wrap; }
                                AddField { label: "Enabled tools (one name per line)"; text <=> RobotWorkbench.server-tools; multiline: true; accept-newlines: true; }
                                AddOption { label: "Save server"; option-width: 120px; enabled: !RobotWorkbench.busy; clicked => { RobotWorkbench.save-server(); } }
                            }
                            if root.tab == 3: VerticalLayout {
                                width: root.content-width;
                                spacing: 12px;
                                OrbitText { text: "OpenAI and Gemini use the API keys in Settings → Search bar → AI. Brave Search uses the brave-search reference below. MCP secret references use the same system credential store. Values are never included in backups."; color: Theme.secondary; wrap: word-wrap; }
                                AddField { label: "Credential reference"; text <=> RobotWorkbench.credential-name; }
                                AddField { label: "API key or secret"; text <=> RobotWorkbench.credential-value; secret: true; }
                                AddOption { label: "Save credential"; enabled: !RobotWorkbench.busy; option-width: 160px; clicked => { RobotWorkbench.save-credential(); } }
                            }
                        }
                    }
                    HorizontalLayout {
                        Rectangle { horizontal-stretch: 1; }
                        AddOption { label: RobotWorkbench.adding ? "Save and add" : "Save profile"; option-width: 150px; primary: true; enabled: !RobotWorkbench.busy; clicked => { RobotWorkbench.save-profile(); } }
                    }
                }
                if !RobotWorkbench.editing: VerticalLayout {
                    width: parent.width; height: parent.height;
                    spacing: 12px;
                    OrbitText { text: RobotWorkbench.context; color: Theme.secondary; wrap: word-wrap; }
                    Flickable {
                        vertical-stretch: 1; min-height: 100px;
                        content-width: self.width; content-height: messages.preferred-height;
                        messages := VerticalLayout {
                            width: root.content-width; height: self.preferred-height;
                            spacing: 16px; padding: 0px; alignment: start;
                            for message in RobotWorkbench.activity: VerticalLayout {
                                spacing: 6px;
                                OrbitText { text: message.heading; color: Theme.focus; font-size: Theme.type-control; font-weight: 600; }
                                TextInput { text: message.text; read-only: true; wrap: word-wrap; color: Theme.text; font-size: Theme.type-body; horizontal-alignment: TextDirection.is-rtl(self.text) ? right : left; }
                            }
                        }
                    }
                    if RobotWorkbench.approval != "": VerticalLayout {
                        spacing: 8px;
                        OrbitText { text: "Local action — full machine access after approval"; color: Theme.focus; wrap: word-wrap; }
                        Flickable {
                        height: 160px; content-width: self.width; content-height: approval-text.preferred-height;
                            approval-text := TextInput { width: parent.width; text: RobotWorkbench.approval; read-only: true; wrap: word-wrap; color: Theme.text; }
                        }
                        HorizontalLayout {
                            AddOption { label: "Deny"; clicked => { RobotWorkbench.approve(false); } }
                            AddOption { label: "Approve once"; option-width: 140px; primary: true; clicked => { RobotWorkbench.approve(true); } }
                        }
                    }
                    AddField { label: "Command"; text <=> RobotWorkbench.command; multiline: true; accept-newlines: true; }
                    HorizontalLayout {
                        AddOption { label: "Queue command"; option-width: 150px; primary: true; enabled: RobotWorkbench.command != ""; clicked => { RobotWorkbench.submit(); } }
                        AddOption { label: "Cancel work"; option-width: 120px; enabled: RobotWorkbench.running; clicked => { RobotWorkbench.cancel(); } }
                        Rectangle { horizontal-stretch: 1; }
                        for star in 5: AddOption { label: RobotWorkbench.rating > star ? "★" : "☆"; accessible-label: "Rate " + (star + 1); option-width: 40px; enabled: RobotWorkbench.conversation != ""; clicked => { RobotWorkbench.rate(star + 1); } }
                    }
                    if RobotWorkbench.conversation != "": HorizontalLayout {
                        AddOption { label: root.confirm-delete ? "Delete permanently" : "Delete conversation"; option-width: 180px; destructive: true; enabled: !RobotWorkbench.running; clicked => { if root.confirm-delete { RobotWorkbench.delete-conversation(); root.confirm-delete = false; } else { root.confirm-delete = true; } } }
                        if root.confirm-delete: AddOption { label: "Keep"; clicked => { root.confirm-delete = false; } }
                    }
                }
                }
              }
            }
        }
    }
}
