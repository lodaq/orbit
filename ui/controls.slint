import { Theme } from "theme.slint";
// A native keycap for shortcut hints and editable shortcut displays.
export component Kbd inherits Rectangle {
    in property <string> label;
    in property <length> available-width: 1000px;
    private property <string> display: label == "Escape" ? "Esc" : label == "Left" ? "←" : label == "Right" ? "→" : label == "Up" ? "↑" : label == "Down" ? "↓" : label;
    width: label == "" ? 0px : min(available-width, max(Theme.kbd-height, key-label.preferred-width + 2 * Theme.kbd-padding));
    height: Theme.kbd-height;
    horizontal-stretch: 0;
    visible: label != "";
    accessible-role: text;
    accessible-label: label;
    background: Theme.kbd-background;
    border-color: Theme.kbd-border; border-width: Theme.border-width;
    border-radius: Theme.kbd-radius;
    Rectangle { x: Theme.kbd-radius; y: parent.height - Theme.border-width; width: max(0px, parent.width - 2 * self.x); height: Theme.border-width; background: Theme.kbd-shadow; }
    key-label := Text {
        x: Theme.kbd-padding; width: max(0px, parent.width - 2 * self.x); height: parent.height;
        text: root.display; color: Theme.secondary; font-size: Theme.kbd-font-size; font-weight: 500;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
}

export component AddOption inherits Rectangle {
    in property <bool> add-style;
    in property <bool> type-tile;
    in property <bool> source-tab;

    in property <bool> settings-style;
    in property <bool> navigation-style;
    in property <bool> tab-style;
    in property <bool> dashed-style;
    in property <string> label;
    in property <string> trailing;
    in property <string> shortcut;
    in property <bool> selected;
    in property <bool> primary;
    in property <bool> destructive;
    in property <image> icon;
    in property <bool> icon-present;
    in property <bool> enabled: true;
    in property <bool> full-width;
    in property <length> available-width: 460px;
    in property <length> option-width: Theme.control-option-width;
    callback clicked;
    private property <bool> hovered: hit-area.has-hover;
    private property <bool> focused: keyboard-focus.has-focus;
    width: full-width ? available-width : option-width;
    height: type-tile ? 68px : add-style ? (full-width ? 64px : Theme.add-control-height) : full-width ? Theme.control-row-height : Theme.control-height;
    accessible-role: button;
    accessible-label: shortcut != "" ? shortcut : label;
    accessible-enabled: enabled;
    accessible-checked: selected;
    forward-focus: keyboard-focus;
    border-radius: root.source-tab ? 0px : root.type-tile ? 12px : root.add-style ? Theme.add-radius : (root.settings-style ? Theme.settings-r-control : Theme.radius-control);
    border-width: focused ? Theme.focus-width : root.source-tab ? 0px : root.navigation-style || root.tab-style || root.dashed-style ? 0px : Theme.border-width;
    border-color: root.add-style ? (focused || selected ? Theme.add-focus : Theme.add-border) : focused ? (root.settings-style ? Theme.settings-icon-accent : Theme.focus) : root.settings-style && root.destructive ? Theme.settings-danger-border : (selected ? (root.settings-style ? Theme.settings-border-control : Theme.primary) : (root.settings-style ? Theme.settings-border-control : Theme.border));
    opacity: enabled || settings-style || add-style ? 1 : 0.45;
    background: root.add-style ? (root.source-tab ? transparent : !root.enabled ? #1f2647 : root.primary ? Theme.add-primary : root.selected ? Theme.add-selected : root.hovered ? Theme.add-hover : Theme.add-field) : root.settings-style
        ? !enabled ? Theme.settings-disabled-bg
            : hit-area.pressed ? Theme.settings-bg-inset
            : destructive ? Theme.settings-danger-bg
            : primary ? Theme.settings-primary
            : selected ? (root.tab-style ? Theme.settings-bg-tab-active : Theme.settings-bg-nav-active)
            : hovered ? Theme.settings-disabled-bg
            : root.dashed-style ? Theme.settings-bg-inset : root.navigation-style || root.tab-style ? transparent : Theme.settings-bg-control
        : destructive ? Theme.error-background : primary ? Theme.primary : selected ? Theme.selection : hovered ? Theme.raised : Theme.field;
    if root.source-tab && root.selected: Rectangle { y: parent.height - 2px; height: 2px; width: parent.width; background: Theme.add-focus; }
    if icon-present: Image { x: root.type-tile ? (parent.width - self.width) / 2 : root.settings-style && root.width <= 40px ? 10px : Theme.space-3; y: root.type-tile ? 13px : (parent.height - self.height) / 2; width: root.type-tile ? 22px : root.settings-style ? 18px : Theme.icon-control-size; height: self.width; source: root.icon; image-fit: contain; }
    option-label := Text {
        x: root.type-tile ? 2px : root.settings-style && root.width <= 40px ? 0px : root.icon-present ? Theme.space-3 + (root.settings-style ? 18px : Theme.icon-control-size) + Theme.space-3 : Theme.space-3;
        y: root.type-tile ? 39px : 0px;
        width: root.type-tile ? parent.width - 4px : max(0px, parent.width - self.x - (root.settings-style && root.width <= 40px ? 0px : root.trailing == "" ? Theme.space-3 : root.settings-style ? 32px : 72px));
        height: root.type-tile ? 22px : parent.height;
        text: root.label;
        color: root.add-style ? (!root.enabled ? Theme.add-secondary : root.selected || root.primary ? white : Theme.add-text) : root.settings-style && !root.enabled ? Theme.settings-disabled-text : root.dashed-style ? Theme.settings-text-accent : root.navigation-style && !root.selected ? Theme.settings-text-muted : root.destructive ? (root.settings-style ? Theme.settings-danger-text : Theme.error) : root.primary ? Theme.on-primary : (root.settings-style ? Theme.settings-text : Theme.text);
        font-size: (root.settings-style ? Theme.type-body : Theme.type-control);
        font-weight: root.selected || root.primary ? 600 : 500;
        horizontal-alignment: root.full-width || root.trailing != "" ? left : center;
        vertical-alignment: center;
        overflow: elide;
    }
    if trailing != "": Text {
        x: parent.width - self.width - Theme.space-3;
        width: root.settings-style ? 24px : 72px;
        height: parent.height;
        text: root.trailing;
        color: root.primary ? Theme.on-primary : (root.settings-style ? Theme.settings-text-muted : Theme.secondary);
        font-size: Theme.type-hint;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    if root.shortcut != "": Kbd {
        label: root.shortcut; available-width: parent.width - 2 * Theme.space-3;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
    hit-area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { if root.settings-style { keyboard-focus.focus(); } root.clicked(); }
    }
    keyboard-focus := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if root.enabled && (event.text == "\n" || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject;
        }
    }
}

export component AddField inherits VerticalLayout {
    in property <bool> add-style;
    in property <bool> settings-style;
    in property <string> label;
    in property <string> placeholder;
    in property <string> error;
    in-out property <string> text;
    in property <bool> enabled: true;
    in property <bool> multiline;
    in property <bool> secret;
    callback accepted;
    callback edited;
    spacing: Theme.space-2;
    alignment: start;
    horizontal-stretch: 1;
    forward-focus: input-field;

    if root.label != "": Text {
        text: root.label;
        color: (root.add-style ? Theme.add-text : root.settings-style ? Theme.settings-text-muted : Theme.text);
        font-size: Theme.type-control;
        font-weight: root.add-style ? 600 : 500;
    }
    Rectangle {
        height: root.add-style ? (root.multiline ? 132px : Theme.add-control-height) : root.multiline ? Theme.field-multiline-height : Theme.control-height;
        horizontal-stretch: 1;
        border-radius: (root.add-style ? Theme.add-radius : root.settings-style ? Theme.settings-r-control : Theme.radius-control);
        background: (root.add-style ? Theme.add-field : root.settings-style ? Theme.settings-bg-inset : Theme.field);
        border-width: input-field.has-focus ? Theme.focus-width : Theme.border-width;
        border-color: root.error != "" ? (root.settings-style ? Theme.settings-danger-text : Theme.error) : input-field.has-focus ? (root.add-style ? Theme.add-focus : root.settings-style ? Theme.settings-icon-accent : Theme.focus) : (root.add-style ? Theme.add-border : root.settings-style ? Theme.settings-border-control : Theme.border);
        Text { x: Theme.space-3; y: Theme.space-2; width: parent.width - 2 * Theme.space-3; visible: root.text == ""; text: root.placeholder; color: (root.add-style ? Theme.add-secondary : root.settings-style ? Theme.settings-text-muted : Theme.secondary); font-size: Theme.type-body;
            font-family: root.add-style && root.multiline ? "monospace" : "Inter"; }
        input-field := TextInput {
            x: Theme.space-3; y: Theme.space-2; width: parent.width - 2 * Theme.space-3; height: parent.height - 2 * Theme.space-2;
            text <=> root.text;
            enabled: root.enabled;
            single-line: !root.multiline;
            input-type: root.secret ? InputType.password : InputType.text;
            color: (root.add-style ? Theme.add-text : root.settings-style ? Theme.settings-text : Theme.text);
            font-size: Theme.type-body;
            font-family: root.add-style && root.multiline ? "monospace" : "Inter";
            selection-background-color: (root.settings-style ? Theme.settings-bg-nav-active : Theme.selection);
            selection-foreground-color: (root.add-style ? Theme.add-text : root.settings-style ? Theme.settings-text : Theme.text);
            edited => { root.edited(); }
            key-pressed(event) => {
                if root.multiline && event.text == "\n" {
                    root.accepted();
                    return accept;
                }
                reject;
            }
            accepted => { root.accepted(); }
        }
    }
    if error != "": Text {
        text: "! " + root.error;
        color: (root.settings-style ? Theme.settings-danger-text : Theme.error);
        font-size: Theme.type-hint;
    }
}

// The owner removes this component when hidden so no idle work survives.
export component SmoothCaret inherits Rectangle {
    in property <length> target-x;
    in property <length> target-y;
    in property <length> caret-height;
    in property <length> caret-width;
    in property <bool> active: true;
    in property <bool> animated: true;
    in property <bool> trail: true;
    in property <int> edit-generation;
    private property <bool> snapping: false;
    private property <bool> idle: false;
    private property <bool> dim: false;
    private property <length> fast-x: target-x;
    private property <length> slow-x: target-x;
    out property <length> block-x: max(min(fast-x, slow-x), fast-x - Theme.cursor-max-stretch);
    out property <length> block-width: min(abs(fast-x - slow-x), Theme.cursor-max-stretch) + caret-width;
    out property <float> idle-opacity: dim ? Theme.cursor-idle-opacity : 1;
    out property <bool> idle-running: idle-timer.running;
    public function reset() {
        root.idle = false;
        root.dim = false;
        idle-timer.stop();
        if root.active { idle-timer.start(); }
    }
    changed target-x => { root.reset(); }
    changed target-y => { root.snapping = true; snap-timer.start(); root.reset(); }
    changed edit-generation => { root.reset(); }
    changed active => { root.reset(); }
    init => { root.reset(); }
    snap-timer := Timer { running: false; interval: Theme.cursor-snap-delay; triggered => { root.snapping = false; self.stop(); } }
    idle-timer := Timer {
        running: false;
        interval: root.idle ? Theme.cursor-idle-period : Theme.cursor-idle-delay;
        triggered => { root.idle = true; root.dim = !root.dim; }
    }
    animate fast-x { duration: root.animated && !root.snapping && root.active ? Theme.cursor-lead : 0ms; easing: ease-out; }
    animate slow-x { duration: root.animated && !root.snapping && root.active ? (root.trail ? Theme.cursor-trail : Theme.cursor-lead) : 0ms; easing: ease-out; }
    animate idle-opacity { duration: root.idle && root.active ? Theme.cursor-idle-period : 0ms; easing: ease-in-out; }
    x: block-x; y: target-y; width: block-width; height: caret-height;
    opacity: active ? 1 : 0;
    animate opacity { duration: Theme.cursor-selection-fade; }
    Rectangle { width: parent.width; height: parent.height; background: Theme.cursor-color; opacity: Theme.cursor-opacity * root.idle-opacity; }
}


export component SettingsButton inherits AddOption {
    settings-style: true;
    accessible-action-default => { if root.enabled { root.clicked(); } }
}

export component SettingsAddButton inherits SettingsButton {
    dashed-style: true;
    height: Theme.settings-h-control;
    for segment in max(0, floor((root.width - 20px) / 10px)): Rectangle {
        x: 10px + segment * 10px; y: 0px; width: 5px; height: 1px; background: Theme.settings-border-dashed;
    }
    for segment in max(0, floor((root.width - 20px) / 10px)): Rectangle {
        x: 10px + segment * 10px; y: root.height - 1px; width: 5px; height: 1px; background: Theme.settings-border-dashed;
    }
    for segment in max(0, floor((root.height - 12px) / 10px)): Rectangle {
        x: 0px; y: 6px + segment * 10px; width: 1px; height: 5px; background: Theme.settings-border-dashed;
    }
    for segment in max(0, floor((root.height - 12px) / 10px)): Rectangle {
        x: root.width - 1px; y: 6px + segment * 10px; width: 1px; height: 5px; background: Theme.settings-border-dashed;
    }
}

export component SettingsField inherits AddField {
    settings-style: true;
}

export component SettingsCard inherits Rectangle {
    background: Theme.settings-bg-card;
    border-color: Theme.settings-border-card;
    border-width: Theme.border-width;
    border-radius: Theme.settings-r-card;
}

export component SettingsTitle inherits Text {
    color: Theme.settings-text;
    font-size: Theme.settings-card-title-size;
    font-weight: 500;
}

export component SettingsDescription inherits Text {
    color: Theme.settings-text-muted;
    font-size: Theme.type-control;
    wrap: word-wrap;
}

export component SettingsNav inherits SettingsButton {
    in property <string> hint;
    Kbd { label: root.hint; x: parent.width - self.width - 12px; y: (parent.height - self.height) / 2; }
    height: Theme.settings-h-nav;
    full-width: true;
    navigation-style: true;
}

export component SettingsTabGroup inherits Rectangle {
    background: Theme.settings-bg-track;
    border-width: Theme.border-width; border-color: Theme.settings-border-panel; border-radius: 11px;
    height: 44px;
    HorizontalLayout { padding: 4px; spacing: 2px; @children }
}

export component SettingsTab inherits SettingsButton {
    height: Theme.settings-h-control-sm;
    border-radius: Theme.settings-r-small;
    tab-style: true;
}

export component SettingsSwitch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled;
    accessible-action-default => { if root.enabled { root.toggled(); } }
    width: 46px; height: 26px; border-radius: 13px;
    background: checked ? Theme.settings-primary : Theme.settings-border-control;
    border-width: focus.has-focus ? Theme.focus-width : 0px; border-color: Theme.settings-icon-accent;
    opacity: enabled ? 1 : 0.45;
    accessible-role: switch; accessible-label: "Smooth cursor"; accessible-checked: checked; accessible-enabled: enabled;
    forward-focus: focus;
    Rectangle { x: root.checked ? 23px : 3px; y: 3px; width: 20px; height: 20px; border-radius: 10px; background: root.checked ? Theme.settings-primary-text : Theme.settings-text-muted; }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.toggled(); } }
    focus := FocusScope { key-pressed(event) => { if root.enabled && (event.text == " " || event.text == "\n") { root.toggled(); return accept; } reject; } }
}

export component SettingsChip inherits Rectangle {
    in property <bool> path-name;
    in property <string> accessible-name: label;
    in property <string> label;
    in property <bool> accent;
    in property <bool> enabled: true;
    in property <bool> confirming;
    callback removed;
    height: 30px;
    background: Theme.settings-bg-inset; border-radius: Theme.settings-r-small;
    border-width: Theme.border-width; border-color: accent ? Theme.settings-border-dashed : Theme.settings-border-panel;
    Text {
        x: 12px; y: 0px; width: max(0px, parent.width - 42px); height: parent.height;
        text: root.label; font-family: root.path-name ? "monospace" : "Inter";
        color: root.accent ? Theme.settings-text-accent : Theme.settings-text-chip;
        font-size: Theme.type-hint; vertical-alignment: center; overflow: elide;
    }
    SettingsButton {
        x: parent.width - self.width - 4px; y: (parent.height - self.height) / 2;
        label: root.confirming ? "✓" : "×"; shortcut: "";
        accessible-label: (root.confirming ? "Confirm removal of " : "Remove ") + root.accessible-name;
        option-width: 22px; height: 22px; destructive: root.confirming; enabled: root.enabled;
        clicked => { root.removed(); }
    }
}

export component SettingsStepper inherits Rectangle {
    in property <bool> enabled: true;
    opacity: root.enabled ? 1 : 0.45;
    in-out property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 64;
    in property <int> step: 1;
    in property <string> label;
    private property <string> draft;
    init => { root.draft = root.value; }
    changed value => { if !number.has-focus { root.draft = root.value; } }
    height: Theme.settings-h-control;
    background: Theme.settings-bg-inset; border-radius: Theme.settings-r-control;
    border-width: Theme.border-width; border-color: Theme.settings-border-control;
    HorizontalLayout {
        padding-left: 14px; padding-right: Theme.space-1;
        padding-top: Theme.space-1; padding-bottom: Theme.space-1; spacing: Theme.space-2;
        number := TextInput {
            enabled: root.enabled;
            text <=> root.draft; color: Theme.settings-text; font-size: Theme.type-body;
            vertical-alignment: center; input-type: InputType.number; accessible-label: root.label;
            changed has-focus => { if !self.has-focus { root.draft = root.value; } }
            key-pressed(event) => {
                if event.text == Key.UpArrow { root.value = min(root.maximum, root.value + root.step); root.draft = root.value; return accept; }
                if event.text == Key.DownArrow { root.value = max(root.minimum, root.value - root.step); root.draft = root.value; return accept; }
                reject;
            }
            edited => {
                if self.text.is-float() {
                    root.value = min(root.maximum, max(root.minimum, root.minimum + round((self.text.to-float() - root.minimum) / root.step) * root.step));
                }
            }
            accepted => { root.draft = root.value; }
        }
        SettingsButton {
            label: "−"; accessible-label: "Decrease " + root.label;
            option-width: 32px; height: 32px; enabled: root.enabled && root.value > root.minimum;
            clicked => { root.value = max(root.minimum, root.value - root.step); }
        }
        SettingsButton {
            label: "+"; accessible-label: "Increase " + root.label;
            option-width: 32px; height: 32px; enabled: root.enabled && root.value < root.maximum;
            clicked => { root.value = min(root.maximum, root.value + root.step); }
        }
    }
}

export component SettingsSelect inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    in property <string> label: "Choose";
    width: 220px; height: Theme.settings-h-control;
    background: hit.has-hover ? Theme.settings-bg-control : Theme.settings-bg-inset;
    border-radius: Theme.settings-r-control;
    border-width: focus.has-focus ? Theme.focus-width : Theme.border-width;
    border-color: focus.has-focus ? Theme.settings-icon-accent : Theme.settings-border-control;
    accessible-role: combobox; accessible-label: label;
    accessible-action-expand => { if root.enabled { choices.show(); } }
    accessible-value: model[current-index]; accessible-enabled: enabled;
    forward-focus: focus;
    Text { x: 14px; width: parent.width - 48px; height: parent.height; text: root.model[root.current-index]; color: root.enabled ? Theme.settings-text : Theme.settings-disabled-text; font-size: Theme.type-body; vertical-alignment: center; overflow: elide; }
    Text { x: parent.width - 30px; width: 16px; height: parent.height; text: "⌄"; color: Theme.settings-text-muted; vertical-alignment: center; }
    hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { choices.show(); } }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.UpArrow { root.current-index = max(0, root.current-index - 1); return accept; }
            if event.text == Key.DownArrow { root.current-index = min(root.model.length - 1, root.current-index + 1); return accept; }
            if event.text == "\n" || event.text == " " { choices.show(); return accept; }
            reject;
        }
    }
    choices := PopupWindow {
        y: root.height + 4px; width: root.width; height: min(320px, root.model.length * 42px + 8px);
        forward-focus: popup-focus;
        popup-focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.UpArrow { root.current-index = max(0, root.current-index - 1); return accept; }
                if event.text == Key.DownArrow { root.current-index = min(root.model.length - 1, root.current-index + 1); return accept; }
                if event.text == "\n" || event.text == Key.Escape { choices.close(); focus.focus(); return accept; }
                reject;
            }
        Rectangle {
            background: Theme.settings-bg-panel; border-color: Theme.settings-border-control; border-width: 1px; border-radius: Theme.settings-r-control;
            Flickable {
                x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                content-width: self.width; content-height: root.model.length * 42px;
                content-y: -max(0px, min(root.current-index * 42px, self.content-height - self.height));
                VerticalLayout {
                    width: root.width - 8px; spacing: 2px;
                    for choice[index] in root.model: SettingsButton {
                        label: choice; selected: root.current-index == index; option-width: root.width - 8px;
                        clicked => { root.current-index = index; choices.close(); focus.focus(); }
                    }
                }
            }
        }
        }
    }
}

// Cached app and System action rows share one explicit Add control.
export component AddItemRow inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <string> letter;
    in property <image> icon;
    in property <bool> icon-present;
    in property <bool> enabled: true;
    callback clicked;
    height: 64px;
    background: Theme.add-field;
    border-width: 1px;
    border-color: Theme.add-border;
    border-radius: 12px;
    Rectangle {
        x: 12px; y: 12px; width: 40px; height: 40px;
        background: Theme.add-selected; border-radius: 10px;
        if root.icon-present: Image { source: root.icon; image-fit: contain; width: 22px; height: 22px; x: 9px; y: 9px; }
        if !root.icon-present: Text { text: root.letter; color: Theme.add-focus; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text { x: 64px; y: root.description == "" ? 0px : 10px; width: max(0px, parent.width - 160px); height: root.description == "" ? parent.height : 22px; text: root.label; color: Theme.add-text; font-size: 14px; font-weight: 500; vertical-alignment: center; overflow: elide; }
    if root.description != "": Text { x: 64px; y: 34px; width: max(0px, parent.width - 160px); height: 18px; text: root.description; color: Theme.add-secondary; font-size: 12px; overflow: elide; }
    AddOption { add-style: true; x: parent.width - 88px; y: 12px; width: 76px; height: 40px; label: "+ Add"; accessible-label: "Add " + root.label; enabled: root.enabled; clicked => { root.clicked(); } }
}
