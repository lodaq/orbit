export global Theme {
    // Four-pixel spacing scale keeps controls aligned across sheets and pages.
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-6: 24px;
    out property <length> space-10: 40px;
    out property <length> space-12: 48px;

    // Shared component sizes.
    out property <length> control-height: 40px;
    out property <length> control-row-height: 52px;
    out property <length> field-multiline-height: 88px;
    out property <length> control-option-width: 96px;
    out property <length> icon-control-size: 32px;
    out property <length> icon-preview-size: 48px;
    out property <length> radius-control: 8px;
    out property <length> radius-sheet: 16px;
    out property <length> border-width: 1px;
    out property <length> focus-width: 2px;

    // Type scale for shared controls and common text roles.
    out property <length> type-hint: 12px;
    out property <length> type-control: 13px;
    out property <length> type-body: 14px;
    out property <length> type-title: 20px;
    out property <color> on-primary: #FFFFFF;

    out property <color> sheet: #181D35;
    out property <color> raised: #222942;
    out property <color> field: #14192E;
    out property <color> border: #39415F;
    out property <color> text: #EFF0FF;
    out property <color> secondary: #9EA8C8;
    out property <color> selection: #303962;
    out property <color> widget-header: #354269;
    out property <color> primary: #6975E8;
    out property <color> focus: #B6BEFF;
    out property <color> error: #FFB0B8;
    out property <color> success: #75D6AD;
    out property <color> warning: #F0C879;
    out property <color> error-background: #392633;
    out property <color> backdrop: #060814B8;
}
