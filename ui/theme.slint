export global Theme {
    out property <length> focus-title-size: 24px;
    out property <color> priority-high: #F18C98;
    out property <color> priority-medium: #E8BC70;
    out property <color> priority-low: #83ADFF;
    out property <color> adhkar-accent: #ffc477;
    out property <length> adhkar-reading-size: 22px;
    out property <color> launcher-background: #0B0D19;
    out property <float> background-opacity: 0.9;
    out property <color> placement-valid: #71DDCF;
    out property <color> placement-invalid: #EE9A8B;
    out property <color> folder-preview: #8597DC;
    out property <length> radius-preview: 12px;
    out property <length> radius-dock: 24px;
    out property <color> hover-overlay: #FFFFFF0C;
    out property <color> separator: #FFFFFF14;
    out property <color> dock-surface: #171A29D9;
    out property <color> dock-border: #C6D0FF70;
    out property <color> canvas-surface: #324D6B80;
    out property <color> outline-logo: #FF0000;
    out property <color> outline-engine: #00FF00;
    out property <color> outline-search: #FFFF00;
    out property <color> outline-dock: #0000FF;
    out property <color> outline-button: #FFFFFF;
    out property <color> widget-surface: #1B2138;
    out property <length> radius-widget: 22px;
    out property <brush> widget-background: @linear-gradient(135deg, #252C46 0%, #1A2036 100%);
    out property <color> widget-border: #C6D0FF20;
    out property <color> widget-row: #FFFFFF06;
    out property <color> widget-completed: #B6BEFF12;
    out property <length> widget-reading-size: 20px;
    out property <length> azan-time-size: 34px;
    out property <length> widget-word-size: 24px;
    out property <length> widget-action-height: 32px;
    // Feedback starts on press; only the release eases back to rest.
    out property <duration> control-release: 120ms;
    out property <color> press-overlay: #FFFFFF18;
    out property <color> surface-shadow: #00000050;
    out property <length> surface-shadow-blur: 28px;
    out property <color> add-sheet: sheet;
    out property <color> add-footer: #131830;
    out property <color> add-field: field;
    out property <color> add-border: border;
    out property <color> add-hover: raised;
    out property <color> add-selected: selection;
    out property <color> add-primary: primary;
    out property <color> add-focus: focus;
    out property <color> add-text: text;
    out property <color> add-secondary: secondary;
    out property <length> add-control-height: 44px;
    out property <length> add-radius: 10px;

    out property <color> settings-bg-app: field;
    out property <color> settings-bg-panel: sheet;
    out property <color> settings-bg-card: widget-surface;
    out property <color> settings-bg-inset: field;
    out property <color> settings-bg-track: field;
    out property <color> settings-bg-control: raised;
    out property <color> settings-bg-nav-active: selection;
    out property <color> settings-bg-tab-active: selection;
    out property <color> settings-border-panel: border;
    out property <color> settings-border-card: separator;
    out property <color> settings-border-control: border;
    out property <color> settings-border-dashed: #3A4090;
    out property <color> settings-text: text;
    out property <color> settings-text-muted: secondary;
    out property <color> settings-text-control: text;
    out property <color> settings-text-chip: text;
    out property <color> settings-text-kbd: secondary;
    out property <color> settings-text-accent: focus;
    out property <color> settings-icon-accent: focus;
    out property <color> settings-text-none: #8D93C7;
    out property <color> settings-primary: primary;
    out property <color> settings-primary-text: #FFFFFF;
    out property <color> settings-danger-bg: #33192B;
    out property <color> settings-danger-border: #4C2640;
    out property <color> settings-danger-text: #FFA3AE;
    out property <color> settings-success-bg: #12301F;
    out property <color> settings-success-text: #7EE0A4;
    out property <color> settings-disabled-bg: #232750;
    out property <color> settings-disabled-text: #8F95C8;
    out property <length> settings-r-panel: 20px;
    out property <length> settings-r-card: 14px;
    out property <length> settings-r-control: 10px;
    out property <length> settings-r-small: 8px;
    out property <length> settings-r-kbd: 6px;
    out property <length> settings-r-pill: 12px;
    out property <length> settings-sidebar-w: 232px;
    out property <length> settings-h-control: 40px;
    out property <length> settings-h-control-sm: 34px;
    out property <length> settings-h-icon-btn: 36px;
    out property <length> settings-h-nav: 44px;
    out property <length> settings-title-size: 24px;
    out property <length> settings-card-title-size: 15px;

    out property <duration> cursor-snap-delay: 1ms;
    out property <duration> cursor-lead: 70ms;
    out property <duration> cursor-trail: 180ms;
    out property <duration> cursor-idle-delay: 450ms;
    out property <duration> cursor-idle-period: 1100ms;
    out property <duration> cursor-selection-fade: 80ms;
    out property <length> cursor-max-stretch: 160px;
    out property <float> cursor-width-ratio: 0.55;
    out property <float> cursor-opacity: 0.65;
    out property <float> cursor-idle-opacity: 0.1;
    out property <color> cursor-color: #5B8CFF;

    out property <length> kbd-height: 22px;
    out property <length> kbd-padding: 6px;
    out property <length> kbd-radius: 5px;
    out property <length> kbd-font-size: 11px;
    out property <color> kbd-background: #FFFFFF0A;
    out property <color> kbd-border: #FFFFFF14;
    out property <color> kbd-shadow: #00000030;
    out property <length> search-min-height: 48px;
    out property <length> search-padding: 12px;
    out property <length> search-cursor-inset: 2px;
    out property <length> search-font-size: 16px;
    out property <duration> folder-transition: 150ms;
    out property <color> search-background: #171A29E8;
    out property <color> search-border: #C6D0FF60;
    out property <color> search-focus-border: #8FAEFF;
    out property <color> search-prefix-background: #6975E829;

    // Four-pixel spacing scale keeps controls aligned across sheets and controls.
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-6: 24px;
    out property <length> space-10: 40px;
    out property <length> space-12: 48px;

    // Shared component sizes.
    out property <length> control-height: 40px;
    out property <length> control-row-height: 52px;
    out property <length> field-multiline-height: 88px;
    out property <length> control-option-width: 96px;
    out property <length> icon-control-size: 32px;
    out property <length> icon-preview-size: 48px;
    out property <length> radius-control: 10px;
    out property <length> radius-sheet: 20px;
    out property <length> border-width: 1px;
    out property <length> focus-width: 2px;

    // Type scale for shared controls and common text roles.
    out property <length> type-hint: 12px;
    out property <length> type-control: 13px;
    out property <length> type-body: 14px;
    out property <length> type-title: 20px;
    out property <color> on-primary: #FFFFFF;

    out property <color> sheet: #181D35;
    out property <color> raised: #222942;
    out property <color> field: #14192E;
    out property <color> border: #39415F;
    out property <color> text: #EFF0FF;
    out property <color> secondary: #9EA8C8;
    out property <color> selection: #303962;
    out property <color> widget-header: #28324F;
    out property <color> primary: #5966D2;
    out property <color> focus: #B6BEFF;
    out property <color> error: #FFB0B8;
    out property <color> success: #75D6AD;
    out property <color> warning: #F0C879;
    out property <color> error-background: #392633;
    out property <color> backdrop: #060814B8;
}
