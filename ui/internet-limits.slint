import { OrbitText, Panel, AddOption, AddField } from "controls.slint";
import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";

export global InternetLimits {
    in-out property <bool> visible;
    in-out property <bool> busy;
    in-out property <string> download;
    in-out property <string> upload;
    in-out property <string> status;
    in-out property <string> error;
    in-out property <int> session;
    callback load;
    callback apply(bool);
    public function open() {
        if self.busy { return; }
        self.session += 1; self.visible = true; self.busy = true;
        self.download = ""; self.upload = ""; self.error = "";
        self.status = "Checking active limits…"; self.load();
    }
    public function close() {
        if self.busy { return; }
        self.visible = false; self.session += 1;
    }
}

export component InternetLimitsSheet inherits Rectangle {
    init => { download-field.focus(); }
    background: Theme.backdrop;
    TouchArea { clicked => { InternetLimits.close(); } }
    Panel {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: min(480px, parent.width - Theme.space-6);
        height: min(600px, parent.height - Theme.space-6);
        background: Theme.sheet;
        TouchArea { }
        VerticalLayout {
            padding: Theme.space-6; spacing: Theme.space-4;
            HorizontalLayout {
                OrbitText { text: "Internet limits"; color: Theme.text; font-size: Theme.type-title; font-weight: 600; vertical-alignment: center; }
                AddOption { label: "×"; accessible-label: "Close Internet limits"; option-width: Theme.control-height; enabled: !InternetLimits.busy; clicked => { InternetLimits.close(); } }
            }
            fields := ScrollView {
                horizontal-scrollbar-policy: always-off; min-height: 0px; vertical-stretch: 1;
                VerticalLayout {
                    width: fields.visible-width; height: self.preferred-height;
                    spacing: Theme.space-4; padding-right: Theme.space-2;
                    OrbitText { text: "Limit this computer's upload and download speeds across its network connections. Shared devices keep their own limits."; color: Theme.secondary; font-size: Theme.type-body; wrap: word-wrap; }
                    OrbitText { text: InternetLimits.status; color: Theme.focus; font-size: Theme.type-body; wrap: word-wrap; }
                    download-field := AddField { label: "Download limit (kbps)"; placeholder: "0 — Unlimited"; text <=> InternetLimits.download; enabled: !InternetLimits.busy; }
                    AddField { label: "Upload limit (kbps)"; placeholder: "0 — Unlimited"; text <=> InternetLimits.upload; enabled: !InternetLimits.busy; }
                    OrbitText { text: "0 or an empty field means Unlimited. Limits allow brief bursts and stay active until removed or the computer restarts. Excess traffic is dropped; download caps reduce receiving speed but cannot recover data already delivered by your provider."; color: Theme.secondary; font-size: Theme.type-hint; wrap: word-wrap; }
                    if InternetLimits.error != "": OrbitText { text: InternetLimits.error; color: Theme.error; font-size: Theme.type-body; wrap: word-wrap; }
                }
            }
            AddOption { label: "Remove limits"; option-width: parent.width; enabled: !InternetLimits.busy; clicked => { InternetLimits.apply(true); } }
            HorizontalLayout {
                spacing: Theme.space-2;
                AddOption { label: "Close"; option-width: (parent.width - Theme.space-2) / 2; enabled: !InternetLimits.busy; clicked => { InternetLimits.close(); } }
                AddOption { label: InternetLimits.busy ? "Working…" : "Apply limits"; primary: true; option-width: (parent.width - Theme.space-2) / 2; enabled: !InternetLimits.busy; clicked => { InternetLimits.apply(false); } }
            }
        }
    }
}
