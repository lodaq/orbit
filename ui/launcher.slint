            { value: #4263eb, name: "Blue", code: "#4263eb" }, { value: #4dabf7, name: "Light blue", code: "#4dabf7" },
            { value: #ffc078, name: "Light orange", code: "#ffc078" }, { value: #f76707, name: "Orange", code: "#f76707" },
            { value: #099268, name: "Green", code: "#099268" }, { value: #40c057, name: "Light green", code: "#40c057" },
