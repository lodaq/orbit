                    if kind == 0 { root.dock-clear-hover(); root.begin-drag(0,false,x,y); root.drag-from-dock = true; root.dock-source-index = index; root.drag-item = item; root.grab-x = 32px * CanvasState.zoom; root.grab-y = 32px * CanvasState.zoom; }
                    if kind == 2 { root.end-drag(); }
                    if kind == 3 { root.cancel-drag(); }
