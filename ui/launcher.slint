        root.drop-y = round(((root.drag-y - root.grab-y) / 1px - CanvasState.pan-y) / CanvasState.zoom - root.grid-gap / 2);
        let target = !root.on-dock ? root.folder-target(root.items,root.drag-item,root.drop-x,root.drop-y,root.merge-target,root.grid-gap) : -1;
        if target >= 0 {
