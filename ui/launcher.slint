        }
        if root.selected-ids.length > 0: SettingsButton {
            x: 12px; y: 216px; option-width: 156px; height: 32px; label: "Apply to selection"; enabled: !root.layout-locked;
            clicked => { root.style-selection(root.selected-ids,root.ink-color,root.text-size,root.ink-opacity); canvas-focus.focus(); }
