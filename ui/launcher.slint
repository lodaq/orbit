                                VerticalLayout { spacing: 4px; alignment: center;
                                    SettingsTitle { text: "Live preview" + (root.items.length > 0 ? " · " + root.items[0].name : ""); wrap: word-wrap; }
                                    SettingsDescription { text: grid.columns + " columns × " + grid.rows + " rows. Save reflows displaced items; Back cancels unsaved sizing."; }
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    x: parent.stacked ? 0px : (parent.width - 20px) * 1.3 / 2.3 + 20px;
                    y: parent.stacked ? 540px : 0px;
                    width: parent.stacked ? parent.width : (parent.width - 20px) / 2.3;
                    height: parent.stacked ? 500px : parent.height;
                    spacing: 20px;
                    SettingsCard {
                        height: 256px;
                        VerticalLayout { padding: 22px; spacing: 14px;
                            HorizontalLayout {
                                SettingsTitle { text: "TickTick account"; }
                                Rectangle { horizontal-stretch: 1; }
                                Rectangle {
                                    width: root.ticktick-connected ? 100px : 124px; height: 24px; border-radius: Theme.settings-r-pill;
                                    background: root.ticktick-connected ? Theme.settings-success-bg : Theme.settings-bg-inset;
                                    Text { text: root.ticktick-connected ? "Connected" : "Not connected"; color: root.ticktick-connected ? Theme.settings-success-text : Theme.settings-text-muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                                }
                            }
                            SettingsField { label: "Personal API token"; placeholder: "Paste a replacement token"; text <=> root.ticktick-token-draft; secret: true; }
                            HorizontalLayout { spacing: 10px;
                                SettingsButton { label: "Connect TickTick"; option-width: 160px; primary: true; enabled: !root.ticktick-loading && root.ticktick-token-draft != ""; clicked => { root.save-ticktick-token(root.ticktick-token-draft); root.ticktick-token-draft = ""; } }
                                SettingsButton { label: "Disconnect"; option-width: 112px; destructive: true; enabled: !root.ticktick-loading && root.ticktick-connected; clicked => { root.remove-ticktick-token(); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            SettingsDescription { text: root.ticktick-status; }
                        }
                    }
                    SettingsCard {
                        vertical-stretch: 1; min-height: 220px;
                        VerticalLayout { padding: 22px; spacing: 14px; alignment: start;
                            SettingsTitle { text: "Data"; }
                            SettingsDescription { text: root.installed-status; }
                            SettingsButton { label: "Refresh installed apps"; option-width: 214px; enabled: !root.busy; clicked => { root.busy = true; root.refresh-installed-apps(); } }
                            HorizontalLayout { spacing: 10px;
                                SettingsButton { label: "Export data"; option-width: 132px; enabled: !root.busy; clicked => { root.busy = true; root.data-busy = true; root.data-status = ""; root.transfer-data(false); } }
                                SettingsButton { label: "Import data"; option-width: 132px; enabled: !root.layout-locked && !root.busy; clicked => { root.busy = true; root.data-busy = true; root.data-status = ""; root.transfer-data(true); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if root.data-status != "": SettingsDescription { text: root.data-status; }
                        }
                    }
                }
            }
            if root.settings-tab == 5: SettingsCard {
                height: english-settings.preferred-height;
                english-settings := VerticalLayout {
                    padding: 20px; spacing: 16px; alignment: start;
                    SettingsTitle { text: "English assistance"; }
                    SettingsDescription { text: "Local qwen3:4b suggests better wording. Your text changes only when you choose a suggestion. The model stays loaded while enabled."; }
                    CheckBox { text: "Suggestions"; checked: root.english-suggestions-enabled; enabled: !root.busy; toggled => { root.busy = true; root.save-english(self.checked,root.english-address); } }
                    SettingsField { label: "Local Ollama address"; text <=> root.english-address-draft; placeholder: "http://127.0.0.1:11434"; }
                    SettingsDescription { text: "Model: qwen3:4b · English text stays on this computer"; }
                    HorizontalLayout { spacing: 12px; alignment: start;
                        SettingsButton { label: "Save address"; option-width: 130px; enabled: !root.busy; clicked => { root.busy = true; root.save-english(root.english-suggestions-enabled,root.english-address-draft); } }
                        SettingsButton { label: "Test connection"; option-width: 150px; clicked => { root.english-test(); } }
                    }
                    SettingsDescription { text: root.english-connection; }
                }
            }
            if root.settings-tab == 4: VerticalLayout {
                spacing: 20px;
                SettingsCard {
                    height: (root.width - 392px) < 640px ? 252px : 158px;
                    VerticalLayout {
                        spacing: 0px;
                        HorizontalLayout {
                            padding: 20px; spacing: 16px;
                            VerticalLayout { spacing: 3px;
                                SettingsTitle { text: "Smooth cursor"; }
                                SettingsDescription { text: "Animate the cursor while typing in Search anything."; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            SettingsSwitch { checked: root.smooth-cursor; enabled: !root.busy; toggled => { root.busy = true; root.save-smooth-cursor(!root.smooth-cursor); } }
                        }
                        Rectangle { height: 1px; background: Theme.settings-border-card; }
                        GridLayout {
                            padding: 20px; spacing: 12px;
                            VerticalLayout { row: 0; col: 0; spacing: 3px;
                                SettingsTitle { text: "Fallback search engine"; }
                                SettingsDescription { text: "Used when nothing in Orbit matches your query."; }
                            }
                            HorizontalLayout { row: (root.width - 392px) < 640px ? 1 : 0; col: (root.width - 392px) < 640px ? 0 : 1; spacing: 10px;
                                SettingsSelect { label: "Fallback search engine"; model: root.search-engine-names; current-index <=> root.default-search-engine-index; enabled: !root.busy; }
                                SettingsButton { label: "Save"; option-width: 82px; primary: true; enabled: !root.busy && root.default-search-engine-index != root.saved-default-search-engine-index; clicked => { root.busy = true; root.save-default-search-engine(root.default-search-engine-index); } }
                            }
                        }
                    }
                }
                VerticalLayout { spacing: 4px;
                    SettingsTitle { text: "Search locations"; }
                    SettingsDescription { text: "Choose the directories Orbit searches for files and directories."; }
                }
                GridLayout {
                    spacing: 20px;

                    SettingsCard {
                        row: (root.width - 392px) < 640px ? 0 : 0; col: (root.width - 392px) < 640px ? 0 : 0;
                        min-height: 150px;
                        VerticalLayout {
                            padding: 20px; spacing: 12px; alignment: start;
                            SettingsTitle { text: "File search paths"; }
                            for path[index] in root.file-search-paths: HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    horizontal-stretch: 1; min-width: 0px; height: 36px;
                                    background: Theme.settings-bg-inset; border-width: 1px; border-color: Theme.settings-border-panel; border-radius: Theme.settings-r-control;
                                    Text { x: 12px; width: parent.width - 24px; height: parent.height; text: path; font-family: "monospace"; color: Theme.settings-text-muted; font-size: 13px; overflow: elide; vertical-alignment: center; }
                                }
                                SettingsButton { label: ""; icon: @image-url("assets/pencil.svg"); icon-present: true; accessible-label: "Edit " + path; option-width: 36px; height: 36px; enabled: !root.busy; clicked => { root.search-path-directory = false; root.search-path-index = index; root.search-path-draft = path; root.search-path-editor = true; } }
                                SettingsButton { label: ""; icon: @image-url("assets/trash.svg"); icon-present: true; accessible-label: "Delete " + path; option-width: 36px; height: 36px; destructive: true; enabled: !root.busy; clicked => { root.busy = true; root.delete-search-path(false, index); } }
                            }
                            SettingsAddButton { label: "+  Add file path"; full-width: true; available-width: ((root.width - 392px) < 640px ? (root.width - 392px) : ((root.width - 392px) - 20px) / 2) - 40px; height: 40px; border-color: Theme.settings-border-dashed; enabled: !root.busy; clicked => { root.search-path-directory = false; root.search-path-index = -1; root.search-path-draft = ""; root.search-path-editor = true; } }
                        }
                    }

                    SettingsCard {
                        row: (root.width - 392px) < 640px ? 1 : 0; col: (root.width - 392px) < 640px ? 0 : 1;
                        min-height: 150px;
                        VerticalLayout {
                            padding: 20px; spacing: 12px; alignment: start;
                            SettingsTitle { text: "Directory search paths"; }
                            for path[index] in root.directory-search-paths: HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    horizontal-stretch: 1; min-width: 0px; height: 36px;
                                    background: Theme.settings-bg-inset; border-width: 1px; border-color: Theme.settings-border-panel; border-radius: Theme.settings-r-control;
                                    Text { x: 12px; width: parent.width - 24px; height: parent.height; text: path; font-family: "monospace"; color: Theme.settings-text-muted; font-size: 13px; overflow: elide; vertical-alignment: center; }
                                }
                                SettingsButton { label: ""; icon: @image-url("assets/pencil.svg"); icon-present: true; accessible-label: "Edit " + path; option-width: 36px; height: 36px; enabled: !root.busy; clicked => { root.search-path-directory = true; root.search-path-index = index; root.search-path-draft = path; root.search-path-editor = true; } }
                                SettingsButton { label: ""; icon: @image-url("assets/trash.svg"); icon-present: true; accessible-label: "Delete " + path; option-width: 36px; height: 36px; destructive: true; enabled: !root.busy; clicked => { root.busy = true; root.delete-search-path(true, index); } }
                            }
                            SettingsAddButton { label: "+  Add directory path"; full-width: true; available-width: ((root.width - 392px) < 640px ? (root.width - 392px) : ((root.width - 392px) - 20px) / 2) - 40px; height: 40px; border-color: Theme.settings-border-dashed; enabled: !root.busy; clicked => { root.search-path-directory = true; root.search-path-index = -1; root.search-path-draft = ""; root.search-path-editor = true; } }
                        }
                    }

                }
                if root.search-path-editor: SettingsCard {
                    VerticalLayout { padding: 20px; spacing: 12px;
                        SettingsField { label: root.search-path-directory ? "Directory search path" : "File search path"; placeholder: "/home/user/Documents"; text <=> root.search-path-draft; accepted => { root.busy = true; root.save-search-path(root.search-path-directory, root.search-path-index, root.search-path-draft); } }
                        HorizontalLayout { spacing: 8px;
                            SettingsButton { label: "Cancel"; enabled: !root.busy; clicked => { root.search-path-editor = false; } }
                            SettingsButton { label: "Save"; primary: true; enabled: !root.busy; clicked => { root.busy = true; root.save-search-path(root.search-path-directory, root.search-path-index, root.search-path-draft); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
                SettingsCard {
                    VerticalLayout { padding: 20px; spacing: 14px;
                        SettingsTitle { text: "Excluded from file search"; }
                        SettingsDescription { text: "Files and folders with these names are skipped. Use .* for anything that starts with a dot."; }
                        HorizontalLayout { spacing: 10px;
                            SettingsField { label: "Name or pattern"; placeholder: "e.g. dist"; text <=> root.file-search-exclusion-draft; enabled: !root.busy; accepted => { if !root.busy && root.file-search-exclusion-draft != "" { root.busy = true; root.add-file-search-exclusion(root.file-search-exclusion-draft); } } }
                            VerticalLayout { Rectangle { height: 23px; } SettingsButton { label: "Exclude"; option-width: 100px; primary: true; enabled: !root.busy && root.file-search-exclusion-draft != ""; clicked => { root.busy = true; root.add-file-search-exclusion(root.file-search-exclusion-draft); } } }
                        }
                        Rectangle {
                            property <int> columns: max(1, floor((self.width + 8px) / 160px));
                            height: ceil(root.file-search-exclusions.length / self.columns) * 38px;
                            for name[index] in root.file-search-exclusions: SettingsChip {
                                x: mod(index, parent.columns) * ((parent.width + 8px) / parent.columns);
                                y: floor(index / parent.columns) * 38px;
                                width: (parent.width + 8px) / parent.columns - 8px;
                                label: name; path-name: true; accent: name == ".*"; enabled: !root.busy;
                                removed => { root.busy = true; root.remove-file-search-exclusion(name); }
                            }
                        }
                    }
                }
            }
            if root.settings-tab == 1: VerticalLayout {
                spacing: 16px;
                SettingsCard {
                    height: shortcut-columns-layout.preferred-height;
                    shortcut-columns-layout := HorizontalLayout {
                        spacing: 0px;
                        for column in root.shortcut-columns: VerticalLayout {
                            spacing: 0px; alignment: start;
                            for group[index] in root.shortcut-groups: Rectangle {
                                visible: mod(index, root.shortcut-columns) == column;
                                property <length> row-width: ((root.width - 392px) / root.shortcut-columns);
                                property <length> name-width: min(190px, self.row-width * 0.35);
                                property <length> keys-width: self.row-width - self.name-width - 120px;
                                property <int> key-columns: max(1, floor((self.keys-width + 6px) / 140px));
                                height: mod(index, root.shortcut-columns) != column ? 0px : max(56px, ceil(group.entries.length / self.key-columns) * 34px + 22px);
                                width: self.row-width;
                                Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.settings-border-card; }
                                SettingsTitle { x: 20px; width: parent.name-width; height: parent.height; text: root.shortcut-actions[group.action]; font-size: 14px; wrap: word-wrap; vertical-alignment: center; }
                                if group.entries.length == 0: SettingsDescription { x: 32px + parent.name-width; width: parent.keys-width; height: parent.height; text: "No shortcut assigned"; font-italic: true; color: Theme.settings-text-none; vertical-alignment: center; }
                                for binding[key-index] in group.entries: SettingsChip {
                                    x: 32px + parent.name-width + mod(key-index, parent.key-columns) * (parent.keys-width + 6px) / parent.key-columns;
                                    y: 12px + floor(key-index / parent.key-columns) * 34px;
                                    width: (parent.keys-width + 6px) / parent.key-columns - 6px;
                                    label: binding.keys == "Escape" ? "Esc" : binding.keys == "Left" ? "←" : binding.keys == "Right" ? "→" : binding.keys == "Up" ? "↑" : binding.keys == "Down" ? "↓" : binding.keys;
                                    accessible-name: binding.keys;
                                    enabled: !root.busy;
                                    confirming: root.shortcut-delete-action == binding.action && root.shortcut-delete-keys == binding.keys;
                                    removed => {
                                        if root.shortcut-delete-action == binding.action && root.shortcut-delete-keys == binding.keys {
                                            root.busy = true; root.shortcut-delete-action = -1; root.delete-shortcut(binding.action, binding.keys);
                                        } else { root.shortcut-delete-action = binding.action; root.shortcut-delete-keys = binding.keys; }
                                    }
                                }
                                SettingsButton { x: parent.width - 80px; y: 11px; label: "Add"; option-width: 60px; height: 34px; enabled: !root.busy; clicked => { root.shortcut-action = group.action; root.shortcut-existing = ""; root.shortcut-draft = ""; root.shortcut-editor = true; } }
                            }
                        }
                    }
                }
                SettingsDescription { text: "Remove a shortcut with ×, then confirm with ✓. Use Add to record a replacement."; }
                SettingsDescription { text: "Toggle Orbit is configured outside Orbit. Text editing uses the text field’s shortcuts. Shift + wheel switches pages."; }
                if root.shortcut-editor: VerticalLayout {
                    spacing: 12px;
                    SettingsSelect { width: min(360px, root.width - 392px); model: root.shortcut-actions; current-index <=> root.shortcut-action; }
                    SettingsButton { label: root.shortcut-recording ? "Press shortcut…" : root.shortcut-draft == "" ? "Record shortcut" : ""; shortcut: root.shortcut-recording ? "" : root.shortcut-draft; option-width: 220px; clicked => { root.shortcut-recording = true; } }
                    SettingsButton { label: "Cancel"; clicked => { root.shortcut-editor = false; root.shortcut-recording = false; } }
                    SettingsButton { label: "Save"; primary: true; enabled: !root.busy && !root.shortcut-recording && root.shortcut-draft != ""; clicked => { root.busy = true; root.save-shortcut(root.shortcut-action, root.shortcut-existing, root.shortcut-draft); } }
                }
            }
            if root.settings-tab == 2: VerticalLayout {
                spacing: 12px;

                Flickable {
                    height: max(106px, ceil(root.prefixes.length / root.action-columns) * 106px);
                    content-height: max(self.height, ceil(root.prefixes.length / root.action-columns) * 106px);
                    content-width: self.width;
                    for prefix[index] in root.prefixes: SettingsCard {
                        x: mod(index, root.action-columns) * ((parent.width - (root.action-columns - 1) * 12px) / root.action-columns + 12px);
                        y: floor(index / root.action-columns) * 106px;
                        width: (parent.width - (root.action-columns - 1) * 12px) / root.action-columns;
                        height: 92px;

                        Text { x: 12px; y: 8px; width: parent.width - 112px; height: 24px; text: prefix.name; color: Theme.settings-text; font-size: 15px; font-weight: 500; overflow: elide; }
                        Text { x: 12px; y: 34px; width: parent.width - 112px; height: 20px; font-family: "monospace"; text: "\u{2066}" + prefix.token + "  →  " + prefix.action-name + "\u{2069}"; color: Theme.settings-text-accent; font-size: 13px; overflow: elide; }
                        HorizontalLayout {
                            x: parent.width - 90px; y: 10px; spacing: 6px;
                            SettingsButton { label: ""; icon: @image-url("assets/pencil.svg"); icon-present: true; accessible-label: "Edit " + prefix.name; option-width: 36px; height: 36px; enabled: !root.busy; clicked => {
                                root.prefix-id-draft = prefix.id; root.prefix-name-draft = prefix.name;
                                root.prefix-token-draft = prefix.token; root.prefix-action-index = prefix.action-index;
                            } }
                            SettingsButton { label: ""; icon: @image-url("assets/trash.svg"); icon-present: true; accessible-label: "Delete " + prefix.name; option-width: 36px; height: 36px; destructive: true; enabled: !root.busy; clicked => { root.busy = true; root.delete-prefix(prefix.id); } }
                        }
                    }
                }
                GridLayout {
                    spacing: 8px;
                    SettingsField { row: 0; col: 0; label: "Name"; placeholder: "YouTube"; text <=> root.prefix-name-draft; }
                    SettingsField { row: 0; col: 1; label: "Token"; placeholder: "y"; text <=> root.prefix-token-draft; }
                    SettingsSelect { row: root.width - 392px < 640px ? 1 : 0; col: root.width - 392px < 640px ? 0 : 2; colspan: root.width - 392px < 640px ? 2 : 1; width: root.width - 392px < 640px ? root.width - 392px : 220px; label: "Action"; model: root.action-names; current-index <=> root.prefix-action-index; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    SettingsButton { label: "New Prefix"; clicked => { root.prefix-id-draft = ""; root.prefix-name-draft = ""; root.prefix-token-draft = ""; root.prefix-action-index = 0; } }
                    SettingsButton { label: "Save Prefix"; option-width: 132px; primary: true; enabled: !root.busy && root.prefix-name-draft != "" && root.prefix-token-draft != "" && root.user-actions.length > 0; clicked => { root.busy = true; root.save-prefix(root.prefix-id-draft, root.prefix-name-draft, root.prefix-token-draft, root.user-actions[root.prefix-action-index].id); } }
                }
            }
            if root.settings-tab == 3: VerticalLayout {
                spacing: 12px;
                if !root.action-editor-open: Flickable {
                    height: max(320px, ceil(root.user-actions.length / root.action-columns) * 150px); content-height: max(self.height, ceil(root.user-actions.length / root.action-columns) * 150px); content-width: self.width;
                    for action[index] in root.user-actions: SettingsCard {
                        x: mod(index, root.action-columns) * ((parent.width - (root.action-columns - 1) * 12px) / root.action-columns + 12px);
                        y: floor(index / root.action-columns) * 150px;
                        width: (parent.width - (root.action-columns - 1) * 12px) / root.action-columns;
                        height: 136px;
                        background: Theme.settings-bg-card;
                        border-width: action-focus.has-focus ? 2px : 1px;
                        border-color: action-focus.has-focus ? Theme.settings-icon-accent : Theme.settings-border-card;
                        border-radius: Theme.settings-r-card;
                        Text { x: 14px; y: 14px; width: parent.width - 110px; height: 24px; text: action.name; color: Theme.settings-text; font-size: 15px; font-weight: 600; wrap: word-wrap; vertical-alignment: center; }
                        Rectangle { x: parent.width - 86px; y: 14px; width: 72px; height: 22px; background: Theme.settings-bg-nav-active; border-radius: Theme.settings-r-kbd;
                            Text { text: action.kind; color: Theme.settings-text-kbd; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                        }
                        Text { x: 14px; y: 46px; width: parent.width - 28px; height: 18px; font-family: "monospace"; text: action.tokens == "" ? "" : "Tokens · " + action.tokens; color: Theme.settings-text-accent; font-size: 13px; overflow: elide; }
                        Text { x: 14px; y: 72px; width: parent.width - 28px; height: 42px; text: action.description; color: Theme.settings-text-muted; font-size: 13px; wrap: word-wrap; overflow: elide; }
                        callback edit;
                        forward-focus: action-focus;
                        accessible-role: button; accessible-label: "Edit " + action.name;
                        accessible-action-default => { self.edit(); }
                        action-focus := FocusScope { key-pressed(event) => { if event.text == "\n" || event.text == " " { parent.edit(); return accept; } reject; } }
                        edit => { root.action-id-draft = action.id; root.action-name-draft = action.name; root.action-kind-draft = action.kind; root.action-source-draft = action.source; root.action-description-draft = action.description; root.action-tokens-draft = action.tokens; root.action-used = action.referenced; root.action-editor-open = true; }
                        action-card := TouchArea {
                            accessible-role: button; accessible-label: "Edit " + action.name;
                            clicked => { parent.edit(); }
                        }
                    }
                }
                if root.action-editor-open: VerticalLayout {
                    vertical-stretch: 1; spacing: 8px;
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: min(760px, parent.width - 32px);
                            height: max(220px, min(root.height - 500px, 560px));
                            background: Theme.settings-bg-card; border-width: 1px; border-color: Theme.settings-border-card; border-radius: Theme.settings-r-card;
                            VerticalLayout {
                                padding: 18px; spacing: 8px;
                                HorizontalLayout {
                                    Text { text: root.action-id-draft == "" ? "New Action" : "Edit Action"; color: Theme.settings-text; font-size: 20px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Flickable {
                                    vertical-stretch: 1;
                                    content-width: self.width;
                                    width: min(760px, root.width - 424px) - 36px;
                                    content-height: action-fields.preferred-height;
                                    action-fields := VerticalLayout {
                                        width: min(760px, root.width - 424px) - 36px; spacing: 10px;
                                        SettingsField { label: "Name"; placeholder: "My action"; text <=> root.action-name-draft; }
                                        SettingsField { label: "Description"; placeholder: "Explain what this Action does and how to use it"; text <=> root.action-description-draft; multiline: true; }
                                        SettingsField { label: "Tokens · separate with commas"; placeholder: "g, ل"; text <=> root.action-tokens-draft; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            SettingsButton { label: "Shell"; selected: root.action-kind-draft == "Shell"; clicked => { if root.action-kind-draft != "Shell" { root.action-kind-draft = "Shell"; root.action-source-draft = ""; } } }
                                            SettingsButton { label: "URL"; selected: root.action-kind-draft == "URL"; clicked => { if root.action-kind-draft != "URL" { root.action-kind-draft = "URL"; root.action-source-draft = ""; } } }
                                            SettingsButton { label: "TickTick"; selected: root.action-kind-draft == "TickTick"; clicked => { if root.action-kind-draft != "TickTick" { root.action-kind-draft = "TickTick"; root.action-source-draft = ""; } } }
                                        }
                                        if root.action-kind-draft == "URL": SettingsField { label: "URL template · use %s for Search anything"; placeholder: "https://example.com/?q=%s"; text <=> root.action-source-draft; }
                                        if root.action-kind-draft == "Shell": SettingsField { label: "Shell script · argument: $1 on Arch Linux, $OrbitQuery on Windows"; placeholder: "Write a script that reads the search argument"; text <=> root.action-source-draft; multiline: true; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    SettingsButton { label: "Cancel"; option-width: root.width < 900px ? 80px : 100px; enabled: !root.busy; clicked => { root.action-editor-open = false; } }
                                    Rectangle { horizontal-stretch: 1; }
                                    if root.action-id-draft != "": SettingsButton { label: "Delete"; option-width: root.width < 900px ? 80px : 100px; destructive: true; enabled: !root.busy && !root.action-used; clicked => { root.busy = true; root.delete-user-action(root.action-id-draft); } }
                                    SettingsButton { label: "Save Action"; option-width: root.width < 900px ? 116px : 132px; primary: true; enabled: !root.busy && root.action-name-draft != "" && (root.action-kind-draft == "TickTick" || root.action-source-draft != ""); clicked => { root.busy = true; root.save-user-action(root.action-id-draft, root.action-name-draft, root.action-kind-draft, root.action-source-draft, root.action-description-draft, root.action-tokens-draft); } }
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }

                }
            }
        }
    }

    if root.ticktick-popup-widget-id != "": Rectangle {
        width: root.width; height: root.height; background: transparent;
        TouchArea { clicked => { root.ticktick-popup-widget-id = ""; } }
        Rectangle {
            x: root.ticktick-popup-x; y: root.ticktick-popup-y; width: 220px;
            height: root.ticktick-popup-options ? 148px : 12px + min(6,max(0,root.ticktick-views.length - root.ticktick-list-page)) * 36px + (root.ticktick-views.length > 6 ? 32px : 0px);
            background: #282b35; border-radius: 10px; border-width: 1px; border-color: #ffffff32;
            if root.ticktick-popup-options: VerticalLayout {
                padding: 6px; spacing: 4px;
                AddOption { label: root.ticktick-loading ? "Loading…" : "Refresh Tasks"; option-width: 208px; enabled: !root.ticktick-loading; clicked => { root.load-ticktick(); } }
                AddOption { label: "Refresh List"; option-width: 208px; enabled: !root.ticktick-loading; clicked => {
                    root.refresh-ticktick-list(root.ticktick-selected-project(root.ticktick-popup-widget-id));
                } }
                AddOption { label: root.ticktick-show-completed ? "Hide completed" : "Show completed"; option-width: 208px; clicked => { root.ticktick-show-completed = !root.ticktick-show-completed; root.ticktick-scroll-offset = 0px; root.ticktick-popup-widget-id = ""; } }
            }
            for row in 6: Rectangle {
                visible: !root.ticktick-popup-options && row + root.ticktick-list-page < root.ticktick-views.length;
                x: 6px; y: 6px + row * 36px; width: parent.width - 12px; height: 36px;
                background: project-touch.has-hover ? #ffffff14 : transparent; border-radius: 5px;
                Text { x: 10px; width: parent.width - 20px; height: parent.height; text: row + root.ticktick-list-page < root.ticktick-views.length ? root.ticktick-views[row + root.ticktick-list-page].name : ""; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; }
                project-touch := TouchArea { width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => {
                    if row + root.ticktick-list-page < root.ticktick-views.length { root.select-ticktick-list(root.ticktick-popup-widget-id,root.ticktick-views[row + root.ticktick-list-page].id); root.ticktick-scroll-offset = 0px; root.ticktick-popup-widget-id = ""; }
                } }
            }
            if !root.ticktick-popup-options && root.ticktick-views.length > 6: Rectangle {
                x: 6px; y: 6px + min(6,max(0,root.ticktick-views.length - root.ticktick-list-page)) * 36px;
                width: parent.width - 12px; height: 32px; background: more-lists-touch.has-hover ? #ffffff14 : transparent; border-radius: 5px;
                Text { x: 10px; width: parent.width - 20px; height: parent.height; text: root.ticktick-list-page + 6 < root.ticktick-views.length ? "More lists ↓" : "First lists ↑"; color: Theme.secondary; font-size: 12px; vertical-alignment: center; }
                more-lists-touch := TouchArea { width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { root.ticktick-list-page = root.ticktick-list-page + 6 < root.ticktick-views.length ? root.ticktick-list-page + 6 : 0; } }
            }
        }
    }
    if root.ticktick-open: Rectangle {
        width: root.width; height: root.height; background: #00000099;
        TouchArea {
            clicked => { root.ticktick-open = false; root.ticktick-confirm-delete = false; }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    root.ticktick-open = false; root.ticktick-confirm-delete = false;
                }
            }
        }
        ticktick-editor := Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(parent.width - 40px, 470px); height: min(parent.height - 40px, root.ticktick-form-error == "" ? 730px : 770px);
            background: #222631; border-radius: 14px; border-color: #ffffff2a; border-width: 1px;
            TouchArea { width: parent.width; height: parent.height; }
            VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    Text { text: root.ticktick-create ? "New task" : "Task details"; color: Theme.text; font-size: 19px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    AddOption { label: "Cancel"; option-width: 72px; clicked => { root.ticktick-open = false; root.ticktick-confirm-delete = false; } }
                }
                AddField { label: "Title"; placeholder: "What needs doing?"; text <=> root.ticktick-title; enabled: !root.ticktick-loading; }
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "List"; color: Theme.text; font-size: 13px; }
                    ComboBox { model: root.ticktick-project-names; current-index <=> root.ticktick-project-index; enabled: root.ticktick-projects.length > 0 && !root.ticktick-loading; }
                }
                if !root.ticktick-create: Text { text: "Currently in " + root.ticktick-list-name(root.ticktick-projects,root.ticktick-edit-project); color: Theme.secondary; font-size: 12px; }
                AddField { label: "Notes (optional)"; placeholder: "Add notes"; text <=> root.ticktick-content; multiline: true; enabled: !root.ticktick-loading; }
                if !root.ticktick-create: AddField { label: "Description"; placeholder: "Add a task description"; text <=> root.ticktick-desc; multiline: true; enabled: !root.ticktick-loading; }
                if !root.ticktick-create: HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout { spacing: 4px; Text { text: "Priority"; color: Theme.text; font-size: 13px; } ComboBox { model: ["None", "Low", "Medium", "High"]; current-index <=> root.ticktick-priority; enabled: !root.ticktick-loading; } }
                    AddField { label: "Tags · comma separated"; placeholder: "work, urgent"; text <=> root.ticktick-tags; enabled: !root.ticktick-loading; }
                }
                if !root.ticktick-create: HorizontalLayout {
                    spacing: 10px;
                    AddField { label: "Due date · YYYY-MM-DD"; placeholder: "YYYY-MM-DD or blank"; text <=> root.ticktick-due-date; enabled: !root.ticktick-loading; }
                    VerticalLayout {
                        Rectangle { vertical-stretch: 1; }
                        AddOption { label: "Today"; option-width: 76px; enabled: !root.ticktick-loading; clicked => { root.ticktick-due-date = root.ticktick-current-date(); } }
                    }
                }
                if root.ticktick-form-error != "": Text { text: root.ticktick-form-error; color: Theme.error; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    AddOption { label: root.ticktick-create ? "Add task" : "Save changes"; option-width: 112px; primary: true; enabled: !root.ticktick-loading && root.ticktick-title != "" && root.ticktick-projects.length > 0; clicked => {
                        root.ticktick-form-error = "";
                        root.save-ticktick-task(root.ticktick-edit-id,root.ticktick-projects[root.ticktick-project-index].id,root.ticktick-edit-project,root.ticktick-title,root.ticktick-content,root.ticktick-desc,root.ticktick-priority-value(root.ticktick-priority),root.ticktick-tags,root.ticktick-due-date);
                    } }
                    Rectangle { horizontal-stretch: 1; }
                    if !root.ticktick-create: AddOption { label: root.ticktick-confirm-delete ? "Delete forever" : "Delete"; option-width: root.ticktick-confirm-delete ? 122px : 82px; destructive: true; enabled: !root.ticktick-loading; clicked => {
                        if root.ticktick-confirm-delete { root.delete-ticktick-task(root.ticktick-edit-id,root.ticktick-edit-project); root.ticktick-confirm-delete = false; }
                        else { root.ticktick-confirm-delete = true; }
                    } }
                }
            }
        }
    }

    if root.move-id != "": Rectangle {
        width: root.width; height: root.height; background: #00000070;
        TouchArea { clicked => { root.move-id = ""; } }
        Rectangle {
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            width: 400px; height: 180px; background: Theme.sheet; border-radius: 16px;
            VerticalLayout {
                padding: 24px; spacing: 12px;
                Text { text: "Move to Page"; color: Theme.text; font-size: 20px; }
                ComboBox { model: root.page-names; current-index <=> root.move-page; }
                HorizontalLayout {
                    AddOption { label: "Cancel"; clicked => { root.move-id = ""; } }
                    AddOption { label: "Move"; primary: true; clicked => { root.busy = true; root.move-item(root.move-id,root.move-page); root.move-id = ""; } }
                }
            }
        }
    }
    if root.page-delete-confirm: Rectangle {
        width: root.width; height: root.height; background: #00000080;
        TouchArea { clicked => { root.page-delete-confirm = false; } }
        Rectangle {
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            width: 500px; height: 190px; background: Theme.sheet; border-radius: 16px; border-width: 1px; border-color: Theme.border;
            VerticalLayout {
                padding: 24px; spacing: 16px;
                Text { text: "Delete page " + (root.current-page + 1) + "?"; font-size: 20px; color: Theme.text; }
                Text { text: "Its items will move to " + (root.current-page == 0 ? "the next page." : "the previous page."); wrap: word-wrap; color: Theme.secondary; }
                HorizontalLayout {
                    spacing: 12px;
                    AddOption { label: "Cancel"; clicked => { root.page-delete-confirm = false; } }
                    AddOption { label: "Delete page"; option-width: 132px; destructive: true; enabled: !root.busy; clicked => { root.page-delete-confirm = false; root.busy = true; root.delete-page(); } }
                }
            }
        }
    }
    if root.page-context || root.context-index >= 0 || root.dock-context != "": Rectangle {
        width: root.width; height: root.height;
        background: #00000050;
        TouchArea {
            clicked => { root.page-context = false; root.context-index = -1; root.dock-context = ""; root.context-id = ""; }
            pointer-event(event) => { if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { root.page-context = false; root.context-index = -1; root.dock-context = ""; root.context-id = ""; } }
        }
        Rectangle {
            x: max(0px, min(root.context-x, parent.width - self.width));
            y: max(0px, min(root.context-y, parent.height - self.height));
            width: 200px; height: root.page-context ? 256px : root.context-index >= 0 ? (root.items[root.context-index].widget ? 380px : 208px) : 64px;
            background: Theme.sheet; border-radius: 16px; border-width: 1px; border-color: Theme.border;
            VerticalLayout {
                padding: 12px; spacing: 8px;
                if root.page-context: AddOption { width: 176px; label: "Add item"; enabled: !root.layout-locked; clicked => { root.add-item("App"); } }
                if root.page-context: AddOption { width: 176px; label: "Add page"; enabled: !root.layout-locked && root.page-count < 9 && !root.busy; clicked => { root.page-context = false; root.busy = true; root.add-page(); } }
                if root.page-context: AddOption { width: 176px; label: "Move page left"; enabled: !root.layout-locked && root.current-page > 0 && !root.busy; clicked => { root.page-context = false; root.busy = true; root.reorder-page(-1); } }
                if root.page-context: AddOption { width: 176px; label: "Move page right"; enabled: !root.layout-locked && root.current-page + 1 < root.page-count && !root.busy; clicked => { root.page-context = false; root.busy = true; root.reorder-page(1); } }
                if root.page-context: AddOption { width: 176px; label: "Delete page"; destructive: true; enabled: !root.layout-locked && root.page-count > 1 && !root.busy; clicked => { root.page-context = false; root.confirm-delete-page(); } }
                if root.context-index >= 0 && root.items[root.context-index].ticktick && !root.items[root.context-index].ticktick-next: AddOption { width: 176px; label: "New task"; clicked => { root.open-ticktick-create(root.items[root.context-index].ticktick-project-id); root.context-index = -1; } }
                if root.context-index >= 0 && root.items[root.context-index].widget: AddOption { width: 176px; label: "Duplicate"; enabled: !root.layout-locked; clicked => { root.busy = true; root.duplicate-widget(root.items[root.context-index].id); root.context-index = -1; } }
                if root.context-index >= 0 && root.items[root.context-index].widget: AddOption { width: 176px; label: "Resize · wider";
                    enabled: !root.layout-locked && root.preview-valid(root.items,root.items[root.context-index].id,root.items[root.context-index].row * grid.columns + root.items[root.context-index].col,root.items[root.context-index].span-x + 1,root.items[root.context-index].span-y,grid.columns,grid.rows);
                    clicked => { root.busy = true; root.widget-action(root.items[root.context-index].id,root.items[root.context-index].span-x + 1,root.items[root.context-index].span-y); root.context-index = -1; } }
                if root.context-index >= 0 && root.items[root.context-index].widget: AddOption { width: 176px; label: "Resize · taller";
                    enabled: !root.layout-locked && root.preview-valid(root.items,root.items[root.context-index].id,root.items[root.context-index].row * grid.columns + root.items[root.context-index].col,root.items[root.context-index].span-x,root.items[root.context-index].span-y + 1,grid.columns,grid.rows);
                    clicked => { root.busy = true; root.widget-action(root.items[root.context-index].id,root.items[root.context-index].span-x,root.items[root.context-index].span-y + 1); root.context-index = -1; } }
                if root.context-index >= 0 && root.items[root.context-index].widget: AddOption { width: 176px; label: "Resize · smaller";
                    enabled: !root.layout-locked && (root.items[root.context-index].span-x > root.items[root.context-index].min-span-x || root.items[root.context-index].span-y > root.items[root.context-index].min-span-y)
                        && root.preview-valid(root.items,root.items[root.context-index].id,root.items[root.context-index].row * grid.columns + root.items[root.context-index].col,max(root.items[root.context-index].min-span-x,root.items[root.context-index].span-x - 1),max(root.items[root.context-index].min-span-y,root.items[root.context-index].span-y - 1),grid.columns,grid.rows);
                    clicked => { root.busy = true; root.widget-action(root.items[root.context-index].id,max(root.items[root.context-index].min-span-x,root.items[root.context-index].span-x - 1),max(root.items[root.context-index].min-span-y,root.items[root.context-index].span-y - 1)); root.context-index = -1; } }
                if root.context-index >= 0 && !root.items[root.context-index].widget: AddOption { width: 176px; label: root.items[root.context-index].folder ? "Rename" : "Edit"; clicked => {
                    root.edit-item(root.context-index);
                } }
                if root.context-index >= 0 && !root.items[root.context-index].widget: AddOption { width: 176px; label: root.items[root.context-index].pinned ? "Unpin" : "Pin"; enabled: !root.layout-locked; clicked => { root.busy = true; root.pin-item(root.context-index); root.context-index = -1; } }
                if root.context-index >= 0: AddOption { width: 176px; label: "Move to Page"; enabled: !root.layout-locked; clicked => { root.move-id = root.items[root.context-index].id; root.move-page = root.current-page; root.context-index = -1; } }
                if root.context-index >= 0: AddOption { width: 176px; label: "Delete"; destructive: true; enabled: !root.layout-locked; clicked => {
                    root.editing = root.context-index;
                    root.app-name = root.items[root.context-index].name;
                    root.context-index = -1;
                    root.banner = ""; root.alert = true;
                    cancel-delete.focus();
                } }
                if root.dock-context == "pinned": AddOption { width: 176px; label: "Unpin"; enabled: !root.layout-locked; clicked => { root.busy = true; root.unpin-dock-item(root.context-id); root.dock-context = ""; } }
                if root.dock-context == "recent": AddOption { width: 176px; label: "Remove from Recent"; clicked => { root.busy = true; root.remove-recent-item(root.context-id); root.dock-context = ""; } }
            }
        }
    }
    // Keeping the sheet instantiated preserves field focus while editing.
    sheet-backdrop := Rectangle {
        width: root.width; height: root.height;
        visible: root.sheet;
        opacity: root.sheet ? 1 : 0;
        animate opacity { duration: 120ms; easing: ease-out; }
        background: Theme.backdrop;
        TouchArea { enabled: !root.picker && !root.alert; clicked => { root.close-top-layer(); } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.editing < 0 ? max(16px, (parent.height - min(760px, parent.height - 32px)) / 2) : (parent.height - self.height) / 2;
            width: min(560px, max(288px, parent.width - (parent.width >= 600px ? 48px : 32px)));
            height: min(root.editing >= 0 ? (root.item-type == "Website" ? 480px : root.item-type == "File" || root.item-type == "Directory" ? 336px : (root.custom && root.item-type == "App" ? 420px : 280px)) : (352px + max(100px, sheet-content.preferred-height) + (root.item-type == "App" ? 56px : 0px)), min(parent.height - 32px, 760px));
            animate height { duration: 180ms; easing: ease-out; }
            background: root.editing < 0 ? Theme.add-sheet : Theme.sheet;
            border-width: 1px;
            border-color: root.editing < 0 ? Theme.add-border : Theme.border;
            border-radius: root.editing < 0 ? 20px : 16px;
            if root.editing < 0: Rectangle {
                x: 1px; y: parent.height - 88px; width: parent.width - 2px; height: 68px;
                background: Theme.add-footer;
            }
            TouchArea { }
            VerticalLayout {
                padding: root.editing < 0 ? 24px : 16px;
                spacing: root.editing < 0 ? 20px : 16px;
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        spacing: 6px; horizontal-stretch: 1;
                        Text {
                            text: root.editing < 0 ? "Add item" : ("Edit " + root.item-type);
                            color: Theme.text; font-size: 20px; font-weight: 600;
                            vertical-alignment: center;
                        }
                        if root.editing < 0: Text {
                            text: "Pick a type, then fill in the details.";
                            color: Theme.add-secondary; font-size: 13px;
                        }
                    }
                    AddOption { add-style: root.editing < 0;
                        label: "×";
                        width: 40px;
                        height: 40px;
                        accessible-label: "Close the top layer";
                        clicked => { root.close-top-layer(); }
                    }
                }
                if root.editing < 0: FlexboxLayout {
                    flex-wrap: wrap;
                    spacing: 8px;
                    AddOption { add-style: root.editing < 0; type-tile: true; option-width: max(72px, (root.sheet-content-width - 40px) / 6); icon-present: true; icon: @image-url("assets/add-window.svg"); label: "App"; selected: root.item-type == "App"; clicked => { root.add-item("App"); } }
                    AddOption { add-style: root.editing < 0; type-tile: true; option-width: max(72px, (root.sheet-content-width - 40px) / 6); icon-present: true; icon: @image-url("assets/add-globe.svg"); label: "Website"; selected: root.item-type == "Website"; clicked => { root.add-item("Website"); } }
                    AddOption { add-style: root.editing < 0; type-tile: true; option-width: max(72px, (root.sheet-content-width - 40px) / 6); icon-present: true; icon: @image-url("assets/add-file.svg"); label: "File"; selected: root.item-type == "File"; clicked => { root.add-item("File"); } }
                    AddOption { add-style: root.editing < 0; type-tile: true; option-width: max(72px, (root.sheet-content-width - 40px) / 6); icon-present: true; icon: @image-url("assets/add-dir.svg"); label: "Directory"; selected: root.item-type == "Directory"; clicked => { root.add-item("Directory"); } }
                    AddOption { add-style: root.editing < 0; type-tile: true; option-width: max(72px, (root.sheet-content-width - 40px) / 6); icon-present: true; icon: @image-url("assets/add-group.svg"); label: "Folder"; selected: root.item-type == "Folder"; clicked => { root.add-item("Folder"); } }
                    AddOption { add-style: root.editing < 0; type-tile: true; option-width: max(72px, (root.sheet-content-width - 40px) / 6); icon-present: true; icon: @image-url("assets/add-widgets.svg"); label: "Widgets"; selected: root.item-type == "Widgets"; clicked => { root.add-item("Widgets"); } }
                }
                if root.item-type == "App" && root.editing < 0: FlexboxLayout {
                    flex-wrap: wrap;
                    spacing: 8px;
                    AddOption { add-style: root.editing < 0; source-tab: true; label: "Custom command"; option-width: 148px; selected: root.app-source == "Custom command"; clicked => { root.app-source-changed("Custom command"); } }
                    AddOption { add-style: root.editing < 0; source-tab: true; label: "Actions"; selected: root.app-source == "Actions"; clicked => { root.app-source-changed("Actions"); } }
                    AddOption { add-style: root.editing < 0; source-tab: true; label: "Installed apps"; option-width: 132px; selected: root.app-source == "Installed apps"; clicked => { root.installed-filter = ""; root.filter-installed-apps(""); root.app-source-changed("Installed apps"); } }
                }
                sheet-scroll := Flickable {
                    interactive: true;
                    vertical-stretch: 1;
                    min-height: 100px;
                    content-width: self.width;
                    content-height: sheet-content.preferred-height;
                    sheet-content := VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                        height: self.preferred-height;
                        spacing: 12px;
                        if root.item-type == "App" && root.editing < 0 && root.app-source == "Actions": VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: 8px;
                            for action[index] in root.actions: VerticalLayout {
                                spacing: 6px;
                                if index == 0 || index == 4 || index == 8: Text { text: index == 0 ? "System" : index == 4 ? "Audio" : "Media"; color: Theme.add-secondary; font-size: 12px; font-weight: 600; height: 26px; }
                                AddItemRow {
                                    label: action.name; icon-present: true; icon: index == 0 ? @image-url("assets/add-lock.svg") : index == 1 ? @image-url("assets/add-shot.svg") : index == 2 ? @image-url("assets/add-moon.svg") : index == 3 ? @image-url("assets/add-logout.svg") : index == 4 ? @image-url("assets/add-vol-up.svg") : index == 5 ? @image-url("assets/add-vol-down.svg") : index == 6 ? @image-url("assets/add-mute.svg") : index == 7 ? @image-url("assets/add-mic-off.svg") : index == 8 ? @image-url("assets/add-play.svg") : index == 9 ? @image-url("assets/add-next.svg") : @image-url("assets/add-previous.svg");
                                    enabled: !root.busy;
                                    clicked => { root.busy = true; root.sheet-operation = "adding"; root.sheet-status = "Adding…"; root.add-system-action(action.id); }
                                }
                            }
                        }
                        if root.item-type == "App" && root.editing < 0 && root.app-source == "Installed apps": VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                AddField { add-style: true; label: "";
                                    text <=> root.installed-filter;
                                    placeholder: "Filter installed apps";
                                    enabled: !root.busy;
                                    horizontal-stretch: 1;
                                    edited => { root.filter-installed-apps(root.installed-filter); }
                                }
                            AddOption { add-style: root.editing < 0;
                                label: root.busy && root.sheet-operation == "refreshing" ? "◌" : "↻"; accessible-label: "Refresh installed apps";
                                option-width: 44px;
                                enabled: !root.busy;
                                clicked => {
                                    root.busy = true;
                                    root.sheet-operation = "refreshing";
                                    root.sheet-status = "Refreshing… Cached apps stay available.";
                                    root.refresh-installed-apps();
                                }
                            }

                            }
                            Text {
                                text: root.installed-status == "" ? (root.installed-apps-loaded ? "0 apps · Cached inventory" : "No cached apps. Refresh installed apps.") : root.installed-status;
                                color: Theme.secondary;
                                font-size: 12px;

                            }
                            if root.installed-apps.length == 0 && root.installed-filter == "": Text {
                                text: root.installed-apps-loaded ? "No items found" : "Refresh installed apps to load the list.";
                                color: Theme.secondary;
                                font-size: 14px;

                            }
                            if root.installed-filter != "" && !root.installed-apps-match: Text {
                                text: "No items match this filter.";
                                color: Theme.secondary;
                                font-size: 14px;
                            }
                            VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                                spacing: 8px;
                                for app in root.installed-apps: AddItemRow {
                                    label: app.name; description: app.command; letter: app.letter;
                                    icon: app.icon; icon-present: app.icon-present;
                                    enabled: !root.busy;
                                    clicked => {
                                        root.busy = true;
                                        root.sheet-operation = "adding";
                                        root.sheet-status = "Adding…";
                                        root.add-installed-app(app.id);
                                    }
                                }
                            }
                        }
                        if root.item-type == "App" && root.custom && (root.editing >= 0 || root.app-source == "Custom command"): VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: root.editing < 0 ? 20px : 12px;
                            custom_name_field := AddField { add-style: root.editing < 0;
                                width: root.sheet-content-width;
                                label: "Name";
                                placeholder: "e.g. Terminal";
                                text <=> root.app-name;
                                error: root.name-error;
                                enabled: !root.busy;
                                edited => { root.name-error = ""; }
                                accepted => { custom_command_field.focus(); }
                            }
                            custom_command_field := AddField { add-style: root.editing < 0;
                                width: root.sheet-content-width;
                                label: "Command";
                                placeholder: "e.g. foot --title Terminal";
                                text <=> root.command;
                                error: root.command-error;
                                enabled: !root.busy;
                                multiline: true;
                                edited => { root.command-error = ""; }
                                accepted => { root.submit-form(); }
                            }
                            if root.editing < 0: Text { text: "Enter the full command, including any arguments."; color: Theme.add-secondary; font-size: 12px; wrap: word-wrap; }
                            HorizontalLayout {
                                width: root.sheet-content-width; height: 48px; spacing: 12px; alignment: start;
                                Rectangle {
                                    width: 48px; height: 48px; border-radius: 12px; background: Theme.selection;
                                    if root.icon-preview-present: Image { width: 48px; height: 48px; source: root.icon-preview; image-fit: contain; }
                                    if !root.icon-preview-present: Text { text: root.icon-letter != "" ? root.icon-letter : root.app-name == "" ? "?" : root.first-letter(root.app-name); color: Theme.focus; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                AddOption { add-style: root.editing < 0; label: "Change icon"; option-width: 136px; height: 48px; enabled: !root.busy; clicked => { root.open-icon(root.icon-value, root.app-name); } }
                            }
                        }
                        if root.item-type == "App" && !root.custom && root.editing >= 0: VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: root.editing < 0 ? 20px : 12px;
                            AddField { add-style: root.editing < 0;
                                width: root.sheet-content-width;
                                label: "Name";
                                placeholder: "e.g. Terminal";
                                text <=> root.app-name;
                                error: root.name-error;
                                enabled: !root.busy;
                                edited => { root.name-error = ""; }
