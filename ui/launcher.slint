                    root.context-index = -1; root.dock-context = recent ? "recent" : "pinned";
                    root.context-id = id; root.context-x = x; root.context-y = y;
                }
            }
        }
        if dock.overflowing: Rectangle {
            x: 12px; y: 16px; width: 32px; height: 32px; border-radius: Theme.radius-widget; background: Theme.raised.with-alpha(0.8);
            OrbitText { text: "‹"; color: Theme.text; font-size: Theme.type-title; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { mouse-cursor: pointer; clicked => { dock-scroll.content-x = max(0px,dock-scroll.content-x - 300px); } }
        }
        if dock.overflowing && dock-scroll.content-x < dock-scroll.content-width - dock-scroll.width: Rectangle {
            x: parent.width - 44px; y: 16px; width: 32px; height: 32px; border-radius: Theme.radius-widget; background: Theme.raised.with-alpha(0.8);
            OrbitText { text: "›"; color: Theme.text; font-size: Theme.type-title; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { mouse-cursor: pointer; clicked => { dock-scroll.content-x = min(dock-scroll.content-width - dock-scroll.width,dock-scroll.content-x + 300px); } }
        }
    }
    if root.on-dock: Rectangle {
        x: dock-scroll.absolute-position.x + dock.content-offset + 8px + (root.recent-items.length + root.dock-target) * dock.slot-width - dock-scroll.content-x;
