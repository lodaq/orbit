            x: -72px; y: parent.height + 4px; width: 108px; height: 28px;
            background: Theme.raised; border-radius: 6px;
            OrbitText { text: root.layout-locked ? "Unlock layout" : "Lock layout"; color: Theme.text; font-size: Theme.type-hint; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    VerticalLayout {
        padding-left: 0px; padding-right: 0px; padding-top: 78px; padding-bottom: 134px;
