                    text: index == 0 ? "Select" : index == 1 ? "Hand" : index == 2 ? "Draw" : index == 3 ? "Eraser" : index == 4 ? "Note" : index == 5 ? "Text" : index == 6 ? "Image" : index == 7 ? "Arrow" : index == 8 ? "Highlighter" : "Laser";
