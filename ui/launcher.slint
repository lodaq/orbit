                    AddOption { add-style: true; type-tile: true; option-width: 72px; icon-present: true; icon: @image-url("assets/robot.svg"); label: "Robot"; clicked => { root.sheet = false; RobotWorkbench.adding = true; RobotWorkbench.open("", true); } }
