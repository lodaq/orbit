    merge-timer := Timer {
        interval: 500ms;
        triggered => {
            root.merge-ready = root.dragging && root.merge-target >= 0;
            if root.merge-ready { root.drag-scale = 0.84; }
            self.stop();
        }
    }

    drag-scroll-timer := Timer {
        interval: 32ms;
        running: root.dragging && root.drag-from-folder && !root.drag-outside-folder;
        triggered => {
            let top = folder-scroll.absolute-position.y;
            if root.drag-y < top + 24px { folder-scroll.content-y = min(0px,folder-scroll.content-y + 12px); }
            if root.drag-y > top + folder-scroll.height - 24px {
                folder-scroll.content-y = max(min(0px,folder-scroll.height - folder-scroll.content-height),folder-scroll.content-y - 12px);
            }
            root.move-drag(root.drag-x,root.drag-y);
        }
    }
    folder-close-timer := Timer {
        interval: Theme.folder-transition;
        triggered => { root.folder-closing = false; self.stop(); }
    }
    function close-folder-view() {
        root.folder-open = false;
        root.ticktick-open = false;
        root.ticktick-confirm-delete = false;
        root.folder-closing = !root.drag-outside-folder;
        if root.folder-closing { folder-close-timer.start(); }
        root.close-folder();
    }
    function clear-merge() {
        root.merge-target = -1;
        root.merge-ready = false;
        root.drag-scale = root.dragging && !root.drag-item.widget ? 1.08 : 1;
        merge-timer.stop();
    }
    function cancel-drag() {
        if root.dragging && !root.drop-pending && !root.resizing {
            root.snapping = true; root.drag-x = root.drag-start-x; root.drag-y = root.drag-start-y; snap-timer.start();
        }
        root.clear-merge();
        root.drag-from-search = false; root.drag-from-dock = false; root.resizing = false; root.ticktick-control-pressed = false;
        root.ticktick-content-pressed = false; root.ticktick-content-scrolling = false;
        root.dragging = false;
        root.drag-scale = 1;
        root.drag-index = -1;
        root.drop-target = -1;
        root.drop-pending = false;
        root.drag-outside-folder = false;
    }
    function begin-drag(index: int, folder: bool, x: length, y: length) {
        root.cancel-drag();
