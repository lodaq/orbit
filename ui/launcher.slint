import { Theme } from "theme.slint";
import { AddOption, AddField } from "controls.slint";
import "fonts/inter.ttf";
import { Button, LineEdit, Palette, ComboBox, SpinBox, Slider } from "std-widgets.slint";

export struct ShortcutEntry { action: int, keys: string }
export struct ShortcutGroup { action: int, entries: [ShortcutEntry] }

export struct FolderPreview {
    icon: image,
    icon-present: bool,
    letter: string,
}

export struct AppTile {
    row: int, col: int, span-x: int, span-y: int, widget: bool, widget-text: string,
    text-icon: bool,
    id: string,
    name: string,
    page: int,
    index: int,
    folder-app-index: int,
    pinned: bool,
    artwork: string,
    letter: string,
    icon: image,
    command: string,
    url: string,
    path: string,
    icon-value: string,
    custom: bool,
    icon-present: bool,
    app: bool,
    website: bool,
    file: bool,
    directory: bool,
    folder: bool,
    preview-icons: [FolderPreview],
}

export struct PageItems { items: [AppTile] }

export struct InstalledAppTile {
    id: string,
    name: string,
    letter: string,
    icon: image,
    icon-present: bool,
}

export struct ActionChoice {
    id: string,
    name: string,
}

component ItemIcon inherits Rectangle {
    in property <AppTile> item;
    in property <bool> dock;
    background: transparent;
    border-radius: self.width * 0.25;
    Image {
        width: parent.width; height: parent.height;
        source: item.text-icon ? @image-url("assets/letter.svg") : dock && item.artwork == "website" ? @image-url("assets/dock-website.svg")
            : dock && item.artwork == "file" ? @image-url("assets/dock-file.svg")
            : dock && item.artwork == "command" ? @image-url("assets/dock-command.svg")
            : dock && item.artwork == "directory" ? @image-url("assets/dock-directory.svg")
            : dock && item.artwork == "browser" ? @image-url("assets/dock-browser.svg")
            : item.artwork == "action" ? @image-url("assets/action.svg")
            : item.icon-present ? item.icon
            : item.website ? @image-url("assets/website.svg")
            : item.file ? @image-url("assets/file.svg")
            : item.directory ? @image-url("assets/directory.svg")
            : item.folder ? @image-url("assets/folder-empty.svg")
            : @image-url("assets/letter.svg");
        image-fit: contain;
    }
    if (item.app || item.text-icon) && !item.icon-present && item.artwork != "action": Text { text: item.letter; color: #e0e5ff; font-size: parent.width * (item.text-icon ? 0.32 : 0.4); horizontal-alignment: center; vertical-alignment: center; }
    if item.folder && item.preview-icons.length == 0: Text {
        text: "Empty"; color: #e0e5ff; font-size: parent.width * 0.16;
        horizontal-alignment: center; vertical-alignment: center;
    }
    for index in item.preview-icons.length: Rectangle {
        x: parent.width * (mod(index, 2) == 0 ? 0.16 : 0.55);
        y: parent.height * (index < 2 ? 0.16 : 0.55);
        width: parent.width * 0.29; height: self.width;
        border-radius: self.width * 0.22; background: #8597dc;
        if item.preview-icons[index].icon-present: Image {
            width: parent.width; height: parent.height;
            source: item.preview-icons[index].icon; image-fit: contain;
        }
        if !item.preview-icons[index].icon-present: Image {
            width: parent.width; height: parent.height;
            source: @image-url("assets/letter.svg"); image-fit: contain;
        }
        if !item.preview-icons[index].icon-present: Text {
            text: item.preview-icons[index].letter; color: #eef1ff;
            font-size: parent.width * 0.56;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
}

component PageTile inherits Rectangle {
    in property <[AppTile]> items;
    in property <int> index;
    in property <bool> hovered;
    in property <bool> folder-preview: false;
    in property <AppTile> drag-preview-item;
    width: 128px;
    height: 128px;
    background: hovered ? #ffffff16 : #51405f99;
    border-radius: min(self.width,self.height) * 0.15625;
    border-width: 1px;
    border-color: index < items.length ? #a6b1ed33 : transparent;
    if index == items.length || !items[index].widget: Rectangle {
        x: (parent.width - self.width) / 2; y: parent.height * 0.09;
        width: min(parent.width * 0.625, parent.height - 44px); height: self.width;
        border-radius: 20px;
        if index < items.length && !folder-preview: ItemIcon { width: parent.width; height: parent.height; item: items[index]; }
        if index < items.length && folder-preview && !items[index].folder: ItemIcon {
            x: 4px; y: 8px; width: parent.width * 0.42; height: self.width; item: items[index];
        }
        if index < items.length && folder-preview && !items[index].folder: ItemIcon {
            x: parent.width * 0.52; y: 8px; width: parent.width * 0.42; height: self.width; item: drag-preview-item;
        }
        if index < items.length && folder-preview && items[index].folder: ItemIcon { width: parent.width; height: parent.height; item: items[index]; }
        if index < items.length && folder-preview && items[index].folder: ItemIcon {
            x: parent.width - 30px; y: parent.height - 30px; width: 28px; height: 28px; item: drag-preview-item;
        }
        if index == items.length: Image { width: parent.width; height: parent.height; source: @image-url("assets/add.svg"); }
    }
    if index < items.length && items[index].widget: Text { x: parent.width - 20px; y: parent.height - 22px; text: "◢"; color: #a8b3ff; font-size: 16px; }
    if index < items.length && items[index].widget: Text { x: 16px; y: 12px; width: parent.width - 32px; height: parent.height - 48px; text: items[index].widget-text; color: #e0e3f4; font-size: 16px; wrap: word-wrap; vertical-alignment: center; }
    Text {
        y: parent.height - 28px;
        width: parent.width;
        height: 24px;
        text: index == items.length ? "Add" : folder-preview ? (items[index].folder ? "Add to folder" : "Create folder") : items[index].name;
        color: #e0e3f4;
        font-size: min(18px,max(12px,min(parent.width,parent.height) * 0.109375));
        horizontal-alignment: center;
        overflow: elide;
    }
}

component DockTile inherits Rectangle {
    in property <AppTile> item;
    in property <bool> enabled;
    in property <bool> recent;
    callback gesture(int,length,length);
    callback open();
    callback context-menu(bool, string, length, length);
    height: 82px;
    border-radius: 20px;
    background: dock-touch.has-hover ? #ffffff0b : transparent;
    ItemIcon { x: (parent.width - 48px) / 2; y: 6px; width: 48px; height: 48px; item: item; dock: true; }
    Text { y: 65px; width: parent.width; height: 16px; text: item.name; color: #e0e3f4; font-size: 11px; horizontal-alignment: center; overflow: elide; }
    dock-touch := TouchArea {
        mouse-cursor: pointer; enabled: root.enabled;

        pointer-event(event) => {
            if event.kind == PointerEventKind.move { root.gesture(1,self.absolute-position.x + self.mouse-x,self.absolute-position.y + self.mouse-y); }
            if event.kind == PointerEventKind.cancel { root.gesture(3,0px,0px); }
            if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down { root.gesture(0,self.absolute-position.x + self.mouse-x,self.absolute-position.y + self.mouse-y); }
                if event.kind == PointerEventKind.up { root.gesture(2,self.absolute-position.x + self.mouse-x,self.absolute-position.y + self.mouse-y); }
            }
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.context-menu(root.recent, root.item.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

export component Launcher inherits Window {
    pure callback center-zone(float,float,float,bool) -> bool;
    pure callback hit-cell([AppTile],int,int) -> int;
    pure callback free-cell([AppTile],int,int) -> int;
    pure callback preview-valid([AppTile],string,int,int,int,int,int) -> bool;
    pure callback preview-cells([AppTile],string,int,int,int,int,int) -> [AppTile];
    in property <[string]> page-names;
    callback move-item(string,int);
    callback reorder-page(int);
    private property <string> move-id;
    private property <int> move-page;
    callback geometry(int,int);
    callback add-widget(int);
    callback widget-action(string,bool,int,int);
    private property <int> known-columns: 0;
    private property <int> known-rows: 0;
    private property <bool> reorder-ready;
    private property <int> reorder-target: -1;
    private property <length> grab-x;
    private property <length> grab-y;
    private property <int> focused-item: 0;
    private property <bool> keyboard-grid;
    private property <int> dock-source-index: -1;
    out property <bool> grid-navigation: page-focus.has-focus && !root.settings && !root.sheet && !root.folder-open && !root.alert && !root.picker;
    pure callback next-grid-item([AppTile],int,int) -> int;
    callback move-grid(int);
    move-grid(direction) => { root.keyboard-grid = true; root.focused-item = root.next-grid-item(root.items,root.focused-item,direction); }
    callback activate-grid();
    activate-grid => { if root.focused-item >= 0 && root.focused-item < root.items.length { root.begin-drag(root.focused-item,false,0px,0px); root.end-drag(); } }
    callback context-focused();
    context-focused => { if root.focused-item >= 0 && root.focused-item < root.items.length { root.context-index = root.focused-item; root.context-x = grid.absolute-position.x + root.items[root.focused-item].col * grid.tile-size; root.context-y = grid.absolute-position.y + root.items[root.focused-item].row * grid.tile-size; } }
    private property <bool> snapping;
    snap-timer := Timer { interval: 210ms; triggered => { root.snapping = false; self.stop(); } }
    animate drag-x { duration: root.snapping ? 200ms : 0ms; easing: ease-out; }
    animate drag-y { duration: root.snapping ? 200ms : 0ms; easing: ease-out; }
    private property <bool> drag-slide-animate;
    private property <float> drag-slide: 1;
    private property <int> drag-slide-direction;
    animate drag-slide { duration: root.drag-slide-animate ? 280ms : 0ms; easing: ease-out; }
    drag-slide-timer := Timer { interval: 16ms; triggered => { root.drag-slide-animate = true; root.drag-slide = 1; self.stop(); } }
    private property <bool> resizing;
    private property <int> resize-width;
    private property <int> resize-height;
    private property <bool> resize-valid: root.preview-valid(root.items,root.drag-item.id,root.drag-item.row * grid.columns + root.drag-item.col,root.resize-width,root.resize-height,grid.columns,grid.rows);
    private property <bool> drag-from-dock;
    private property <bool> on-dock: root.dragging && root.drag-y >= dock.absolute-position.y && root.drag-y <= dock.absolute-position.y + dock.height && root.drag-x >= dock.x && root.drag-x <= dock.x + dock.width;
    private property <int> dock-target: min(root.dock-items.length,max(0,floor((root.drag-x - dock.x) / dock.slot-width) - root.recent-items.length));
    private property <bool> placement-valid: root.drop-target >= 0 && root.preview-valid(root.drag-items,root.drag-item.id,root.drop-target,root.drag-item.span-x,root.drag-item.span-y,grid.columns,grid.rows);
    geometry-timer := Timer {
        interval: 200ms; running: true;
        triggered => {
            if root.launcher-visible && !root.settings && !root.dragging && !root.busy && (root.known-columns != grid.columns || root.known-rows != grid.rows) {
                root.known-columns = grid.columns; root.known-rows = grid.rows;
                root.geometry(grid.columns,grid.rows);
            }
        }
    }
    reorder-timer := Timer { interval: 300ms; triggered => { root.reorder-ready = root.dragging && root.reorder-target >= 0; self.stop(); } }
    pure callback first-letter(string) -> string;
    pure callback valid-name(string) -> bool;
    pure callback valid-command(string) -> bool;
    pure callback valid-url(string) -> bool;
    in property <string> monitor-name;
    in property <float> cursor-x;
    in property <float> cursor-y;
    in-out property <bool> launcher-visible;
    in-out property <string> banner;
    in property <int> page-count: 1;
    in property <int> current-page;
    in property <[AppTile]> items;
    in property <[AppTile]> previous-items;
    in property <[AppTile]> next-items;
    in property <[AppTile]> dock-items;
    in property <[AppTile]> recent-items;
    in property <[AppTile]> search-results;
    in property <[string]> file-search-paths;
    in property <[string]> directory-search-paths;
    in-out property <string> search-text;
    in-out property <bool> settings;
    private property <bool> shortcuts-tab;
    in property <[ShortcutEntry]> shortcuts;
    in property <[ShortcutGroup]> shortcut-groups;
    in property <[PageItems]> page-previews;
    in-out property <int> page-margin: 10;
    in-out property <int> item-size: 128;
    private property <int> saved-size: 128;
    private property <int> saved-margin: 10;
    changed settings => {
        if root.settings { root.saved-size = root.item-size; root.saved-margin = root.page-margin; }
        else { root.item-size = root.saved-size; root.page-margin = root.saved-margin; }
    }
    callback save-appearance(int, int, int, int);
    in-out property <bool> shortcut-recording;
    in-out property <string> shortcut-draft;
    private property <bool> shortcut-editor;
    private property <string> shortcut-existing;
    private property <int> shortcut-delete-action: -1;
    private property <string> shortcut-delete-keys;
    private property <int> shortcut-action;
    private property <[string]> shortcut-actions: ["Focus Search anything", "Close the top layer", "Move left / previous page", "Move right / next page", "Move up", "Move down", "Open / Choose", "Next field", "Previous field", "Open Settings", "Add page", "Delete page"];
    callback save-shortcut(int, string, string);
    callback delete-shortcut(int, string);
    callback shortcut-saved();
    shortcut-saved => { root.shortcut-editor = false; root.shortcut-recording = false; }
    private property <bool> page-delete-confirm;
    callback delete-page();
    callback confirm-delete-page();
    confirm-delete-page => { if root.page-count > 1 && !root.busy && !root.sheet && !root.folder-open { root.page-delete-confirm = true; } }
    private property <int> search-selection;
    private property <length> search-offset;
    private property <int> search-columns: max(1, floor(min(1316px, root.width - 96px) / 160px));
    out property <bool> search-navigation: root.search-text != "" && !root.settings && !root.sheet && !root.folder-open && !root.picker && !root.alert;
    callback move-search-selection(int);
    callback activate-search-selection();
    activate-search-selection => {
        if root.search-selection >= 0 && root.search-selection < root.search-results.length && !root.busy {
            root.busy = true;
            root.open-result(root.search-results[root.search-selection].page, root.search-results[root.search-selection].index);
        }
    }
    move-search-selection(direction) => {
        if root.search-results.length == 0 { return; }
        let column = mod(root.search-selection, root.search-columns);
        if direction == 0 && column > 0 { root.search-selection -= 1; }
        if direction == 1 && column < root.search-columns - 1 && root.search-selection + 1 < root.search-results.length { root.search-selection += 1; }
        if direction == 2 && root.search-selection >= root.search-columns { root.search-selection -= root.search-columns; }
        if direction == 3 && root.search-selection + root.search-columns < root.search-results.length { root.search-selection += root.search-columns; }
        let top = floor(root.search-selection / root.search-columns) * 164px;
        let view-height = root.height - 238px;
        if top < root.search-offset { root.search-offset = top; }
        if top + 152px > root.search-offset + view-height { root.search-offset = top + 152px - view-height; }
    }

    in-out property <bool> data-busy;
    in-out property <string> data-status;
    callback transfer-data(bool);
    private property <bool> search-path-editor;
    private property <bool> search-path-directory;
    private property <int> search-path-index: -1;
    private property <string> search-path-draft;
    callback search(string);
    callback save-search-path(bool, int, string);
    callback delete-search-path(bool, int);
    callback finish-search-path-save();
    callback open-result(int, int);
    callback open-dock-item(int, int, int);
    callback pin-item(int);
    callback unpin-dock-item(string);
    callback remove-recent-item(string);
    out property <bool> search-focused: search-input.has-focus;
    callback focus-search();
    callback page-key(int);
    focus-search => { if !root.sheet && !root.folder-open && root.context-index < 0 && root.dock-context == "" { root.settings = false; search-input.focus(); } }
    page-key(direction) => { if !root.sheet && !root.folder-open && root.search-text == "" && !root.settings && root.context-index < 0 && root.dock-context == "" { root.change-page(root.current-page + direction); } }

    in property <[InstalledAppTile]> installed-apps;
    in property <[ActionChoice]> actions;
    in property <string> installed-status;
    in property <bool> installed-apps-loaded;
    in property <bool> installed-apps-match;
    in property <[AppTile]> folder-items;
    in property <string> folder-name;
    in-out property <int> folder-index: -1;
    in-out property <bool> folder-open;
    private property <bool> folder-closing;
    in-out property <bool> busy;
    private property <bool> sheet;
    private property <bool> alert;
    in-out property <bool> picker;
    private property <int> context-index: -1;
    private property <string> dock-context;
    private property <string> context-id;
    private property <int> editing: -1;
    private property <string> app-name;
    private property <string> command;
    private property <string> url-or-path;
    private property <string> item-type: "App";
    in-out property <string> icon-value;
    in-out property <string> svg-draft;
    in-out property <string> letter-draft;
    in-out property <string> icon-file-draft;
    in-out property <string> icon-mode: "Letter";
    in-out property <image> icon-preview;
    in-out property <bool> icon-preview-present;
    in-out property <string> icon-letter;
    in-out property <bool> icon-busy;
    in-out property <int> icon-session;
    callback open-icon(string, string);
    callback save-icon(string, string, int);
    callback choose-icon(int);

    private property <length> context-x;
    private property <length> context-y;
    private property <length> page-drag-offset;
    private property <bool> page-dragging;
    private property <bool> page-swipe-pressed;
    private property <length> page-swipe-start;
    private property <length> page-span: page.width + 24px;
    private property <[AppTile]> transition-items;
    private property <[AppTile]> transition-incoming-items;
    private property <bool> transitioning;
    private property <int> transition-direction;
    private property <length> transition-start;
    private property <float> transition-progress;
    private property <duration> transition-duration: max(90ms, 170ms * (1 - abs(root.transition-start) / root.page-span));
    private property <bool> custom: true;
    private property <string> app-source: "Custom command";
    private property <length> sheet-content-width: min(520px, max(220px, root.width - 68px));
    private property <string> installed-filter;
    in-out property <string> sheet-status;
    in-out property <string> sheet-operation;
    private property <string> name-error;
    private property <string> command-error;
    private property <string> url-error;
    private property <string> path-error;
    in-out property <string> icon-error;
    private property <string> custom-name-draft;
    private property <string> custom-command-draft;
    private property <string> website-name-draft;
    private property <string> website-url-draft;
    private property <string> folder-name-draft;
    // The input surfaces stay still; only the rendered tiles move.
    private property <int> drag-index: -1;
    private property <int> drag-origin: -1;
    private property <int> drag-page: -1;
    private property <bool> drag-from-folder;
    private property <bool> drag-outside-folder;
    private property <bool> dragging;
    private property <bool> drop-pending;
    private property <AppTile> drag-item;
    private property <length> drag-start-x;
    private property <length> drag-start-y;
    private property <length> drag-x;
    private property <length> drag-y;
    private property <int> drop-target: -1;
    private property <int> merge-target: -1;
    private property <bool> merge-ready;
    private property <int> edge-direction;
    private property <[AppTile]> drag-items: root.drag-page >= 0 && root.drag-page < root.page-previews.length ? root.page-previews[root.drag-page].items : [];
    private property <bool> drag-on-page: root.dragging && (!root.drag-from-folder || root.drag-outside-folder);
    callback save-app(int, string, string, string);
    callback add-system-action(string);
    callback add-installed-app(string);
    callback refresh-installed-apps();
    callback filter-installed-apps(string);
    callback save-website(int, string, string);
    callback choose-path(bool);
    callback path-chosen(string);
    path-chosen(path) => { root.url-or-path = path; root.path-error = ""; }
    finish-search-path-save => { root.search-path-editor = false; root.search-path-draft = ""; }
    callback save-path(int, string, bool, string);
    callback save-folder(int, string);
    callback cancel-add();
    callback delete-item(int);
    callback open-item(int);
    callback launch-folder-app(int, int);
    callback open-folder(int);
    callback close-folder();
    callback add-page();
    callback drop-item(string, int, int, string);
    callback cancel-pointer();
    cancel-pointer => { root.cancel-drag(); }
    callback reset-launcher();
    callback finish-drag();
    callback close-top-layer();
    animate page-drag-offset { duration: root.page-dragging ? 0ms : 100ms; easing: ease-out; }
    animate transition-progress { duration: root.transition-duration; easing: ease-out-sine; }
    transition-timer := Timer {
        running: false;
        interval: root.transition-duration + 34ms;
        triggered => {
            root.transitioning = false;
            root.transition-progress = 0;
            root.transition-items = [];
            root.transition-incoming-items = [];
            self.running = false;
        }
    }
    merge-timer := Timer {
        interval: 500ms;
        triggered => { root.merge-ready = root.dragging && root.merge-target >= 0; self.stop(); }
    }
    edge-timer := Timer {
        interval: 600ms;
        triggered => {
            let destination = root.drag-page + root.edge-direction;
            if root.drag-on-page && destination >= 0 && destination <= min(root.page-count, 8) {
                root.drag-slide-animate = false; root.drag-slide-direction = root.edge-direction; root.drag-slide = 0; drag-slide-timer.start();
                root.drag-page = destination;
                page.content-y = 0px;
                root.clear-merge();
                root.update-drop();
            } else { self.stop(); }
        }
    }
    drag-scroll-timer := Timer {
        interval: 32ms;
        running: root.dragging;
        triggered => {
            if root.drag-on-page {
                let top = page.absolute-position.y;
                if root.drag-y >= top && root.drag-y < top + 32px { page.content-y = min(0px, page.content-y + 12px); }
                if root.drag-y <= top + page.height && root.drag-y > top + page.height - 32px {
                    page.content-y = max(min(0px, page.height - page.content-height), page.content-y - 12px);
                }
                root.update-drop();
            } else {
                let top = folder-scroll.absolute-position.y;
                if root.drag-y < top + 24px { folder-scroll.content-y = min(0px, folder-scroll.content-y + 12px); }
                if root.drag-y > top + folder-scroll.height - 24px {
                    folder-scroll.content-y = max(min(0px, folder-scroll.height - folder-scroll.content-height), folder-scroll.content-y - 12px);
                }
                root.move-drag(root.drag-x, root.drag-y);
            }
        }
    }
    folder-close-timer := Timer {
        interval: 220ms;
        triggered => { root.folder-closing = false; self.stop(); }
    }
    function close-folder-view() {
        root.folder-open = false;
        root.folder-closing = !root.drag-outside-folder;
        if root.folder-closing { folder-close-timer.start(); }
        root.close-folder();
    }
    function clear-merge() {
        root.merge-target = -1;
        root.merge-ready = false;
        merge-timer.stop();
    }
    function cancel-drag() {
        if root.dragging && !root.drop-pending && !root.resizing {
            root.snapping = true; root.drag-x = root.drag-start-x; root.drag-y = root.drag-start-y; snap-timer.start();
        }
        edge-timer.stop();
        root.clear-merge();
        reorder-timer.stop(); root.reorder-ready = false; root.reorder-target = -1;
        root.drag-from-dock = false; root.resizing = false;
        root.dragging = false;
        root.drag-index = -1;
        root.drag-page = -1;
        root.drop-target = -1;
        root.drop-pending = false;
        root.drag-outside-folder = false;
        root.edge-direction = 0;
    }
    function begin-drag(index: int, folder: bool, x: length, y: length) {
        root.cancel-drag();
        root.snapping = false; snap-timer.stop();
        root.drag-index = index;
        root.drag-origin = root.current-page;
        root.drag-page = root.current-page;
        root.drag-from-folder = folder;
        root.drag-start-x = x;
        root.drag-start-y = y;
        root.drag-x = x;
        root.drag-y = y;
        if index >= 0 && index < (folder ? root.folder-items.length : root.items.length) {
            root.drag-item = folder ? root.folder-items[index] : root.items[index];
            root.grab-x = folder ? root.item-size * 0.5px : x - grid.absolute-position.x - root.drag-item.col * grid.tile-size - (grid.tile-size - root.item-size * 1px) / 2;
            root.grab-y = folder ? root.item-size * 0.5px : y - grid.absolute-position.y - root.drag-item.row * grid.tile-size - (grid.tile-size - root.item-size * 1px) / 2;
        }
    }
    function update-drop() {
        if !root.drag-on-page { return; }
        let x = root.drag-x - grid.absolute-position.x;
        let y = root.drag-y - grid.absolute-position.y;
        let column = floor(x / grid.tile-size);
        let row = floor(y / grid.tile-size);
        let in-page = column >= 0 && column < grid.columns && row >= 0 && row < grid.rows;
        let slot = in-page ? row * grid.columns + column : -1;
        let target = root.hit-cell(root.drag-items,column,row);
        root.drop-target = slot;
        let icon-size = min(root.item-size * 0.625px, root.item-size * 1px - 44px);
        let icon-x = column * grid.tile-size + (grid.tile-size - icon-size) / 2;
        let icon-y = row * grid.tile-size + (grid.tile-size - root.item-size * 1px) / 2 + root.item-size * 0.09px;
        let can-merge = in-page && !root.drag-item.folder && !root.drag-item.widget && target >= 0
            && root.drag-items[target].id != root.drag-item.id
