                OrbitText { text: "Its items will move to " + (root.current-page == 0 ? "the next page." : "the previous page."); wrap: word-wrap; color: Theme.secondary; }
                HorizontalLayout {
                    spacing: 12px;
                    AddOption { label: "Cancel"; clicked => { root.page-delete-confirm = false; } }
                    AddOption { label: "Delete page"; option-width: 132px; destructive: true; enabled: !root.busy; clicked => { root.page-delete-confirm = false; root.busy = true; root.delete-page(); } }
                }
            }
        }
    }
    if root.search-context: Rectangle {
        width: root.width; height: root.height;
        TouchArea { clicked => { root.search-context = false; } }
        Panel {
            x: min(root.context-x,root.width - self.width); y: min(root.context-y,root.height - self.height);
            width: 200px; height: 104px;
            VerticalLayout { padding: 8px; spacing: 4px;
                MenuOption { label: "Pin"; width: 184px; enabled: !root.layout-locked && !root.busy && (root.dock-items.length < 10 || root.search-context-item.pinned); clicked => { root.save-result(root.search-context-item,root.current-page,-1,true); } }
                MenuOption { label: "Add to Page"; width: 184px; enabled: !root.layout-locked && !root.busy; clicked => { root.save-result(root.search-context-item,root.current-page,-1,false); } }
            }
        }
    }
    if root.page-context || root.context-index >= 0 || root.dock-context != "": Rectangle {
