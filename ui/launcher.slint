    }
    function handle-ticktick-click(index: int, x: length, y: length) {
        if index < 0 || index >= root.items.length || !root.items[index].ticktick { return; }
        let item = root.items[index];
        let tile-x = item.col * 1px + root.grid-gap * 0.5px;
        let tile-y = item.row * 1px + root.grid-gap * 0.5px;
        let local-x = root.world-x(x) - tile-x;
        let local-y = root.world-y(y) - tile-y;
        let tile-width = item.span-x * 1px - root.grid-gap * 1px;
        let tile-height = item.span-y * 1px - root.grid-gap * 1px;
        if item.ticktick-next {
            if (local-x >= tile-width - 76px && local-y >= 12px && local-y <= (tile-height <= 220px ? 48px : 64px)) || local-y >= (tile-height <= 220px ? 52px : 88px) {
                let first = root.ticktick-visible-tasks(root.ticktick-tasks,"@today",false,0,1);
                if first.length == 0 { return; }
                // The checkbox completes the task; the title opens it for editing.
                if local-x >= tile-width - 76px && local-x <= tile-width - 16px && local-y <= (tile-height <= 220px ? 48px : 64px) {
                    if !root.ticktick-loading {
                        root.complete-ticktick-task(first[0].id,first[0].project-id);
                        root.ticktick-next-completion-sequence += 1;
                        root.ticktick-focus-scroll = 0px; root.ticktick-focus-details-id = "";
                    }
                } else if tile-height > 220px && local-y >= tile-height - 56px && local-y <= tile-height - 20px && local-x >= tile-width - 144px && local-x <= tile-width - 56px {
                    root.ticktick-focus-details-id = root.ticktick-focus-details-id == root.items[index].id ? "" : root.items[index].id;
                    root.ticktick-focus-scroll = 0px;
                } else {
                    root.open-ticktick-details(first[0]);
                }
            }
            return;
        }
        if local-y < 48px {
            if local-x >= tile-width - 44px {
                root.ticktick-popup-options = true;
                root.ticktick-popup-x = max(16px,min((CanvasState.pan-x + (tile-x + tile-width) / 1px * CanvasState.zoom) * 1px - 232px,root.width - 236px));
            } else if local-x >= tile-width - 82px {
                root.open-ticktick-create(item.ticktick-project-id);
                return;
            } else {
                root.ticktick-popup-options = false;
                root.ticktick-popup-x = max(16px,min((CanvasState.pan-x + tile-x / 1px * CanvasState.zoom) * 1px,root.width - 316px));
            }
            root.ticktick-popup-y = (CanvasState.pan-y + (tile-y / 1px + 48) * CanvasState.zoom) * 1px;
            root.ticktick-popup-project-id = root.items[index].ticktick-project-id;
            root.ticktick-popup-widget-id = root.items[index].id;
            return;
        }
        let scroll-offset = root.ticktick-scroll-widget-id == item.id ? root.ticktick-scroll-offset : 0px;
        let scroll-row = floor(scroll-offset / 36px);
        let scroll-shift = scroll-offset - scroll-row * 36px;
        let task-row = floor((local-y - 52px + scroll-shift) / 36px);
        let visible = root.ticktick-visible-tasks(root.ticktick-tasks,item.ticktick-project-id,root.ticktick-show-completed,scroll-row,max(0,floor((tile-height - 68px) / 36px)) + 1);
        if local-y >= 52px && task-row >= 0 && task-row < visible.length {
            if visible[task-row].rtl ? (local-x >= tile-width - 39px && local-x <= tile-width - 10px) : (local-x >= 10px && local-x <= 39px) {
                if root.ticktick-loading { return; }
                if visible[task-row].done { root.reopen-ticktick-task(visible[task-row].id,visible[task-row].project-id); }
                else { root.complete-ticktick-task(visible[task-row].id,visible[task-row].project-id); }
            } else { root.open-ticktick-details(visible[task-row]); }
        }
    }
    function scroll-ticktick(x: length, y: length, delta: length) -> bool {
        let index = root.canvas-item-at(x,y);
        if index < 0 || index >= root.items.length || !root.items[index].ticktick { return false; }
        let item = root.items[index];
        let offset = item.ticktick-next ? (root.ticktick-focus-scroll-widget-id == item.id ? root.ticktick-focus-scroll : 0px) : root.ticktick-scroll-widget-id == item.id ? root.ticktick-scroll-offset : 0px;
        root.set-ticktick-scroll(item,offset - delta * (item.ticktick-next ? 2.4 : 1.8));
        return true;
    }
    function set-ticktick-scroll(item: AppTile, offset: length) {
        let tile-height = item.span-y * 1px - root.grid-gap * 1px;
        if item.ticktick-next {
            root.ticktick-focus-scroll-widget-id = item.id;
            root.ticktick-focus-width = max(1px,item.span-x * 1px - root.grid-gap * 1px - 48px);
            root.ticktick-focus-compact = tile-height <= 220px;
            root.ticktick-focus-scroll = min(max(0px,focus-scroll-measure.content-height - max(0px,tile-height - (root.ticktick-focus-compact ? 68px : 164px))),max(0px,offset));
        } else {
            let count = root.ticktick-task-count(root.ticktick-tasks,item.ticktick-project-id,root.ticktick-show-completed);
            let visible = max(1,floor((tile-height - 68px) / 36px));
            root.ticktick-scroll-widget-id = item.id;
            root.ticktick-scroll-offset = min(max(0,count - visible) * 36px,max(0px,offset));
        }
    }
    function ticktick-scrollbar-at(index: int, x: length, y: length) -> bool {
        if index < 0 || index >= root.items.length || !root.items[index].ticktick || root.items[index].ticktick-next { return false; }
        let item = root.items[index];
        let tile-x = item.col * 1px + root.grid-gap * 0.5px;
        let tile-y = item.row * 1px + root.grid-gap * 0.5px;
        let tile-width = item.span-x * 1px - root.grid-gap * 1px;
        let tile-height = item.span-y * 1px - root.grid-gap * 1px;
        let visible = max(1,floor((tile-height - 68px) / 36px));
        let count = root.ticktick-task-count(root.ticktick-tasks,item.ticktick-project-id,root.ticktick-show-completed);
        return count > visible && root.world-x(x) >= tile-x + tile-width - 16px && root.world-x(x) < tile-x + tile-width
            && root.world-y(y) >= tile-y + 52px && root.world-y(y) < tile-y + tile-height - 12px;
    }
    function set-ticktick-scrollbar(index: int, y: length) {
        if index < 0 || index >= root.items.length { return; }
        let item = root.items[index];
        let tile-y = item.row * 1px + root.grid-gap * 0.5px;
        let tile-height = item.span-y * 1px - root.grid-gap * 1px;
        let visible = max(1,floor((tile-height - 68px) / 36px));
        let count = root.ticktick-task-count(root.ticktick-tasks,item.ticktick-project-id,root.ticktick-show-completed);
        if count <= visible { return; }
        let track-height = max(1px,tile-height - 64px);
        let thumb-height = min(track-height,max(24px,track-height * visible / count));
        let travel = max(1px,track-height - thumb-height);
        let position = min(travel,max(0px,root.world-y(y) - tile-y - 52px - thumb-height / 2));
        root.ticktick-scroll-widget-id = item.id;
        root.ticktick-scroll-offset = (count - visible) * 36px * position / travel;
    }
    function canvas-item-at(x: length, y: length) -> int {
        let dx = root.world-x(x); let dy = root.world-y(y);
        let index = root.hit-cell(root.items,floor(dx / 1px),floor(dy / 1px));
        if index < 0 { return -1; }
        let local-x = dx - root.items[index].col * 1px;
        let local-y = dy - root.items[index].row * 1px;
        return local-x >= root.grid-gap * 0.5px && local-x < (root.items[index].span-x - root.grid-gap / 2) * 1px
            && local-y >= root.grid-gap * 0.5px && local-y < (root.items[index].span-y - root.grid-gap / 2) * 1px ? index : -1;
    }
    canvas-focus := FocusScope { width: 0px; height: 0px; changed has-focus => { if self.has-focus { KeyboardNavigation.list-focused = false; } } }
    finish-drag => { if root.drop-pending { root.cancel-drag(); } }
    reset-launcher(preserve-search) => {
        RobotWorkbench.visible = false;
        root.cancel-canvas(); root.flush-canvas();
        AzanSettings.close();
        if !preserve-search {
            root.clear-ai();
            root.search-text = "";
            root.search-history-index = -1;
            root.activated-prefix-id = "";
            root.activated-prefix-name = "";
            root.search-selection = 0;
            root.search-offset = 0px;
        }
        root.search-context = false;
        root.canvas-context = false;
        root.frame-context-id = "";
        root.selected-ids = [];
        root.tool-mode = 0;
        root.marquee-active = false;
        root.ink-draft = [];
        root.erase-draft = [];
        root.tool-active = false;
        root.frame-editor = false; root.annotation-editor = false;
        root.frame-recording = false;
        root.frame-edit-id = "";
        root.frame-name-draft = "";
        root.frame-keys-draft = "";
        root.frame-error = "";
        root.placing-widget = -1; root.widget-placement-target = false;
        if root.folder-open { root.close-folder(); }
        root.cancel-drag();
        root.folder-closing = false;
        folder-close-timer.stop();
        root.engine-menu = false;
        root.settings = false;
        root.shortcuts-tab = false;
        root.shortcut-editor = false;
        root.shortcut-recording = false;
        root.search-path-editor = false;
        root.sheet = false;
        root.alert = false;
        root.picker = false;
        root.sheet-status = "";
        root.sheet-operation = "";
        root.name-error = "";
        root.command-error = "";
        root.url-error = "";
        root.path-error = "";
        root.icon-error = "";
        root.context-index = -1;
        root.dock-context = "";
        root.context-id = "";
        root.folder-open = false;
        search-input.focus();
    }
    close-top-layer => {
        if RobotWorkbench.visible { RobotWorkbench.visible = false; return; }
        if root.panning { root.cancel-canvas(); return; }
        if root.tool-active || root.marquee-active { root.set-tool(root.tool-mode); return; }
        if AzanSettings.widget-id != "" { AzanSettings.close(); return; }
        if root.search-context { root.search-context = false; return; }
        if root.canvas-context { root.canvas-context = false; return; }
        if root.frame-context-id != "" { root.frame-context-id = ""; return; }
        if root.ticktick-confirm-delete { root.ticktick-confirm-delete = false; return; }
        if root.ticktick-open { root.ticktick-open = false; root.ticktick-edit-id = ""; return; }
        if root.placing-widget >= 0 { root.placing-widget = -1; root.widget-placement-target = false; return; }
        else if root.annotation-editor { root.annotation-editor = false; }
        else if root.frame-editor { root.frame-editor = false; root.frame-recording = false; }
        else if root.shortcut-editor { root.shortcut-editor = false; root.shortcut-recording = false; }
        else if root.drag-index >= 0 { root.cancel-drag(); }
        else if root.picker { root.icon-session += 1; root.icon-busy = false; root.picker = false;  }
        else if root.alert { root.alert = false; }
        else if root.sheet {
            root.cancel-add();
            root.sheet = false;
            root.busy = false;
            root.sheet-operation = "";
            root.sheet-status = "";
            canvas-focus.focus();
        }
        else if root.context-index >= 0 || root.dock-context != "" { root.context-index = -1; root.dock-context = ""; }
        else if root.folder-open { root.close-folder-view(); }
        else if root.settings && root.search-path-editor { root.search-path-editor = false; }
        else if root.settings { root.settings = false; search-input.focus(); }
        else if root.selected-ids.length > 0 { root.selected-ids = []; }
        else if root.engine-menu { root.engine-menu = false; }
        else if root.activated-prefix-id != "" { root.search-text = ""; root.clear-ai(); root.activated-prefix-id = ""; root.activated-prefix-name = ""; root.search(""); canvas-focus.focus(); }
        else if root.search-text != "" { root.search-text = ""; root.search(""); canvas-focus.focus(); }
        else { root.hide-launcher(); }
    }
    function edit-app(index: int) {
        root.context-index = -1;
        root.dock-context = "";
        root.banner = "";
        root.sheet-status = "";
        root.editing = index;
        root.editing-id = index < 0 ? "" : root.items[index].id;
        root.item-type = "App";
        root.app-name = index < 0 ? "" : root.items[index].name;
        root.url-or-path = "";
        root.command = index < 0 ? "" : root.items[index].command;
        root.icon-value = index < 0 ? "" : root.items[index].icon-value;
        root.icon-preview = root.items[index].icon;
        root.icon-preview-present = index >= 0 && root.items[index].icon-present;
        root.icon-letter = index < 0 ? "" : root.items[index].letter;
        root.custom = index < 0 || root.items[index].custom;
        root.app-source = root.custom ? "Custom command" : "Actions";
        root.installed-filter = "";
        root.sheet = true;

    }
    function edit-folder(index: int) {
        root.context-index = -1;
        root.banner = "";
        root.sheet-status = "";
        root.editing = index;
        root.editing-id = index < 0 ? "" : root.items[index].id;
        root.item-type = "Folder";
        root.app-name = index < 0 ? "" : root.items[index].name;
        root.sheet = true;

    }
    function add-item(kind: string) {
        if root.layout-locked { return; }
        root.canvas-context = false;
        sheet-scroll.content-x = 0px; sheet-scroll.content-y = 0px;
        root.icon-preview-present = false; root.icon-letter = "";
        if root.sheet {
            root.remember-add-draft();
        } else {
            root.custom-name-draft = "";
            root.custom-command-draft = "";
            root.website-name-draft = "";
            root.website-url-draft = "";
            root.folder-name-draft = "";
            root.installed-filter = "";
        }
        root.editing = -1;
        root.editing-id = "";
        root.website-icon-session += 1;
        root.website-auto-icon = true;
        root.website-preview-url = "";
        root.website-icon-loading = false;
        root.website-icon-status = "Enter a URL to preview its icon.";
        root.item-type = kind;
        root.custom = true;
        if kind == "App" {
            root.app-source = "Custom command";
            root.app-name = root.custom-name-draft;
            root.command = root.custom-command-draft;
        } else if kind == "Website" {
            root.app-name = root.website-name-draft;
            root.url-or-path = root.website-url-draft;
        } else if kind == "Folder" {
            root.app-name = root.folder-name-draft;
        } else {
            root.url-or-path = "";
        }
        root.icon-value = kind == "Directory" ? "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path fill=\"#777\" d=\"M5 15a5 5 0 0 1 5-5h17l6 7h21a5 5 0 0 1 5 5v26a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5z\"/></svg>" : (kind == "File" ? "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path fill=\"#777\" d=\"M14 5h24l13 13v41H14z\"/><path fill=\"white\" d=\"M38 5v14h13z\"/><path stroke=\"white\" stroke-width=\"3\" d=\"M21 34h23M21 41h23M21 48h17\"/></svg>" : "");
        if kind == "File" || kind == "Directory" {
            root.icon-preview = kind == "File" ? @image-url("assets/file.svg") : @image-url("assets/directory.svg");
            root.icon-preview-present = true;
        }
        root.banner = "";
        root.sheet-status = "";
        root.name-error = "";
        root.command-error = "";
        root.url-error = "";
        root.path-error = "";
        root.icon-error = "";
        root.sheet = true;
        if kind == "Website" { root.website-url-changed(); }


    }
    function remember-add-draft() {
        if root.item-type == "App" && root.app-source == "Custom command" {
            root.custom-name-draft = root.app-name;
            root.custom-command-draft = root.command;
        } else if root.item-type == "Website" {
            root.website-name-draft = root.app-name;
            root.website-url-draft = root.url-or-path;
        } else if root.item-type == "Folder" {
            root.folder-name-draft = root.app-name;
        }
    }
    function app-source-changed(source: string) {
        sheet-scroll.content-x = 0px; sheet-scroll.content-y = 0px;
        root.remember-add-draft();
        root.app-source = source;
        root.app-name = root.custom-name-draft;
        root.command = root.custom-command-draft;
        root.sheet-status = "";

    }
    function submit-form() {
        root.name-error = "";
        root.command-error = "";
        root.url-error = "";
        root.path-error = "";
        root.sheet-status = "";
        if root.item-type == "Website" && root.website-auto-icon && root.website-icon-loading { return; }
        if (root.item-type == "Folder" || root.item-type == "Website" || (root.item-type == "App" && (root.editing >= 0 || root.app-source == "Custom command"))) && !root.valid-name(root.app-name) {
            root.name-error = "Enter a Name.";
            return;
        }
        if root.item-type == "App" && root.custom && !root.valid-command(root.command) {
            root.command-error = "Enter a Command with closed quotes.";
            return;
        }
        if root.item-type == "Website" && !root.valid-url(root.url-or-path) {
            root.url-error = "Enter a valid HTTP or HTTPS URL.";
            return;
        }
        if (root.item-type == "File" || root.item-type == "Directory") && root.url-or-path == "" {
            root.path-error = "Enter a Path.";
            return;
        }
        root.busy = true;
        root.sheet-operation = "saving";
        if root.item-type == "App" { root.save-app(root.editing-id, root.app-name, root.command, root.icon-value); }
        else if root.item-type == "Website" { root.save-website(root.editing-id, root.app-name, root.url-or-path, root.icon-value, root.website-auto-icon); }
        else if root.item-type == "File" || root.item-type == "Directory" { root.save-path(root.editing-id, root.url-or-path, root.item-type == "Directory", root.icon-value); }
        else { root.save-folder(root.editing-id, root.app-name); }
    }
    function edit-item(index: int) {
        if root.items[index].robot != "" { root.context-index = -1; RobotWorkbench.adding = false; RobotWorkbench.open(root.items[index].robot, true); }
        else if root.items[index].folder { root.edit-folder(index); }
        else if root.items[index].app { root.edit-app(index); }
        else {
            root.context-index = -1;
            root.banner = "";
            root.editing = index;
            root.editing-id = index < 0 ? "" : root.items[index].id;
            root.path-error = "";
            root.item-type = root.items[index].website ? "Website" : (root.items[index].file ? "File" : "Directory");
            root.app-name = root.items[index].name;
            root.url-or-path = root.items[index].website ? root.items[index].url : root.items[index].path;
            root.website-icon-session += 1;
            root.website-auto-icon = root.website-icon-automatic(root.items[index].icon-value);
            root.website-preview-url = root.items[index].url;
            root.website-icon-loading = false;
            root.website-icon-status = "Fetched icon";
            root.icon-value = root.items[index].icon-value;
            root.icon-preview = root.items[index].icon;
            root.icon-preview-present = root.items[index].icon-present;
            root.icon-letter = root.items[index].letter;
            root.sheet = true;


        }
    }
    callback hide-launcher();
