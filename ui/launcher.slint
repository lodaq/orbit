    function canvas-pointer(event: PointerEvent, x: length, y: length) {
        if event.kind == PointerEventKind.down {
            let index = root.canvas-item-at(x,y);
            if event.button == PointerEventButton.right {
                root.cancel-drag();
                root.marquee-active = false;
                root.frame-context-id = "";
                root.canvas-context = index < 0;
                if index >= 0 && !root.selection-has(root.selected-ids, root.items[index].id) {
                    root.selected-ids = [root.items[index].id];
                }
                root.dock-context = ""; root.context-index = index; root.context-x = x; root.context-y = y;
                RobotWorkbench.common-actions = [];
                if root.items[index].robot != "" { RobotWorkbench.context-actions(root.items[index].robot); }
                if index < 0 { root.set-add-position(root.world-x(x) / 1px,root.world-y(y) / 1px); }
                canvas-focus.focus();
                return;
            }
            if event.button != PointerEventButton.left { return; }
            if root.placing-widget >= 0 { root.update-widget-placement(x,y); return; }
            root.keyboard-grid = false; root.focused-item = index;
            if index < 0 {
                root.flush-canvas();
                if root.tool-mode == 0 {
                    root.marquee-additive = root.ctrl-held || root.shift-held;
                    root.marquee-selection = root.selected-ids;
                    if !root.marquee-additive { root.selected-ids = []; }
                    root.marquee-active = true;
                    root.marquee-start-x = x; root.marquee-start-y = y;
                    root.marquee-end-x = x; root.marquee-end-y = y;
                } else {
                    root.pan-origin-x = CanvasState.pan-x; root.pan-origin-y = CanvasState.pan-y;
                    root.pan-start-x = x; root.pan-start-y = y; root.panning = true;
                }
            } else if root.tool-mode == 0 && (root.ctrl-held || root.shift-held) {
                root.selected-ids = root.selection-toggle(root.selected-ids,root.items[index].id);
            } else if root.ticktick-scrollbar-at(index,x,y) {
                root.selected-ids = [];
                root.ticktick-scrollbar-dragging = true; root.ticktick-scrollbar-index = index;
                root.set-ticktick-scrollbar(index,y);
            } else {
                root.selected-ids = [];
                root.begin-drag(index,false,x,y);
                if root.items[index].widget || root.items[index].annotation == 3 {
                    let local-x = root.world-x(x) - (root.items[index].col + root.grid-gap / 2) * 1px;
                    let local-y = root.world-y(y) - (root.items[index].row + root.grid-gap / 2) * 1px;
                    let tile-width = (root.items[index].span-x - root.grid-gap) * 1px;
                    let tile-height = (root.items[index].span-y - root.grid-gap) * 1px;
                    root.resizing = !root.layout-locked && local-x >= tile-width - 32px && local-y >= tile-height - 32px;
                    root.resize-width = root.items[index].span-x; root.resize-height = root.items[index].span-y;
                    if root.items[index].ticktick && !root.resizing {
                        root.ticktick-content-pressed = local-x >= 12px && local-x < tile-width - 16px
                            && local-y >= (root.items[index].ticktick-next ? (tile-height <= 220px ? 52px : 88px) : 52px) && local-y < tile-height - 12px;
                        root.ticktick-scroll-start = root.items[index].ticktick-next
                            ? (root.ticktick-focus-scroll-widget-id == root.items[index].id ? root.ticktick-focus-scroll : 0px)
                            : root.ticktick-scroll-widget-id == root.items[index].id ? root.ticktick-scroll-offset : 0px;
                        root.ticktick-control-pressed = local-y < 48px || root.ticktick-content-pressed
                            || (root.items[index].ticktick-next && local-x >= tile-width - 76px && local-x <= tile-width - 16px
                                && local-y >= 12px && local-y <= (tile-height <= 220px ? 48px : 64px));
                    }
                }
            }
            canvas-focus.focus();
        }
        if event.kind == PointerEventKind.move {
            if root.placing-widget >= 0 { root.update-widget-placement(x,y); }
            else if root.marquee-active {
                root.marquee-end-x = x; root.marquee-end-y = y;
                root.selected-ids = root.marquee-select(root.items,root.ink-strokes,root.world-x(root.marquee-start-x) / 1px,root.world-y(root.marquee-start-y) / 1px,root.world-x(x) / 1px,root.world-y(y) / 1px,root.marquee-selection,root.marquee-additive);
            }
            else if root.panning {
                CanvasState.pan-x = root.pan-origin-x + (x - root.pan-start-x) / 1px * root.canvas-speed;
                CanvasState.pan-y = root.pan-origin-y + (y - root.pan-start-y) / 1px * root.canvas-speed;
            } else if root.ticktick-scrollbar-dragging { root.set-ticktick-scrollbar(root.ticktick-scrollbar-index,y); }
            else { root.move-drag(x,y); }
        }
        if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
            if root.placing-widget >= 0 {
                root.update-widget-placement(x,y);
                if root.widget-placement-valid { root.busy = true; root.add-widget(root.placing-widget,root.widget-placement-x,root.widget-placement-y,false); }
                root.placing-widget = -1; root.widget-placement-target = false;
            } else if root.marquee-active {
                root.marquee-end-x = x; root.marquee-end-y = y;
                root.finish-marquee();
            } else if root.panning {
                root.panning = false;
                root.view-dirty = CanvasState.pan-x != root.pan-origin-x || CanvasState.pan-y != root.pan-origin-y;
                root.flush-canvas();
            } else if root.ticktick-scrollbar-dragging {
                root.set-ticktick-scrollbar(root.ticktick-scrollbar-index,y);
                root.ticktick-scrollbar-dragging = false; root.ticktick-scrollbar-index = -1;
            } else { root.move-drag(x,y); root.end-drag(); }
        }
        if event.kind == PointerEventKind.cancel {
            root.cancel-canvas(); root.cancel-drag(); root.placing-widget = -1; root.widget-placement-target = false;
            root.marquee-active = false;
            root.ticktick-scrollbar-dragging = false; root.ticktick-scrollbar-index = -1;
        }
    }
    function update-widget-placement(x: length, y: length) {
        root.widget-placement-x = round((x / 1px - CanvasState.pan-x) / CanvasState.zoom - root.grid-gap / 2);
        root.widget-placement-y = round((y / 1px - CanvasState.pan-y) / CanvasState.zoom - root.grid-gap / 2);
        root.widget-placement-target = true;
    }

