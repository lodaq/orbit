    private property <int> search-selection;
    private property <[SearchHistoryEntry]> search-history: [];
    private property <int> search-history-index: -1;
    private property <SearchHistoryEntry> search-history-draft;
    function remember-search() {
        if root.search-text != "" || root.activated-prefix-id != "" {
            let last-index = root.search-history.length - 1;
            let is-duplicate = last-index >= 0
                && root.search-history[last-index].text == root.search-text
                && root.search-history[last-index].prefix-id == root.activated-prefix-id;
            if !is-duplicate {
                if root.search-history.length == 50 { root.search-history.remove(0); }
                root.search-history.push({
                    text: root.search-text,
                    prefix-id: root.activated-prefix-id,
                    prefix-name: root.activated-prefix-name,
                    prefix-width: root.activated-prefix-width,
                });
            }
        }
        root.search-history-index = -1;
    }
    function apply-search-history(entry: SearchHistoryEntry) {
        root.activated-prefix-id = entry.prefix-id;
        root.activated-prefix-name = entry.prefix-name;
        root.activated-prefix-width = entry.prefix-width > 0px ? entry.prefix-width : 78px;
        root.search-text = entry.text;
        let is-ai = entry.prefix-id != "" && root.action-index-for-id(entry.prefix-id) >= 0 && root.user-actions[root.action-index-for-id(entry.prefix-id)].kind == "AI";
        if !is-ai {
            root.search(root.search-text);
        } else {
            root.search("");
        }
        root.search-selection = 0;
        root.search-hover = -1;
        root.search-offset = 0px;
        search-input.focus();
        search-input.set-selection-offsets(1000000, 1000000);
    }
    function move-search-history(direction: int) {
        if root.search-history.length == 0 { return; }
        if root.search-history-index < 0 {
            if direction < 0 {
                root.search-history-draft = {
                    text: root.search-text,
                    prefix-id: root.activated-prefix-id,
                    prefix-name: root.activated-prefix-name,
                    prefix-width: root.activated-prefix-width,
                };
                root.search-history-index = root.search-history.length - 1;
            } else { return; }
        } else if direction > 0 && root.search-history-index + direction >= root.search-history.length {
            root.search-history-index = -1;
            root.apply-search-history(root.search-history-draft);
            return;
        } else {
            root.search-history-index = clamp(root.search-history-index + direction, 0, root.search-history.length - 1);
        }
        root.apply-search-history(root.search-history[root.search-history-index]);
    }
    private property <int> search-hover: -1;
    private property <int> search-detail-index: search-hover >= 0 && search-hover < root.search-results.length ? search-hover : search-selection;
    private property <string> search-detail: search-detail-index >= 0 && search-detail-index < root.search-results.length ? (root.search-results[search-detail-index].path != "" ? root.search-results[search-detail-index].path : root.search-results[search-detail-index].url != "" ? root.search-results[search-detail-index].url : root.search-results[search-detail-index].command) : "";
    private property <length> search-offset;
    private property <int> search-columns: max(1, floor(min(1316px, root.width - 96px) / 160px));
    out property <bool> search-navigation: !root.search-context && !root.ai-active && root.search-text != "" && !root.settings && !root.sheet && !root.folder-open && !root.picker && !root.alert && !root.ticktick-open;
    callback move-search-selection(int);
    callback activate-search-selection();
    activate-search-selection => {
        if root.script-active { root.launch-script(); return; }
        if root.ai-active { return; }
        if root.search-selection >= 0 && root.search-selection < root.search-results.length && !root.busy {
            root.busy = true;
            let result = root.search-results[root.search-selection];
            if result.source == -5 { root.search-web(root.search-text,result.id); }
            else { root.open-result(result); }
        } else if root.search-results.length == 0 && root.search-text != "" && !root.busy {
            root.busy = true;
            root.search-web(root.search-text,"");
        }
    }
    callback search-web(string,string);
    move-search-selection(direction) => {
        KeyboardNavigation.list-focused = true;
        if root.script-active {
            if direction == 2 { root.script-selection = max(0, root.script-selection - 1); }
            if direction == 3 { root.script-selection = min(max(0, root.script-matches.length - 1), root.script-selection + 1); }
            let top = root.script-selection * 64px;
            let view-height = min(384px, max(0px, root.height - search-bar.y - search-bar.height - 210px));
            if top < root.script-offset { root.script-offset = top; }
            if top + 64px > root.script-offset + view-height { root.script-offset = top + 64px - view-height; }
            return;
        }
        if root.ai-active { return; }
        root.search-hover = -1;
        if root.search-results.length == 0 { return; }
        let column = mod(root.search-selection, root.search-columns);
        if direction == 0 && column > 0 { root.search-selection -= 1; }
        if direction == 1 && column < root.search-columns - 1 && root.search-selection + 1 < root.search-results.length { root.search-selection += 1; }
        if direction == 2 && root.search-selection >= root.search-columns { root.search-selection -= root.search-columns; }
        if direction == 3 && root.search-selection + root.search-columns < root.search-results.length { root.search-selection += root.search-columns; }
        let top = floor(root.search-selection / root.search-columns) * 192px;
        let view-height = max(0px, root.height - search-bar.y - search-bar.height - 26px - 184px);
        if top < root.search-offset { root.search-offset = top; }
        if top + 180px > root.search-offset + view-height { root.search-offset = top + 180px - view-height; }
    }

