            property <bool> next-line: completion-measure.preferred-width > search-input.width - root.search-cursor-x - 4px;
            x: search-scroll.x + search-input.x + (self.next-line ? 0px : root.search-cursor-x + 2px);
            y: search-scroll.y + search-input.y + root.search-cursor-y + search-scroll.content-y + (self.next-line ? root.search-cursor-height : 0px);
            width: max(0px,search-input.width - (self.next-line ? 0px : root.search-cursor-x));
            height: root.search-cursor-height;
            text: root.english-completion-suffix; font-size: Theme.search-font-size; color: Theme.secondary; overflow: elide;
        }
        if root.search-cursor-overlay: Rectangle {
            x: search-scroll.x; y: search-scroll.y;
            width: search-scroll.width; height: search-scroll.height; clip: true;
