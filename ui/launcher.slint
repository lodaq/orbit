import "fonts/Inter.ttf";
import { Button, LineEdit, TextEdit, Palette } from "std-widgets.slint";

export struct AppTile {
    id: string,
    name: string,
    page: int,
    index: int,
    folder-app-index: int,
    pinned: bool,
    artwork: string,
    letter: string,
    icon: image,
    command: string,
    url: string,
    path: string,
    svg: string,
    custom: bool,
    icon-present: bool,
    app: bool,
    website: bool,
    file: bool,
    directory: bool,
    folder: bool,
    preview: string,
}

export struct InstalledAppTile {
    id: string,
    name: string,
    letter: string,
    icon: image,
    icon-present: bool,
}

component ItemIcon inherits Rectangle {
    in property <AppTile> item;
    in property <bool> dock;
    background: transparent;
    border-radius: self.width * 0.25;
    Image {
        width: parent.width; height: parent.height;
        source: dock && item.artwork == "website" ? @image-url("assets/dock-website.svg")
            : dock && item.artwork == "file" ? @image-url("assets/dock-file.svg")
            : dock && item.artwork == "command" ? @image-url("assets/dock-command.svg")
            : dock && item.artwork == "directory" ? @image-url("assets/dock-directory.svg")
            : dock && item.artwork == "browser" ? @image-url("assets/dock-browser.svg")
            : item.icon-present ? item.icon
            : item.website ? @image-url("assets/website.svg")
            : item.file ? @image-url("assets/file.svg")
            : item.directory ? @image-url("assets/directory.svg")
            : item.folder ? @image-url("assets/folder.svg")
            : @image-url("assets/letter.svg");
        image-fit: contain;
    }
    if item.app && !item.icon-present: Text { text: item.letter; color: #e0e5ff; font-size: parent.width * 0.4; horizontal-alignment: center; vertical-alignment: center; }
}

component PageTile inherits Rectangle {
    in property <[AppTile]> items;
    in property <int> index;
    in property <bool> hovered;
    width: 128px;
    height: 128px;
    background: hovered ? #ffffff0b : transparent;
    border-radius: 20px;
    border-width: 1px;
    border-color: index < items.length ? #a6b1ed33 : transparent;
    Rectangle {
        x: (parent.width - self.width) / 2; y: 12px;
        width: 80px; height: 80px;
        border-radius: 20px;
        if index < items.length: ItemIcon { width: 80px; height: 80px; item: items[index]; }
        if index == items.length: Image { width: 80px; height: 80px; source: @image-url("assets/add.svg"); }
    }
    Text {
        y: 100px;
        width: parent.width;
        height: 24px;
        text: index == items.length ? "Add" : items[index].name;
        color: #e0e3f4;
        font-size: 14px;
        horizontal-alignment: center;
        overflow: elide;
    }
}

component DockTile inherits Rectangle {
    in property <AppTile> item;
    in property <bool> enabled;
    in property <bool> recent;
    callback open();
    callback context-menu(bool, string, length, length);
    height: 82px;
    border-radius: 20px;
    background: dock-touch.has-hover ? #ffffff0b : transparent;
    ItemIcon { x: (parent.width - 48px) / 2; y: 6px; width: 48px; height: 48px; item: item; dock: true; }
    Text { y: 65px; width: parent.width; height: 16px; text: item.name; color: #e0e3f4; font-size: 11px; horizontal-alignment: center; overflow: elide; }
    dock-touch := TouchArea {
        mouse-cursor: pointer; enabled: root.enabled;
        clicked => { root.open(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.context-menu(root.recent, root.item.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

export component Launcher inherits Window {
    in property <string> monitor-name;
    in property <float> cursor-x;
    in property <float> cursor-y;
    in-out property <bool> launcher-visible;
    in-out property <string> banner;
    in property <int> page-count: 1;
    in property <int> current-page;
    in property <[AppTile]> items;
    in property <[AppTile]> previous-items;
    in property <[AppTile]> next-items;
    in property <[AppTile]> dock-items;
    in property <[AppTile]> recent-items;
    in property <[AppTile]> search-results;
    in-out property <string> search-text;
    private property <bool> settings;
    callback search(string);
    callback open-result(int, int);
    callback open-dock-item(int, int, int);
    callback pin-item(int);
    callback unpin-dock-item(string);
    callback remove-recent-item(string);
    out property <bool> search-focused: search-input.has-focus;
    callback focus-search();
    callback page-key(int);
    focus-search => { if !root.sheet && !root.folder-open && root.context-index < 0 && root.dock-context == "" { root.settings = false; search-input.focus(); } }
    page-key(direction) => { if !root.sheet && !root.folder-open && root.search-text == "" && !root.settings && root.context-index < 0 && root.dock-context == "" { root.change-page(root.current-page + direction); } }

    in property <[InstalledAppTile]> installed-apps;
    in property <string> installed-status;
    in property <[AppTile]> folder-items;
    in property <string> folder-name;
    in-out property <int> folder-index: -1;
    in-out property <bool> folder-open;
    in-out property <bool> busy;
    private property <bool> sheet;
    private property <bool> alert;
    private property <bool> picker;
    private property <int> context-index: -1;
    private property <string> dock-context;
    private property <string> context-id;
    private property <int> editing: -1;
    private property <string> app-name;
    private property <string> command;
    private property <string> url-or-path;
    private property <string> item-type: "App";
    private property <string> svg;
    private property <string> svg-draft;
    private property <length> context-x;
    private property <length> context-y;
    private property <length> page-drag-offset;
    private property <bool> page-dragging;
    private property <length> page-span: min(1152px, page.width) + 16px;
    private property <[AppTile]> transition-items;
    private property <[AppTile]> transition-incoming-items;
    private property <bool> transitioning;
    private property <int> transition-direction;
    private property <length> transition-start;
    private property <float> transition-progress;
    private property <duration> transition-duration: max(90ms, 170ms * (1 - abs(root.transition-start) / root.page-span));
    private property <bool> custom: true;
    private property <string> app-source: "Actions";
    private property <string> installed-filter;
    private property <bool> dragged;
    private property <int> drag-index: -1;
    private property <int> hover-index: -1;
    private property <bool> folder-ready;
    private property <int> drag-page: -1;
    private property <int> edge-target: -1;
    private property <bool> edge-ready;
    private property <bool> folder-dragged;
    private property <int> folder-drag-index: -1;
    callback save-app(int, string, string, string);
    callback add-system-action(string);
    callback add-installed-app(string);
    callback refresh-installed-apps();
    callback save-website(int, string, string);
    callback choose-path(int, bool, string);
    callback save-folder(int, string);
    callback delete-item(int);
    callback open-item(int);
    callback launch-folder-app(int, int);
    callback open-folder(int);
    callback close-folder();
    callback add-page();
    callback drop-item(int, int, int, int, bool);
    callback move-folder-app(int, int, int);
    callback reorder-folder-app(int, int, int);
    callback reset-launcher();
    callback close-top-layer();
    animate page-drag-offset { duration: root.page-dragging ? 0ms : 100ms; easing: ease-out; }
    animate transition-progress { duration: root.transition-duration; easing: ease-out-sine; }
    transition-timer := Timer {
        running: false;
        interval: root.transition-duration + 34ms;
        triggered => {
            root.transitioning = false;
            root.transition-progress = 0;
            root.transition-items = [];
            root.transition-incoming-items = [];
            self.running = false;
        }
    }
    folder-timer := Timer {
        running: false;
        interval: 500ms;
        triggered => { root.folder-ready = true; self.running = false; }
    }
    edge-timer := Timer {
        running: false;
        interval: 500ms;
        triggered => { root.edge-ready = true; self.running = false; }
    }
    page-focus := FocusScope { width: 0px; height: 0px; }
    reset-launcher => {
        if root.folder-open { root.close-folder(); }
        page-focus.focus();
        root.page-dragging = false;
        root.page-drag-offset = 0px;
        root.transitioning = false;
        root.transition-items = [];
        root.transition-incoming-items = [];
        transition-timer.stop();
        page.content-x = 0px;
        root.search-text = "";
        root.settings = false;
        root.sheet = false;
        root.alert = false;
        root.picker = false;
        root.context-index = -1;
        root.dock-context = "";
        root.context-id = "";
        root.folder-open = false;
    }
    close-top-layer => {
        if root.busy { return; }
        if root.picker { root.picker = false; }
        else if root.alert { root.alert = false; }
        else if root.sheet { root.sheet = false; }
        else if root.context-index >= 0 || root.dock-context != "" { root.context-index = -1; root.dock-context = ""; }
        else if root.folder-open { root.folder-open = false; root.close-folder(); }
        else if root.settings { root.settings = false; }
        else if root.search-text != "" { root.search-text = ""; page-focus.focus(); }
        else { root.hide-launcher(); }
    }
    function edit-app(index: int) {
        root.context-index = -1;
        root.dock-context = "";
        root.banner = "";
        root.editing = index;
        root.item-type = "App";
        root.app-name = index < 0 ? "" : root.items[index].name;
        root.url-or-path = "";
        root.command = index < 0 ? "" : root.items[index].command;
        root.svg = index < 0 ? "" : root.items[index].svg;
        root.custom = index < 0 || root.items[index].custom;
        root.app-source = root.custom ? "Custom command" : "Actions";
        root.installed-filter = "";
        root.sheet = true;
        name-field.focus();
    }
    function edit-folder(index: int) {
        root.context-index = -1;
        root.banner = "";
        root.editing = index;
        root.item-type = "Folder";
        root.app-name = index < 0 ? "" : root.items[index].name;
        root.sheet = true;
        name-field.focus();
    }
    function add-item(kind: string) {
        root.editing = -1;
        root.item-type = kind;
        root.custom = true;
        root.app-source = "Actions";
        root.installed-filter = "";
        root.app-name = "";
        root.command = "";
        root.url-or-path = "";
        root.svg = kind == "Directory" ? "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path fill=\"#777\" d=\"M5 15a5 5 0 0 1 5-5h17l6 7h21a5 5 0 0 1 5 5v26a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5z\"/></svg>" : (kind == "File" ? "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path fill=\"#777\" d=\"M14 5h24l13 13v41H14z\"/><path fill=\"white\" d=\"M38 5v14h13z\"/><path stroke=\"white\" stroke-width=\"3\" d=\"M21 34h23M21 41h23M21 48h17\"/></svg>" : "");
        root.banner = "";
        root.sheet = true;
        if kind != "App" { name-field.focus(); }
    }
    function edit-item(index: int) {
        if root.items[index].folder { root.edit-folder(index); }
        else if root.items[index].app { root.edit-app(index); }
        else {
            root.context-index = -1;
            root.banner = "";
            root.editing = index;
            root.item-type = root.items[index].website ? "Website" : (root.items[index].file ? "File" : "Directory");
            root.app-name = root.items[index].name;
            root.url-or-path = root.items[index].website ? root.items[index].url : root.items[index].path;
            root.svg = root.items[index].svg;
            root.sheet = true;
            name-field.focus();
        }
    }
    callback open-page(int);
    callback hide-launcher();
    function change-page(index: int) {
        if !root.busy && !root.transitioning && index >= 0 && index < root.page-count && index != root.current-page {
            root.transition-items = root.items;
            root.transition-direction = index > root.current-page ? 1 : -1;
            root.transition-incoming-items = root.transition-direction > 0 ? root.next-items : root.previous-items;
            root.transition-start = root.page-drag-offset;
            root.page-drag-offset = 0px;
            root.transition-progress = 0;
            root.transitioning = true;
            root.busy = true;
            root.open-page(index);
            page.content-y = 0px;
            root.transition-progress = 1;
            transition-timer.start();
        } else {
            root.page-drag-offset = 0px;
        }
    }
    function empty-page-area(x: length, y: length) -> bool {
        let grid-x = x - grid.x;
        let grid-y = y + page.content-y;
        if grid-x < 0px || grid-x >= grid.width || grid-y < 0px || grid-y >= grid.height {
            return true;
        }
        let column = floor(grid-x / grid.tile-size);
        let row = floor(grid-y / grid.tile-size);
        if row * grid.columns + column > root.items.length {
            return true;
        }
        let tile-x = mod(grid-x, grid.tile-size);
        let tile-y = mod(grid-y, grid.tile-size);
        let inset = (grid.tile-size - 128px) / 2;
        return tile-x < inset || tile-x >= inset + 128px || tile-y < inset || tile-y >= inset + 128px;
    }
    function scroll-page(event: PointerScrollEvent) -> EventResult {
        if event.modifiers.shift {
            if event.delta-y > 0px || event.delta-x > 0px {
                root.change-page(root.current-page + 1);
            } else if event.delta-y < 0px || event.delta-x < 0px {
                root.change-page(root.current-page - 1);
            }
            return accept;
        }
        return reject;
    }
    init => { Palette.color-scheme = ColorScheme.light; }
    default-font-family: "Inter";
    default-font-size: 14px;
    title: "Orbit";
    no-frame: true;
    full-screen: true;
    background: #0b0d19;
    Image { width: root.width; height: root.height; source: @image-url("assets/background.svg"); image-fit: fill; }
    Image { x: 48px; y: 40px; width: 90px; height: 32px; source: @image-url("assets/orbit.svg"); }
    Rectangle {
        x: (root.width - self.width) / 2; y: 34px; width: min(360px, root.width - 440px); height: 44px;
        background: #ffffff04; border-color: #a6b1ed26; border-width: 1px; border-radius: 12px;
        Image { x: 16px; y: 13px; width: 18px; height: 18px; source: @image-url("assets/search.svg"); }
        Text { x: 45px; y: 0px; height: parent.height; text: root.search-text == "" ? "Search anything" : ""; color: #a7adc7; font-size: 13px; vertical-alignment: center; }
        search-input := TextInput {
            x: 45px; y: 0px; width: parent.width - 109px; height: parent.height;
            text <=> root.search-text; color: #e0e4f5; font-size: 13px; vertical-alignment: center;
            single-line: true;
            edited => { root.search(self.text); }
            accepted => { if root.search-results.length > 0 && self.text != "" { root.busy = true; root.open-result(root.search-results[0].page, root.search-results[0].index); } }
        }
        Rectangle { x: parent.width - 58px; y: 14px; width: 1px; height: 16px; background: #a6b1ed26; }
        Text { x: parent.width - 45px; height: parent.height; text: "Ctrl K"; color: #7881a4; font-size: 11px; vertical-alignment: center; }
    }
    for index in 2: Rectangle {
        x: root.width - 132px + index * 48px; y: 36px; width: 36px; height: 40px;
        border-radius: 10px; background: top-button.has-hover ? #ffffff10 : transparent;
        Image { x: 8px; y: 10px; width: 20px; height: 20px; source: index == 0 ? @image-url("assets/settings.svg") : @image-url("assets/close.svg"); }
        top-button := TouchArea { mouse-cursor: pointer; clicked => { if index == 0 { root.settings = !root.settings; } else { root.hide-launcher(); } } }
    }
    VerticalLayout {
        padding-left: 48px; padding-right: 48px; padding-top: 166px; padding-bottom: 134px;
        spacing: 0px;
        if root.banner != "": Text {
            text: root.banner;
            color: white;
            font-size: 15px;
            wrap: word-wrap;
        }
        page := Flickable {
            visible: root.search-text == "" && !root.settings;
            mouse-drag-pan-enabled: false;
            content-width: self.width;
            content-height: max(self.height, grid.height);
            swipe := SwipeGestureHandler {
                width: page.width;
                height: page.height;
                enabled: !root.busy && !root.transitioning && !root.folder-open && !root.sheet && !root.alert && !root.picker && !root.settings && root.search-text == "";
                handle-swipe-left: root.empty-page-area(self.pressed-position.x, self.pressed-position.y);
                handle-swipe-right: root.empty-page-area(self.pressed-position.x, self.pressed-position.y);
                moved => {
                    if self.swiping {
                        page-focus.focus();
                        root.page-dragging = true;
                        let dx = self.current-position.x - self.pressed-position.x;
                        let limit = (dx > 0px && root.current-page == 0)
                            || (dx < 0px && root.current-page == root.page-count - 1) ? 64px : root.page-span;
                        root.page-drag-offset = min(limit, max(-limit, dx));
                    }
                }
                swiped => {
                    let dx = self.current-position.x - self.pressed-position.x;
                    if root.page-dragging && abs(dx) > min(120px, page.width * 0.18) {
                        root.page-dragging = false;
                        root.change-page(root.current-page + (dx < 0px ? 1 : -1));
                    } else {
                        root.page-dragging = false;
                        root.page-drag-offset = 0px;
                    }
                }
                cancelled => { root.page-dragging = false; root.page-drag-offset = 0px; }
                page-touch := TouchArea {
                    width: page.width;
                    height: page.height;
                    clicked => { page-focus.focus(); }
                    scroll-event(event) => { return root.scroll-page(event); }
                }
            preview := Rectangle {
                visible: root.transitioning
                    || (root.page-drag-offset < 0px && root.current-page < root.page-count - 1)
                    || (root.page-drag-offset > 0px && root.current-page > 0);
                x: (page.width - self.width) / 2 + (root.transitioning
                    ? root.transition-start + (-root.transition-direction * root.page-span - root.transition-start) * root.transition-progress
                    : root.page-drag-offset + (root.page-drag-offset < 0px ? root.page-span : -root.page-span));
                y: 0px;
                width: min(1152px, page.width);
                property <[AppTile]> preview-items: root.transitioning ? root.transition-items
                    : (root.page-drag-offset < 0px ? root.next-items : root.previous-items);
                property <int> columns: max(1, floor(self.width / 144px));
                property <length> tile-size: self.width / self.columns;
                height: ceil((self.preview-items.length + 1) / self.columns) * self.tile-size;
                border-width: 1px;
                border-color: #a6b1ed33;
                border-radius: 24px;
                for index in preview.preview-items.length + 1: PageTile {
                    x: mod(index, preview.columns) * preview.tile-size + (preview.tile-size - 128px) / 2;
                    y: floor(index / preview.columns) * preview.tile-size + (preview.tile-size - 128px) / 2;
                    items: preview.preview-items;
                    index: index;
                }
            }
            grid := Rectangle {
                x: (page.width - self.width) / 2 + (root.transitioning
                    ? root.transition-start + (-root.transition-direction * root.page-span - root.transition-start) * root.transition-progress + root.transition-direction * root.page-span
                    : root.page-drag-offset);
                y: 0px;
                width: min(1152px, page.width);
                property <[AppTile]> display-items: root.transitioning ? root.transition-incoming-items : root.items;
                property <int> columns: max(1, floor(self.width / 144px));
                property <length> tile-size: self.width / self.columns;
                height: ceil((self.display-items.length + 1) / self.columns) * self.tile-size;
                border-width: 1px;
                border-color: #a6b1ed33;
                border-radius: 24px;
                for index in grid.display-items.length + 1: Rectangle {
                    x: mod(index, grid.columns) * grid.tile-size + (grid.tile-size - 128px) / 2;
                    y: floor(index / grid.columns) * grid.tile-size + (grid.tile-size - 128px) / 2;
                    width: 128px; height: 128px;
                    PageTile { items: grid.display-items; index: index; hovered: tile.has-hover; }
                    tile := TouchArea {
                        scroll-event(event) => { return root.scroll-page(event); }
                        enabled: !root.busy && !root.transitioning && !root.picker && !root.alert;
                        mouse-cursor: pointer;
                        clicked => {
                            if root.dragged { root.dragged = false; return; }
                            if index == root.items.length { root.add-item("App"); }
                            else if root.items[index].folder { root.folder-index = index; root.open-folder(index); root.folder-open = true; }
                            else if root.items[index].app || root.items[index].website || root.items[index].file || root.items[index].directory {
                                root.busy = true;
                                root.open-item(index);
                            }
                        }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                root.drag-index = index;
                                root.drag-page = root.current-page;
                                root.dragged = false;
                                root.hover-index = -1;
                                root.folder-ready = false;
                                folder-timer.stop();
                                root.edge-target = -1;
                                root.edge-ready = false;
                                edge-timer.stop();
                            }
                            if event.kind == PointerEventKind.move && root.drag-index >= 0
                                && (abs(self.mouse-x - self.pressed-x) > 8px || abs(self.mouse-y - self.pressed-y) > 8px) {
                                root.dragged = true;
                                let x = self.absolute-position.x + self.mouse-x;
                                let y = self.absolute-position.y + self.mouse-y;
                                if y < page.absolute-position.y + 24px {
                                    page.content-y = max(0px, page.content-y - 12px);
                                } else if y > page.absolute-position.y + page.height - 24px {
                                    page.content-y = min(max(0px, page.content-height - page.height), page.content-y + 12px);
                                }
                                let edge = x < 32px ? root.current-page - 1 : (x > root.width - 32px ? root.current-page + 1 : -1);
                                if edge >= 0 && (edge < root.page-count || (edge == root.page-count && root.page-count < 9)) {
                                    if root.edge-target != edge {
                                        root.edge-target = edge;
                                        root.edge-ready = false;
                                        edge-timer.start();
                                    }
                                } else {
                                    root.edge-target = -1;
                                    root.edge-ready = false;
                                    edge-timer.stop();
                                }
                                let column = floor((x - grid.absolute-position.x) / (grid.width / grid.columns));
                                let row = floor((y - grid.absolute-position.y) / grid.tile-size);
                                let target = max(0, row * grid.columns + column);
                                if target < root.items.length && target != root.drag-index && root.items[target].app {
                                    if root.hover-index != target {
                                        root.hover-index = target;
                                        root.folder-ready = false;
                                        folder-timer.start();
                                    }
                                } else {
                                    root.hover-index = -1;
                                    root.folder-ready = false;
                                    folder-timer.stop();
                                }
                            }
                            if event.kind == PointerEventKind.up && root.drag-index >= 0 {
                                if root.dragged && index < root.items.length {
                                    root.busy = true;
                                    let x = self.absolute-position.x + self.mouse-x;
                                    let y = self.absolute-position.y + self.mouse-y;
                                    let destination = root.edge-ready ? root.edge-target : root.current-page;
                                    let column = floor((x - grid.absolute-position.x) / (grid.width / grid.columns));
                                    let row = floor((y - grid.absolute-position.y) / grid.tile-size);
                                    let target = min(root.items.length, max(0, row * grid.columns + column));
                                    root.drop-item(root.drag-index, target, root.drag-page, destination, root.folder-ready && root.hover-index == target);
                                } else if root.dragged && index == root.items.length {
                                    root.busy = true;
                                    let x = self.absolute-position.x + self.mouse-x;
                                    let y = self.absolute-position.y + self.mouse-y;
                                    let destination = root.edge-ready ? root.edge-target : root.current-page;
                                    let column = floor((x - grid.absolute-position.x) / (grid.width / grid.columns));
                                    let row = floor((y - grid.absolute-position.y) / grid.tile-size);
                                    let target = min(root.items.length, max(0, row * grid.columns + column));
                                    root.drop-item(root.drag-index, target, root.drag-page, destination, root.folder-ready && root.hover-index == target);
                                }
                                folder-timer.stop();
                                edge-timer.stop();
                                root.drag-index = -1;
                            }
                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down
                                && index < root.items.length {
                                root.dock-context = "";
                                root.context-x = self.absolute-position.x + self.mouse-x;
                                root.context-y = self.absolute-position.y + self.mouse-y;
                                root.context-index = index;
                            }
                        }
                    }
                }
            }
            }
        }
    }
    HorizontalLayout {
        x: (root.width - self.width) / 2; y: root.height - 158px;
        width: root.page-count * 16px; height: 24px; spacing: 0px;
        for index in root.page-count: Rectangle {
            width: 16px; height: 24px;
            Rectangle { x: 5px; y: 9px; width: index == root.current-page ? 7px : 5px; height: self.width; border-radius: self.width / 2; background: index == root.current-page ? #a8b3ff : #657097; }
            TouchArea { mouse-cursor: pointer; clicked => { root.change-page(index); } }
        }
    }
    dock := Rectangle {
        x: (root.width - self.width) / 2; y: root.height - 120px;
        width: min(root.width - 96px, max(104px, (root.recent-items.length + root.dock-items.length) * 100px + 4px)); height: 94px;
        property <length> slot-width: (self.width - 4px) / max(1, root.recent-items.length + root.dock-items.length);
        Image { x: -1px; y: -1px; width: parent.width + 2px; height: parent.height + 2px; source: @image-url("assets/dock.svg"); image-fit: fill; }
        for item[index] in root.recent-items: DockTile {
            x: 8px + index * dock.slot-width; y: 6px; width: dock.slot-width - 12px;
            item: item; enabled: !root.busy; recent: true;
            open => { root.busy = true; root.open-dock-item(item.page, item.index, item.folder-app-index); }
            context-menu(recent, id, x, y) => {
                root.context-index = -1; root.dock-context = recent ? "recent" : "pinned";
                root.context-id = id; root.context-x = x; root.context-y = y;
            }
        }
        for item[index] in root.dock-items: DockTile {
            x: 8px + (root.recent-items.length + index) * dock.slot-width; y: 6px; width: dock.slot-width - 12px;
            item: item; enabled: !root.busy; recent: false;
            open => { root.busy = true; root.open-dock-item(item.page, item.index, item.folder-app-index); }
            context-menu(recent, id, x, y) => {
                root.context-index = -1; root.dock-context = recent ? "recent" : "pinned";
                root.context-id = id; root.context-x = x; root.context-y = y;
            }
        }
        if root.recent-items.length > 0 && root.dock-items.length > 0: Rectangle {
            x: 2px + root.recent-items.length * dock.slot-width;
            y: 19px; width: 1px; height: 52px; background: #a6b1ed26;
        }
    }
    Image { x: 48px; y: root.height - 22px; width: 105px; height: 15px; source: @image-url("assets/page-hint.svg"); }
    Image { x: root.width - 160px; y: root.height - 21px; width: 112px; height: 13px; source: @image-url("assets/close-hint.svg"); }
    if root.search-text != "" && !root.settings: Flickable {
        x: (root.width - self.width) / 2; y: 166px; width: min(1316.572px, root.width - 96px); height: root.height - 340px;
        content-height: max(self.height, ceil(root.search-results.length / max(1, floor(self.width / 160px))) * 132px);
        for item[index] in root.search-results: Rectangle {
            property <int> columns: max(1, floor(parent.width / 160px));
            x: mod(index, self.columns) * (parent.width / self.columns); y: floor(index / self.columns) * 132px;
            width: parent.width / self.columns; height: 124px;
            ItemIcon { x: (parent.width - 80px) / 2; y: 0px; width: 80px; height: 80px; item: item; }
            Text { y: 98px; height: 24px; width: parent.width; text: item.name; color: #e0e3f4; horizontal-alignment: center; overflow: elide; }
            TouchArea { mouse-cursor: pointer; enabled: !root.busy; clicked => { root.busy = true; root.open-result(item.page, item.index); } }
        }
        if root.search-results.length == 0: Text { text: "No items found"; color: #a7adc7; }
    }
    if root.settings: Rectangle {
        x: (root.width - self.width) / 2; y: 128px; width: min(600px, root.width - 96px); height: 300px;
        background: #20243b; border-color: #a6b1ed26; border-width: 1px; border-radius: 20px;
        VerticalLayout {
            padding: 28px; spacing: 16px;
            Text { text: "Settings"; font-size: 22px; color: #e0e3f4; }
            Button { text: "Add page"; enabled: root.page-count < 9 && !root.busy; clicked => { root.busy = true; root.add-page(); root.settings = false; } }
            Button { text: "Refresh installed apps"; enabled: !root.busy; clicked => { root.busy = true; root.refresh-installed-apps(); } }
            Text { text: root.installed-status; color: #a7adc7; }
            Button { text: "Back"; clicked => { root.settings = false; } }
        }
    }

    if root.context-index >= 0 || root.dock-context != "": Rectangle {
        width: root.width; height: root.height;
        background: #00000050;
        TouchArea { clicked => { root.context-index = -1; root.dock-context = ""; root.context-id = ""; } }
        Rectangle {
            x: min(root.context-x, parent.width - self.width);
            y: min(root.context-y, parent.height - self.height);
            width: 200px; height: root.context-index >= 0 ? 154px : 64px;
            background: white; border-radius: 16px;
            VerticalLayout {
                padding: 12px; spacing: 8px;
                if root.context-index >= 0: Button { text: "Edit"; clicked => {
                    root.edit-item(root.context-index);
                } }
                if root.context-index >= 0: Button { text: root.items[root.context-index].pinned ? "Unpin" : "Pin"; clicked => { root.busy = true; root.pin-item(root.context-index); root.context-index = -1; } }
                if root.context-index >= 0: Button { text: "Delete"; clicked => {
                    root.editing = root.context-index;
                    root.app-name = root.items[root.context-index].name;
                    root.context-index = -1;
                    root.banner = ""; root.alert = true;
                    cancel-delete.focus();
                } }
                if root.dock-context == "pinned": Button { text: "Unpin"; clicked => { root.busy = true; root.unpin-dock-item(root.context-id); root.dock-context = ""; } }
                if root.dock-context == "recent": Button { text: "Remove from Recent"; clicked => { root.busy = true; root.remove-recent-item(root.context-id); root.dock-context = ""; } }
            }
        }
    }
    // Keeping the sheet instantiated preserves field focus while editing.
    sheet-backdrop := Rectangle {
        width: root.width; height: root.height;
        visible: root.sheet;
        background: #00000070;
        TouchArea { enabled: !root.busy && !root.picker && !root.alert; clicked => { root.close-top-layer(); } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(480px, parent.width - 32px);
            height: min(root.item-type == "App" && root.editing < 0 ? (root.app-source == "Installed apps" ? 560px : 500px) : 430px, parent.height - 32px);
            background: white; border-radius: 20px;
            TouchArea { }
            VerticalLayout {
                padding: 24px; spacing: 12px;
                Text { text: root.editing < 0 ? "Add item" : ("Edit " + root.item-type); color: #202020; font-size: 22px; font-weight: 600; }
                if root.editing < 0: HorizontalLayout {
                    spacing: 4px;
                    Button { width: (parent.width - 16px) / 5; text: "App"; clicked => { root.add-item("App"); } }
                    Button { width: (parent.width - 16px) / 5; text: "Website"; clicked => { root.add-item("Website"); } }
                    Button { width: (parent.width - 16px) / 5; text: "File"; clicked => { root.add-item("File"); } }
                    Button { width: (parent.width - 16px) / 5; text: "Directory"; clicked => { root.add-item("Directory"); } }
                    Button { width: (parent.width - 16px) / 5; text: "Folder"; clicked => { root.add-item("Folder"); } }
                }
                if root.item-type == "App" && root.editing < 0: HorizontalLayout {
                    spacing: 4px;
                    Button { width: (parent.width - 8px) / 3; text: "Actions"; clicked => { root.app-source = "Actions"; } }
                    Button { width: (parent.width - 8px) / 3; text: "Installed apps"; clicked => { root.app-source = "Installed apps"; root.installed-filter = ""; } }
                    Button { width: (parent.width - 8px) / 3; text: "Custom command"; clicked => { root.app-source = "Custom command"; name-field.focus(); } }
                }
                if root.item-type == "App" && root.editing < 0 && root.app-source == "Actions": Flickable {
                    height: 176px;
                    content-width: self.width;
                    content-height: 176px;
                    actions-list := VerticalLayout {
                        width: parent.width;
                        spacing: 4px;
                        Button { text: "Lock screen"; clicked => { root.busy = true; root.add-system-action("lock-screen"); } }
                        Button { text: "Take screenshot"; clicked => { root.busy = true; root.add-system-action("screenshot"); } }
                        Button { text: "Sleep"; clicked => { root.busy = true; root.add-system-action("sleep"); } }
                        Button { text: "Log out"; clicked => { root.busy = true; root.add-system-action("log-out"); } }
                    }
                }
                Text { text: "Name"; visible: root.item-type == "Website" || root.item-type == "Folder" || (root.item-type == "App" && (root.editing >= 0 || root.app-source == "Custom command")); height: root.item-type == "Website" || root.item-type == "Folder" || (root.item-type == "App" && (root.editing >= 0 || root.app-source == "Custom command")) ? 24px : 0px; color: #404040; }
                name-field := LineEdit {
                    visible: root.item-type == "Website" || root.item-type == "Folder" || (root.item-type == "App" && (root.editing >= 0 || root.app-source == "Custom command"));
                    min-height: root.item-type == "Website" || root.item-type == "Folder" || (root.item-type == "App" && (root.editing >= 0 || root.app-source == "Custom command")) ? 32px : 0px;
                    preferred-height: root.item-type == "Website" || root.item-type == "Folder" || (root.item-type == "App" && (root.editing >= 0 || root.app-source == "Custom command")) ? 32px : 0px;
                    max-height: root.item-type == "Website" || root.item-type == "Folder" || (root.item-type == "App" && (root.editing >= 0 || root.app-source == "Custom command")) ? 32px : 0px;
                    text <=> root.app-name;
                    enabled: !root.busy && !root.picker && !root.alert;
                    accepted => {
                        if root.item-type == "App" && root.custom { command-field.focus(); }
                        else if root.item-type == "Website" { address-field.focus(); }
                        else { save-button.focus(); }
                    }
                }
                Text { text: "Command"; visible: root.item-type == "App" && root.custom && (root.editing >= 0 || root.app-source == "Custom command"); height: root.item-type == "App" && root.custom && (root.editing >= 0 || root.app-source == "Custom command") ? 24px : 0px; color: #404040; }
                command-field := LineEdit {
                    visible: root.item-type == "App" && root.custom && (root.editing >= 0 || root.app-source == "Custom command");
                    min-height: root.item-type == "App" && root.custom && (root.editing >= 0 || root.app-source == "Custom command") ? 32px : 0px;
                    preferred-height: root.item-type == "App" && root.custom && (root.editing >= 0 || root.app-source == "Custom command") ? 32px : 0px;
                    max-height: root.item-type == "App" && root.custom && (root.editing >= 0 || root.app-source == "Custom command") ? 32px : 0px;
                    text <=> root.command;
                    enabled: !root.busy && !root.picker && !root.alert;
                    accepted => { icon-button.focus(); }
                }
                Text {
                    text: "URL"; visible: root.item-type == "Website"; height: root.item-type == "Website" ? 24px : 0px; color: #404040;
                }
                address-field := LineEdit {
                    visible: root.item-type == "Website";
                    min-height: root.item-type == "Website" ? 32px : 0px;
                    preferred-height: root.item-type == "Website" ? 32px : 0px;
                    max-height: root.item-type == "Website" ? 32px : 0px;
                    text <=> root.url-or-path;
                    enabled: !root.busy && !root.picker && !root.alert;
                    accepted => { save-button.focus(); }
                }
                if root.item-type == "App" && root.editing < 0 && root.app-source == "Installed apps": VerticalLayout {
                    spacing: 4px;
                    Button { text: "Refresh installed apps"; enabled: !root.busy; clicked => { root.busy = true; root.refresh-installed-apps(); } }
                    Text { text: root.installed-status; color: #404040; }
                    LineEdit { text <=> root.installed-filter; enabled: !root.busy; }
                    Flickable {
                        height: min(180px, max(40px, root.installed-apps.length * 40px));
                        content-width: self.width;
                        content-height: max(40px, root.installed-apps.length * 40px);
                        installed-list := VerticalLayout {
                            width: parent.width;
                            spacing: 4px;
                            for app in root.installed-apps: Button {
                                visible: root.installed-filter == "" || app.name.to-lowercase().starts-with(root.installed-filter.to-lowercase());
                                text: app.name;
                                enabled: !root.busy;
                                clicked => { root.busy = true; root.add-installed-app(app.id); }
                            }
                        }
                    }
                }
                icon-button := Button { text: "Icon"; visible: root.item-type == "File" || root.item-type == "Directory" || (root.item-type == "App" && (root.editing >= 0 || root.app-source == "Custom command")); height: root.item-type == "File" || root.item-type == "Directory" || (root.item-type == "App" && (root.editing >= 0 || root.app-source == "Custom command")) ? 34px : 0px; enabled: !root.busy && !root.picker && !root.alert; clicked => { root.svg-draft = root.svg; root.picker = true; } }
                if root.item-type == "File" || root.item-type == "Directory": Button {
                    text: root.item-type == "Directory" ? "Choose directory" : "Choose file";
                    enabled: !root.busy && !root.picker && !root.alert;
                    clicked => { root.busy = true; root.choose-path(root.editing, root.item-type == "Directory", root.svg); }
                }
                if root.banner != "": Text { text: root.banner; color: #c02020; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: root.editing < 0 ? "Cancel" : "Delete"; enabled: !root.busy && !root.picker && !root.alert; clicked => {
                        if root.editing < 0 { root.close-top-layer(); }
                        else { root.banner = ""; root.alert = true; cancel-delete.focus(); }
                    } }
                    save-button := Button { text: "Save"; primary: true; visible: root.item-type == "Website" || root.item-type == "Folder" || (root.item-type == "App" && (root.editing >= 0 || root.app-source == "Custom command")); height: root.item-type == "Website" || root.item-type == "Folder" || (root.item-type == "App" && (root.editing >= 0 || root.app-source == "Custom command")) ? 34px : 0px; enabled: !root.busy && !root.picker && !root.alert; clicked => {
                        root.busy = true;
                        if root.item-type == "App" { root.save-app(root.editing, root.app-name, root.command, root.svg); }
                        else if root.item-type == "Website" { root.save-website(root.editing, root.app-name, root.url-or-path); }
                        else { root.save-folder(root.editing, root.app-name); }
                    } }
                }
            }
        }
    }
    if root.picker: Rectangle {
        width: root.width; height: root.height;
        background: #00000070;
        TouchArea { clicked => { root.picker = false; } }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(480px, parent.width - 32px); height: min(400px, parent.height - 32px);
            background: white; border-radius: 20px;
            TouchArea { }
            VerticalLayout {
                padding: 24px; spacing: 12px;
                Text { text: "Icon"; font-size: 22px; color: #202020; }
                Button { text: "Letter"; clicked => { root.svg = ""; root.picker = false; } }
                Text { text: "SVG"; color: #404040; }
                TextEdit { text <=> root.svg-draft; }
                Button { text: "Save"; primary: true; clicked => { root.svg = root.svg-draft; root.picker = false; } }
                Button { text: "Cancel"; clicked => { root.picker = false; } }
            }
        }
    }
    if root.folder-open: Rectangle {
        width: root.width; height: root.height;
        background: #00000070;
        TouchArea { clicked => { root.folder-open = false; root.close-folder(); } }
        folder-panel := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(560px, parent.width - 32px);
            height: min(560px, parent.height - 32px);
            background: #f5f5f7; border-radius: 24px;
            TouchArea { }
            VerticalLayout {
                padding: 24px; spacing: 16px;
                Text { text: root.folder-name; color: #202020; font-size: 22px; font-weight: 600; }
                Flickable {
                    content-width: self.width;
                    content-height: folder-grid.height;
                    folder-grid := Rectangle {
                        width: min(480px, parent.width);
                        property <int> columns: max(1, floor(self.width / 112px));
                        height: ceil(root.folder-items.length / self.columns) * 112px;
                        for index in root.folder-items.length: Rectangle {
                            x: mod(index, folder-grid.columns) * (folder-grid.width / folder-grid.columns);
                            y: floor(index / folder-grid.columns) * 112px;
                            width: folder-grid.width / folder-grid.columns; height: 108px;
                            Rectangle {
                                x: (parent.width - self.width) / 2; width: 64px; height: 64px;
                                border-radius: 14px; background: white;
                                Image { x: 8px; y: 8px; width: 48px; height: 48px; source: root.folder-items[index].icon; image-fit: contain; }
                                if root.folder-items[index].svg == "": Text {
                                    text: root.folder-items[index].letter; color: #404040; font-size: 28px;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            Text { y: 70px; width: parent.width; text: root.folder-items[index].name; color: #202020; font-size: 13px; horizontal-alignment: center; overflow: elide; }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if root.folder-dragged { root.folder-dragged = false; return; }
                                    root.busy = true;
                                    root.launch-folder-app(root.folder-index, index);
                                }
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                        root.folder-drag-index = index;
                                        root.folder-dragged = false;
                                    }
                                    if event.kind == PointerEventKind.move && root.folder-drag-index >= 0
                                        && (abs(self.mouse-x - self.pressed-x) > 8px || abs(self.mouse-y - self.pressed-y) > 8px) {
                                        root.folder-dragged = true;
                                    }
                                    if event.kind == PointerEventKind.up && root.folder-drag-index >= 0 {
                                        let x = self.absolute-position.x + self.mouse-x;
                                        let y = self.absolute-position.y + self.mouse-y;
                                        let outside = x < folder-panel.absolute-position.x || x > folder-panel.absolute-position.x + folder-panel.width
                                            || y < folder-panel.absolute-position.y || y > folder-panel.absolute-position.y + folder-panel.height;
                                        if root.folder-dragged && outside {
                                            let column = floor((x - grid.absolute-position.x) / (grid.width / grid.columns));
                                            let row = floor((y - grid.absolute-position.y) / 132px);
                                            let target = min(root.items.length, max(0, row * grid.columns + column));
                                            root.busy = true;
                                            root.move-folder-app(root.folder-index, root.folder-drag-index, target);
                                            root.folder-open = false;
                                        } else if root.folder-dragged {
                                            let column = floor((x - folder-grid.absolute-position.x) / (folder-grid.width / folder-grid.columns));
                                            let row = floor((y - folder-grid.absolute-position.y) / 112px);
                                            let target = min(root.folder-items.length - 1, max(0, row * folder-grid.columns + column));
                                            root.busy = true;
                                            root.reorder-folder-app(root.folder-index, root.folder-drag-index, target);
                                        }
                                        root.folder-drag-index = -1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    alert-backdrop := Rectangle {
        width: root.width; height: root.height;
        visible: root.alert;
        background: #00000070;
        TouchArea { enabled: !root.busy; clicked => { root.alert = false; } }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(360px, parent.width - 32px); height: root.banner == "" ? 190px : 250px;
            background: white; border-radius: 20px;
            TouchArea { }
            VerticalLayout {
                padding: 24px; spacing: 16px;
                Text {
                    text: root.items[root.editing].folder ? ("Delete folder '" + root.app-name + "'? Its apps will move to the page.")
                        : ("Delete '" + root.app-name + "' from Orbit?");
                    color: #202020; font-size: 17px; wrap: word-wrap;
                }
                if root.banner != "": Text { text: root.banner; color: #c02020; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 12px;
                    cancel-delete := Button { text: "Cancel"; enabled: !root.busy; clicked => { root.alert = false; } }
                    Rectangle {
                        border-radius: 8px; background: #ff3b30;
                        Text { text: "Delete"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { enabled: !root.busy; mouse-cursor: pointer; clicked => { root.busy = true; root.delete-item(root.editing); } }
                    }
                }
            }
        }
    }
}
