                let into = !root.drag-on-page ? root.items[root.folder-index].id
                    : root.merge-ready && root.merge-target >= 0 ? root.drag-items[root.merge-target].id : "";
                root.drop-pending = true;
                root.busy = true;
                root.drop-item(root.drag-item.id, root.drag-page, root.drag-on-page && into != "" ? 2147483647 : root.drop-target, into);
                return;
            }
        } else if root.drag-from-dock {
