            root.drag-outside-folder = x < folder-panel.absolute-position.x || x > folder-panel.absolute-position.x + folder-panel.width
                || y < folder-panel.absolute-position.y || y > folder-panel.absolute-position.y + folder-panel.height;
            if !root.drag-outside-folder {
                let column = min(folder-grid.columns - 1, max(0, floor((x - folder-grid.absolute-position.x) / folder-grid.column-step)));
                let row = max(0, floor((y - folder-grid.absolute-position.y) / folder-grid.row-step));
