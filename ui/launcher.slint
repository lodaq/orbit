    private property <int> search-selection;
    private property <length> search-offset;
    private property <int> search-columns: max(1, floor(min(1316px, root.width - 96px) / 160px));
    out property <bool> search-navigation: root.search-text != "" && !root.settings && !root.sheet && !root.folder-open && !root.picker && !root.alert && !root.ticktick-open;
    callback move-search-selection(int);
    callback activate-search-selection();
    activate-search-selection => {
        if root.search-selection >= 0 && root.search-selection < root.search-results.length && !root.busy {
            root.busy = true;
            let result = root.search-results[root.search-selection];
            if result.page == -5 { root.search-web(root.search-text,result.id); }
            else { root.open-result(result.page,result.index); }
        } else if root.search-results.length == 0 && root.search-text != "" && !root.busy {
            root.busy = true;
            root.search-web(root.search-text,"");
        }
    }
    callback search-web(string,string);
    move-search-selection(direction) => {
        if root.search-results.length == 0 { return; }
        let column = mod(root.search-selection, root.search-columns);
        if direction == 0 && column > 0 { root.search-selection -= 1; }
        if direction == 1 && column < root.search-columns - 1 && root.search-selection + 1 < root.search-results.length { root.search-selection += 1; }
        if direction == 2 && root.search-selection >= root.search-columns { root.search-selection -= root.search-columns; }
        if direction == 3 && root.search-selection + root.search-columns < root.search-results.length { root.search-selection += root.search-columns; }
        let top = floor(root.search-selection / root.search-columns) * 164px;
        let view-height = root.height - search-bar.y - search-bar.height - 160px;
        if top < root.search-offset { root.search-offset = top; }
        if top + 152px > root.search-offset + view-height { root.search-offset = top + 152px - view-height; }
    }

