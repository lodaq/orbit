    function scroll-page(event: PointerScrollEvent) -> EventResult {
        if !event.modifiers.shift && (event.delta-x != 0px || event.delta-y != 0px) {
            // The native start signal resets touchpad swipes; the timer covers wheels without phases.
            page-scroll-timer.restart();
