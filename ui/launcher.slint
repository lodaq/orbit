                property <int> target-position: root.on-dock && root.drag-item.id != item.id ? self.compact + (self.compact >= root.dock-target ? 1 : 0) : index;
                property <float> slot-position: root.recent-items.length + self.target-position;
                animate slot-position { duration: 200ms; easing: ease-out; }
                x: dock.content-offset + 8px + self.slot-position * dock.slot-width;
                y: 0px; width: dock.slot-width; height: dock.height + dock.magnify-room;
                opacity: root.dragging && root.drag-item.id == item.id ? 0.2 : 1;
                pointer-x: dock.pointer-x; pointer-on-tiles: dock.pointer-on-tiles;
                item: item; enabled: !root.busy; recent: false;
                hover-entered(id, name, x) => { root.dock-hover-entered(id, name, x); }
                hover-moved(x) => { root.dock-hover-moved(x); }
                hover-left(id) => { root.dock-hover-left(id); }
                pointer-left => { dock.pointer-x = -10000px; root.dock-clear-hover(); }
                open => { root.dock-clear-hover(); root.busy = true; root.open-dock-item(item.page, item.index, item.folder-app-index); }
                gesture(kind,x,y) => {
                    // The same move events drive dock magnification and item dragging.
                    if kind == 1 { dock.pointer-x = x; root.move-drag(x,y); }
                    if kind == 0 { root.dock-clear-hover(); root.begin-drag(0,false,x,y); root.drag-from-dock = true; root.dock-source-index = index; root.drag-item = item; root.grab-x = 32px; root.grab-y = 32px; }
                    if kind == 2 { root.end-drag(); }
                    if kind == 3 { root.cancel-drag(); }
                }
                context-menu(recent, id, x, y) => {
