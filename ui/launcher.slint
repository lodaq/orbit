    function finish-marquee() {
        if root.marquee-active
            && abs(root.marquee-end-x - root.marquee-start-x) < 4px
            && abs(root.marquee-end-y - root.marquee-start-y) < 4px {
            root.selected-ids = root.marquee-select([],root.ink-strokes,
                root.world-x(root.marquee-start-x) / 1px - 3,root.world-y(root.marquee-start-y) / 1px - 3,
                root.world-x(root.marquee-start-x) / 1px + 3,root.world-y(root.marquee-start-y) / 1px + 3,
                root.marquee-selection,root.marquee-additive);
        }
