                if root.canvas-context: MenuOption { width: 184px; label: "Redo"; enabled: root.can-redo && !root.layout-locked; clicked => { root.canvas-command(1); } }
                if (root.canvas-context || root.context-index >= 0) && root.selected-ids.length > 0: MenuOption { width: 184px; label: "Cut"; enabled: !root.layout-locked; clicked => { root.canvas-command(2); } }
                if (root.canvas-context || root.context-index >= 0) && root.selected-ids.length > 0: MenuOption { width: 184px; label: "Copy"; clicked => { root.canvas-command(3); } }
                if root.canvas-context: MenuOption { width: 184px; label: "Paste"; enabled: root.can-paste && !root.layout-locked; clicked => { root.canvas-command(4); } }
