    pure function ticktick-priority-value(index: int) -> int { return index == 3 ? 5 : index == 2 ? 3 : index == 1 ? 1 : 0; }
    function open-ticktick-create(project-id: string) {
        if root.ticktick-loading { return; }
        root.ticktick-confirm-delete = false;
        root.ticktick-create = true;
        root.ticktick-edit-id = "";
        root.ticktick-edit-project = "";
        root.ticktick-title = "";
        root.ticktick-content = ""; root.ticktick-desc = "";
        root.ticktick-due-date = ""; root.ticktick-tags = ""; root.ticktick-priority = 0;
        root.ticktick-form-error = "";
        root.ticktick-project-index = root.ticktick-list-index(root.ticktick-projects,project-id);
        root.ticktick-open = true;
    }
    function open-ticktick-details(task: TickTickTask) {
        if root.ticktick-loading { return; }
        root.ticktick-confirm-delete = false;
        root.ticktick-create = false;
        root.ticktick-edit-id = task.id;
        root.ticktick-edit-project = task.project-id;
        // The List control starts on the task's own list, so saving without a change keeps it.
        root.ticktick-project-index = root.ticktick-list-index(root.ticktick-projects,task.project-id);
        root.ticktick-title = task.title;
        root.ticktick-content = task.content; root.ticktick-desc = task.desc;
        root.ticktick-due-date = task.due-date; root.ticktick-tags = task.tags; root.ticktick-priority = task.priority == 5 ? 3 : task.priority == 3 ? 2 : task.priority == 1 ? 1 : 0;
        root.ticktick-form-error = "";
        root.ticktick-open = true;
    }
