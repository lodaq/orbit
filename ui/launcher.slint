                    AddOption { add-style: root.editing < 0; type-tile: true; option-width: max(72px, (root.sheet-content-width - 40px) / 6); icon-present: true; icon: @image-url("assets/add-globe.svg"); label: "Website"; selected: root.item-type == "Website"; clicked => { root.add-item("Website"); } }
                    AddOption { add-style: root.editing < 0; type-tile: true; option-width: max(72px, (root.sheet-content-width - 40px) / 6); icon-present: true; icon: @image-url("assets/add-file.svg"); label: "File"; selected: root.item-type == "File"; clicked => { root.add-item("File"); } }
