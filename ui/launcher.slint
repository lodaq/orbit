    function fit-frame-view(id: string) {
        root.active-frame-id = id;
        root.frame-context-id = "";
        root.canvas-context = false;
        root.context-index = -1;
        root.flush-canvas();
        root.fit-frame-action(id, root.width / 1px, root.height / 1px);
    }
    fit-frame(id) => { root.fit-frame-view(id); }
    function open-frame-editor(id: string) {
        root.canvas-context = false;
        root.context-index = -1;
        root.dock-context = "";
        root.frame-context-id = "";
        root.frame-edit-id = id;
        root.frame-name-draft = "";
        root.frame-keys-draft = "";
        root.frame-recording = false;
        root.frame-error = "";
        let index = root.frame-index(root.frames, id);
        if index >= 0 {
            root.frame-name-draft = root.frames[index].name;
            root.frame-keys-draft = root.frames[index].keys;
        }
        root.frame-editor = true;
    }
    function frame-member-count() -> int {
        if root.frame-edit-id == "" { return root.selected-ids.length; }
        let index = root.frame-index(root.frames, root.frame-edit-id);
        return index >= 0 ? root.frames[index].count : 0;
    }
    function set-tool(mode: int) {
        root.tool-mode = mode;
        root.cancel-canvas();
