        accessible-role: button; accessible-label: "Change background image"; accessible-action-default => { root.change-background-image(); }
        Image { x: 12px; y: 12px; width: 24px; height: 24px; source: @image-url("assets/change-background.svg"); image-fit: contain; }
        TouchArea { mouse-cursor: pointer; clicked => { root.change-background-image(); } }
    }
    Rectangle { x: root.width < 1200px ? 16px : 48px; y: 40px; width: root.width < 1200px ? 80px : 90px; height: 32px; TouchArea { } Image { width: parent.width; height: parent.height; source: @image-url("assets/orbit.svg"); image-fit: contain; } }
    search-bar := Rectangle {
        x: (root.width - self.width) / 2; y: 34px; width: min(root.ai-active && !root.settings ? 820px : 560px, max(240px, root.width - 440px));
