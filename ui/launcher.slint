                CanvasState.pan-y = root.pan-origin-y + (y - root.pan-start-y) / 1px * root.canvas-speed;
            } else if (root.tool-mode == 2 || root.tool-mode >= 7) && root.tool-active {
                if root.tool-mode == 7 { root.ink-draft = [root.ink-draft[0],{ x: root.world-x(x) / 1px, y: root.world-y(y) / 1px }]; }
                else if root.ink-draft.length < 2000 { if root.tool-mode == 9 && root.ink-draft.length >= 20 { root.ink-draft.remove(0); } root.ink-draft.push({ x: root.world-x(x) / 1px, y: root.world-y(y) / 1px }); }
            } else if root.tool-mode == 3 && root.tool-active && root.erase-draft.length < 2000 {
                let previous = root.erase-draft[root.erase-draft.length - 1];
                root.erase-preview = root.preview-erase(root.erase-preview, previous.x, previous.y, root.world-x(x) / 1px, root.world-y(y) / 1px);
                root.erase-item-targets = root.preview-erase-items(root.items,root.erase-item-targets,previous.x,previous.y,root.world-x(x) / 1px,root.world-y(y) / 1px);
                root.erase-draft.push({ x: root.world-x(x) / 1px, y: root.world-y(y) / 1px });
            }
        }
        if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
            if root.tool-mode == 1 && root.panning {
                root.panning = false;
                root.view-dirty = CanvasState.pan-x != root.pan-origin-x || CanvasState.pan-y != root.pan-origin-y;
                root.flush-canvas();
            } else if (root.tool-mode == 2 || root.tool-mode >= 7) && root.tool-active {
                if root.tool-mode == 9 { laser-timer.restart(); root.tool-active = false; return; }
                root.busy = true;
                root.add-ink(root.ink-draft,root.ink-color,root.ink-size,root.ink-opacity,root.tool-mode);
                root.tool-active = false;
            } else if root.tool-mode == 3 && root.tool-active {
                root.busy = true;
