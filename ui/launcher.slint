        } else if root.drag-from-folder {
            root.busy = true;
            root.launch-folder-app(root.folder-index, root.drag-index);
        } else if root.drag-index == root.items.length { root.add-item("App"); }
        else if root.items[root.drag-index].widget { }
        else if root.items[root.drag-index].folder {
            root.folder-index = root.drag-index;
            root.folder-closing = false;
            root.open-folder(root.drag-index);
        } else { root.busy = true; root.open-item(root.drag-index); }
        root.cancel-drag();
    }
    function page-item-at(x: length, y: length) -> int {
        let dx = x - grid.absolute-position.x;
        let dy = y - grid.absolute-position.y;
        let inset = (grid.tile-size - root.item-size * 1px) / 2;
        let slot = floor(dy / grid.tile-size) * grid.columns + floor(dx / grid.tile-size);
        if dx < 0px || dx >= grid.width || dy < 0px || dy >= grid.height { return -1; }
        let index = root.hit-cell(root.items,floor(dx / grid.tile-size),floor(dy / grid.tile-size));
        if index >= 0 && root.items[index].widget { return index; }
        if mod(dx,grid.tile-size) < inset || mod(dx,grid.tile-size) > grid.tile-size - inset || mod(dy,grid.tile-size) < inset || mod(dy,grid.tile-size) > grid.tile-size - inset { return -1; }
        return index >= 0 ? index : slot == root.free-cell(root.items,grid.columns,grid.rows) ? root.items.length : -1;
    }
    page-focus := FocusScope { width: 0px; height: 0px; }
    finish-drag => { if root.drop-pending { root.cancel-drag(); } }
    reset-launcher => {
        if root.folder-open { root.close-folder(); }
        root.page-dragging = false;
        root.page-swipe-pressed = false;
        root.page-drag-offset = 0px;
        root.cancel-drag();
        root.folder-closing = false;
        folder-close-timer.stop();
        root.transitioning = false;
        root.transition-items = [];
        root.transition-incoming-items = [];
        transition-timer.stop();
        page.content-x = 0px;
        root.search-text = "";
        root.settings = false;
        root.shortcuts-tab = false;
        root.shortcut-editor = false;
        root.shortcut-recording = false;
        root.page-delete-confirm = false;
        root.search-selection = 0;
        root.search-offset = 0px;
        root.search-path-editor = false;
        root.sheet = false;
        root.alert = false;
        root.picker = false;
        root.sheet-status = "";
        root.sheet-operation = "";
        root.name-error = "";
        root.command-error = "";
        root.url-error = "";
        root.path-error = "";
        root.icon-error = "";
        root.context-index = -1;
        root.dock-context = "";
        root.context-id = "";
        root.folder-open = false;
        search-input.focus();
    }
    close-top-layer => {
        if root.move-id != "" { root.move-id = ""; return; }
        if root.page-delete-confirm { root.page-delete-confirm = false; }
        else if root.shortcut-editor { root.shortcut-editor = false; root.shortcut-recording = false; }
        else if root.drag-index >= 0 { root.cancel-drag(); }
        else if root.picker { root.icon-session += 1; root.icon-busy = false; root.picker = false;  }
        else if root.alert { root.alert = false; }
        else if root.sheet {
            root.cancel-add();
            root.sheet = false;
            root.busy = false;
            root.sheet-operation = "";
            root.sheet-status = "";
            page-focus.focus();
        }
        else if root.context-index >= 0 || root.dock-context != "" { root.context-index = -1; root.dock-context = ""; }
        else if root.folder-open { root.close-folder-view(); }
        else if root.settings && root.search-path-editor { root.search-path-editor = false; }
        else if root.settings { root.settings = false; search-input.focus(); }
        else if root.search-text != "" { root.search-text = ""; page-focus.focus(); }
        else { root.hide-launcher(); }
    }
    function edit-app(index: int) {
        root.context-index = -1;
        root.dock-context = "";
        root.banner = "";
        root.sheet-status = "";
        root.editing = index;
        root.item-type = "App";
        root.app-name = index < 0 ? "" : root.items[index].name;
        root.url-or-path = "";
        root.command = index < 0 ? "" : root.items[index].command;
        root.icon-value = index < 0 ? "" : root.items[index].icon-value;
        root.icon-preview = root.items[index].icon;
        root.icon-preview-present = index >= 0 && root.items[index].icon-present;
        root.icon-letter = index < 0 ? "" : root.items[index].letter;
        root.custom = index < 0 || root.items[index].custom;
        root.app-source = root.custom ? "Custom command" : "Actions";
        root.installed-filter = "";
        root.sheet = true;

    }
    function edit-folder(index: int) {
        root.context-index = -1;
        root.banner = "";
        root.sheet-status = "";
        root.editing = index;
        root.item-type = "Folder";
        root.app-name = index < 0 ? "" : root.items[index].name;
        root.sheet = true;

    }
    function add-item(kind: string) {
        sheet-scroll.content-x = 0px; sheet-scroll.content-y = 0px;
        root.icon-preview-present = false; root.icon-letter = "";
        if root.sheet {
            root.remember-add-draft();
        } else {
            root.custom-name-draft = "";
            root.custom-command-draft = "";
            root.website-name-draft = "";
            root.website-url-draft = "";
            root.folder-name-draft = "";
            root.installed-filter = "";
        }
        root.editing = -1;
        root.item-type = kind;
        root.custom = true;
        if kind == "App" {
            root.app-source = "Custom command";
            root.app-name = root.custom-name-draft;
            root.command = root.custom-command-draft;
        } else if kind == "Website" {
            root.app-name = root.website-name-draft;
            root.url-or-path = root.website-url-draft;
        } else if kind == "Folder" {
            root.app-name = root.folder-name-draft;
        } else {
            root.url-or-path = "";
        }
        root.icon-value = kind == "Directory" ? "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path fill=\"#777\" d=\"M5 15a5 5 0 0 1 5-5h17l6 7h21a5 5 0 0 1 5 5v26a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5z\"/></svg>" : (kind == "File" ? "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path fill=\"#777\" d=\"M14 5h24l13 13v41H14z\"/><path fill=\"white\" d=\"M38 5v14h13z\"/><path stroke=\"white\" stroke-width=\"3\" d=\"M21 34h23M21 41h23M21 48h17\"/></svg>" : "");
        if kind == "File" || kind == "Directory" {
            root.icon-preview = kind == "File" ? @image-url("assets/file.svg") : @image-url("assets/directory.svg");
            root.icon-preview-present = true;
        }
        root.banner = "";
        root.sheet-status = "";
        root.name-error = "";
        root.command-error = "";
        root.url-error = "";
        root.path-error = "";
        root.icon-error = "";
        root.sheet = true;


    }
    function remember-add-draft() {
        if root.item-type == "App" && root.app-source == "Custom command" {
            root.custom-name-draft = root.app-name;
            root.custom-command-draft = root.command;
        } else if root.item-type == "Website" {
            root.website-name-draft = root.app-name;
            root.website-url-draft = root.url-or-path;
        } else if root.item-type == "Folder" {
            root.folder-name-draft = root.app-name;
        }
    }
    function app-source-changed(source: string) {
        sheet-scroll.content-x = 0px; sheet-scroll.content-y = 0px;
        root.remember-add-draft();
        root.app-source = source;
        root.app-name = root.custom-name-draft;
        root.command = root.custom-command-draft;
        root.sheet-status = "";

    }
    function submit-form() {
        root.name-error = "";
        root.command-error = "";
        root.url-error = "";
        root.path-error = "";
        root.sheet-status = "";
        if (root.item-type == "Folder" || root.item-type == "Website" || (root.item-type == "App" && (root.editing >= 0 || root.app-source == "Custom command"))) && !root.valid-name(root.app-name) {
            root.name-error = "Enter a Name.";
            return;
        }
        if root.item-type == "App" && root.custom && !root.valid-command(root.command) {
            root.command-error = "Enter a Command with closed quotes.";
            return;
        }
        if root.item-type == "Website" && !root.valid-url(root.url-or-path) {
            root.url-error = "Enter a valid HTTP or HTTPS URL.";
            return;
        }
        if (root.item-type == "File" || root.item-type == "Directory") && root.url-or-path == "" {
            root.path-error = "Enter a Path.";
            return;
        }
        root.busy = true;
        root.sheet-operation = "saving";
        if root.item-type == "App" { root.save-app(root.editing, root.app-name, root.command, root.icon-value); }
        else if root.item-type == "Website" { root.save-website(root.editing, root.app-name, root.url-or-path); }
        else if root.item-type == "File" || root.item-type == "Directory" { root.save-path(root.editing, root.url-or-path, root.item-type == "Directory", root.icon-value); }
        else { root.save-folder(root.editing, root.app-name); }
    }
    function edit-item(index: int) {
        if root.items[index].folder { root.edit-folder(index); }
        else if root.items[index].app { root.edit-app(index); }
        else {
            root.context-index = -1;
            root.banner = "";
            root.editing = index;
            root.path-error = "";
            root.item-type = root.items[index].website ? "Website" : (root.items[index].file ? "File" : "Directory");
            root.app-name = root.items[index].name;
            root.url-or-path = root.items[index].website ? root.items[index].url : root.items[index].path;
            root.icon-value = root.items[index].icon-value;
            root.icon-preview = root.items[index].icon;
            root.icon-preview-present = root.items[index].icon-present;
            root.icon-letter = root.items[index].letter;
            root.sheet = true;


        }
    }
    callback open-page(int);
    callback hide-launcher();
    function change-page(index: int) {
        if !root.busy && !root.transitioning && index >= 0 && index < root.page-count && index != root.current-page {
            root.transition-items = root.items;
            root.transition-direction = index > root.current-page ? 1 : -1;
            root.transition-incoming-items = root.transition-direction > 0 ? root.next-items : root.previous-items;
            root.transition-start = root.page-drag-offset;
            root.page-drag-offset = 0px;
            root.transition-progress = 0;
            root.transitioning = true;
            root.busy = true;
            root.open-page(index);
            page.content-y = 0px;
            root.transition-progress = 1;
            transition-timer.start();
        } else {
            root.page-drag-offset = 0px;
        }
    }
    function move-page-swipe(x: length) {
        let dx = x - root.page-swipe-start;
        if abs(dx) < 8px && !root.page-dragging { return; }
        root.page-dragging = true;
        let limit = (dx > 0px && root.current-page == 0)
            || (dx < 0px && root.current-page == root.page-count - 1) ? 64px : root.page-span;
        root.page-drag-offset = min(limit, max(-limit, dx));
    }
    function end-page-swipe() {
        root.page-swipe-pressed = false;
        root.page-dragging = false;
        if abs(root.page-drag-offset) > min(120px, page.width * 0.18) {
            root.change-page(root.current-page + (root.page-drag-offset < 0px ? 1 : -1));
        } else { root.page-drag-offset = 0px; }
    }
    function scroll-page(event: PointerScrollEvent) -> EventResult {
        if event.modifiers.shift {
            if event.delta-y > 0px || event.delta-x > 0px {
                root.change-page(root.current-page + 1);
            } else if event.delta-y < 0px || event.delta-x < 0px {
                root.change-page(root.current-page - 1);
            }
            return accept;
        }
        return reject;
    }
    init => { Palette.color-scheme = ColorScheme.dark; }
    default-font-family: "Inter";
    default-font-size: 14px;
    title: "Orbit";
    no-frame: true;
    full-screen: true;
    background: #0b0d19;
    Image { width: root.width; height: root.height; source: @image-url("assets/background.svg"); image-fit: fill; }
    Image { x: 48px; y: 40px; width: 90px; height: 32px; source: @image-url("assets/orbit.svg"); }
    Rectangle {
        x: (root.width - self.width) / 2; y: 34px; width: min(360px, root.width - 440px); height: 44px;
        background: #ffffff04; border-color: #a6b1ed26; border-width: 1px; border-radius: 12px;
        Image { x: 16px; y: 13px; width: 18px; height: 18px; source: @image-url("assets/search.svg"); }
        Text { x: 45px; y: 0px; height: parent.height; text: root.search-text == "" ? "Search anything" : ""; color: #a7adc7; font-size: 13px; vertical-alignment: center; }
        search-input := TextInput {
            x: 45px; y: 0px; width: parent.width - 109px; height: parent.height;
            text <=> root.search-text; color: #e0e4f5; font-size: 13px; vertical-alignment: center;
            single-line: true;
            edited => { root.search-selection = 0; root.search-offset = 0px; root.search(self.text); }
            accepted => { if self.text != "" { root.activate-search-selection(); } }
        }
        Rectangle { x: parent.width - 58px; y: 14px; width: 1px; height: 16px; background: #a6b1ed26; }
        Text { x: parent.width - 45px; height: parent.height; text: "Ctrl K"; color: #7881a4; font-size: 11px; vertical-alignment: center; }
    }
    for index in 2: Rectangle {
        x: root.width - 132px + index * 48px; y: 36px; width: 36px; height: 40px;
        border-radius: 10px; background: top-button.has-hover ? #ffffff10 : transparent;
        Image { x: 8px; y: 10px; width: 20px; height: 20px; source: index == 0 ? @image-url("assets/settings.svg") : @image-url("assets/close.svg"); }
        top-button := TouchArea { mouse-cursor: pointer; clicked => { if index == 0 { root.settings = !root.settings; } else { root.hide-launcher(); } } }
    }
    VerticalLayout {
        padding-left: 0px; padding-right: 0px; padding-top: 78px; padding-bottom: 134px;
        spacing: 0px;
        if root.banner != "": Text {
            text: root.banner;
            color: white;
            font-size: 15px;
            wrap: word-wrap;
        }
        page := Flickable {
            visible: root.search-text == "" && !root.settings;
            mouse-drag-pan-enabled: false;
            content-width: self.width;
            content-height: max(self.height, grid.height);
            Rectangle {
                x: 0px; y: 0px; width: page.width; height: page.height;
            preview := Rectangle {
                visible: !root.dragging && (root.transitioning || root.page-count > 1);
                opacity: root.transitioning ? 1 : min(1, abs(root.page-drag-offset) / 96px);
                x: (page.width - self.width) / 2 + (root.transitioning
                    ? root.transition-start + (-root.transition-direction * root.page-span - root.transition-start) * root.transition-progress
                    : root.page-drag-offset + (root.page-drag-offset < 0px ? root.page-span : -root.page-span));
                y: root.page-margin * 1px;
                width: page.width - root.page-margin * 2px;
                property <[AppTile]> preview-items: root.transitioning ? root.transition-items
                    : (root.page-drag-offset < 0px ? root.next-items : root.previous-items);
                property <int> columns: max(1, floor(self.width / (root.item-size * 1px + 16px)));
                property <length> tile-size: root.item-size * 1px + 16px;
                property <int> rows: max(1,floor((page.height - root.page-margin * 2px) / self.tile-size));
                height: max(page.height - root.page-margin * 2px, ceil((self.preview-items.length + 1) / self.columns) * self.tile-size);
                border-width: 1px;
                border-color: #a6b1ed33;
                border-radius: 24px;
                background: #324d6b88;
                for index in preview.preview-items.length + 1: PageTile {
                    property <int> position: index < preview.preview-items.length ? preview.preview-items[index].row * preview.columns + preview.preview-items[index].col : root.free-cell(preview.preview-items,preview.columns,preview.rows);
                    visible: self.position >= 0 && (index == preview.preview-items.length || !preview.preview-items[index].pinned);
                    x: mod(self.position, preview.columns) * preview.tile-size + (preview.tile-size - root.item-size * 1px) / 2;
                    y: floor(self.position / preview.columns) * preview.tile-size + (preview.tile-size - root.item-size * 1px) / 2;
                    width: root.item-size * 1px; height: self.width;
                    items: preview.preview-items;
                    index: index;
                    animate x { duration: 120ms; easing: ease-out; }
                    animate y { duration: 120ms; easing: ease-out; }
                }
            }
            grid := Rectangle {
                x: (root.drag-on-page ? (1 - root.drag-slide) * root.drag-slide-direction * root.page-span : 0px) + (page.width - self.width) / 2 + (root.transitioning
                    ? root.transition-start + (-root.transition-direction * root.page-span - root.transition-start) * root.transition-progress + root.transition-direction * root.page-span
                    : root.page-drag-offset);
                y: root.page-margin * 1px;
                width: page.width - root.page-margin * 2px;
                property <[AppTile]> display-items: root.drag-on-page ? (root.reorder-ready && root.merge-target < 0 && !root.on-dock ? root.preview-cells(root.drag-items,root.drag-item.id,root.drop-target,root.drag-item.span-x,root.drag-item.span-y,self.columns,self.rows) : root.drag-items) : root.transitioning ? root.transition-incoming-items : root.items;
                property <int> columns: max(1, floor(self.width / (root.item-size * 1px + 16px)));
                property <length> tile-size: root.item-size * 1px + 16px;
                property <int> rows: max(1,floor((page.height - root.page-margin * 2px) / self.tile-size));
                opacity: root.page-dragging || root.transitioning ? 0.88 : 1;
                animate opacity { duration: 100ms; easing: ease-out; }
                height: self.rows * self.tile-size;
                border-width: 1px;
                border-color: #a6b1ed33;
                border-radius: 24px;
                background: #324d6b88;
                for index in grid.display-items.length + 1: PageTile {
                    property <bool> source-here: root.dragging && index < grid.display-items.length && grid.display-items[index].id == root.drag-item.id;
                    property <int> position: index < grid.display-items.length ? grid.display-items[index].row * grid.columns + grid.display-items[index].col : root.free-cell(grid.display-items,grid.columns,grid.rows);
                    visible: self.position >= 0 && (index == grid.display-items.length || !grid.display-items[index].pinned);
                    x: mod(self.position, grid.columns) * grid.tile-size + (grid.tile-size - root.item-size * 1px) / 2;
                    y: floor(self.position / grid.columns) * grid.tile-size + (grid.tile-size - root.item-size * 1px) / 2;
                    width: index < grid.display-items.length ? grid.display-items[index].span-x * grid.tile-size - 16px : root.item-size * 1px;
                    height: index < grid.display-items.length ? grid.display-items[index].span-y * grid.tile-size - 16px : root.item-size * 1px;
                    opacity: self.source-here ? 0.2 : 1;
                    items: grid.display-items; index: index;
                    folder-preview: root.drag-on-page && root.merge-ready && root.merge-target == index;
                    drag-preview-item: root.drag-item;
                    hovered: root.drag-on-page ? root.merge-target == index : page-input.has-hover && root.page-item-at(page-input.absolute-position.x + page-input.mouse-x, page-input.absolute-position.y + page-input.mouse-y) == index;
                    border-width: root.keyboard-grid && root.focused-item == index ? 2px : 1px;
                    border-color: (root.keyboard-grid && root.focused-item == index) || (root.drag-on-page && root.merge-target == index) ? #a8b3ff : #a6b1ed33;
                    animate x { duration: root.dragging ? 200ms : 0ms; easing: ease-out; }
                    animate y { duration: root.dragging ? 200ms : 0ms; easing: ease-out; }
                }
            }
            if root.drag-on-page && root.merge-target < 0 && !root.on-dock && root.drop-target >= 0: Rectangle {
                x: grid.x + mod(root.drop-target,grid.columns) * grid.tile-size + 8px;
                y: grid.y + floor(root.drop-target/grid.columns) * grid.tile-size + 8px;
                width: root.drag-item.span-x * grid.tile-size - 16px; height: root.drag-item.span-y * grid.tile-size - 16px;
                border-width: 3px; border-radius: 8px;
                border-color: root.placement-valid && root.reorder-ready ? #71ddcf : #ee9a8b;
                background: root.placement-valid && root.reorder-ready ? #71ddcf18 : #ee9a8b18;
            }
            page-input := TouchArea {
                y: -page.content-y;
                width: page.width; height: page.height;
                enabled: !root.busy && !root.transitioning && !root.folder-open && !root.sheet && !root.alert && !root.picker && !root.settings;
                scroll-event(event) => { return root.dragging ? accept : root.scroll-page(event); }
                pointer-event(event) => {
                    let x = self.absolute-position.x + self.mouse-x;
                    let y = self.absolute-position.y + self.mouse-y;
                    if event.kind == PointerEventKind.down {
                        let index = root.page-item-at(x, y);
                        if event.button == PointerEventButton.left {
                            root.keyboard-grid = false; root.focused-item = index;
                            root.begin-drag(index, false, x, y);
                            if index >= 0 && index < root.items.length && root.items[index].widget {
                                let right = grid.absolute-position.x + (root.items[index].col + root.items[index].span-x) * grid.tile-size - 8px;
                                let bottom = grid.absolute-position.y + (root.items[index].row + root.items[index].span-y) * grid.tile-size - 8px;
                                root.resizing = x > right - 24px && y > bottom - 24px;
                                root.resize-width = root.items[index].span-x; root.resize-height = root.items[index].span-y;
                            }
                            root.page-swipe-pressed = index < 0;
                            root.page-swipe-start = x;
                            page-focus.focus();
                        }
                        if event.button == PointerEventButton.right && index >= 0 && index < root.items.length {
                            root.dock-context = ""; root.context-index = index; root.context-x = x; root.context-y = y;
                        }
                    }
                    if event.kind == PointerEventKind.move {
                        if root.page-swipe-pressed { root.move-page-swipe(x); } else { root.move-drag(x, y); }
                    }
                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                        if root.page-swipe-pressed { root.end-page-swipe(); } else { root.end-drag(); }
                    }
                    if event.kind == PointerEventKind.cancel {
                        root.cancel-drag(); root.page-swipe-pressed = false; root.page-dragging = false; root.page-drag-offset = 0px;
                    }
                }
            }
            }
        }
    }
    HorizontalLayout {
        x: (root.width - self.width) / 2; y: root.height - 158px;
        width: (root.page-count + (root.page-count < 9 ? 1 : 0)) * 16px; height: 24px; spacing: 0px;
        for index in root.page-count: Rectangle {
            width: 16px; height: 24px;
            Rectangle { x: 5px; y: 9px; width: index == (root.drag-on-page ? root.drag-page : root.current-page) ? 7px : 5px; height: self.width; border-radius: self.width / 2; background: index == (root.drag-on-page ? root.drag-page : root.current-page) ? #a8b3ff : #657097; }
            TouchArea { mouse-cursor: pointer; clicked => { root.change-page(index); } }
        }
        if root.page-count < 9: Rectangle {
            width: 16px; height: 24px;
            Text { text: "+"; width: parent.width; height: parent.height; color: #a8b3ff; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { mouse-cursor: pointer; enabled: !root.busy; clicked => { root.busy = true; root.add-page(); } }
        }
    }
    dock := Rectangle {
        x: (root.width - self.width) / 2; y: root.height - 120px;
        width: min(root.width - 96px, max(104px, (root.recent-items.length + root.dock-items.length) * 100px + 4px)); height: 94px;
        property <length> slot-width: (self.width - 4px) / max(1, root.recent-items.length + root.dock-items.length);
        Image { x: -1px; y: -1px; width: parent.width + 2px; height: parent.height + 2px; source: @image-url("assets/dock.svg"); image-fit: fill; }
        for item[index] in root.recent-items: DockTile {
            x: 8px + index * dock.slot-width; y: 6px; width: dock.slot-width - 12px;
            item: item; enabled: !root.busy; recent: true;
            open => { root.busy = true; root.open-dock-item(item.page, item.index, item.folder-app-index); }
            gesture(kind,x,y) => {
                if kind == 0 { root.begin-drag(0,false,x,y); root.drag-from-dock = true; root.dock-source-index = index; root.drag-item = item; root.grab-x = 32px; root.grab-y = 32px; }
                if kind == 1 { root.move-drag(x,y); }
                if kind == 2 { root.end-drag(); }
                if kind == 3 { root.cancel-drag(); }
            }
            context-menu(recent, id, x, y) => {
                root.context-index = -1; root.dock-context = recent ? "recent" : "pinned";
                root.context-id = id; root.context-x = x; root.context-y = y;
            }
        }
        for item[index] in root.dock-items: DockTile {
            property <int> compact: index - (root.drag-item.pinned && index > root.dock-source-index ? 1 : 0);
            property <int> position: root.on-dock && root.drag-item.id != item.id ? self.compact + (self.compact >= root.dock-target ? 1 : 0) : index;
            opacity: root.dragging && root.drag-item.id == item.id ? 0.2 : 1;
            x: 8px + (root.recent-items.length + self.position) * dock.slot-width; y: 6px; width: dock.slot-width - 12px;
            animate x { duration: 200ms; easing: ease-out; }
            item: item; enabled: !root.busy; recent: false;
            open => { root.busy = true; root.open-dock-item(item.page, item.index, item.folder-app-index); }
            gesture(kind,x,y) => {
                if kind == 0 { root.begin-drag(0,false,x,y); root.drag-from-dock = true; root.dock-source-index = index; root.drag-item = item; root.grab-x = 32px; root.grab-y = 32px; }
                if kind == 1 { root.move-drag(x,y); }
                if kind == 2 { root.end-drag(); }
                if kind == 3 { root.cancel-drag(); }
            }
            context-menu(recent, id, x, y) => {
                root.context-index = -1; root.dock-context = recent ? "recent" : "pinned";
                root.context-id = id; root.context-x = x; root.context-y = y;
            }
        }
        if root.recent-items.length > 0 && root.dock-items.length > 0: Rectangle {
