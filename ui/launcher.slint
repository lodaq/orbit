                                color: Theme.secondary;
                                font-size: 14px;
                            }
                            VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                                spacing: 8px;
                                for app in root.installed-apps: AddOption {
                                                                        label: app.name;
                                    icon: app.icon; icon-present: app.icon-present;
                                    trailing: root.busy && root.sheet-operation == "adding" ? "Adding…" : "+";
                                    full-width: true; available-width: root.sheet-content-width;
                                    enabled: !root.busy;
                                    clicked => {
                                        root.busy = true;
                                        root.sheet-operation = "adding";
                                        root.sheet-status = "Adding…";
                                        root.add-installed-app(app.id);
                                    }
                                }
                            }
                        }
                        if root.item-type == "App" && root.custom && (root.editing >= 0 || root.app-source == "Custom command"): VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: 12px;
                            custom_name_field := AddField {
                                width: root.sheet-content-width;
                                label: "Name";
                                placeholder: "e.g. Terminal";
                                text <=> root.app-name;
                                error: root.name-error;
                                enabled: !root.busy;
                                edited => { root.name-error = ""; }
                                accepted => { custom_command_field.focus(); }
                            }
                            custom_command_field := AddField {
                                width: root.sheet-content-width;
                                label: "Command";
                                placeholder: "e.g. foot --title Terminal";
                                text <=> root.command;
                                error: root.command-error;
                                enabled: !root.busy;
                                multiline: true;
                                edited => { root.command-error = ""; }
                                accepted => { root.submit-form(); }
                            }
                            HorizontalLayout {
                                width: root.sheet-content-width; height: 48px; spacing: 12px; alignment: start;
                                Rectangle {
                                    width: 48px; height: 48px; border-radius: 12px; background: Theme.selection;
                                    if root.icon-preview-present: Image { width: 48px; height: 48px; source: root.icon-preview; image-fit: contain; }
                                    if !root.icon-preview-present: Text { text: root.icon-letter != "" ? root.icon-letter : root.app-name == "" ? "?" : root.first-letter(root.app-name); color: Theme.focus; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                AddOption { label: "Change icon"; option-width: 136px; height: 48px; enabled: !root.busy; clicked => { root.open-icon(root.icon-value, root.app-name); } }
                            }
                        }
                        if root.item-type == "App" && !root.custom && root.editing >= 0: VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: 12px;
                            AddField {
                                width: root.sheet-content-width;
                                label: "Name";
                                placeholder: "e.g. Terminal";
                                text <=> root.app-name;
                                error: root.name-error;
                                enabled: !root.busy;
                                edited => { root.name-error = ""; }
                                accepted => { root.submit-form(); }
                            }
                            HorizontalLayout {
                                width: root.sheet-content-width; height: 48px; spacing: 12px; alignment: start;
                                Rectangle {
                                    width: 48px; height: 48px; border-radius: 12px; background: Theme.selection;
                                    if root.icon-preview-present: Image { width: 48px; height: 48px; source: root.icon-preview; image-fit: contain; }
                                    if !root.icon-preview-present: Text { text: root.icon-letter != "" ? root.icon-letter : root.app-name == "" ? "?" : root.first-letter(root.app-name); color: Theme.focus; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                AddOption { label: "Change icon"; option-width: 136px; height: 48px; enabled: !root.busy; clicked => { root.open-icon(root.icon-value, root.app-name); } }
                            }
                        }
                        if root.item-type == "Website": VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: 12px;
                            website_name_field := AddField {
                                width: root.sheet-content-width; label: "Name"; placeholder: "e.g. Work"; text <=> root.app-name; error: root.name-error; enabled: !root.busy; edited => { root.name-error = ""; } accepted => { website_url_field.focus(); } }
                            website_url_field := AddField {
                                width: root.sheet-content-width; label: "URL"; placeholder: "https://example.com"; text <=> root.url-or-path; error: root.url-error; enabled: !root.busy; edited => { root.url-error = ""; } accepted => { root.submit-form(); } }
                        }
                        if root.item-type == "Folder": folder_name_field := AddField {
                                width: root.sheet-content-width;
                            label: "Name";
                            placeholder: "e.g. Work";
                            text <=> root.app-name;
                            error: root.name-error;
                            enabled: !root.busy;
                            edited => { root.name-error = ""; }
                            accepted => { root.submit-form(); }
                        }
                        if root.item-type == "File" || root.item-type == "Directory": VerticalLayout {
                            width: root.sheet-content-width; alignment: start; spacing: 12px;
                            AddField {
                                width: root.sheet-content-width;
                                label: "Path";
                                placeholder: root.item-type == "Directory" ? "/home/user/Documents" : "/home/user/Documents/file.pdf";
                                text <=> root.url-or-path;
                                error: root.path-error;
                                enabled: !root.busy;
                                edited => { root.path-error = ""; }
                                accepted => { root.submit-form(); }
                            }
                            AddOption {
                                label: root.busy && root.sheet-operation == "choosing" ? "Choose…" : (root.item-type == "Directory" ? "Choose directory" : "Choose file");
                                option-width: 148px;
                                enabled: !root.busy;
                                clicked => {
                                    root.busy = true;
                                    root.sheet-operation = "choosing";
                                    root.sheet-status = "Choose a path…";
                                    root.choose-path(root.item-type == "Directory");
                                }
                            }
                            HorizontalLayout {
                                width: root.sheet-content-width; height: 48px; spacing: 12px; alignment: start;
                                Rectangle {
                                    width: 48px; height: 48px; border-radius: 12px; background: Theme.selection;
                                    if root.icon-preview-present: Image {
                                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                        width: 40px; height: 40px; source: root.icon-preview; image-fit: contain;
                                    }
                                    if !root.icon-preview-present: Text { text: root.icon-letter != "" ? root.icon-letter : root.app-name == "" ? "?" : root.first-letter(root.app-name); color: Theme.focus; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                AddOption { label: "Change icon"; option-width: 136px; height: 48px; enabled: !root.busy; clicked => { root.open-icon(root.icon-value, root.app-name); } }
                            }
                        }
                        if root.sheet-status != "": Text {
                            text: (root.sheet-operation == "adding" || root.sheet-operation == "saving" || root.sheet-operation == "refreshing") ? "◌ " + root.sheet-status : "! " + root.sheet-status;
                            color: root.sheet-operation == "adding" || root.sheet-operation == "saving" || root.sheet-operation == "refreshing" ? Theme.focus : Theme.error;
                            font-size: 12px;
                            wrap: word-wrap;

                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    AddOption {
                        label: root.editing < 0 ? "Cancel" : "Delete";
                        selected: false;
                        enabled: root.editing >= 0 ? !root.busy : true;
                        horizontal-stretch: 1;
                        clicked => {
                            if root.editing < 0 { root.close-top-layer(); }
                            else { root.banner = ""; root.alert = true; cancel-delete.focus(); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.item-type == "Website" || root.item-type == "Folder" || root.item-type == "File" || root.item-type == "Directory" || (root.item-type == "App" && (root.editing >= 0 || root.app-source == "Custom command")): AddOption {
                        label: root.busy && root.sheet-operation == "saving" ? "Saving…" : "Save";
                        primary: true;
                        enabled: !root.busy;
                        clicked => { root.submit-form(); }
                    }
                }
            }
        }
    }
    if root.picker: Rectangle {
        width: root.width; height: root.height; background: Theme.backdrop;
        TouchArea { clicked => { root.close-top-layer(); } }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(520px, parent.width - 32px); height: min(380px, parent.height - 32px);
            background: Theme.sheet; border-width: 1px; border-color: Theme.border; border-radius: 16px;
            TouchArea { }
            VerticalLayout {
                padding: 16px; spacing: 16px;
                HorizontalLayout {
                    Text { text: "Icon"; color: Theme.text; font-size: 20px; font-weight: 600; vertical-alignment: center; }
                    AddOption { label: "×"; option-width: 40px; accessible-label: "Close the top layer"; clicked => { root.close-top-layer(); } }
                }
                HorizontalLayout {
                    spacing: 8px; alignment: start;
                    AddOption { label: "Letter"; option-width: 80px; selected: root.icon-mode == "Letter"; clicked => { root.icon-mode = "Letter"; root.icon-error = ""; } }
                    AddOption { label: "SVG"; option-width: 72px; selected: root.icon-mode == "SVG"; clicked => { root.icon-mode = "SVG"; root.icon-error = ""; } }
                    AddOption { label: "URL"; option-width: 72px; enabled: false; }
                    AddOption { label: "Choose icon"; option-width: 128px; selected: root.icon-mode == "Choose icon"; clicked => { root.icon-mode = "Choose icon"; root.icon-error = ""; } }
                }
                VerticalLayout {
                    alignment: start; spacing: 8px;
                    if root.icon-mode == "Letter": AddField {
                        width: parent.width;
                        label: "Letter"; placeholder: "A, AB, or an emoji"; text <=> root.letter-draft;
                    }
                    if root.icon-mode == "Letter": Text { text: "1–2 characters, including emojis"; color: Theme.secondary; font-size: 12px; }
                    if root.icon-mode == "SVG": AddField {
                        width: parent.width;
                        label: "SVG"; placeholder: "Paste SVG markup"; multiline: true; text <=> root.svg-draft;
                    }
                    if root.icon-mode == "Choose icon": AddOption { label: root.icon-busy ? "Choosing…" : "Choose icon"; option-width: 144px; enabled: !root.icon-busy; clicked => { root.icon-busy = true; root.choose-icon(root.icon-session); } }
                    if root.icon-mode == "Choose icon": Text { text: root.icon-file-draft == "" ? "PNG, JPEG, SVG or ICO" : root.icon-file-draft; color: Theme.secondary; font-size: 12px; overflow: elide; }
                    if root.icon-error != "": Text { text: root.icon-error; color: Theme.error; font-size: 12px; wrap: word-wrap; }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    AddOption { label: "Cancel"; clicked => { root.close-top-layer(); } }
                    Rectangle { horizontal-stretch: 1; }
                    AddOption { label: root.icon-busy ? "Saving…" : "Save"; primary: true; enabled: !root.icon-busy;
                        clicked => { root.icon-busy = true; root.save-icon(root.icon-mode, root.icon-mode == "Letter" ? root.letter-draft : root.icon-mode == "SVG" ? root.svg-draft : root.icon-file-draft, root.icon-session); }
                    }
                }
            }
        }
    }
    folder-backdrop := Rectangle {
        width: root.width; height: root.height;
        visible: root.folder-open || root.folder-closing;
        opacity: root.folder-open ? 1 : 0;
        animate opacity { duration: 220ms; easing: ease-out; }
        background: #00000070;
        TouchArea { enabled: root.folder-open; clicked => { root.close-folder-view(); } }
        folder-panel := Rectangle {
            x: root.folder-open ? (parent.width - self.width) / 2 : grid.absolute-position.x + mod(root.folder-index, grid.columns) * grid.tile-size;
            y: root.folder-open ? (parent.height - self.height) / 2 : grid.absolute-position.y + floor(root.folder-index / grid.columns) * grid.tile-size;
            width: root.folder-open ? min(560px, parent.width - 32px) : 128px;
            height: root.folder-open ? min(560px, parent.height - 32px) : 128px;
            animate x { duration: 220ms; easing: ease-out; }
            animate y { duration: 220ms; easing: ease-out; }
            animate width { duration: 220ms; easing: ease-out; }
            animate height { duration: 220ms; easing: ease-out; }
            background: #f5f5f7; border-radius: 24px;
            TouchArea { enabled: root.folder-open; }
            VerticalLayout {
                visible: root.folder-open || root.folder-closing;
                opacity: root.folder-open ? 1 : 0;
                animate opacity { duration: 150ms; easing: ease-out; }
                padding: 24px; spacing: 16px;
                Text { text: root.folder-name; color: #202020; font-size: 22px; font-weight: 600; }
                Flickable {
                    content-width: self.width;
                    content-height: folder-grid.height;
                    folder-grid := Rectangle {
                        width: min(480px, parent.width);
                        property <int> columns: max(1, floor(self.width / 112px));
                        height: ceil(root.folder-items.length / self.columns) * 112px;
                        for index in root.folder-items.length: Rectangle {
                            property <int> position: root.folder-dragged && root.folder-drop-target >= 0 && index != root.folder-drag-index
                                ? (root.folder-drag-index < root.folder-drop-target && index > root.folder-drag-index && index <= root.folder-drop-target ? index - 1
                                : root.folder-drag-index > root.folder-drop-target && index >= root.folder-drop-target && index < root.folder-drag-index ? index + 1 : index)
                                : index;
                            x: mod(self.position, folder-grid.columns) * (folder-grid.width / folder-grid.columns);
                            y: floor(self.position / folder-grid.columns) * 112px;
                            width: folder-grid.width / folder-grid.columns; height: 108px;
                            opacity: root.folder-dragged && index == root.folder-drag-index ? 0 : 1;
                            animate x { duration: 120ms; easing: ease-out; }
                            animate y { duration: 120ms; easing: ease-out; }
                            Rectangle {
                                x: (parent.width - self.width) / 2; width: 64px; height: 64px;
                                border-radius: 14px; background: white;
                                Image { x: 8px; y: 8px; width: 48px; height: 48px; source: root.folder-items[index].icon; image-fit: contain; }
                                if !root.folder-items[index].icon-present: Text {
                                    text: root.folder-items[index].letter; color: #404040; font-size: 28px;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            Text { y: 70px; width: parent.width; text: root.folder-items[index].name; color: #202020; font-size: 13px; horizontal-alignment: center; overflow: elide; }
                            TouchArea {
                                enabled: root.folder-open;
                                mouse-cursor: pointer;
                                clicked => {
                                    if root.folder-dragged { root.folder-dragged = false; return; }
                                    root.busy = true;
                                    root.launch-folder-app(root.folder-index, index);
                                }
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                        root.folder-drag-index = index;
                                        root.folder-dragged = false;
                                        root.folder-drop-target = -1;
                                        root.folder-settling = false;
                                        folder-settle-timer.stop();
                                    }
                                    if event.kind == PointerEventKind.move && root.folder-drag-index >= 0
                                        && (abs(self.mouse-x - self.pressed-x) > 8px || abs(self.mouse-y - self.pressed-y) > 8px) {
                                        root.folder-dragged = true;
                                        let x = self.absolute-position.x + self.mouse-x;
                                        let y = self.absolute-position.y + self.mouse-y;
                                        root.folder-drag-x = x - 32px;
                                        root.folder-drag-y = y - 32px;
                                        let outside = x < folder-panel.absolute-position.x || x > folder-panel.absolute-position.x + folder-panel.width
                                            || y < folder-panel.absolute-position.y || y > folder-panel.absolute-position.y + folder-panel.height;
                                        if outside { root.move-folder-out(x, y); return; }
                                        let column = floor((x - folder-grid.absolute-position.x) / (folder-grid.width / folder-grid.columns));
                                        let row = floor((y - folder-grid.absolute-position.y) / 112px);
                                        root.folder-drop-target = min(root.folder-items.length - 1, max(0, row * folder-grid.columns + column));
                                    }
                                    if event.kind == PointerEventKind.up && root.folder-drag-index >= 0 {
                                        let x = self.absolute-position.x + self.mouse-x;
                                        let y = self.absolute-position.y + self.mouse-y;
                                        let outside = x < folder-panel.absolute-position.x || x > folder-panel.absolute-position.x + folder-panel.width
                                            || y < folder-panel.absolute-position.y || y > folder-panel.absolute-position.y + folder-panel.height;
                                        if root.folder-dragged && outside {
                                            root.move-folder-out(x, y);
                                        } else if root.folder-dragged {
                                            let column = floor((x - folder-grid.absolute-position.x) / (folder-grid.width / folder-grid.columns));
                                            let row = floor((y - folder-grid.absolute-position.y) / 112px);
                                            let target = min(root.folder-items.length - 1, max(0, row * folder-grid.columns + column));
                                            root.folder-settling-item = root.folder-items[root.folder-drag-index];
                                            root.folder-settling = true;
                                            root.folder-settle-x = folder-grid.absolute-position.x + mod(target, folder-grid.columns) * (folder-grid.width / folder-grid.columns) + ((folder-grid.width / folder-grid.columns) - 64px) / 2;
                                            root.folder-settle-y = folder-grid.absolute-position.y + floor(target / folder-grid.columns) * 112px;
                                            folder-settle-timer.start();
                                            root.busy = true;
                                            root.reorder-folder-app(root.folder-index, root.folder-drag-index, target);
                                        }
                                        root.folder-drag-index = -1;
                                        root.folder-drop-target = -1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if (root.folder-open && root.folder-dragged && root.folder-drag-index >= 0 && root.folder-drag-index < root.folder-items.length) || root.folder-settling: Rectangle {
        x: root.folder-drag-index >= 0 ? root.folder-drag-x : root.folder-settle-x;
        y: root.folder-drag-index >= 0 ? root.folder-drag-y : root.folder-settle-y;
        width: 64px; height: 64px; opacity: 0.88;
        animate x { duration: 120ms; easing: ease-out; }
        animate y { duration: 120ms; easing: ease-out; }
        ItemIcon { width: 64px; height: 64px; item: root.folder-drag-index >= 0 ? root.folder-items[root.folder-drag-index] : root.folder-settling-item; }
    }
    alert-backdrop := Rectangle {
        width: root.width; height: root.height;
        visible: root.alert;
        opacity: root.alert ? 1 : 0;
        animate opacity { duration: 120ms; easing: ease-out; }
        background: #00000070;
        TouchArea { enabled: !root.busy; clicked => { root.alert = false; } }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(360px, parent.width - 32px); height: root.banner == "" ? 190px : 250px;
            background: Theme.sheet; border-radius: 16px; border-width: 1px; border-color: Theme.border;
            TouchArea { }
            VerticalLayout {
                padding: 24px; spacing: 16px;
                Text {
                    text: root.items[root.editing].folder ? ("Delete folder '" + root.app-name + "'? Its apps will move to the page.")
                        : ("Delete '" + root.app-name + "' from Orbit?");
                    color: Theme.text; font-size: 17px; wrap: word-wrap;
                }
                if root.banner != "": Text { text: root.banner; color: #c02020; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 12px;
                    cancel-delete := AddOption { label: "Cancel"; enabled: !root.busy; clicked => { root.alert = false; } }
                    AddOption {
                        label: "Delete"; destructive: true; enabled: !root.busy;
                        clicked => { root.busy = true; root.delete-item(root.editing); }
                    }
                }
            }
        }
    }
}
