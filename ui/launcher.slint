        Image { x: 8px; y: 10px; width: 20px; height: 20px;
            source: index == 0 ? (root.layout-locked ? @image-url("assets/lock.svg") : @image-url("assets/unlock.svg")) : index == 1 ? @image-url("assets/settings.svg") : @image-url("assets/close.svg"); }
        top-button := TouchArea {
