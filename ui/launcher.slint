                                let bottom = grid.absolute-position.y + (root.items[index].row + root.items[index].span-y) * grid.tile-size - root.grid-gap * 0.5px;
                                root.resizing = !root.layout-locked && x >= right - 32px && x <= right + 8px && y >= bottom - 32px && y <= bottom + 8px;
