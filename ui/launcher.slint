    if !root.background-image-active && !root.background-color-active: Image { width: root.width; height: root.height; source: @image-url("assets/background.svg"); image-fit: fill; }
    if root.home-visible: Rectangle {
        x: root.width - 72px; y: root.height - 92px; width: 48px; height: 48px;
        background: Theme.dock-surface; border-width: 1px; border-color: Theme.dock-border; border-radius: 24px;
        accessible-role: button; accessible-label: "Change background image"; accessible-action-default => { root.change-background-image(); }
        Image { x: 12px; y: 12px; width: 24px; height: 24px; source: @image-url("assets/change-background.svg"); image-fit: contain; }
        TouchArea { mouse-cursor: pointer; clicked => { root.change-background-image(); } }
    }
    Image { x: root.width < 1200px ? 16px : 48px; y: 40px; width: root.width < 1200px ? 80px : 90px; height: 32px; source: @image-url("assets/orbit.svg"); image-fit: contain; }
    search-bar := Rectangle {
        x: (root.width - self.width) / 2; y: 34px; width: min(root.ai-active && !root.settings ? 820px : 560px, max(240px, root.width - 440px));
        height: max(Theme.search-min-height, min(176px, search-measure.preferred-height + 2 * (Theme.search-padding + Theme.search-cursor-inset) + (completion-ghost.visible && completion-ghost.next-line ? root.search-cursor-height : 0px)));
        background: Theme.search-background;
        border-color: root.search-focused ? Theme.search-focus-border : Theme.search-border;
        border-width: Theme.border-width; border-radius: Theme.radius-sheet - Theme.space-1;
        Image { x: Theme.space-4; y: (Theme.search-min-height - self.height) / 2; width: 18px; height: 18px; source: @image-url("assets/search.svg"); }
        OrbitText {
            x: search-scroll.x + search-input.x; y: search-scroll.y + search-input.y;
            width: search-input.width; height: root.search-cursor-height;
            text: root.search-text == "" ? (root.ai-active ? "Ask AI" : "Search anything") : "";
            color: Theme.secondary; font-size: Theme.search-font-size;
        }
        search-measure := OrbitText {
            visible: false; width: search-input.width;
            text: root.search-text == "" ? " " : root.search-text;
            font-size: Theme.search-font-size; wrap: word-wrap;
        }
