                                    preferred-height: 40px;
                                    horizontal-stretch: 1;
                                    edited(text) => { root.filter-installed-apps(text); }
                                }
                                AddOption { label: "Clear filter"; enabled: root.installed-filter != "" && !root.busy; clicked => { root.installed-filter = ""; root.filter-installed-apps(""); } }
                            }
                            if root.installed-apps.length == 0 && root.installed-filter == "": Text {
                                text: root.installed-apps-loaded ? "No items found" : "Refresh installed apps to load the list.";
                                color: Theme.secondary;
                                font-size: 14px;

                            }
                            if root.installed-filter != "" && !root.installed-apps-match: Text {
