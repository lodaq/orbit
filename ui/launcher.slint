    cancel-pointer => { canvas-view.cancel(); root.cancel-drag(); }
    callback reset-launcher();
    callback finish-drag();
    callback close-top-layer();
    animate page-drag-offset { duration: root.page-dragging ? 0ms : 100ms; easing: ease-out; }
    animate transition-progress { duration: root.transitioning ? root.transition-duration : 0ms; easing: ease-out-sine; }
    function finish-page-transition() {
        root.transitioning = false;
        root.transition-progress = 0;
        root.transition-items = [];
        root.transition-incoming-items = [];
        transition-timer.stop();
    }
    transition-timer := Timer {
        running: false;
        interval: root.transition-duration + 34ms;
        triggered => { root.finish-page-transition(); }
    }
    merge-timer := Timer {
        interval: 500ms;
        triggered => {
            root.merge-ready = root.dragging && root.merge-target >= 0;
            if root.merge-ready { root.drag-scale = 0.84; }
            self.stop();
        }
    }
    edge-timer := Timer {
        interval: 600ms;
        triggered => {
            let destination = root.drag-page + root.edge-direction;
            if root.current-page < root.page-count && root.drag-on-page && destination >= 0 && destination <= min(root.page-count, 8) {
                root.drag-slide-animate = false; root.drag-slide-direction = root.edge-direction; root.drag-slide = 0; drag-slide-timer.start();
                root.drag-page = destination;
                page.content-y = 0px;
                root.clear-merge();
                root.update-drop();
            } else { self.stop(); }
        }
    }
