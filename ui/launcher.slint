    function activate-prefix() {
        root.engine-menu = false;
        root.clear-ai();
        let matched = root.match-prefix(root.search-text);
        let has-match = matched.action-id != "";
        root.activated-prefix-id = matched.action-id;
        root.activated-prefix-name = matched.name;
        root.activated-prefix-width = min(132px, max(52px, matched.badge-width * 1px));
        if has-match {
            root.search-text = matched.query;
            root.search(root.ai-active ? "" : root.search-text);
            root.search-selection = 0;
            root.search-offset = 0px;
            search-input.focus();
            search-input.set-selection-offsets(matched.query-length, matched.query-length);
        }
    }
    callback activate-ticktick-prefix();
    activate-ticktick-prefix => {
        root.activated-prefix-id = "ticktick";
        root.activated-prefix-name = "TickTick";
        root.activated-prefix-width = 78px;
        root.focus-search();
    }
    callback run-activated-prefix();
    run-activated-prefix => {
        if root.busy { return; }
        if root.activated-prefix-id == "" {
            let matched = root.match-prefix(root.search-text);
            if matched.action-id != "" {
                root.activate-prefix();
            }
        }
        root.remember-search();
        if root.script-active {
            if root.script-needs-completion(root.search-text, root.script-matches[root.script-selection].name) { root.complete-script(); }
            else { root.launch-script(); }
        }
        else if root.ai-active {
            if !root.ai-loading { root.save-ai(); root.ai-submit(); }
        } else if root.activated-prefix-id != "" {
            root.busy = true;
            root.run-prefix(root.activated-prefix-id, root.search-text);
        } else { root.activate-search-selection(); }
    }
