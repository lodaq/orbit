        width: min(root.width - 48px, max(360px, min(1400px, self.content-width + 64px))); height: 98px;
        background: #171a29e8; border-width: 1px; border-color: #a6b1ed44; border-radius: 32px;
        property <bool> overflowing: self.content-width > self.width - 16px;
        property <length> scroll-inset: 8px;
        property <length> slot-width: 100px;
        dock-scroll := Flickable {
