                accessible-role: button; accessible-label: "Run " + script.name + " · " + script.path;
                accessible-action-default => { root.script-selection = index; root.launch-script(); }
                OrbitText { x: 12px; y: 8px; width: parent.width - 24px; height: 24px; text: script.name; color: Theme.text; font-size: Theme.type-control; font-weight: 600; overflow: elide; }
                OrbitText { x: 12px; y: 34px; width: parent.width - 24px; height: 22px; text: script.path; color: Theme.secondary; font-size: Theme.type-control; overflow: elide; }
