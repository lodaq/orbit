                if root.context-index >= 0 && root.items[root.context-index].robot != "": VerticalLayout {
                    for action in RobotWorkbench.common-actions: MenuOption { width: 184px; label: action.name; clicked => { RobotWorkbench.run-action(root.items[root.context-index].robot, action.id); root.context-index = -1; } }
                }
                if root.context-index >= 0 && root.items[root.context-index].ticktick && !root.items[root.context-index].ticktick-next: MenuOption { width: 184px; label: "New task"; clicked => { root.open-ticktick-create(root.items[root.context-index].ticktick-project-id); root.context-index = -1; } }
                if root.context-index >= 0 && root.items[root.context-index].widget: MenuOption { width: 184px; label: "Duplicate"; enabled: !root.layout-locked; clicked => { root.busy = true; root.duplicate-widget(root.items[root.context-index].id); root.context-index = -1; } }
                if root.context-index >= 0 && root.items[root.context-index].widget: MenuOption { width: 184px; label: "Resize · wider";
                    enabled: !root.layout-locked && root.preview-valid(root.items,root.items[root.context-index].id,root.items[root.context-index].col,root.items[root.context-index].row,root.items[root.context-index].span-x + 1,root.items[root.context-index].span-y);
                    clicked => { root.busy = true; root.resize-item(root.items[root.context-index].id,root.items[root.context-index].span-x + 1,root.items[root.context-index].span-y); root.context-index = -1; } }
                if root.context-index >= 0 && root.items[root.context-index].widget: MenuOption { width: 184px; label: "Resize · taller";
                    enabled: !root.layout-locked && root.preview-valid(root.items,root.items[root.context-index].id,root.items[root.context-index].col,root.items[root.context-index].row,root.items[root.context-index].span-x,root.items[root.context-index].span-y + 1);
                    clicked => { root.busy = true; root.resize-item(root.items[root.context-index].id,root.items[root.context-index].span-x,root.items[root.context-index].span-y + 1); root.context-index = -1; } }
                if root.context-index >= 0 && root.items[root.context-index].widget: MenuOption { width: 184px; label: "Resize · smaller";
                    enabled: !root.layout-locked && (root.items[root.context-index].span-x > root.items[root.context-index].min-span-x || root.items[root.context-index].span-y > root.items[root.context-index].min-span-y)
                        && root.preview-valid(root.items,root.items[root.context-index].id,root.items[root.context-index].col,root.items[root.context-index].row,max(root.items[root.context-index].min-span-x,root.items[root.context-index].span-x - 1),max(root.items[root.context-index].min-span-y,root.items[root.context-index].span-y - 1));
                    clicked => { root.busy = true; root.resize-item(root.items[root.context-index].id,max(root.items[root.context-index].min-span-x,root.items[root.context-index].span-x - 1),max(root.items[root.context-index].min-span-y,root.items[root.context-index].span-y - 1)); root.context-index = -1; } }
                if root.context-index >= 0 && root.items[root.context-index].annotation > 0 && root.items[root.context-index].annotation != 3: MenuOption { width: 184px; label: "Edit"; enabled: !root.layout-locked; clicked => {
                    let item = root.items[root.context-index]; root.annotation-id = item.id; root.annotation-text = item.name; root.annotation-kind = item.annotation;
                    root.text-size = item.annotation-size; root.ink-opacity = item.annotation-opacity; root.ink-color-value = item.annotation-color; root.ink-color = item.annotation-color-name;
                    root.annotation-editor = true; root.context-index = -1;
                } }
                if root.context-index >= 0 && !root.items[root.context-index].widget && root.items[root.context-index].annotation == 0: MenuOption { width: 184px; label: root.items[root.context-index].folder ? "Rename" : "Edit"; enabled: !root.layout-locked; clicked => {
                    root.edit-item(root.context-index);
                } }
                if root.context-index >= 0 && !root.items[root.context-index].widget && root.items[root.context-index].annotation == 0: MenuOption { width: 184px; label: root.items[root.context-index].pinned ? "Unpin" : "Pin"; enabled: !root.layout-locked; clicked => { root.busy = true; root.pin-item(root.items[root.context-index].id); root.context-index = -1; } }
                if root.context-index >= 0: MenuOption { width: 184px; label: "Delete"; destructive: true; enabled: !root.layout-locked; clicked => {
                    root.editing = root.context-index;
