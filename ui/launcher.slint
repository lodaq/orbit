        if can-merge {
            reorder-timer.stop(); root.reorder-ready = false; root.reorder-target = -1;
            if root.merge-target != target { root.clear-merge(); root.merge-target = target; merge-timer.start(); }
        } else {
            root.clear-merge();
            if root.reorder-target != slot {
                reorder-timer.stop(); root.reorder-ready = false; root.reorder-target = slot;
                if slot >= 0 { if target < 0 || root.drag-items[target].id == root.drag-item.id { root.reorder-ready = true; } else { reorder-timer.start(); } }
            }
        }
    }
    function move-drag(x: length, y: length) {
        if root.drag-index < 0 || root.drop-pending { return; }
        root.drag-x = x;
        root.drag-y = y;
        if root.resizing {
            root.dragging = true;
            root.resize-width = min(4,max(1,ceil((x - grid.absolute-position.x) / grid.tile-size) - root.drag-item.col));
            root.resize-height = min(4,max(1,ceil((y - grid.absolute-position.y) / grid.tile-size) - root.drag-item.row));
