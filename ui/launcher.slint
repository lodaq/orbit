        root.icon-preview-present = index >= 0 && root.items[index].icon-present;
        root.icon-letter = index < 0 ? "" : root.items[index].letter;
        root.custom = index < 0 || root.items[index].custom;
        root.app-source = root.custom ? "Custom command" : "Actions";
        root.installed-filter = "";
        root.sheet = true;

    }
    function edit-folder(index: int) {
        root.context-index = -1;
        root.banner = "";
        root.sheet-status = "";
        root.editing = index;
        root.item-type = "Folder";
        root.app-name = index < 0 ? "" : root.items[index].name;
        root.sheet = true;

    }
    function add-item(kind: string) {
        if root.layout-locked { return; }
        root.page-context = false;
        sheet-scroll.content-x = 0px; sheet-scroll.content-y = 0px;
        root.icon-preview-present = false; root.icon-letter = "";
        if root.sheet {
            root.remember-add-draft();
        } else {
            root.custom-name-draft = "";
            root.custom-command-draft = "";
            root.website-name-draft = "";
            root.website-url-draft = "";
            root.folder-name-draft = "";
            root.installed-filter = "";
        }
        root.editing = -1;
        root.website-icon-session += 1;
        root.website-auto-icon = true;
        root.website-preview-url = "";
        root.website-icon-loading = false;
        root.website-icon-status = "Enter a URL to preview its icon.";
        root.item-type = kind;
        root.custom = true;
        if kind == "App" {
            root.app-source = "Custom command";
            root.app-name = root.custom-name-draft;
            root.command = root.custom-command-draft;
        } else if kind == "Website" {
            root.app-name = root.website-name-draft;
            root.url-or-path = root.website-url-draft;
        } else if kind == "Folder" {
            root.app-name = root.folder-name-draft;
        } else {
            root.url-or-path = "";
        }
        root.icon-value = kind == "Directory" ? "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path fill=\"#777\" d=\"M5 15a5 5 0 0 1 5-5h17l6 7h21a5 5 0 0 1 5 5v26a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5z\"/></svg>" : (kind == "File" ? "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path fill=\"#777\" d=\"M14 5h24l13 13v41H14z\"/><path fill=\"white\" d=\"M38 5v14h13z\"/><path stroke=\"white\" stroke-width=\"3\" d=\"M21 34h23M21 41h23M21 48h17\"/></svg>" : "");
        if kind == "File" || kind == "Directory" {
            root.icon-preview = kind == "File" ? @image-url("assets/file.svg") : @image-url("assets/directory.svg");
            root.icon-preview-present = true;
        }
        root.banner = "";
        root.sheet-status = "";
        root.name-error = "";
        root.command-error = "";
        root.url-error = "";
        root.path-error = "";
        root.icon-error = "";
        root.sheet = true;
        if kind == "Website" { root.website-url-changed(); }


    }
    function remember-add-draft() {
        if root.item-type == "App" && root.app-source == "Custom command" {
            root.custom-name-draft = root.app-name;
            root.custom-command-draft = root.command;
        } else if root.item-type == "Website" {
            root.website-name-draft = root.app-name;
            root.website-url-draft = root.url-or-path;
        } else if root.item-type == "Folder" {
            root.folder-name-draft = root.app-name;
        }
    }
    function app-source-changed(source: string) {
        sheet-scroll.content-x = 0px; sheet-scroll.content-y = 0px;
        root.remember-add-draft();
        root.app-source = source;
        root.app-name = root.custom-name-draft;
        root.command = root.custom-command-draft;
        root.sheet-status = "";

    }
    function submit-form() {
        root.name-error = "";
        root.command-error = "";
        root.url-error = "";
        root.path-error = "";
        root.sheet-status = "";
        if root.item-type == "Website" && root.website-auto-icon && root.website-icon-loading { return; }
        if (root.item-type == "Folder" || root.item-type == "Website" || (root.item-type == "App" && (root.editing >= 0 || root.app-source == "Custom command"))) && !root.valid-name(root.app-name) {
            root.name-error = "Enter a Name.";
            return;
        }
        if root.item-type == "App" && root.custom && !root.valid-command(root.command) {
            root.command-error = "Enter a Command with closed quotes.";
            return;
        }
        if root.item-type == "Website" && !root.valid-url(root.url-or-path) {
            root.url-error = "Enter a valid HTTP or HTTPS URL.";
            return;
        }
        if (root.item-type == "File" || root.item-type == "Directory") && root.url-or-path == "" {
            root.path-error = "Enter a Path.";
            return;
        }
        root.busy = true;
        root.sheet-operation = "saving";
        if root.item-type == "App" { root.save-app(root.editing, root.app-name, root.command, root.icon-value); }
        else if root.item-type == "Website" { root.save-website(root.editing, root.app-name, root.url-or-path, root.icon-value, root.website-auto-icon); }
        else if root.item-type == "File" || root.item-type == "Directory" { root.save-path(root.editing, root.url-or-path, root.item-type == "Directory", root.icon-value); }
        else { root.save-folder(root.editing, root.app-name); }
    }
    function edit-item(index: int) {
        if root.items[index].folder { root.edit-folder(index); }
        else if root.items[index].app { root.edit-app(index); }
        else {
            root.context-index = -1;
            root.banner = "";
            root.editing = index;
            root.path-error = "";
            root.item-type = root.items[index].website ? "Website" : (root.items[index].file ? "File" : "Directory");
            root.app-name = root.items[index].name;
            root.url-or-path = root.items[index].website ? root.items[index].url : root.items[index].path;
            root.website-icon-session += 1;
            root.website-auto-icon = root.website-icon-automatic(root.items[index].icon-value);
            root.website-preview-url = root.items[index].url;
            root.website-icon-loading = false;
            root.website-icon-status = "Fetched icon";
            root.icon-value = root.items[index].icon-value;
            root.icon-preview = root.items[index].icon;
            root.icon-preview-present = root.items[index].icon-present;
            root.icon-letter = root.items[index].letter;
            root.sheet = true;


        }
    }
    callback open-page(int);
    callback hide-launcher();
    function change-page(index: int) {
        root.page-context = false;
        if !root.busy && !root.transitioning && index >= 0 && index < root.page-count && index != root.current-page {
            root.transition-items = root.items;
            root.transition-direction = index > root.current-page ? 1 : -1;
            root.transition-incoming-items = root.transition-direction > 0 ? root.next-items : root.previous-items;
            root.transition-start = root.page-drag-offset;
            root.page-drag-offset = 0px;
            root.transition-progress = 0;
            root.transitioning = true;
            root.busy = true;
            root.open-page(index);
            page.content-y = 0px;
            root.transition-progress = 1;
            transition-timer.start();
        } else {
            root.page-drag-offset = 0px;
        }
    }
    function move-page-swipe(x: length) {
        let dx = x - root.page-swipe-start;
        if abs(dx) < 8px && !root.page-dragging { return; }
        root.page-dragging = true;
        let limit = (dx > 0px && root.current-page == 0)
            || (dx < 0px && root.current-page == root.page-count - 1) ? 64px : root.page-span;
        root.page-drag-offset = min(limit, max(-limit, dx));
    }
    function end-page-swipe() {
        root.page-swipe-pressed = false;
        root.page-dragging = false;
        if abs(root.page-drag-offset) > min(120px, page.width * 0.18) {
            root.change-page(root.current-page + (root.page-drag-offset < 0px ? 1 : -1));
        } else { root.page-drag-offset = 0px; }
    }
    function scroll-page(event: PointerScrollEvent) -> EventResult {
        if event.modifiers.shift {
            if event.delta-y > 0px || event.delta-x > 0px {
                root.change-page(root.current-page + 1);
            } else if event.delta-y < 0px || event.delta-x < 0px {
                root.change-page(root.current-page - 1);
            }
            return accept;
        }
        return reject;
    }
    init => { Palette.color-scheme = ColorScheme.dark; }
    default-font-family: "Inter";
    default-font-size: 14px;
    title: "Orbit";
    no-frame: true;
    full-screen: true;
    background: #0b0d19;
    Image { width: root.width; height: root.height; source: @image-url("assets/background.svg"); image-fit: fill; }
    Image { x: 48px; y: 40px; width: 90px; height: 32px; source: @image-url("assets/orbit.svg"); }
    search-bar := Rectangle {
        x: (root.width - self.width) / 2; y: 34px; width: min(560px, root.width - 440px);
        height: max(Theme.search-min-height, min(176px, search-measure.preferred-height + 2 * (Theme.search-padding + Theme.search-cursor-inset)));
        background: Theme.search-background;
        border-color: root.search-focused ? Theme.search-focus-border : Theme.search-border;
        border-width: Theme.border-width; border-radius: Theme.radius-sheet - Theme.space-1;
        Image { x: Theme.space-4; y: (Theme.search-min-height - self.height) / 2; width: 18px; height: 18px; source: @image-url("assets/search.svg"); }
        Text {
            x: search-scroll.x + search-input.x; y: search-scroll.y + search-input.y;
            width: search-input.width; height: root.search-cursor-height;
            text: root.search-text == "" ? "Search anything" : "";
            color: Theme.secondary; font-size: Theme.search-font-size;
        }
        search-measure := Text {
            visible: false; width: search-input.width;
            text: root.search-text == "" ? " " : root.search-text;
            font-size: Theme.search-font-size; wrap: word-wrap;
        }
        search-scroll := Flickable {
            x: root.activated-prefix-name == "" ? 45px : 53px + root.activated-prefix-width;
            y: Theme.search-padding;
            width: max(40px, parent.width - self.x - Theme.search-padding - (search-hint.width > 0px ? search-hint.width + Theme.space-4 : 0px));
            height: parent.height - 2 * Theme.search-padding;
            content-width: self.width;
            content-height: max(self.height, max(search-measure.preferred-height + 2 * Theme.search-cursor-inset, search-input.y + root.search-cursor-y + root.search-cursor-height + Theme.search-cursor-inset));
            search-input := TextInput {
                x: Theme.search-cursor-inset; y: Theme.search-cursor-inset;
                // Text wraps before the reserved block width, so the full cursor fits.
                width: parent.width - root.search-cursor-width - 2 * Theme.search-cursor-inset;
                height: max(search-scroll.height - self.y, search-measure.preferred-height + Theme.search-cursor-inset);
                text <=> root.search-text; color: Theme.text; font-size: Theme.search-font-size; vertical-alignment: top;
                single-line: false; wrap: word-wrap;
                cursor-position-changed(point) => {
                    root.search-edit-generation += 1;
                    root.search-cursor-x = point.x;
                    root.search-cursor-y = point.y;
                    let top = self.y + point.y + search-scroll.content-y;
                    let bottom = top + root.search-cursor-height;
                    if top < Theme.search-cursor-inset {
                        search-scroll.content-y = min(0px, Theme.search-cursor-inset - self.y - point.y);
                    } else if bottom > search-scroll.height - Theme.search-cursor-inset {
                        search-scroll.content-y = max(search-scroll.height - search-scroll.content-height, search-scroll.height - Theme.search-cursor-inset - self.y - point.y - root.search-cursor-height);
                    }
                }
                edited => { root.search-selection = 0; root.search-offset = 0px; root.search(self.text); }
                accepted => { if self.text != "" || root.activated-prefix-id != "" { root.run-activated-prefix(); } }
                key-pressed(event) => {
                    if event.text == Key.Backspace && self.text == "" && root.activated-prefix-id != "" {
                        root.activated-prefix-id = ""; root.activated-prefix-name = ""; root.search(""); accept;
                    }
                    else if event.text == "\n" { if self.text != "" || root.activated-prefix-id != "" { root.run-activated-prefix(); } accept; }
                    else if event.text == Key.Tab { if root.activated-prefix-id == "" { root.activate-prefix(); } accept; }
                    else if event.text == Key.Space && root.activated-prefix-id == "" {
                        let matched = root.match-prefix(root.search-text);
                        if matched.action-id != "" { root.activate-prefix(); accept; } else { reject; }
                    }
                    else { reject; }
                }
            }
        }
        if root.search-cursor-overlay: Rectangle {
            x: search-scroll.x; y: search-scroll.y;
            width: search-scroll.width; height: search-scroll.height; clip: true;
            SmoothCaret {
                target-x: search-input.x + root.search-cursor-x;
                target-y: search-input.y + root.search-cursor-y + search-scroll.content-y;
                caret-width: root.search-cursor-width;
                caret-height: root.search-cursor-height;
                active: search-input.cursor-position-byte-offset == search-input.anchor-position-byte-offset;
                edit-generation: root.search-edit-generation;
            }
        }
        if root.activated-prefix-name != "": Rectangle {
            x: 45px; y: (Theme.search-min-height - self.height) / 2; width: root.activated-prefix-width; height: 28px;
            background: Theme.search-prefix-background; border-width: Theme.border-width; border-color: Theme.search-focus-border; border-radius: Theme.radius-control;
            prefix-badge-label := Text { x: 6px; width: parent.width - 12px; height: parent.height; text: root.activated-prefix-name; accessible-label: root.activated-prefix-name; color: #cbd2ff; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        }
        search-hint := Kbd {
            x: parent.width - self.width - Theme.search-padding;
            y: (Theme.search-min-height - self.height) / 2;
            label: root.shortcut-hints[0]; available-width: parent.width / 3;
        }
    }
    for index in 3: Rectangle {
        x: root.width - 180px + index * 48px; y: 36px; width: 36px; height: 40px;
        property <string> label: index == 0 ? (root.layout-locked ? "Unlock layout" : "Lock layout") : index == 1 ? "Settings" : "Close";
        accessible-role: button; accessible-label: self.label;
        accessible-action-default => { top-button.clicked(); }
        border-radius: 10px;
        background: index == 0 && root.layout-locked ? Theme.search-focus-border : top-button.has-hover ? #ffffff10 : transparent;
        Image { x: 8px; y: 10px; width: 20px; height: 20px;
            source: index == 0 ? (root.layout-locked ? @image-url("assets/lock.svg") : @image-url("assets/unlock.svg")) : index == 1 ? @image-url("assets/settings.svg") : @image-url("assets/close.svg"); }
        top-button := TouchArea {
            enabled: !root.busy; mouse-cursor: pointer;
            clicked => {
                if index == 0 { root.cancel-drag(); root.busy = true; root.save-layout-locked(!root.layout-locked); }
                else if index == 1 { root.settings = !root.settings; } else { root.hide-launcher(); }
            }
        }
        if index == 0 && top-button.has-hover: Rectangle {
            x: -72px; y: parent.height + 4px; width: 108px; height: 28px;
            background: Theme.raised; border-radius: 6px;
            Text { text: root.layout-locked ? "Unlock layout" : "Lock layout"; color: Theme.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    VerticalLayout {
        padding-left: 0px; padding-right: 0px; padding-top: 78px; padding-bottom: 134px;
        spacing: 0px;
        if root.banner != "": Text {
            text: root.banner;
            color: white;
            font-size: 15px;
            wrap: word-wrap;
        }
        page := Flickable {
            visible: root.search-text == "" && !root.settings;
            mouse-drag-pan-enabled: false;
            content-width: self.width;
            content-height: max(self.height, grid.height);
            Rectangle {
                x: 0px; y: 0px; width: page.width; height: page.height;
            preview := Rectangle {
                visible: !root.dragging && (root.transitioning || root.page-count > 1);
                opacity: root.transitioning ? 1 : min(1, abs(root.page-drag-offset) / 96px);
                x: (page.width - self.width) / 2 + (root.transitioning
                    ? root.transition-start + (-root.transition-direction * root.page-span - root.transition-start) * root.transition-progress
                    : root.page-drag-offset + (root.page-drag-offset < 0px ? root.page-span : -root.page-span));
                y: root.page-margin * 1px;
                width: page.width - root.page-margin * 2px;
                property <[AppTile]> preview-items: root.transitioning ? root.transition-items
                    : (root.page-drag-offset < 0px ? root.next-items : root.previous-items);
                property <int> columns: max(1, floor(self.width / 1px));
                property <length> tile-size: 1px;
                property <int> rows: max(1,floor((page.height - root.page-margin * 2px) / self.tile-size));
                height: max(page.height - root.page-margin * 2px, ceil((self.preview-items.length) / self.columns) * self.tile-size);
                border-width: 0px;
                border-color: transparent;
                border-radius: 24px;
                background: #324d6b1A;
                for index in preview.preview-items.length: PageTile {
                    property <int> position: preview.preview-items[index].row * preview.columns + preview.preview-items[index].col;
                    visible: self.position >= 0 && !preview.preview-items[index].pinned;
                    x: mod(self.position, preview.columns) * preview.tile-size + 8px;
                    y: floor(self.position / preview.columns) * preview.tile-size + 8px;
                    width: root.item-size * 1px; height: self.width;
                    items: preview.preview-items;
                    index: index;
                    animate x { duration: 120ms; easing: ease-out; }
                    animate y { duration: 120ms; easing: ease-out; }
                }
            }
            grid := Rectangle {
                x: (root.drag-on-page ? (1 - root.drag-slide) * root.drag-slide-direction * root.page-span : 0px) + (page.width - self.width) / 2 + (root.transitioning
                    ? root.transition-start + (-root.transition-direction * root.page-span - root.transition-start) * root.transition-progress + root.transition-direction * root.page-span
                    : root.page-drag-offset);
                y: root.page-margin * 1px;
                width: page.width - root.page-margin * 2px;
                property <[AppTile]> display-items: root.drag-on-page ? root.drag-items : root.transitioning ? root.transition-incoming-items : root.items;
                property <int> columns: max(1, floor(self.width / 1px));
                property <length> tile-size: 1px;
                property <int> rows: max(1,floor((page.height - root.page-margin * 2px) / self.tile-size));
                opacity: root.page-dragging || root.transitioning ? 0.88 : 1;
                animate opacity { duration: 100ms; easing: ease-out; }
                height: max(page.height - root.page-margin * 2px, self.rows * self.tile-size);
                border-width: 0px;
                border-color: transparent;
                border-radius: 24px;
                background: #324d6b1A;
                for index in grid.display-items.length: PageTile {
                    property <bool> source-here: root.dragging && index < grid.display-items.length && grid.display-items[index].id == root.drag-item.id;
                    property <int> position: grid.display-items[index].row * grid.columns + grid.display-items[index].col;
                    visible: self.position >= 0 && !grid.display-items[index].pinned;
                    x: mod(self.position, grid.columns) * grid.tile-size + root.grid-gap * 0.5px;
                    y: floor(self.position / grid.columns) * grid.tile-size + root.grid-gap * 0.5px;
                    width: index < grid.display-items.length ? grid.display-items[index].span-x * grid.tile-size - root.grid-gap * 1px : root.item-size * 1px;
                    height: index < grid.display-items.length ? grid.display-items[index].span-y * grid.tile-size - root.grid-gap * 1px : root.item-size * 1px;
                    opacity: self.source-here ? 0.2 : 1;
                    items: grid.display-items; index: index;
                    ticktick-scroll-offset: index < grid.display-items.length && !grid.display-items[index].ticktick-next && root.ticktick-scroll-widget-id == grid.display-items[index].id ? root.ticktick-scroll-offset : 0px;
                    ticktick-total-count: index < grid.display-items.length && grid.display-items[index].ticktick && !grid.display-items[index].ticktick-next
                        ? root.ticktick-task-count(root.ticktick-tasks,grid.display-items[index].ticktick-project-id,root.ticktick-show-completed) : 0;
                    property <int> ticktick-scroll-row: floor(self.ticktick-scroll-offset / 36px);
                    ticktick-scroll-shift: self.ticktick-scroll-offset - self.ticktick-scroll-row * 36px;
                    ticktick-tasks: index < grid.display-items.length && grid.display-items[index].ticktick
                        ? root.ticktick-visible-tasks(root.ticktick-tasks,grid.display-items[index].ticktick-next ? "@today" : grid.display-items[index].ticktick-project-id,grid.display-items[index].ticktick-next ? false : root.ticktick-show-completed,
                            self.ticktick-scroll-row,
                            grid.display-items[index].ticktick-next ? 1 : max(0,floor((self.height - 68px) / 36px)) + 1) : [];
                    ticktick-next-completion-sequence: root.ticktick-next-completion-sequence;
                    ticktick-focus-scroll: root.ticktick-focus-scroll;
                    ticktick-list-name: index < grid.display-items.length && grid.display-items[index].ticktick
                        ? root.ticktick-list-name(root.ticktick-projects,grid.display-items[index].ticktick-next && ticktick-tasks.length > 0 ? ticktick-tasks[0].project-id : grid.display-items[index].ticktick-project-id) : "";
                    ticktick-status: root.ticktick-status; ticktick-connected: root.ticktick-connected; ticktick-refreshing: root.ticktick-refreshing; ticktick-error: root.ticktick-error; ticktick-pulse: root.ticktick-pulse;
                    folder-preview: root.drag-on-page && root.merge-ready && root.merge-target == index;
                    drag-preview-item: root.drag-item;
                    hovered: (root.keyboard-grid && root.focused-item == index) || (root.drag-on-page ? root.merge-target == index : page-input.has-hover && root.page-item-at(page-input.absolute-position.x + page-input.mouse-x, page-input.absolute-position.y + page-input.mouse-y) == index);
                    border-width: 0px;
                    border-color: transparent;
                    animate border-width { duration: 180ms; easing: ease-out; }
                    animate border-color { duration: 180ms; easing: ease-out; }
                    animate x { duration: root.dragging ? 200ms : 0ms; easing: ease-out; }
                    animate y { duration: root.dragging ? 200ms : 0ms; easing: ease-out; }
                }
            }
            if root.drag-on-page && !root.resizing && root.merge-target < 0 && !root.on-dock && root.drop-target >= 0: Rectangle {
                x: grid.x + mod(root.drop-target,grid.columns) * grid.tile-size + root.grid-gap * 0.5px;
                y: grid.y + floor(root.drop-target/grid.columns) * grid.tile-size + root.grid-gap * 0.5px;
                width: root.drag-item.span-x * grid.tile-size - root.grid-gap * 1px; height: root.drag-item.span-y * grid.tile-size - root.grid-gap * 1px;
                border-width: 3px; border-radius: 8px;
                border-color: root.placement-valid && root.reorder-ready ? #71ddcf : #ee9a8b;
                background: root.placement-valid && root.reorder-ready ? #71ddcf18 : #ee9a8b18;
            }
            if root.placing-widget >= 0 && root.widget-placement-target >= 0: Rectangle {
                x: grid.x + mod(root.widget-placement-target,grid.columns) * grid.tile-size + root.grid-gap * 0.5px;
                y: grid.y + floor(root.widget-placement-target/grid.columns) * grid.tile-size + root.grid-gap * 0.5px;
                width: root.placing-width * grid.tile-size - root.grid-gap * 1px;
                height: root.placing-height * grid.tile-size - root.grid-gap * 1px;
                border-width: 3px; border-radius: 12px;
                border-color: root.widget-placement-valid ? #71ddcf : #ee9a8b;
                background: root.widget-placement-valid ? #71ddcf30 : #ee9a8b30;
            }
