        }
        if root.resizing {
            if root.resize-valid && (root.resize-width != root.drag-item.span-x || root.resize-height != root.drag-item.span-y) { root.busy = true; root.resize-item(root.drag-item.id,root.resize-width,root.resize-height); }
            root.cancel-drag(); return;
        }
        if root.ticktick-control-pressed {
