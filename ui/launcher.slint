    function move-page-swipe(x: length, y: length) {
        let horizontal = x - root.page-swipe-start;
        let vertical = y - root.page-swipe-start-y;
        if max(abs(horizontal), abs(vertical)) < 8px && !root.page-dragging { return; }
        if !root.page-dragging { root.page-vertical = abs(vertical) > abs(horizontal); }
        let dx = root.page-vertical ? vertical : horizontal;
        root.page-dragging = true;
        let boundary = root.page-vertical ? root.vertical-page(dx < 0px ? 1 : -1) < 0
            : root.current-page >= root.page-count || (dx > 0px && root.current-page == 0)
                || (dx < 0px && root.current-page == root.page-count - 1);
