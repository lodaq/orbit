                                    let local-x = x - (grid.absolute-position.x + root.items[index].col * grid.tile-size + root.grid-gap * 0.5px);
                                    let tile-width = root.items[index].span-x * grid.tile-size - root.grid-gap * 1px;
                                    let local-y = y - tile-y;
