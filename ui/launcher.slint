                                full-width: true; available-width: root.sheet-content-width;
                                enabled: !root.busy;
                                clicked => {
                                    root.busy = true;
                                    root.sheet-operation = "refreshing";
                                    root.sheet-status = "Refreshing… Cached apps stay available.";
                                    root.refresh-installed-apps();
                                }
                            }
                            Text {
                                text: root.installed-status == "" ? (root.installed-apps-loaded ? "0 apps · Cached inventory" : "No cached apps. Refresh installed apps.") : root.installed-status;
                                color: Theme.secondary;
                                font-size: 12px;

                            }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    text <=> root.installed-filter;
                                    placeholder-text: "Filter installed apps";
                                    enabled: !root.busy;
                                    min-height: 40px;
                                    preferred-height: 40px;
                                    horizontal-stretch: 1;
                                    edited(text) => { root.filter-installed-apps(text); }
                                }
                                AddOption { label: "Clear filter"; enabled: root.installed-filter != "" && !root.busy; clicked => { root.installed-filter = ""; root.filter-installed-apps(""); } }
