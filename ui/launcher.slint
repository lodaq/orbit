    in-out property <string> website-preview-url;
    function website-url-changed() {
        root.url-error = "";
        if root.website-auto-icon {
            root.website-preview-url = "";
            root.icon-preview-present = false;
            root.icon-value = "";
            root.icon-letter = "";
            root.website-icon-loading = root.valid-url(root.url-or-path);
            root.website-icon-status = root.website-icon-loading ? "Fetching icon…" : "Enter a URL to preview its icon.";
        }
    }
    Timer {
        interval: 400ms;
        running: root.sheet && root.item-type == "Website" && root.website-auto-icon && root.valid-url(root.url-or-path) && root.website-preview-url != root.url-or-path;
        triggered => {
            root.website-preview-url = root.url-or-path;
            root.website-icon-loading = true;
            root.preview-website-icon(root.url-or-path);
        }
    }
