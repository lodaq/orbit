            x: root.activated-prefix-name == "" ? 45px : 53px + root.activated-prefix-width;
            y: Theme.search-padding;
            width: max(40px, parent.width - self.x - Theme.search-padding - (search-hint.width > 0px ? search-hint.width + Theme.space-4 : 0px));
            height: parent.height - 2 * Theme.search-padding;
            content-width: self.width;
            content-height: max(self.height, max(search-measure.preferred-height + 2 * Theme.search-cursor-inset, search-input.y + root.search-cursor-y + root.search-cursor-height + Theme.search-cursor-inset));
            search-input := TextInput {
                x: Theme.search-cursor-inset; y: Theme.search-cursor-inset;
                // Text wraps before the reserved block width, so the full cursor fits.
                width: parent.width - root.search-cursor-width - 2 * Theme.search-cursor-inset;
                height: max(search-scroll.height - self.y, search-measure.preferred-height + Theme.search-cursor-inset);
                text <=> root.search-text; color: Theme.text; font-size: Theme.search-font-size; vertical-alignment: top;
                horizontal-alignment: root.text-is-rtl(self.text) ? right : left;
                single-line: false; wrap: word-wrap;
                cursor-position-changed(point) => {
                    root.search-edit-generation += 1;
                    root.search-cursor-x = point.x;
                    root.search-cursor-y = point.y;
                    let top = self.y + point.y + search-scroll.content-y;
                    let bottom = top + root.search-cursor-height;
                    if top < Theme.search-cursor-inset {
                        search-scroll.content-y = min(0px, Theme.search-cursor-inset - self.y - point.y);
                    } else if bottom > search-scroll.height - Theme.search-cursor-inset {
                        search-scroll.content-y = max(search-scroll.height - search-scroll.content-height, search-scroll.height - Theme.search-cursor-inset - self.y - point.y - root.search-cursor-height);
                    }
