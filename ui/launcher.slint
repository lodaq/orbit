    pure callback match-prefix(string) -> PrefixMatch;
    pure callback action-index-for-id(string) -> int;
    function activate-prefix() {
        let matched = root.match-prefix(root.search-text);
        let has-match = matched.action-id != "";
        root.activated-prefix-id = matched.action-id;
        root.activated-prefix-name = matched.name;
        root.activated-prefix-width = min(132px, max(52px, matched.badge-width * 1px));
        if has-match {
            root.search-text = matched.query;
            root.search(root.search-text);
            root.search-selection = 0;
            root.search-offset = 0px;
            search-input.focus();
            search-input.set-selection-offsets(matched.query-length, matched.query-length);
        }
    }
    callback run-activated-prefix();
    run-activated-prefix => {
        if root.busy { return; }
        if root.activated-prefix-id != "" {
            root.busy = true;
            root.run-prefix(root.activated-prefix-id, root.search-text);
        } else { root.activate-search-selection(); }
    }
