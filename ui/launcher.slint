            width: min(520px,parent.width - 48px); height: min(400px,parent.height - 48px);
            VerticalLayout { padding: 24px; spacing: 16px;
                SettingsTitle { text: root.annotation-kind == 1 ? "Note" : "Text"; }
                SettingsField { text <=> root.annotation-text; multiline: true; accept-newlines: true; autofocus: true; multiline-height: 190px; label: "Content"; placeholder: "Write here"; error: root.annotation-error; }
                HorizontalLayout {
                    SettingsButton { label: "Cancel"; clicked => { root.annotation-editor = false; } }
                    Rectangle { horizontal-stretch: 1; }
                    SettingsButton { label: "Save"; primary: true; enabled: root.annotation-text != "" && !root.busy; clicked => {
                        root.busy = true; root.save-annotation(root.annotation-id,root.annotation-text,root.annotation-kind,root.ink-color,root.text-size,root.ink-opacity,root.annotation-x,root.annotation-y);
                    } }
