import { Theme } from "theme.slint";
import { AddOption, AddField } from "controls.slint";
import "fonts/Inter.ttf";
import { Button, LineEdit, Palette } from "std-widgets.slint";

export struct FolderPreview {
    icon: image,
    icon-present: bool,
    letter: string,
}

export struct AppTile {
    text-icon: bool,
    id: string,
    name: string,
    page: int,
    index: int,
    folder-app-index: int,
    pinned: bool,
    artwork: string,
    letter: string,
    icon: image,
    command: string,
    url: string,
    path: string,
    icon-value: string,
    custom: bool,
    icon-present: bool,
    app: bool,
    website: bool,
    file: bool,
    directory: bool,
    folder: bool,
    preview-icons: [FolderPreview],
}

export struct InstalledAppTile {
    id: string,
    name: string,
    letter: string,
    icon: image,
    icon-present: bool,
}

export struct ActionChoice {
    id: string,
    name: string,
}

component ItemIcon inherits Rectangle {
    in property <AppTile> item;
    in property <bool> dock;
    background: transparent;
    border-radius: self.width * 0.25;
    Image {
        width: parent.width; height: parent.height;
        source: item.text-icon ? @image-url("assets/letter.svg") : dock && item.artwork == "website" ? @image-url("assets/dock-website.svg")
            : dock && item.artwork == "file" ? @image-url("assets/dock-file.svg")
            : dock && item.artwork == "command" ? @image-url("assets/dock-command.svg")
            : dock && item.artwork == "directory" ? @image-url("assets/dock-directory.svg")
            : dock && item.artwork == "browser" ? @image-url("assets/dock-browser.svg")
            : item.artwork == "action" ? @image-url("assets/action.svg")
            : item.icon-present ? item.icon
            : item.website ? @image-url("assets/website.svg")
            : item.file ? @image-url("assets/file.svg")
            : item.directory ? @image-url("assets/directory.svg")
            : item.folder ? @image-url("assets/folder-empty.svg")
            : @image-url("assets/letter.svg");
        image-fit: contain;
    }
    if (item.app || item.text-icon) && !item.icon-present && item.artwork != "action": Text { text: item.letter; color: #e0e5ff; font-size: parent.width * (item.text-icon ? 0.32 : 0.4); horizontal-alignment: center; vertical-alignment: center; }
    if item.folder && item.preview-icons.length == 0: Text {
        text: "Empty"; color: #e0e5ff; font-size: parent.width * 0.16;
        horizontal-alignment: center; vertical-alignment: center;
    }
    for index in item.preview-icons.length: Rectangle {
        x: parent.width * (mod(index, 2) == 0 ? 0.16 : 0.55);
        y: parent.height * (index < 2 ? 0.16 : 0.55);
        width: parent.width * 0.29; height: self.width;
        border-radius: self.width * 0.22; background: #8597dc;
        if item.preview-icons[index].icon-present: Image {
            width: parent.width; height: parent.height;
            source: item.preview-icons[index].icon; image-fit: contain;
        }
        if !item.preview-icons[index].icon-present: Image {
            width: parent.width; height: parent.height;
            source: @image-url("assets/letter.svg"); image-fit: contain;
        }
        if !item.preview-icons[index].icon-present: Text {
            text: item.preview-icons[index].letter; color: #eef1ff;
            font-size: parent.width * 0.56;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
}

component PageTile inherits Rectangle {
    in property <[AppTile]> items;
    in property <int> index;
    in property <bool> hovered;
    width: 128px;
    height: 128px;
    background: hovered ? #ffffff16 : #51405f99;
    border-radius: 20px;
    border-width: 1px;
    border-color: index < items.length ? #a6b1ed33 : transparent;
    Rectangle {
        x: (parent.width - self.width) / 2; y: 12px;
        width: 80px; height: 80px;
        border-radius: 20px;
        if index < items.length: ItemIcon { width: 80px; height: 80px; item: items[index]; }
        if index == items.length: Image { width: 80px; height: 80px; source: @image-url("assets/add.svg"); }
    }
    Text {
        y: 100px;
        width: parent.width;
        height: 24px;
        text: index == items.length ? "Add" : items[index].name;
        color: #e0e3f4;
        font-size: 14px;
        horizontal-alignment: center;
        overflow: elide;
    }
}

component DockTile inherits Rectangle {
    in property <AppTile> item;
    in property <bool> enabled;
    in property <bool> recent;
    callback open();
    callback context-menu(bool, string, length, length);
    height: 82px;
    border-radius: 20px;
    background: dock-touch.has-hover ? #ffffff0b : transparent;
    ItemIcon { x: (parent.width - 48px) / 2; y: 6px; width: 48px; height: 48px; item: item; dock: true; }
    Text { y: 65px; width: parent.width; height: 16px; text: item.name; color: #e0e3f4; font-size: 11px; horizontal-alignment: center; overflow: elide; }
    dock-touch := TouchArea {
        mouse-cursor: pointer; enabled: root.enabled;
        clicked => { root.open(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.context-menu(root.recent, root.item.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

export component Launcher inherits Window {
    pure callback first-letter(string) -> string;
    pure callback valid-name(string) -> bool;
    pure callback valid-command(string) -> bool;
    pure callback valid-url(string) -> bool;
    in property <string> monitor-name;
    in property <float> cursor-x;
    in property <float> cursor-y;
    in-out property <bool> launcher-visible;
    in-out property <string> banner;
    in property <int> page-count: 1;
    in property <int> current-page;
    in property <[AppTile]> items;
    in property <[AppTile]> previous-items;
    in property <[AppTile]> next-items;
    in property <[AppTile]> dock-items;
    in property <[AppTile]> recent-items;
    in property <[AppTile]> search-results;
    in property <[string]> file-search-paths;
    in property <[string]> directory-search-paths;
    in-out property <string> search-text;
    private property <bool> settings;
    private property <bool> search-path-editor;
    private property <bool> search-path-directory;
    private property <int> search-path-index: -1;
    private property <string> search-path-draft;
    callback search(string);
    callback save-search-path(bool, int, string);
    callback delete-search-path(bool, int);
    callback finish-search-path-save();
    callback open-result(int, int);
    callback open-dock-item(int, int, int);
    callback pin-item(int);
    callback unpin-dock-item(string);
    callback remove-recent-item(string);
    out property <bool> search-focused: search-input.has-focus;
    callback focus-search();
    callback page-key(int);
    focus-search => { if !root.sheet && !root.folder-open && root.context-index < 0 && root.dock-context == "" { root.settings = false; search-input.focus(); } }
    page-key(direction) => { if !root.sheet && !root.folder-open && root.search-text == "" && !root.settings && root.context-index < 0 && root.dock-context == "" { root.change-page(root.current-page + direction); } }

    in property <[InstalledAppTile]> installed-apps;
    in property <[ActionChoice]> actions;
    in property <string> installed-status;
    in property <bool> installed-apps-loaded;
    in property <bool> installed-apps-match;
    in property <[AppTile]> folder-items;
    in property <string> folder-name;
    in-out property <int> folder-index: -1;
    in-out property <bool> folder-open;
    private property <bool> folder-closing;
    in-out property <bool> busy;
    private property <bool> sheet;
    private property <bool> alert;
    in-out property <bool> picker;
    private property <int> context-index: -1;
    private property <string> dock-context;
    private property <string> context-id;
    private property <int> editing: -1;
    private property <string> app-name;
    private property <string> command;
    private property <string> url-or-path;
    private property <string> item-type: "App";
    in-out property <string> icon-value;
    in-out property <string> svg-draft;
    in-out property <string> letter-draft;
    in-out property <string> icon-file-draft;
    in-out property <string> icon-mode: "Letter";
    in-out property <image> icon-preview;
    in-out property <bool> icon-preview-present;
    in-out property <string> icon-letter;
    in-out property <bool> icon-busy;
    in-out property <int> icon-session;
    callback open-icon(string, string);
    callback save-icon(string, string, int);
    callback choose-icon(int);

    private property <length> context-x;
    private property <length> context-y;
    private property <length> page-drag-offset;
    private property <bool> page-dragging;
    private property <length> page-span: page.width + 24px;
    private property <[AppTile]> transition-items;
    private property <[AppTile]> transition-incoming-items;
    private property <bool> transitioning;
    private property <int> transition-direction;
    private property <length> transition-start;
    private property <float> transition-progress;
    private property <duration> transition-duration: max(90ms, 170ms * (1 - abs(root.transition-start) / root.page-span));
    private property <bool> custom: true;
    private property <string> app-source: "Custom command";
    private property <length> sheet-content-width: min(520px, max(220px, root.width - 68px));
    private property <string> installed-filter;
    in-out property <string> sheet-status;
    in-out property <string> sheet-operation;
    private property <string> name-error;
    private property <string> command-error;
    private property <string> url-error;
    private property <string> path-error;
    in-out property <string> icon-error;
    private property <string> custom-name-draft;
    private property <string> custom-command-draft;
    private property <string> website-name-draft;
    private property <string> website-url-draft;
    private property <string> folder-name-draft;
    private property <bool> dragged;
    private property <bool> drag-click;
    private property <int> drag-index: -1;
    private property <AppTile> drag-item;
    private property <int> drag-view-page: -1;
    private property <length> drag-page-offset;
    private property <bool> drop-pending;
    private property <[AppTile]> drag-view-items;
    private property <int> drop-target: -1;
    private property <length> drag-x;
    private property <length> drag-y;
    private property <bool> settling;
    private property <AppTile> settling-item;
    private property <length> settle-x;
    private property <length> settle-y;
    private property <int> hover-index: -1;
    private property <bool> folder-ready;
    private property <int> drag-page: -1;
    private property <int> edge-target: -1;
    private property <bool> edge-ready;
    private property <bool> folder-dragged;
    private property <int> folder-drag-index: -1;
    private property <int> folder-drop-target: -1;
    private property <length> folder-drag-x;
    private property <length> folder-drag-y;
    private property <bool> folder-settling;
    private property <AppTile> folder-settling-item;
    private property <length> folder-settle-x;
    private property <length> folder-settle-y;
    callback save-app(int, string, string, string);
    callback add-system-action(string);
    callback add-installed-app(string);
    callback refresh-installed-apps();
    callback filter-installed-apps(string);
    callback save-website(int, string, string);
    callback choose-path(bool);
    callback path-chosen(string);
    path-chosen(path) => { root.url-or-path = path; root.path-error = ""; }
    finish-search-path-save => { root.search-path-editor = false; root.search-path-draft = ""; }
    callback save-path(int, string, bool, string);
    callback save-folder(int, string);
    callback cancel-add();
    callback delete-item(int);
    callback open-item(int);
    callback launch-folder-app(int, int);
    callback open-folder(int);
    callback close-folder();
    callback add-page();
    callback drop-item(int, int, int, int, bool);
    callback move-folder-app(int, int, int);
    callback reorder-folder-app(int, int, int);
    callback reset-launcher();
    callback finish-drag();
    callback close-top-layer();
    animate drag-page-offset { duration: 100ms; easing: ease-out; }
    animate page-drag-offset { duration: root.page-dragging ? 0ms : 100ms; easing: ease-out; }
    animate transition-progress { duration: root.transition-duration; easing: ease-out-sine; }
    transition-timer := Timer {
        running: false;
        interval: root.transition-duration + 34ms;
        triggered => {
            root.transitioning = false;
            root.transition-progress = 0;
            root.transition-items = [];
            root.transition-incoming-items = [];
            self.running = false;
        }
    }
    folder-timer := Timer {
        running: false;
        interval: 500ms;
        triggered => { root.folder-ready = true; self.running = false; }
    }
    edge-timer := Timer {
        running: false;
        interval: 500ms;
        triggered => {
            if root.edge-target == root.drag-page {
                root.drag-view-page = -1;
                root.drag-page-offset = 0px;
            } else {
                root.drag-view-page = root.edge-target;
                root.drag-view-items = root.edge-target > root.drag-page ? root.next-items : root.previous-items;
                root.drag-page-offset = root.edge-target > root.drag-page ? -root.page-span : root.page-span;
            }
            root.edge-ready = true;
            self.running = false;
        }
    }
    settle-timer := Timer {
        running: false;
        interval: 140ms;
        triggered => { root.settling = false; self.running = false; }
    }
    folder-settle-timer := Timer {
        running: false;
        interval: 140ms;
        triggered => { root.folder-settling = false; self.running = false; }
    }
    folder-close-timer := Timer {
        running: false;
        interval: 220ms;
        triggered => { root.folder-closing = false; self.running = false; }
    }
    function close-folder-view() {
        root.folder-open = false;
        root.folder-closing = true;
        folder-close-timer.start();
        root.close-folder();
    }
    function move-folder-out(x: length, y: length) {
        let column = floor((x - grid.absolute-position.x) / grid.tile-size);
        let row = floor((y - grid.absolute-position.y) / grid.tile-size);
        let target = min(root.items.length, max(0, row * grid.columns + column));
        root.folder-settling-item = root.folder-items[root.folder-drag-index];
        root.folder-settling = true;
        root.folder-settle-x = grid.absolute-position.x + mod(target, grid.columns) * grid.tile-size + (grid.tile-size - 64px) / 2;
        root.folder-settle-y = grid.absolute-position.y + floor(target / grid.columns) * grid.tile-size + (grid.tile-size - 64px) / 2;
        folder-settle-timer.start();
        root.busy = true;
        root.move-folder-app(root.folder-index, root.folder-drag-index, target);
        root.folder-drag-index = -1;
        root.folder-drop-target = -1;
        root.close-folder-view();
    }
    page-focus := FocusScope { width: 0px; height: 0px; }
    finish-drag => {
        if !root.drop-pending { return; }
        root.drag-view-page = -1;
        root.drag-view-items = [];
        root.drag-page-offset = 0px;
        root.drop-target = -1;
        root.drop-pending = false;
    }
    reset-launcher => {
        if root.folder-open { root.close-folder(); }
        root.page-dragging = false;
        root.page-drag-offset = 0px;
        root.drag-index = -1;
        root.drag-view-page = -1;
        root.drag-view-items = [];
        root.drop-pending = false;
        root.drag-page-offset = 0px;
        root.drop-target = -1;
        root.dragged = false;
        root.drag-click = false;
        root.settling = false;
        settle-timer.stop();
        root.folder-settling = false;
        folder-settle-timer.stop();
        root.folder-closing = false;
        folder-close-timer.stop();
        root.transitioning = false;
        root.transition-items = [];
        root.transition-incoming-items = [];
        transition-timer.stop();
        page.content-x = 0px;
        root.search-text = "";
        root.settings = false;
        root.search-path-editor = false;
        root.sheet = false;
        root.alert = false;
        root.picker = false;
        root.sheet-status = "";
        root.sheet-operation = "";
        root.name-error = "";
        root.command-error = "";
        root.url-error = "";
        root.path-error = "";
        root.icon-error = "";
        root.context-index = -1;
        root.dock-context = "";
        root.context-id = "";
        root.folder-open = false;
        search-input.focus();
    }
    close-top-layer => {
        if root.picker { root.icon-session += 1; root.icon-busy = false; root.picker = false;  }
        else if root.alert { root.alert = false; }
        else if root.sheet {
            root.cancel-add();
            root.sheet = false;
            root.busy = false;
            root.sheet-operation = "";
            root.sheet-status = "";
            page-focus.focus();
        }
        else if root.context-index >= 0 || root.dock-context != "" { root.context-index = -1; root.dock-context = ""; }
        else if root.folder-open { root.close-folder-view(); }
        else if root.settings && root.search-path-editor { root.search-path-editor = false; }
        else if root.settings { root.settings = false; }
        else if root.search-text != "" { root.search-text = ""; page-focus.focus(); }
        else { root.hide-launcher(); }
    }
    function edit-app(index: int) {
        root.context-index = -1;
        root.dock-context = "";
        root.banner = "";
        root.sheet-status = "";
        root.editing = index;
        root.item-type = "App";
        root.app-name = index < 0 ? "" : root.items[index].name;
        root.url-or-path = "";
        root.command = index < 0 ? "" : root.items[index].command;
        root.icon-value = index < 0 ? "" : root.items[index].icon-value;
        root.icon-preview = root.items[index].icon;
        root.icon-preview-present = index >= 0 && root.items[index].icon-present;
        root.icon-letter = index < 0 ? "" : root.items[index].letter;
        root.custom = index < 0 || root.items[index].custom;
        root.app-source = root.custom ? "Custom command" : "Actions";
        root.installed-filter = "";
        root.sheet = true;

    }
    function edit-folder(index: int) {
        root.context-index = -1;
        root.banner = "";
        root.sheet-status = "";
        root.editing = index;
        root.item-type = "Folder";
        root.app-name = index < 0 ? "" : root.items[index].name;
        root.sheet = true;

    }
    function add-item(kind: string) {
        sheet-scroll.content-x = 0px; sheet-scroll.content-y = 0px;
        root.icon-preview-present = false; root.icon-letter = "";
        if root.sheet {
            root.remember-add-draft();
        } else {
            root.custom-name-draft = "";
            root.custom-command-draft = "";
            root.website-name-draft = "";
            root.website-url-draft = "";
            root.folder-name-draft = "";
            root.installed-filter = "";
        }
        root.editing = -1;
        root.item-type = kind;
        root.custom = true;
        if kind == "App" {
            root.app-source = "Custom command";
            root.app-name = root.custom-name-draft;
            root.command = root.custom-command-draft;
        } else if kind == "Website" {
            root.app-name = root.website-name-draft;
            root.url-or-path = root.website-url-draft;
        } else if kind == "Folder" {
            root.app-name = root.folder-name-draft;
        } else {
            root.url-or-path = "";
        }
        root.icon-value = kind == "Directory" ? "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path fill=\"#777\" d=\"M5 15a5 5 0 0 1 5-5h17l6 7h21a5 5 0 0 1 5 5v26a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5z\"/></svg>" : (kind == "File" ? "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path fill=\"#777\" d=\"M14 5h24l13 13v41H14z\"/><path fill=\"white\" d=\"M38 5v14h13z\"/><path stroke=\"white\" stroke-width=\"3\" d=\"M21 34h23M21 41h23M21 48h17\"/></svg>" : "");
        if kind == "File" || kind == "Directory" {
            root.icon-preview = kind == "File" ? @image-url("assets/file.svg") : @image-url("assets/directory.svg");
            root.icon-preview-present = true;
        }
        root.banner = "";
        root.sheet-status = "";
        root.name-error = "";
        root.command-error = "";
        root.url-error = "";
        root.path-error = "";
        root.icon-error = "";
        root.sheet = true;


    }
    function remember-add-draft() {
        if root.item-type == "App" && root.app-source == "Custom command" {
            root.custom-name-draft = root.app-name;
            root.custom-command-draft = root.command;
        } else if root.item-type == "Website" {
            root.website-name-draft = root.app-name;
            root.website-url-draft = root.url-or-path;
        } else if root.item-type == "Folder" {
            root.folder-name-draft = root.app-name;
        }
    }
    function app-source-changed(source: string) {
        sheet-scroll.content-x = 0px; sheet-scroll.content-y = 0px;
        root.remember-add-draft();
        root.app-source = source;
        root.app-name = root.custom-name-draft;
        root.command = root.custom-command-draft;
        root.sheet-status = "";

    }
    function submit-form() {
        root.name-error = "";
        root.command-error = "";
        root.url-error = "";
        root.path-error = "";
        root.sheet-status = "";
        if (root.item-type == "Folder" || root.item-type == "Website" || (root.item-type == "App" && (root.editing >= 0 || root.app-source == "Custom command"))) && !root.valid-name(root.app-name) {
            root.name-error = "Enter a Name.";
            return;
        }
        if root.item-type == "App" && root.custom && !root.valid-command(root.command) {
            root.command-error = "Enter a Command with closed quotes.";
            return;
        }
        if root.item-type == "Website" && !root.valid-url(root.url-or-path) {
            root.url-error = "Enter a valid HTTP or HTTPS URL.";
            return;
        }
        if (root.item-type == "File" || root.item-type == "Directory") && root.url-or-path == "" {
            root.path-error = "Enter a Path.";
            return;
        }
        root.busy = true;
        root.sheet-operation = "saving";
        if root.item-type == "App" { root.save-app(root.editing, root.app-name, root.command, root.icon-value); }
        else if root.item-type == "Website" { root.save-website(root.editing, root.app-name, root.url-or-path); }
        else if root.item-type == "File" || root.item-type == "Directory" { root.save-path(root.editing, root.url-or-path, root.item-type == "Directory", root.icon-value); }
        else { root.save-folder(root.editing, root.app-name); }
    }
    function edit-item(index: int) {
        if root.items[index].folder { root.edit-folder(index); }
        else if root.items[index].app { root.edit-app(index); }
        else {
            root.context-index = -1;
            root.banner = "";
            root.editing = index;
            root.path-error = "";
            root.item-type = root.items[index].website ? "Website" : (root.items[index].file ? "File" : "Directory");
            root.app-name = root.items[index].name;
            root.url-or-path = root.items[index].website ? root.items[index].url : root.items[index].path;
            root.icon-value = root.items[index].icon-value;
            root.icon-preview = root.items[index].icon;
            root.icon-preview-present = root.items[index].icon-present;
            root.icon-letter = root.items[index].letter;
            root.sheet = true;


        }
    }
    callback open-page(int);
    callback hide-launcher();
    function change-page(index: int) {
        if !root.busy && !root.transitioning && index >= 0 && index < root.page-count && index != root.current-page {
            root.transition-items = root.items;
            root.transition-direction = index > root.current-page ? 1 : -1;
