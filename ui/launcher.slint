    callback confirm-delete-page();
    confirm-delete-page => { if root.current-page < root.page-count && !root.layout-locked && root.page-count > 1 && !root.busy && !root.sheet && !root.folder-open { root.page-delete-confirm = true; } }
    private property <int> search-selection;
    private property <int> search-hover: -1;
    private property <int> search-detail-index: search-hover >= 0 && search-hover < root.search-results.length ? search-hover : search-selection;
    private property <string> search-detail: search-detail-index >= 0 && search-detail-index < root.search-results.length ? (root.search-results[search-detail-index].path != "" ? root.search-results[search-detail-index].path : root.search-results[search-detail-index].url != "" ? root.search-results[search-detail-index].url : root.search-results[search-detail-index].command) : "";
    private property <length> search-offset;
    private property <int> search-columns: max(1, floor(min(1316px, root.width - 96px) / 160px));
    out property <bool> search-navigation: !root.search-context && !root.ai-active && root.search-text != "" && !root.settings && !root.sheet && !root.folder-open && !root.picker && !root.alert && !root.ticktick-open;
    callback move-search-selection(int);
    callback activate-search-selection();
    activate-search-selection => {
        if root.ai-active { return; }
        if root.search-selection >= 0 && root.search-selection < root.search-results.length && !root.busy {
            root.busy = true;
            let result = root.search-results[root.search-selection];
            if result.page == -5 { root.search-web(root.search-text,result.id); }
            else if result.folder-app-index >= 0 { root.open-dock-item(result.page,result.index,result.folder-app-index); }
            else { root.open-result(result.page,result.index); }
        } else if root.search-results.length == 0 && root.search-text != "" && !root.busy {
            root.busy = true;
            root.search-web(root.search-text,"");
        }
    }
    callback search-web(string,string);
    move-search-selection(direction) => {
        if root.ai-active { return; }
        root.search-hover = -1;
        if root.search-results.length == 0 { return; }
        let column = mod(root.search-selection, root.search-columns);
        if direction == 0 && column > 0 { root.search-selection -= 1; }
        if direction == 1 && column < root.search-columns - 1 && root.search-selection + 1 < root.search-results.length { root.search-selection += 1; }
        if direction == 2 && root.search-selection >= root.search-columns { root.search-selection -= root.search-columns; }
        if direction == 3 && root.search-selection + root.search-columns < root.search-results.length { root.search-selection += root.search-columns; }
        let top = floor(root.search-selection / root.search-columns) * 192px;
        let view-height = max(0px, root.height - search-bar.y - search-bar.height - 26px - (english-panel.visible ? english-panel.height + 12px : 0px) - 184px);
        if top < root.search-offset { root.search-offset = top; }
        if top + 180px > root.search-offset + view-height { root.search-offset = top + 180px - view-height; }
    }

