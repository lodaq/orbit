        }
        if root.ticktick-control-pressed {
            if sqrt((x - root.drag-start-x)*(x - root.drag-start-x)/1px/1px + (y - root.drag-start-y)*(y - root.drag-start-y)/1px/1px) < 8 { return; }
            root.ticktick-control-pressed = false;
