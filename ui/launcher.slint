                target-x: search-input.x + root.search-cursor-x;
                target-y: search-input.y + root.search-cursor-y + search-scroll.content-y;
                caret-width: root.search-cursor-width;
                caret-height: root.search-cursor-height;
                active: search-input.cursor-position-byte-offset == search-input.anchor-position-byte-offset;
                edit-generation: root.search-edit-generation;
            }
        }
        if root.activated-prefix-name != "": Rectangle {
            x: 45px; y: (Theme.search-min-height - self.height) / 2; width: root.activated-prefix-width; height: 28px;
            background: Theme.search-prefix-background; border-width: Theme.border-width; border-color: Theme.search-focus-border; border-radius: Theme.radius-control;
            prefix-badge-label := OrbitText { x: 6px; width: parent.width - 12px; height: parent.height; text: root.activated-prefix-name; accessible-label: root.activated-prefix-name; color: Theme.focus; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        }
        search-hint := Kbd {
            x: parent.width - self.width - Theme.search-padding;
            y: (Theme.search-min-height - self.height) / 2;
            label: root.shortcut-hints[0]; available-width: parent.width / 3;
        }
    }
    for index in 3: Rectangle {
        x: root.width - 180px + index * 48px; y: 36px; width: 36px; height: 40px;
        property <string> label: index == 0 ? (root.layout-locked ? "Unlock layout" : "Lock layout") : index == 1 ? "Settings" : "Close";
