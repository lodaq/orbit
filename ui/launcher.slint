            y: floor(index / root.search-columns) * 192px;
            width: parent.width / root.search-columns - 12px; height: 180px;
            background: result-hit.pressed ? Theme.press-overlay : index == root.search-selection ? Theme.selection : result-hit.has-hover ? Theme.hover-overlay : transparent;
            border-width: index == root.search-selection ? 2px : 0px;
            border-color: Theme.focus; border-radius: Theme.radius-widget;
            if item.source != -5: ItemIcon { x: (parent.width - 80px) / 2; y: 10px; width: 80px; height: 80px; item: item; }
            if item.source == -5: Rectangle {
                x: (parent.width - 80px) / 2; y: 10px; width: 80px; height: 80px;
                border-radius: Theme.radius-sheet; clip: true;
                background: item.id == "perplexity" ? #000000 : item.id == "qwant-search" ? #202426 : item.id == "ecosia-search" ? #dceb83 : #ffffff;
                Image {
                    x: 12px; y: 12px; width: 56px; height: 56px; image-fit: contain;
                    source: item.id == "perplexity" ? @image-url("assets/search-engines/perplexity.png")
                        : item.id == "brave-search" ? @image-url("assets/search-engines/brave.png")
                        : item.id == "google-search" ? @image-url("assets/search-engines/google.png")
                        : item.id == "duckduckgo-search" ? @image-url("assets/search-engines/duckduckgo.png")
                        : item.id == "qwant-search" ? @image-url("assets/search-engines/qwant.png")
                        : item.id == "bing-search" ? @image-url("assets/search-engines/bing.svg")
                        : item.id == "startpage-search" ? @image-url("assets/search-engines/startpage.png")
                        : @image-url("assets/search-engines/ecosia.png");
                }
            }
            OrbitText { x: 8px; y: 98px; height: 24px; width: parent.width - 16px; text: item.name; color: Theme.text; font-size: Theme.type-control; horizontal-alignment: center; overflow: elide; }
            if item.source < 0: OrbitText {
                y: 126px; width: parent.width; height: 18px;
                text: item.source == -5 ? (index == 0 ? "Default search engine" : "Search engine") : item.source == -1 ? "Actions" : item.source == -2 ? "Installed apps" : item.source == -3 ? "File" : "Directory";
                color: Theme.secondary; font-size: 11px * Theme.font-scale; horizontal-alignment: center;
            }
            if item.path != "" || item.url != "" || item.command != "": OrbitText {
                x: Theme.space-2; y: 144px; width: parent.width - 2 * Theme.space-2; height: 28px;
                text: item.path != "" ? item.parent-path : item.url != "" ? item.url : item.command;
                color: Theme.secondary; font-size: Theme.type-hint; wrap: word-wrap; overflow: elide;
                horizontal-alignment: center;
            }
            result-hit := TouchArea {
                width: parent.width; height: parent.height;
                mouse-cursor: pointer; enabled: !root.busy;
                changed has-hover => { if self.has-hover { root.search-hover = index; } else if root.search-hover == index { root.search-hover = -1; } }
                pointer-event(event) => {
                    let x = self.absolute-position.x + self.mouse-x;
                    let y = self.absolute-position.y + self.mouse-y;
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right && item.source != -5 {
                        root.search-context-item = item; root.search-context = true; root.context-x = x; root.context-y = y;
                    }
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.search-selection = index;
                        if !root.layout-locked && item.source != -5 { root.begin-search-drag(item,index,x,y); }
                    }
                    if event.kind == PointerEventKind.move && root.drag-from-search { root.move-drag(x,y); }
                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                        if root.drag-from-search { root.move-drag(x,y); root.end-drag(); }
                        else if root.layout-locked || item.source == -5 { root.activate-search-selection(); }
                    }

                }
            }
        }
    }
    if root.search-results-visible && root.search-detail != "": Rectangle {
        x: (root.width - self.width) / 2; y: root.height - 176px;
        width: min(1316px, root.width - 96px); height: 40px;
        background: Theme.field; border-radius: Theme.radius-control;
        OrbitText {
            x: Theme.space-3; width: parent.width - 2 * Theme.space-3; height: parent.height;
            text: root.search-detail; color: Theme.secondary; font-size: Theme.type-hint;
            wrap: word-wrap; overflow: elide; vertical-alignment: center;
        }
    }
    if root.engine-menu && !root.ai-active && !root.script-active: TouchArea { clicked => { root.engine-menu = false; } }
    engine-select := Rectangle {
        x: search-bar.x - self.width - Theme.space-3; y: search-bar.y + (Theme.search-min-height - self.height) / 2;
        width: root.width < 1200px ? 104px : 128px; height: Theme.control-height; visible: !root.settings && !root.ai-active && !root.script-active;
        accessible-role: combobox; accessible-label: "Default search engine";
        accessible-value: root.search-engine-names[root.default-search-engine-index];
        accessible-enabled: !root.busy;
        accessible-action-expand => { if !root.busy { root.engine-menu = !root.engine-menu; } }
        forward-focus: engine-focus;
        engine-focus := FocusScope {
            enabled: !root.busy;
            key-pressed(event) => {
                if event.text == " " || event.text == "\n" { root.engine-menu = !root.engine-menu; return accept; }
                reject;
            }
        }
        background: engine-select-hit.pressed ? Theme.press-overlay : engine-select-hit.has-hover ? Theme.hover-overlay : Theme.search-background;
        border-radius: Theme.radius-control; border-width: engine-focus.has-focus ? Theme.focus-width : 0px; border-color: Theme.focus;
        OrbitText { x: Theme.space-3; width: parent.width - 40px; height: parent.height; text: root.search-engine-names[root.default-search-engine-index]; color: Theme.text; font-size: Theme.type-control; vertical-alignment: center; overflow: elide; }
        OrbitText { x: parent.width - 28px; height: parent.height; text: "⌄"; color: Theme.secondary; vertical-alignment: center; }
        engine-select-hit := TouchArea { enabled: !root.busy; mouse-cursor: pointer; clicked => { root.engine-menu = !root.engine-menu; } }
    }
    if root.engine-menu && !root.settings && !root.ai-active && !root.script-active: Rectangle {
        x: engine-select.x; y: engine-select.y + engine-select.height + 6px;
        width: max(154px, engine-select.width); height: min(root.search-engine-names.length * 36px + 38px, root.height - self.y - 24px);
        background: Theme.sheet; border-width: Theme.border-width; border-color: Theme.border; border-radius: Theme.radius-preview;
        drop-shadow-color: Theme.surface-shadow; drop-shadow-blur: Theme.surface-shadow-blur; drop-shadow-offset-y: Theme.space-2;
        Flickable {
            x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
            content-width: self.width; content-height: root.search-engine-names.length * 36px + 26px;
            VerticalLayout {
                width: parent.width; spacing: 2px;
                OrbitText { x: 10px; height: 24px; text: "Search engine"; color: Theme.secondary; font-size: Theme.type-hint; vertical-alignment: center; }
                for name[index] in root.search-engine-names: MenuOption {
                    height: 34px; width: parent.width; label: name;
                    selected: index == root.default-search-engine-index;
                    trailing: self.selected ? "✓" : ""; enabled: !root.busy;
                    clicked => { root.engine-menu = false; root.busy = true; root.save-default-search-engine(index); }
                }
            }
        }
    }
    if root.ai-active && !root.settings: Panel {
        x: search-bar.x; y: search-bar.y + search-bar.height + Theme.space-4;
        width: search-bar.width;
        height: min(root.height - self.y - 156px, root.ai-answer == "" ? 240px : max(280px, min(640px, ai-answer-measure.preferred-height + 184px)));
        background: Theme.sheet; border-width: Theme.border-width;
        border-color: Theme.border; border-radius: Theme.radius-sheet;
        ai-answer-measure := OrbitText {
            visible: false; width: parent.width - 4 * Theme.space-4;
            text: root.ai-answer; font-size: Theme.search-font-size; wrap: word-wrap;
        }
        VerticalLayout {
            padding: Theme.space-4; spacing: Theme.space-4;
            HorizontalLayout { spacing: Theme.space-2; vertical-stretch: 0;
                SettingsSelect { label: "AI provider"; width: 128px; model: root.ai-providers; current-index <=> root.ai-provider; selected => { root.save-ai(); } }
                if root.ai-provider == 0 && root.ai-local-models.length > 0: SettingsSelect { label: "AI model"; width: max(100px, parent.width - 228px); model: root.ai-local-models; current-index <=> root.ai-local-index; selected => { root.ai-local-model = root.ai-local-models[root.ai-local-index]; root.save-ai(); } }
                if root.ai-provider == 0 && root.ai-local-models.length == 0: OrbitText { text: root.ai-local-model; color: Theme.secondary; font-size: Theme.type-control; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                if root.ai-provider == 1: AddField { accessible-name: "OpenAI model ID"; placeholder: "Model ID"; text <=> root.ai-openai-model; accepted => { root.save-ai(); } }
                if root.ai-provider == 2: AddField { accessible-name: "Gemini model ID"; placeholder: "Model ID"; text <=> root.ai-gemini-model; accepted => { root.save-ai(); } }
                AddOption { label: "Settings"; option-width: 84px; clicked => { root.settings-tab = 6; root.settings = true; } }
            }
            Rectangle { height: Theme.border-width; background: Theme.border; }
            Rectangle {
                vertical-stretch: 1;
                background: Theme.field; border-radius: Theme.radius-control;
                if root.ai-answer == "": OrbitText {
                    x: Theme.space-4; width: parent.width - 2 * Theme.space-4; height: parent.height;
                    text: root.ai-loading ? "Preparing answer…" : root.ai-status != "" ? root.ai-status : "Enter a prompt above and press Enter.";
                    color: Theme.secondary; font-size: Theme.type-body; wrap: word-wrap;
                    vertical-alignment: center; horizontal-alignment: center;
                }
                ai-answer-scroll := ScrollView {
                    visible: root.ai-answer != "";
                    x: Theme.space-4; y: Theme.space-4;
                    width: parent.width - 2 * Theme.space-4; height: parent.height - 2 * Theme.space-4;
                    horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, ai-answer-field.preferred-height);
                    ai-answer-field := TextInput {
                        width: ai-answer-scroll.visible-width; height: ai-answer-scroll.content-height;
                        horizontal-alignment: TextDirection.is-rtl(self.text) ? right : left;
                        text: root.ai-answer; read-only: true; wrap: word-wrap;
                        color: Theme.text; font-size: Theme.search-font-size;
                        selection-background-color: Theme.selection; selection-foreground-color: Theme.text;
                        accessible-label: "Answer";
                    }
                }
            }
            HorizontalLayout { spacing: Theme.space-2; vertical-stretch: 0;
                AddOption { label: root.ai-loading ? "Cancel" : "Ask"; primary: !root.ai-loading; enabled: root.ai-loading || root.search-text != ""; option-width: 84px; clicked => { if root.ai-loading { root.ai-cancel(); root.ai-status = "Cancelled"; } else { root.save-ai(); root.ai-submit(); } } }
                Rectangle { horizontal-stretch: 1; }
                AddOption { label: "Copy"; option-width: 84px; enabled: root.ai-answer != ""; clicked => { ai-answer-field.select-all(); ai-answer-field.copy(); } }
            }
        }
    }
    if root.settings: Rectangle {
        x: root.settings-outer-margin; y: root.height < 720px ? 88px : 112px;
        width: root.width - 2 * self.x; height: root.height - (root.settings-tab == 7 ? (root.height < 720px ? 104px : 128px) : root.height < 720px ? 104px : 264px);
        background: Theme.settings-bg-panel; border-color: Theme.settings-border-panel; border-width: 1px; border-radius: Theme.settings-r-panel;
        Rectangle {
            x: 1px; y: 1px; width: root.settings-sidebar-width - 1px; height: parent.height - 2px;
            background: Theme.field; border-radius: Theme.settings-r-panel;
        }
        Rectangle { x: root.settings-sidebar-width - 20px; y: 1px; width: 20px; height: parent.height - 2px; background: Theme.field; }
        Rectangle { x: root.settings-sidebar-width; y: 1px; width: 1px; height: parent.height - 2px; background: Theme.settings-border-panel; }
        VerticalLayout {
            x: 16px; y: 28px; width: root.settings-sidebar-width - 32px; height: parent.height - 48px;
            spacing: 4px;
            OrbitText { text: "Settings"; color: Theme.settings-text; font-size: 22px * Theme.font-scale; font-weight: 600; height: 46px; }
            SettingsNav { label: "General"; icon: @image-url("assets/settings.svg"); icon-present: true; available-width: parent.width; selected: root.settings-tab == 0; clicked => { root.settings-tab = 0; root.shortcuts-tab = false; root.shortcut-recording = false; } }
            SettingsNav { label: "Robots"; icon: @image-url("assets/robot.svg"); icon-present: true; available-width: parent.width; clicked => { RobotWorkbench.adding = false; RobotWorkbench.section = 0; RobotWorkbench.refresh-skills(); RobotWorkbench.open("", true); } }
            SettingsNav { label: "Appearance"; icon: @image-url("assets/settings.svg"); icon-present: true; available-width: parent.width; selected: root.settings-tab == 8; clicked => { root.settings-tab = 8; root.shortcuts-tab = false; root.shortcut-recording = false; } }
            SettingsNav { label: "Shortcuts"; icon: @image-url("assets/keyboard.svg"); icon-present: true; available-width: parent.width; selected: root.settings-tab == 1; clicked => { root.settings-tab = 1; root.shortcuts-tab = true; } }
            SettingsNav { label: "Search bar"; icon: @image-url("assets/search.svg"); icon-present: true; available-width: parent.width; selected: (root.settings-tab >= 2 && root.settings-tab <= 6) || root.settings-tab == 10; clicked => { root.settings-tab = 4; root.shortcuts-tab = false; root.shortcut-recording = false; } }
            SettingsNav { label: "Data"; icon: @image-url("assets/add-widgets.svg"); icon-present: true; available-width: parent.width; selected: root.settings-tab == 7; clicked => { root.settings-tab = 7; root.shortcuts-tab = false; root.shortcut-recording = false; root.load-widget-data(); } }
            Rectangle { vertical-stretch: 1; }
            SettingsNav { label: "Back"; icon: @image-url("assets/arrow-left.svg"); icon-present: true; available-width: parent.width; hint: root.shortcut-hints[1]; clicked => { root.search-path-editor = false; root.settings = false; } }
        }
        VerticalLayout {
            x: root.settings-sidebar-width + root.settings-gutter; y: 28px;
            width: root.settings-content-width; height: parent.height - 56px;
            spacing: 20px;
            if root.settings-tab != 7: VerticalLayout { spacing: 6px; vertical-stretch: 0; alignment: start;
                OrbitText { text: root.settings-tab == 9 ? "Providers" : root.settings-tab == 0 ? "General" : root.settings-tab == 1 ? "Shortcuts" : root.settings-tab == 7 ? "Data" : root.settings-tab == 8 ? "Appearance" : "Search bar"; color: Theme.settings-text; font-size: Theme.settings-title-size; font-weight: 600; }
                SettingsDescription { text: root.settings-tab == 9 ? "Your T3 Code provider accounts, shared by Robots. Existing authentication stays in its provider storage." : root.settings-tab == 7 ? "Manage locally saved widget content and see Orbit storage use." : root.settings-tab == 0 ? "Home screen layout, integrations and app data." : root.settings-tab == 1 ? "Choose an action, then record its shortcut. Changes are saved automatically." : root.settings-tab == 2 ? "Prefixes route a token to an action. Type one before your query to use it." : root.settings-tab == 3 ? "Choose an action to edit it, or create a new one." : root.settings-tab == 8 ? "Change the Home Screen background color or image, or restore the supplied background." : "Control how Orbit finds things and where it looks."; }
            }
            if (root.settings-tab >= 2 && root.settings-tab <= 6) || root.settings-tab == 10: GridLayout {
                spacing: 12px;
                SettingsTabGroup { row: 0; col: 0; width: min(4 * Theme.control-option-width + 230px + 24px, root.settings-content-width);
                    SettingsTab { option-width: root.settings-content-width < 800px ? 70px : Theme.control-option-width; label: "General"; selected: root.settings-tab == 4; clicked => { root.settings-tab = 4; } }
                    SettingsTab { option-width: root.settings-content-width < 800px ? 70px : Theme.control-option-width; label: "Prefixes"; selected: root.settings-tab == 2; clicked => { root.settings-tab = 2; } }
                    SettingsTab { option-width: root.settings-content-width < 800px ? 70px : Theme.control-option-width; label: "Actions"; selected: root.settings-tab == 3; clicked => { root.settings-tab = 3; } }
                    SettingsTab { option-width: root.settings-content-width < 800px ? 70px : Theme.control-option-width; label: "Scripts"; selected: root.settings-tab == 10; clicked => { root.settings-tab = 10; } }
                    SettingsTab { label: "AI"; option-width: 60px; selected: root.settings-tab == 6; clicked => { root.settings-tab = 6; } }
                }
                Rectangle { row: 0; col: 1; horizontal-stretch: 1; }
                if root.settings-tab == 3 && !root.action-editor-open: SettingsButton { row: root.settings-content-width < 1000px ? 1 : 0; col: root.settings-content-width < 1000px ? 0 : 2; label: "New action"; option-width: 132px; primary: true; enabled: !root.busy; clicked => { root.action-id-draft = ""; root.action-name-draft = ""; root.action-kind-draft = "Shell"; root.action-source-draft = ""; root.action-description-draft = ""; root.action-tokens-draft = ""; root.action-used = false; root.action-editor-open = true; } }
            }
            settings-body := Flickable {
                width: root.settings-content-width;
                vertical-stretch: 1;
                content-width: self.width;
                content-height: settings-content.preferred-height;
                settings-content := VerticalLayout {
                    width: (root.settings-content-width); height: self.preferred-height; alignment: start; spacing: 20px;
                    if root.banner != "": SettingsDescription { text: root.banner; color: Theme.settings-danger-text; }
            if root.settings-tab == 7: VerticalLayout {
                spacing: 18px;
                HorizontalLayout {
                    spacing: 24px;
                    VerticalLayout {
                        spacing: 6px;
                        OrbitText { text: "Data"; color: Theme.settings-text; font-size: Theme.settings-title-size; font-weight: 600; }
                        SettingsDescription { text: "Saved locally on this device. TickTick tasks are stored separately."; }
                    }
                    VerticalLayout {
                        width: min(560px, root.settings-content-width * 0.52); spacing: 8px;
                        HorizontalLayout {
                            SettingsDescription { text: root.widget-data-summary; color: Theme.settings-text; font-weight: 600; horizontal-stretch: 1; }
                            SettingsDescription { text: "Local storage"; }
                        }
                        Rectangle {
                            height: 8px; border-radius: 4px; background: Theme.settings-bg-control; clip: true;
                            HorizontalLayout { spacing: 2px;
                                for fraction[index] in root.widget-data-storage-fractions: Rectangle {
                                    horizontal-stretch: fraction; background: index == 0 ? Theme.focus : index == 1 ? Theme.settings-success-text : index == 2 ? Theme.text : Theme.secondary;
                                }
                            }
                        }
                        HorizontalLayout { spacing: 12px;
                            for label[index] in root.widget-data-storage-labels: HorizontalLayout { spacing: 6px;
                                Rectangle { width: 10px; height: 10px; border-radius: 3px; background: index == 0 ? Theme.focus : index == 1 ? Theme.settings-success-text : index == 2 ? Theme.text : Theme.secondary; }
                                SettingsDescription { text: label; font-size: Theme.type-hint; }
                            }
                        }
                    }
                }
                data-layout := Rectangle {
                    property <bool> stacked: self.width < 1050px;
                    height: max(420px, root.height - (root.height < 720px ? 104px : 128px) - 146px) + (self.stacked && root.widget-data-editing ? 580px : 0px);
                    Flickable {
                        x: 0px; y: 0px;
                        width: parent.width < 700px ? 160px : 204px; height: parent.height;
                        content-width: self.width; content-height: 11 * 46px + 4 * 30px;
                        VerticalLayout { width: data-layout.width < 700px ? 144px : 188px; height: self.preferred-height; spacing: 2px; alignment: start;
                            for category[index] in ["Quotes", "Facts", "Motivation", "Affirmations", "Vocabulary", "Quran Player", "Azan Reminder", "Morning Remembrances", "Evening Remembrances", "Habits", "Achievements"]: VerticalLayout {
                                property <int> category-id: index < 7 ? index : index < 9 ? index + 2 : index - 2;
                                spacing: 4px;
                                if index == 0 || index == 4 || index == 5 || index == 9: SettingsDescription {
                                    height: 26px; text: index == 0 ? "INSPIRATION" : index == 4 ? "LEARNING" : index == 5 ? "FAITH" : "ROUTINE";
                                    font-size: Theme.type-hint; font-weight: 600; vertical-alignment: center;
                                }
                                SettingsNav {
                                    label: category; trailing: "" + root.widget-data-counts[parent.category-id]; available-width: data-layout.width < 700px ? 144px : 188px;
                                    selected: root.widget-data-category == parent.category-id;
                                    enabled: !root.widget-data-busy;
                                    clicked => { root.widget-data-category = parent.category-id; root.widget-data-editing = false; root.widget-data-page = 0; root.widget-data-search = ""; root.widget-data-delete-id = ""; root.load-widget-data(); }
                                }
                            }
                        }
                    }
                    data-table := SettingsCard {
                        y: 0px;
                        x: parent.width < 700px ? 176px : 224px;
                        width: parent.width - self.x - (!data-layout.stacked && root.widget-data-editing ? min(340px, parent.width * 0.32) + 20px : 0px);
                        height: data-layout.stacked && root.widget-data-editing ? parent.height - 580px : parent.height;
                        background: Theme.settings-bg-inset;
                        VerticalLayout { padding: 1px; spacing: 0px;
                            HorizontalLayout {
                                padding: 16px; spacing: 12px; vertical-stretch: 0;
                                SettingsTitle { text: ["Quotes", "Facts", "Motivation", "Affirmations", "Vocabulary", "Quran Player", "Azan Reminder", "Habits", "Achievements", "Morning Remembrances", "Evening Remembrances"][root.widget-data-category]; vertical-alignment: center; }
                                SettingsField { accessible-name: "Search content or attribution"; placeholder: "Search content or attribution"; text <=> root.widget-data-search; enabled: !root.widget-data-busy; accepted => { root.widget-data-page = 0; root.widget-data-delete-id = ""; root.load-widget-data(); } }
                                SettingsButton { label: "Add entry"; primary: true; enabled: root.widget-data-category != 8 && !root.widget-data-busy; clicked => { root.widget-data-id = ""; root.widget-data-content = ""; root.widget-data-attribution = ""; root.widget-data-resource = ""; root.widget-data-error = ""; root.widget-data-delete-id = ""; root.widget-data-editing = true; } }
                            }
                            Rectangle { height: 1px; background: Theme.separator; }
                            if root.widget-data-error != "" && !root.widget-data-editing: SettingsDescription { text: root.widget-data-error; color: Theme.settings-danger-text; }
                            if root.widget-data-category == 8: SettingsDescription { text: "Achievements are recorded automatically and are read-only."; }
                            ScrollView {
                                horizontal-scrollbar-policy: always-off;
                                VerticalLayout { spacing: 0px; padding: 0px;
                                    if root.widget-data-entries.length == 0: Rectangle {
                                        height: 160px;
                                        SettingsDescription {
                                            x: 24px; width: parent.width - 48px; height: parent.height;
                                            text: root.widget-data-busy ? "Loading local data…" : root.widget-data-search != "" ? "No matching entries. Try another search." : root.widget-data-category == 8 ? "No achievements recorded yet." : "No saved entries. Add an entry to begin.";
                                            horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
                                        }
                                    }
                                    for entry in root.widget-data-entries: Rectangle {
                                        height: 88px;
                                        background: (root.widget-data-editing && root.widget-data-id == entry.id) || root.widget-data-delete-id == entry.id ? Theme.selection : row-hover.has-hover ? Theme.hover-overlay : transparent;
                                        row-hover := TouchArea { enabled: !root.widget-data-busy; }
                                        HorizontalLayout {
                                            padding-left: 16px; padding-right: 16px; spacing: 16px;
                                            VerticalLayout {
                                                alignment: center; spacing: 4px; horizontal-stretch: 1;
                                                OrbitText { text: entry.preview; color: Theme.settings-text; font-size: Theme.type-body; height: 38px; wrap: word-wrap; overflow: elide; }
                                                if entry.attribution != "": OrbitText { text: entry.attribution; color: Theme.settings-text-muted; font-size: Theme.type-hint; overflow: elide; }
                                            }
                                            if root.widget-data-category != 8: VerticalLayout {
                                                width: root.widget-data-delete-id == entry.id ? 216px : root.widget-data-category == 4 && entry.done ? 290px : 168px; alignment: center; spacing: 0px;
                                                if root.widget-data-delete-id != entry.id: HorizontalLayout {
                                                    alignment: end; spacing: 8px;
                                                    if root.widget-data-category == 4 && entry.done: SettingsButton { label: "Undo learned"; option-width: 114px; enabled: !root.widget-data-busy; clicked => { root.restore-widget-word(entry.id); } }
                                                    SettingsButton { label: "Edit"; accessible-label: "Edit " + entry.preview; option-width: 72px; enabled: !root.widget-data-busy; clicked => { root.widget-data-id = entry.id; root.widget-data-content = entry.content; root.widget-data-attribution = entry.attribution; root.widget-data-resource = entry.resource; root.widget-data-error = ""; root.widget-data-editing = true; root.widget-data-delete-id = ""; } }
                                                    SettingsButton { label: "Delete"; accessible-label: "Delete " + entry.preview; option-width: 88px; destructive: true; enabled: !root.widget-data-busy; clicked => { root.widget-data-delete-id = entry.id; } }
                                                }
                                                if root.widget-data-delete-id == entry.id: HorizontalLayout {
                                                    alignment: end; spacing: 8px;
                                                    SettingsButton { label: "Cancel"; option-width: 72px; enabled: !root.widget-data-busy; clicked => { root.widget-data-delete-id = ""; } }
                                                    SettingsButton { label: "Delete entry"; option-width: 128px; destructive: true; enabled: !root.widget-data-busy; clicked => { root.delete-widget-data(entry.id); } }
                                                }
                                            }
                                        }
                                        if root.widget-data-editing && root.widget-data-id == entry.id: Rectangle { x: 0px; y: 0px; width: 3px; height: parent.height; background: Theme.focus; }
                                        Rectangle { y: parent.height - self.height; height: Theme.border-width; background: Theme.separator; }
                                    }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.separator; }
                            HorizontalLayout { padding: 12px; padding-left: 16px; padding-right: 16px; spacing: 12px; vertical-stretch: 0;
                                SettingsDescription { text: root.widget-data-count + " entries"; vertical-alignment: center; horizontal-stretch: 1; }
                                SettingsButton { label: "Previous"; enabled: !root.widget-data-busy && root.widget-data-page > 0; clicked => { root.widget-data-page -= 1; root.load-widget-data(); } }
                                SettingsDescription { text: "Page " + (root.widget-data-page + 1) + " of " + max(1, ceil(root.widget-data-count / 30)); vertical-alignment: center; }
                                SettingsButton { label: "Next"; enabled: !root.widget-data-busy && (root.widget-data-page + 1) * 30 < root.widget-data-count; clicked => { root.widget-data-page += 1; root.load-widget-data(); } }
                            }
                        }
                    }
                    if root.widget-data-editing: SettingsCard {
                        x: data-layout.stacked ? data-table.x : data-table.x + data-table.width + 20px;
                        y: data-layout.stacked ? data-table.height + 20px : 0px;
                        width: data-layout.stacked ? data-table.width : min(340px, parent.width * 0.32);
                        height: data-layout.stacked ? 560px : parent.height;
                        VerticalLayout { padding: 20px; spacing: 12px;
                            SettingsTitle { vertical-stretch: 0; text: root.widget-data-id == "" ? "Add entry" : "Edit entry"; }
                            SettingsField { vertical-stretch: 0; label: "Content"; placeholder: "English, العربية, or mixed content"; multiline: true; multiline-height: 150px; text <=> root.widget-data-content; enabled: !root.widget-data-busy; }
                            SettingsDescription { vertical-stretch: 0; text: root.widget-data-characters(root.widget-data-content) + " / 20,000"; horizontal-alignment: right; }
                            SettingsField { vertical-stretch: 0; label: "Author or source (optional)"; text <=> root.widget-data-attribution; enabled: !root.widget-data-busy; }
                            SettingsDescription { vertical-stretch: 0; text: root.widget-data-characters(root.widget-data-attribution) + (root.widget-data-category == 9 || root.widget-data-category == 10 ? " / 4,000" : " / 500"); horizontal-alignment: right; }
                            if root.widget-data-error != "": SettingsDescription { vertical-stretch: 0; text: root.widget-data-error; color: Theme.settings-danger-text; }
                            if root.widget-data-category == 5 || root.widget-data-category == 6 || root.widget-data-category == 9 || root.widget-data-category == 10: SettingsField { vertical-stretch: 0;
                                label: root.widget-data-category == 5 ? "Local audio file (optional)" : root.widget-data-category == 9 || root.widget-data-category == 10 ? "Repetitions (1–10,000)" : "Schedule date (YYYY-MM-DD)";
                                text <=> root.widget-data-resource; enabled: !root.widget-data-busy;
                            }
                            if root.widget-data-category == 5: SettingsButton { label: "Choose audio"; option-width: 140px; enabled: !root.widget-data-busy; clicked => { root.choose-widget-audio(); } }
                            if root.widget-data-category == 6: SettingsDescription { vertical-stretch: 0; text: "Enter one prayer name and HH:MM time per line. The starter is an example for Cairo; check the location and date."; wrap: word-wrap; }

                            Rectangle { vertical-stretch: 1; }
                            HorizontalLayout {
                                spacing: 12px; alignment: end;
                                SettingsButton { label: "Cancel"; enabled: !root.widget-data-busy; clicked => { root.widget-data-editing = false; } }
                                SettingsButton { label: "Save"; primary: true; enabled: !root.widget-data-busy && root.widget-data-content != ""; clicked => { root.save-widget-data(root.widget-data-id, root.widget-data-content, root.widget-data-attribution,root.widget-data-resource); } }
                            }
                        }
                    }
                }
            }
            if root.settings-tab == 0: Rectangle {
                property <bool> stacked: (root.settings-content-width) < 900px;
                height: self.stacked ? 1160px : max(580px, root.height - 416px);
                SettingsCard {
                    x: 0px; y: 0px;
                    width: parent.stacked ? parent.width : (parent.width - 20px) * 1.3 / 2.3;
                    height: parent.stacked ? 580px : parent.height;
                    VerticalLayout {
                        padding: 22px; spacing: 20px;
                        SettingsTitle { text: "Home screen"; }
                        HorizontalLayout { spacing: 16px;
                            VerticalLayout { spacing: 6px;
                                SettingsDescription { text: "Item gap (px)"; }
                                SettingsStepper { enabled: !root.layout-locked; label: "Item gap"; value <=> root.grid-gap; minimum: 0; maximum: 64; }
                            }
                            VerticalLayout { spacing: 6px;
                                SettingsDescription { text: "Canvas speed (×)"; }
                                SettingsStepper { enabled: !root.layout-locked; label: "Canvas speed"; value <=> root.canvas-speed; minimum: 1; maximum: 10; }
                            }
                        }
                        VerticalLayout { spacing: 6px; vertical-stretch: 0;
                            SettingsDescription { text: "Item size (px)"; }
                            SettingsStepper { enabled: !root.layout-locked; label: "Item size"; value <=> root.item-size; minimum: 80; maximum: 176; step: 8; }
                        }
                        HorizontalLayout { spacing: 10px;
                            SettingsDescription { text: "Font size (px)"; vertical-alignment: center; }
                            SettingsStepper { label: "Font size"; value <=> root.font-size; minimum: 10; maximum: 24; }
                            SettingsButton { label: "Save font"; option-width: max(96px, 96px * Theme.font-scale); clicked => { root.save-font-size(root.font-size); } }
                        }
                        HorizontalLayout { spacing: 10px;
                            SettingsButton { label: "Reset to default"; option-width: 160px; enabled: !root.layout-locked; clicked => { root.item-size = 128; root.grid-gap = 16; root.canvas-speed = 5; root.font-size = 12; root.save-font-size(12); } }
                            SettingsButton { label: "Save"; primary: true; enabled: !root.layout-locked && !root.busy; clicked => { root.busy = true; root.save-appearance(root.item-size, root.grid-gap, root.canvas-speed); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Rectangle { vertical-stretch: 1; }
                        Rectangle {
                            min-height: root.item-size * 1px + 32px;
                            background: Theme.settings-bg-inset; border-color: Theme.settings-border-panel; border-width: 1px; border-radius: Theme.settings-r-pill;
                            HorizontalLayout { padding: 16px; spacing: 16px;
                                if root.items.length > 0: ItemTile { width: root.item-size * 1px; height: self.width; items: root.items; index: 0; }
                                VerticalLayout { spacing: 4px; alignment: center;
                                    SettingsTitle { text: "Live preview" + (root.items.length > 0 ? " · " + root.items[0].name : ""); wrap: word-wrap; }
                                    SettingsDescription { text: "Free placement on the Canvas. Back cancels unsaved sizing."; }
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    x: parent.stacked ? 0px : (parent.width - 20px) * 1.3 / 2.3 + 20px;
                    y: parent.stacked ? 600px : 0px;
                    width: parent.stacked ? parent.width : (parent.width - 20px) / 2.3;
                    height: parent.stacked ? 500px : parent.height;
                    spacing: 20px;
                    SettingsCard {
                        height: max(256px, account-content.preferred-height);
                        account-content := VerticalLayout { padding: 22px; spacing: 14px;
                            HorizontalLayout {
                                SettingsTitle { text: "TickTick account"; }
                                Rectangle { horizontal-stretch: 1; }
                                Rectangle {
                                    width: root.ticktick-connected ? 100px : 124px; height: 24px; border-radius: Theme.settings-r-pill;
                                    background: root.ticktick-connected ? Theme.settings-success-bg : Theme.settings-bg-inset;
                                    OrbitText { text: root.ticktick-connected ? "Connected" : "Not connected"; color: root.ticktick-connected ? Theme.settings-success-text : Theme.settings-text-muted; font-size: Theme.type-hint; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                                }
                            }
                            SettingsField { label: "Personal API token"; placeholder: "Paste a replacement token"; text <=> root.ticktick-token-draft; secret: true; }
                            HorizontalLayout { spacing: 10px;
                                SettingsButton { label: "Connect TickTick"; option-width: 160px; primary: true; enabled: !root.ticktick-loading && root.ticktick-token-draft != ""; clicked => { root.save-ticktick-token(root.ticktick-token-draft); root.ticktick-token-draft = ""; } }
                                SettingsButton { label: "Disconnect"; option-width: 112px; destructive: true; enabled: !root.ticktick-loading && root.ticktick-connected; clicked => { root.remove-ticktick-token(); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            SettingsDescription { text: root.ticktick-status; }
                        }
                    }
                    SettingsCard {
                        vertical-stretch: 1; min-height: 220px;
                        VerticalLayout { padding: 22px; spacing: 14px; alignment: start;
                            SettingsTitle { text: "Data"; }
                            SettingsDescription { text: root.installed-status; }
                            SettingsButton { label: "Refresh"; option-width: 214px; enabled: !root.busy; clicked => { root.busy = true; root.refresh-installed-apps(); } }
                            HorizontalLayout { spacing: 10px;
                                SettingsButton { label: "Export data"; option-width: 132px; enabled: !root.busy; clicked => { root.busy = true; root.data-busy = true; root.data-status = ""; root.transfer-data(false); } }
                                SettingsButton { label: "Import data"; option-width: 132px; enabled: !root.layout-locked && !root.busy; clicked => { root.busy = true; root.data-busy = true; root.data-status = ""; root.transfer-data(true); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if root.data-status != "": SettingsDescription { text: root.data-status; }
                        }
                    }
                }
            }
            if root.settings-tab == 8: SettingsCard {
                height: 292px;
                VerticalLayout {
                    padding: 20px; spacing: 16px; alignment: start;
                    SettingsTitle { text: "Background"; }
                    SettingsDescription { text: root.background-image-active ? "Using the selected image." : root.background-color-active ? "Using " + root.background-color-input + "." : "Using the supplied radial background."; }
                    SettingsField { label: "Background images folder"; placeholder: "/home/you/Pictures"; text <=> root.background-folder-input; enabled: !root.busy; }
                    SettingsButton { label: "Save image folder"; option-width: 160px; enabled: !root.busy; clicked => { root.busy = true; root.save-background-folder(root.background-folder-input); } }
                    SettingsField { label: "Background color (hex)"; placeholder: "#RRGGBB"; text <=> root.background-color-input; enabled: !root.busy; }
                    HorizontalLayout { spacing: 10px;
                        SettingsButton { label: "Save color"; option-width: 120px; primary: true; enabled: !root.busy; clicked => { root.busy = true; root.save-background-color(root.background-color-input); } }
                        SettingsButton { label: "Choose image"; option-width: 136px; enabled: !root.busy; clicked => { root.busy = true; root.sheet-operation = "choosing-background"; root.choose-background-image(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    SettingsButton { label: "Reset background"; option-width: 156px; enabled: !root.busy; clicked => { root.busy = true; root.reset-background(); } }
                }
            }
            if root.settings-tab == 6: SettingsCard {
                height: ai-settings.preferred-height;
                ai-settings := VerticalLayout {
                    padding: 20px; spacing: 16px; alignment: start;
                    SettingsTitle { text: "AI"; }
                    SettingsDescription { text: "Type ai, then Space or Tab, enter a prompt and press Enter. Each question starts fresh. Cloud requests use separately billed API keys."; }
                    SettingsSelect { label: "AI provider"; model: root.ai-providers; current-index <=> root.ai-provider; selected => { root.save-ai(); } }
                    if root.ai-provider == 0: VerticalLayout {
                        spacing: 16px;
                        SettingsField { label: "Local Ollama address"; text <=> root.ai-address; }
                        SettingsDescription { text: "Local model: " + root.ai-local-model; }
                        SettingsSelect { label: "Local model"; model: root.ai-local-models; current-index <=> root.ai-local-index; selected => { root.ai-local-model = root.ai-local-models[root.ai-local-index]; root.save-ai(); } }
                        HorizontalLayout { spacing: 10px;
                            SettingsButton { label: "Refresh models"; option-width: 160px; enabled: !root.ai-models-loading; clicked => { root.ai-refresh-models(); } }
                            SettingsButton { label: "Save address"; option-width: 140px; clicked => { root.save-ai(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                    if root.ai-provider == 1: SettingsField { label: "OpenAI model ID"; placeholder: "Enter an OpenAI model ID"; text <=> root.ai-openai-model; }
                    if root.ai-provider == 2: SettingsField { label: "Gemini model ID"; placeholder: "Enter a Gemini model ID"; text <=> root.ai-gemini-model; }
                    if root.ai-provider > 0: VerticalLayout {
                        spacing: 16px;
                        SettingsButton { label: "Save model"; option-width: 140px; clicked => { root.save-ai(); } }
                        SettingsField { label: "API key"; placeholder: "Enter or replace API key"; secret: true; text <=> root.ai-key-draft; enabled: !root.ai-key-busy; }
                        HorizontalLayout { spacing: 10px;
                            SettingsButton { label: "Save API key"; option-width: 140px; enabled: !root.ai-key-busy && root.ai-key-draft != ""; clicked => { root.ai-store-key(false); } }
                            SettingsButton { label: "Remove API key"; option-width: 160px; enabled: !root.ai-key-busy; clicked => { root.ai-store-key(true); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        SettingsDescription { text: "API keys are stored in your system credential store."; }
                    }
                    SettingsDescription { text: root.ai-settings-status; }
                }
            }
            if root.settings-tab == 4: VerticalLayout {
                spacing: 20px;
                SettingsCard {
                    height: (root.settings-content-width) < 640px ? 252px : 158px;
                    VerticalLayout {
                        spacing: 0px;
                        HorizontalLayout {
                            padding: 20px; spacing: 16px;
                            VerticalLayout { spacing: 3px;
                                SettingsTitle { text: "Smooth cursor"; }
                                SettingsDescription { text: "Animate the cursor while typing in Search anything."; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            SettingsSwitch { checked: root.smooth-cursor; enabled: !root.busy; toggled => { root.busy = true; root.save-smooth-cursor(!root.smooth-cursor); } }
                        }
                        Rectangle { height: 1px; background: Theme.settings-border-card; }
                        GridLayout {
                            padding: 20px; spacing: 12px;
                            VerticalLayout { row: 0; col: 0; spacing: 3px;
                                SettingsTitle { text: "Fallback search engine"; }
                                SettingsDescription { text: "Used when nothing in Orbit matches your query."; }
                            }
                            HorizontalLayout { row: (root.settings-content-width) < 640px ? 1 : 0; col: (root.settings-content-width) < 640px ? 0 : 1; spacing: 10px;
                                SettingsSelect { label: "Fallback search engine"; model: root.search-engine-names; current-index <=> root.default-search-engine-index; enabled: !root.busy; }
                                SettingsButton { label: "Save"; option-width: 82px; primary: true; enabled: !root.busy && root.default-search-engine-index != root.saved-default-search-engine-index; clicked => { root.busy = true; root.save-default-search-engine(root.default-search-engine-index); } }
                            }
                        }
                    }
                }
                SettingsCard {
                    VerticalLayout { padding: 20px; spacing: 20px; alignment: start;
                        HorizontalLayout { spacing: 16px;
                            VerticalLayout { spacing: 4px;
                                SettingsTitle { text: "Search locations"; }
                                SettingsDescription { text: "Manage where Orbit finds apps, files and directories."; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            SettingsButton { label: "Refresh"; primary: true; enabled: !root.busy; clicked => { root.busy = true; root.refresh-installed-apps(); } }
                        }
                        SettingsDescription { text: "Refresh updates installed apps and rescans all saved paths."; }
                        Rectangle { height: 1px; background: Theme.settings-border-card; }
                        VerticalLayout { spacing: 12px; alignment: start;
                            SettingsTitle { text: "App search paths"; }
                            SettingsDescription { text: "Immediate executable files in a directory, or an individual executable. Includes executable symlinks."; }
                            for path in root.app-search-paths: HorizontalLayout { spacing: 10px;
                                SettingsDescription { text: path; horizontal-stretch: 1; }
                                SettingsButton { label: "Delete"; destructive: true; enabled: !root.busy; clicked => { root.busy = true; root.save-app-search-path(path, true); } }
                            }
                            SettingsField { label: "Path"; placeholder: "/home/user/downloads or /home/user/app/program"; text <=> root.app-search-path-draft; }
                            HorizontalLayout { spacing: 10px;
                                SettingsButton { label: "Add path"; enabled: !root.busy && root.app-search-path-draft != ""; clicked => { root.busy = true; root.save-app-search-path(root.app-search-path-draft, false); } }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.settings-border-card; }
                        GridLayout {
                            spacing: 20px;

                            VerticalLayout {
                                row: (root.settings-content-width) < 640px ? 0 : 0; col: (root.settings-content-width) < 640px ? 0 : 0;
                                min-height: 150px;
                                VerticalLayout {
                                    spacing: 12px; alignment: start;
                                    SettingsTitle { text: "File search paths"; }
                                    SettingsDescription { text: "Files inside these directories and their subdirectories."; }
                                    for path[index] in root.file-search-paths: HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            horizontal-stretch: 1; min-width: 0px; height: 36px;
                                            background: Theme.settings-bg-inset; border-width: 1px; border-color: Theme.settings-border-panel; border-radius: Theme.settings-r-control;
                                            OrbitText { x: 12px; width: parent.width - 24px; height: parent.height; text: path; font-family: "monospace"; color: Theme.settings-text-muted; font-size: Theme.type-control; overflow: elide; vertical-alignment: center; }
                                        }
                                        SettingsButton { label: ""; icon: @image-url("assets/pencil.svg"); icon-present: true; accessible-label: "Edit " + path; option-width: 36px; height: 36px; enabled: !root.busy; clicked => { root.search-path-directory = false; root.search-path-index = index; root.search-path-draft = path; root.search-path-editor = true; } }
                                        SettingsButton { label: ""; icon: @image-url("assets/trash.svg"); icon-present: true; accessible-label: "Delete " + path; option-width: 36px; height: 36px; destructive: true; enabled: !root.busy; clicked => { root.busy = true; root.delete-search-path(false, index); } }
                                    }
                                    SettingsAddButton { label: "+  Add file path"; full-width: true; available-width: ((root.settings-content-width) < 640px ? (root.settings-content-width) - 40px : ((root.settings-content-width) - 60px) / 2); height: 40px; border-color: Theme.settings-border-dashed; enabled: !root.busy; clicked => { root.search-path-directory = false; root.search-path-index = -1; root.search-path-draft = ""; root.search-path-editor = true; } }
                                }
                            }

                            VerticalLayout {
                                row: (root.settings-content-width) < 640px ? 1 : 0; col: (root.settings-content-width) < 640px ? 0 : 1;
                                min-height: 150px;
                                VerticalLayout {
                                    spacing: 12px; alignment: start;
                                    SettingsTitle { text: "Directory search paths"; }
                                    SettingsDescription { text: "Immediate directories inside these paths."; }
                                    for path[index] in root.directory-search-paths: HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            horizontal-stretch: 1; min-width: 0px; height: 36px;
                                            background: Theme.settings-bg-inset; border-width: 1px; border-color: Theme.settings-border-panel; border-radius: Theme.settings-r-control;
                                            OrbitText { x: 12px; width: parent.width - 24px; height: parent.height; text: path; font-family: "monospace"; color: Theme.settings-text-muted; font-size: Theme.type-control; overflow: elide; vertical-alignment: center; }
                                        }
                                        SettingsButton { label: ""; icon: @image-url("assets/pencil.svg"); icon-present: true; accessible-label: "Edit " + path; option-width: 36px; height: 36px; enabled: !root.busy; clicked => { root.search-path-directory = true; root.search-path-index = index; root.search-path-draft = path; root.search-path-editor = true; } }
                                        SettingsButton { label: ""; icon: @image-url("assets/trash.svg"); icon-present: true; accessible-label: "Delete " + path; option-width: 36px; height: 36px; destructive: true; enabled: !root.busy; clicked => { root.busy = true; root.delete-search-path(true, index); } }
                                    }
                                    SettingsAddButton { label: "+  Add directory path"; full-width: true; available-width: ((root.settings-content-width) < 640px ? (root.settings-content-width) - 40px : ((root.settings-content-width) - 60px) / 2); height: 40px; border-color: Theme.settings-border-dashed; enabled: !root.busy; clicked => { root.search-path-directory = true; root.search-path-index = -1; root.search-path-draft = ""; root.search-path-editor = true; } }
                                }
                            }

                        }
                        if root.search-path-editor: VerticalLayout {
                            VerticalLayout { spacing: 12px;
                                SettingsField { label: root.search-path-directory ? "Directory search path" : "File search path"; placeholder: "/home/user/Documents"; text <=> root.search-path-draft; accepted => { root.busy = true; root.save-search-path(root.search-path-directory, root.search-path-index, root.search-path-draft); } }
                                HorizontalLayout { spacing: 8px;
                                    SettingsButton { label: "Cancel"; enabled: !root.busy; clicked => { root.search-path-editor = false; } }
                                    SettingsButton { label: "Save"; primary: true; enabled: !root.busy; clicked => { root.busy = true; root.save-search-path(root.search-path-directory, root.search-path-index, root.search-path-draft); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.settings-border-card; }
                        VerticalLayout {
                            VerticalLayout { spacing: 14px;
                                SettingsTitle { text: "Excluded from file search"; }
                                SettingsDescription { text: "Files and folders with these names are skipped. Use .* for anything that starts with a dot."; }
                                HorizontalLayout { spacing: 10px;
                                    SettingsField { label: "Name or pattern"; placeholder: "e.g. dist"; text <=> root.file-search-exclusion-draft; enabled: !root.busy; accepted => { if !root.busy && root.file-search-exclusion-draft != "" { root.busy = true; root.add-file-search-exclusion(root.file-search-exclusion-draft); } } }
                                    VerticalLayout { Rectangle { height: 23px; } SettingsButton { label: "Exclude"; option-width: 100px; primary: true; enabled: !root.busy && root.file-search-exclusion-draft != ""; clicked => { root.busy = true; root.add-file-search-exclusion(root.file-search-exclusion-draft); } } }
                                }
                                Rectangle {
                                    property <int> columns: max(1, floor((self.width + 8px) / 160px));
                                    height: ceil(root.file-search-exclusions.length / self.columns) * 38px;
                                    for name[index] in root.file-search-exclusions: SettingsChip {
                                        x: mod(index, parent.columns) * ((parent.width + 8px) / parent.columns);
                                        y: floor(index / parent.columns) * 38px;
                                        width: (parent.width + 8px) / parent.columns - 8px;
                                        label: name; path-name: true; accent: name == ".*"; enabled: !root.busy;
                                        removed => { root.busy = true; root.remove-file-search-exclusion(name); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if root.settings-tab == 1: VerticalLayout {
                spacing: 16px;
                SettingsCard {
                    height: shortcut-columns-layout.preferred-height;
                    shortcut-columns-layout := HorizontalLayout {
                        spacing: 0px;
                        for column in root.shortcut-columns: VerticalLayout {
                            spacing: 0px; alignment: start;
                            for frame[index] in root.shortcut-groups: Rectangle {
                                visible: mod(index, root.shortcut-columns) == column;
                                property <length> row-width: ((root.settings-content-width) / root.shortcut-columns);
                                property <length> name-width: min(190px, self.row-width * 0.35);
                                property <length> keys-width: self.row-width - self.name-width - 120px;
                                property <int> key-columns: max(1, floor((self.keys-width + 6px) / 140px));
                                height: mod(index, root.shortcut-columns) != column ? 0px : max(56px, ceil(frame.entries.length / self.key-columns) * 34px + 22px);
                                width: self.row-width;
                                Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.settings-border-card; }
                                SettingsTitle { x: 20px; width: parent.name-width; height: parent.height; text: root.shortcut-actions[frame.action >= 14 ? frame.action - 3 : frame.action == 12 ? 10 : frame.action]; font-size: Theme.type-body; wrap: word-wrap; vertical-alignment: center; }
                                if frame.entries.length == 0: SettingsDescription { x: 32px + parent.name-width; width: parent.keys-width; height: parent.height; text: "No shortcut assigned"; font-italic: true; color: Theme.settings-text-none; vertical-alignment: center; }
                                for binding[key-index] in frame.entries: SettingsChip {
                                    x: 32px + parent.name-width + mod(key-index, parent.key-columns) * (parent.keys-width + 6px) / parent.key-columns;
                                    y: 12px + floor(key-index / parent.key-columns) * 34px;
                                    width: (parent.keys-width + 6px) / parent.key-columns - 6px;
                                    label: binding.keys == "Escape" ? "Esc" : binding.keys == "Left" ? "←" : binding.keys == "Right" ? "→" : binding.keys == "Up" ? "↑" : binding.keys == "Down" ? "↓" : binding.keys;
                                    accessible-name: binding.keys;
                                    enabled: !root.busy;
                                    confirming: root.shortcut-delete-action == binding.action && root.shortcut-delete-keys == binding.keys;
                                    removed => {
                                        if root.shortcut-delete-action == binding.action && root.shortcut-delete-keys == binding.keys {
                                            root.busy = true; root.shortcut-delete-action = -1; root.delete-shortcut(binding.action, binding.keys);
                                        } else { root.shortcut-delete-action = binding.action; root.shortcut-delete-keys = binding.keys; }
                                    }
                                }
                                SettingsButton { x: parent.width - 80px; y: 11px; label: "Add"; option-width: 60px; height: 34px; enabled: !root.busy; clicked => { root.shortcut-action = frame.action >= 14 ? frame.action - 3 : frame.action == 12 ? 10 : frame.action; root.shortcut-existing = ""; root.shortcut-draft = ""; root.shortcut-editor = true; } }
                            }
                        }
                    }
                }
                SettingsDescription { text: "Remove a shortcut with ×, then confirm with ✓. Use Add to record a replacement."; }
                SettingsDescription { text: "Toggle Orbit is configured outside Orbit. Text editing uses the text field’s shortcuts. Drag empty space to pan. Wheel zooms around the pointer."; }
                if root.shortcut-editor: VerticalLayout {
                    spacing: 12px;
                    SettingsSelect { width: min(360px, root.settings-content-width); model: root.shortcut-actions; current-index <=> root.shortcut-action; }
                    SettingsButton { label: root.shortcut-recording ? "Press shortcut…" : root.shortcut-draft == "" ? "Record shortcut" : ""; shortcut: root.shortcut-recording ? "" : root.shortcut-draft; option-width: 220px; clicked => { root.shortcut-recording = true; } }
                    SettingsButton { label: "Cancel"; clicked => { root.shortcut-editor = false; root.shortcut-recording = false; } }
                    SettingsButton { label: "Save"; primary: true; enabled: !root.busy && !root.shortcut-recording && root.shortcut-draft != ""; clicked => { root.busy = true; root.save-shortcut(root.shortcut-action >= 11 ? root.shortcut-action + 3 : root.shortcut-action == 10 ? 12 : root.shortcut-action, root.shortcut-existing, root.shortcut-draft); } }
                }
            }
            if root.settings-tab == 2: VerticalLayout {
                spacing: 12px;

                Flickable {
                    height: max(106px, ceil(root.prefixes.length / root.action-columns) * 106px);
                    content-height: max(self.height, ceil(root.prefixes.length / root.action-columns) * 106px);
                    content-width: self.width;
                    for prefix[index] in root.prefixes: SettingsCard {
                        x: mod(index, root.action-columns) * ((parent.width - (root.action-columns - 1) * 12px) / root.action-columns + 12px);
                        y: floor(index / root.action-columns) * 106px;
                        width: (parent.width - (root.action-columns - 1) * 12px) / root.action-columns;
                        height: 92px;

                        OrbitText { x: 12px; y: 8px; width: parent.width - 112px; height: 24px; text: prefix.name; color: Theme.settings-text; font-size: 15px * Theme.font-scale; font-weight: 500; overflow: elide; }
                        OrbitText { x: 12px; y: 34px; width: parent.width - 112px; height: 20px; font-family: "monospace"; text: "\u{2066}" + prefix.token + "  →  " + prefix.action-name + "\u{2069}"; color: Theme.settings-text-accent; font-size: Theme.type-control; overflow: elide; }
                        HorizontalLayout {
                            x: parent.width - 90px; y: 10px; spacing: 6px;
                            SettingsButton { label: ""; icon: @image-url("assets/pencil.svg"); icon-present: true; accessible-label: "Edit " + prefix.name; option-width: 36px; height: 36px; enabled: !root.busy; clicked => {
                                root.prefix-id-draft = prefix.id; root.prefix-name-draft = prefix.name;
                                root.prefix-token-draft = prefix.token; root.prefix-action-index = prefix.action-index;
                            } }
                            SettingsButton { label: ""; icon: @image-url("assets/trash.svg"); icon-present: true; accessible-label: "Delete " + prefix.name; option-width: 36px; height: 36px; destructive: true; enabled: !root.busy; clicked => { root.busy = true; root.delete-prefix(prefix.id); } }
                        }
                    }
                }
                GridLayout {
                    spacing: 8px;
                    SettingsField { row: 0; col: 0; label: "Name"; placeholder: "YouTube"; text <=> root.prefix-name-draft; }
                    SettingsField { row: 0; col: 1; label: "Token"; placeholder: "y"; text <=> root.prefix-token-draft; }
                    SettingsSelect { row: root.settings-content-width < 640px ? 1 : 0; col: root.settings-content-width < 640px ? 0 : 2; colspan: root.settings-content-width < 640px ? 2 : 1; width: root.settings-content-width < 640px ? root.settings-content-width : 220px; label: "Action"; model: root.action-names; current-index <=> root.prefix-action-index; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    SettingsButton { label: "New Prefix"; clicked => { root.prefix-id-draft = ""; root.prefix-name-draft = ""; root.prefix-token-draft = ""; root.prefix-action-index = 0; } }
                    SettingsButton { label: "Save Prefix"; option-width: 132px; primary: true; enabled: !root.busy && root.prefix-name-draft != "" && root.prefix-token-draft != "" && root.user-actions.length > 0; clicked => { root.busy = true; root.save-prefix(root.prefix-id-draft, root.prefix-name-draft, root.prefix-token-draft, root.user-actions[root.prefix-action-index].id); } }
                }
            }
            if root.settings-tab == 10: VerticalLayout {
                spacing: 12px;
                SettingsDescription { text: "Type / in Search anything to choose a script. A space separates its name from one argument string."; }
                if root.scripts.length == 0: SettingsDescription { text: "No scripts yet"; }
                for script in root.scripts: SettingsCard {
                    height: 82px;
                    VerticalLayout { padding: 12px; spacing: 4px;
                        HorizontalLayout {
                            OrbitText { text: script.name; color: Theme.settings-text; font-size: Theme.type-control; font-weight: 600; horizontal-stretch: 1; overflow: elide; }
                            SettingsButton { label: "Edit"; option-width: 64px; enabled: !root.busy; clicked => { root.script-id-draft = script.id; root.script-name-draft = script.name; root.script-path-draft = script.path; root.script-error = ""; } }
                            SettingsButton { label: "Delete"; option-width: 76px; enabled: !root.busy; clicked => { root.busy = true; root.delete-script(script.id); } }
                        }
                        OrbitText { text: script.path; color: Theme.settings-text-muted; font-size: Theme.type-control; overflow: elide; }
                    }
                }
                SettingsCard {
                    height: script-form.preferred-height + 32px;
                    script-form := VerticalLayout {
                        padding: 16px; spacing: 12px;
                        SettingsField { label: "Name"; placeholder: "deploy"; text <=> root.script-name-draft; }
                        SettingsField { label: "Path"; placeholder: "/path/to/script"; text <=> root.script-path-draft; }
                        if root.script-error != "": SettingsDescription { text: root.script-error; color: Theme.settings-danger-text; }
                        HorizontalLayout {
                            spacing: 12px;
                            SettingsButton { label: "Choose file"; option-width: 112px; enabled: !root.busy; clicked => { root.busy = true; root.sheet-operation = "choosing"; root.choose-script(); } }
                            Rectangle { horizontal-stretch: 1; }
                            SettingsButton { label: "New script"; option-width: 112px; enabled: !root.busy; clicked => { root.new-script(); } }
                            SettingsButton { label: "Save script"; option-width: 120px; primary: true; enabled: !root.busy; clicked => { root.busy = true; root.save-script(root.script-id-draft, root.script-name-draft, root.script-path-draft); } }
                        }
                    }
                }
            }
            if root.settings-tab == 3: VerticalLayout {
                spacing: 12px;
                if !root.action-editor-open: Flickable {
                    height: max(320px, ceil(root.user-actions.length / root.action-columns) * 150px); content-height: max(self.height, ceil(root.user-actions.length / root.action-columns) * 150px); content-width: self.width;
                    for action[index] in root.user-actions: SettingsCard {
                        x: mod(index, root.action-columns) * ((parent.width - (root.action-columns - 1) * 12px) / root.action-columns + 12px);
                        y: floor(index / root.action-columns) * 150px;
                        width: (parent.width - (root.action-columns - 1) * 12px) / root.action-columns;
                        height: 136px;
                        background: Theme.settings-bg-card;
                        border-width: action-focus.has-focus ? 2px : 1px;
                        border-color: action-focus.has-focus ? Theme.settings-icon-accent : Theme.settings-border-card;
                        border-radius: Theme.settings-r-card;
                        OrbitText { x: 14px; y: 14px; width: parent.width - 110px; height: 24px; text: action.name; color: Theme.settings-text; font-size: 15px * Theme.font-scale; font-weight: 600; wrap: word-wrap; vertical-alignment: center; }
                        Rectangle { x: parent.width - 86px; y: 14px; width: 72px; height: 22px; background: Theme.settings-bg-nav-active; border-radius: Theme.settings-r-kbd;
                            OrbitText { text: action.kind; color: Theme.settings-text-kbd; font-size: 11px * Theme.font-scale; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                        }
                        OrbitText { x: 14px; y: 46px; width: parent.width - 28px; height: 18px; font-family: "monospace"; text: action.tokens == "" ? "" : "Tokens · " + action.tokens; color: Theme.settings-text-accent; font-size: Theme.type-control; overflow: elide; }
                        OrbitText { x: 14px; y: 72px; width: parent.width - 28px; height: 42px; text: action.description; color: Theme.settings-text-muted; font-size: Theme.type-control; wrap: word-wrap; overflow: elide; }
                        callback edit;
                        forward-focus: action-focus;
                        accessible-role: button; accessible-label: "Edit " + action.name;
                        accessible-action-default => { self.edit(); }
                        action-focus := FocusScope { key-pressed(event) => { if event.text == "\n" || event.text == " " { parent.edit(); return accept; } reject; } }
                        edit => { root.action-id-draft = action.id; root.action-name-draft = action.name; root.action-kind-draft = action.kind; root.action-source-draft = action.source; root.action-description-draft = action.description; root.action-tokens-draft = action.tokens; root.action-used = action.referenced; root.action-editor-open = true; }
                        action-card := TouchArea {
                            accessible-role: button; accessible-label: "Edit " + action.name;
                            clicked => { parent.edit(); }
                        }
                    }
                }
                if root.action-editor-open: VerticalLayout {
                    vertical-stretch: 1; spacing: 8px;
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: min(760px, parent.width - 32px);
                            height: max(220px, min(root.height - 500px, 560px));
                            background: Theme.settings-bg-card; border-width: 1px; border-color: Theme.settings-border-card; border-radius: Theme.settings-r-card;
                            VerticalLayout {
                                padding: 18px; spacing: 8px;
                                HorizontalLayout {
                                    OrbitText { text: root.action-id-draft == "" ? "New Action" : "Edit Action"; color: Theme.settings-text; font-size: Theme.type-title; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Flickable {
                                    vertical-stretch: 1;
                                    content-width: self.width;
                                    width: min(760px, root.width - 424px) - 36px;
                                    content-height: action-fields.preferred-height;
                                    action-fields := VerticalLayout {
                                        width: min(760px, root.width - 424px) - 36px; spacing: 10px;
                                        SettingsField { label: "Name"; placeholder: "My action"; text <=> root.action-name-draft; }
                                        SettingsField { label: "Description"; placeholder: "Explain what this Action does and how to use it"; text <=> root.action-description-draft; multiline: true; }
                                        SettingsField { label: "Tokens · separate with commas"; placeholder: "g, ل"; text <=> root.action-tokens-draft; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            SettingsButton { label: "Shell"; selected: root.action-kind-draft == "Shell"; clicked => { if root.action-kind-draft != "Shell" { root.action-kind-draft = "Shell"; root.action-source-draft = ""; } } }
                                            SettingsButton { label: "URL"; selected: root.action-kind-draft == "URL"; clicked => { if root.action-kind-draft != "URL" { root.action-kind-draft = "URL"; root.action-source-draft = ""; } } }
                                            SettingsButton { label: "TickTick"; selected: root.action-kind-draft == "TickTick"; clicked => { if root.action-kind-draft != "TickTick" { root.action-kind-draft = "TickTick"; root.action-source-draft = ""; } } }
                                            SettingsButton { label: "AI"; selected: root.action-kind-draft == "AI"; clicked => { root.action-kind-draft = "AI"; root.action-source-draft = ""; } }
                                        }
                                        if root.action-kind-draft == "URL": SettingsField { label: "URL template · use %s for Search anything"; placeholder: "https://example.com/?q=%s"; text <=> root.action-source-draft; }
                                        if root.action-kind-draft == "Shell": SettingsField { label: "Shell script · argument: $1 on Arch Linux, $OrbitQuery on Windows"; placeholder: "Write a script that reads the search argument"; text <=> root.action-source-draft; multiline: true; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    SettingsButton { label: "Cancel"; option-width: root.width < 900px ? 80px : 100px; enabled: !root.busy; clicked => { root.action-editor-open = false; } }
                                    Rectangle { horizontal-stretch: 1; }
                                    if root.action-id-draft != "": SettingsButton { label: "Delete"; option-width: root.width < 900px ? 80px : 100px; destructive: true; enabled: !root.busy && !root.action-used; clicked => { root.busy = true; root.delete-user-action(root.action-id-draft); } }
                                    SettingsButton { label: "Save Action"; option-width: root.width < 900px ? 116px : 132px; primary: true; enabled: !root.busy && root.action-name-draft != "" && (root.action-kind-draft == "AI" || root.action-kind-draft == "TickTick" || root.action-source-draft != ""); clicked => { root.busy = true; root.save-user-action(root.action-id-draft, root.action-name-draft, root.action-kind-draft, root.action-source-draft, root.action-description-draft, root.action-tokens-draft); } }
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }

                }
            }
        }
    }

    if root.ticktick-popup-widget-id != "": Rectangle {
        width: root.width; height: root.height; background: transparent;
        TouchArea { clicked => { root.ticktick-popup-widget-id = ""; } }
        Rectangle {
            x: root.ticktick-popup-x; y: max(16px,min(root.ticktick-popup-y,root.height - self.height - 16px));
            width: root.ticktick-popup-options ? 220px : min(300px,root.width - 32px);
            height: root.ticktick-popup-options ? 148px : min(420px,min(root.height - 32px,64px + root.ticktick-views.length * 42px));
            background: Theme.sheet; border-radius: Theme.radius-control; border-width: Theme.border-width; border-color: Theme.border;
            if root.ticktick-popup-options: VerticalLayout {
                padding: 6px; spacing: 4px;
                MenuOption { label: root.ticktick-loading ? "Loading…" : "Refresh Tasks"; option-width: 208px; enabled: !root.ticktick-loading; clicked => { root.load-ticktick(); } }
                MenuOption { label: "Refresh List"; option-width: 208px; enabled: !root.ticktick-loading; clicked => {
                    root.refresh-ticktick-list(root.ticktick-selected-project(root.ticktick-popup-widget-id));
                } }
                MenuOption { label: root.ticktick-show-completed ? "Hide completed" : "Show completed"; option-width: 208px; clicked => { root.ticktick-show-completed = !root.ticktick-show-completed; root.ticktick-scroll-offset = 0px; root.ticktick-popup-widget-id = ""; } }
            }
            if !root.ticktick-popup-options: OrbitText {
                x: 16px; y: 10px; width: parent.width - 32px; height: 32px;
                text: "Lists & tags"; color: Theme.text; font-size: Theme.type-body; font-weight: 600; vertical-alignment: center;
            }
            if !root.ticktick-popup-options: ScrollView {
                x: 8px; y: 48px; width: parent.width - 16px; height: parent.height - 56px;
                horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: as-needed;
                content-width: self.visible-width;
                VerticalLayout {
                    spacing: 2px;
                    for view in root.ticktick-views: Rectangle {
                        height: view.heading ? 28px : 40px;
                        border-radius: Theme.radius-control;
                        property <bool> selected: !view.heading && root.ticktick-popup-project-id == view.id;
                        background: view.heading ? transparent : project-touch.pressed ? Theme.press-overlay : self.selected ? Theme.selection : project-touch.has-hover ? Theme.hover-overlay : transparent;
                        OrbitText {
                            x: 12px; width: parent.width - 44px; height: parent.height;
                            text: view.name; color: view.heading ? Theme.secondary : Theme.text;
                            horizontal-alignment: view.rtl ? right : left;
                            font-family: view.rtl ? "Amiri" : "Inter";
                            font-size: view.heading ? Theme.type-hint : Theme.type-control; font-weight: view.heading || parent.selected ? 600 : 400;
                            vertical-alignment: center; overflow: elide;
                        }
                        if selected: Path { x: parent.width - 25px; y: 16px; width: 11px; height: 8px; commands: "M 0 4 L 4 8 L 11 0"; fill: transparent; stroke: Theme.focus; stroke-width: 1.5px; }
                        project-touch := TouchArea {
                            enabled: !view.heading; mouse-cursor: pointer;
                            clicked => {
                                root.select-ticktick-list(root.ticktick-popup-widget-id,view.id);
                                root.ticktick-scroll-offset = 0px; root.ticktick-popup-widget-id = "";
                            }
                        }
                    }
                }
            }
        }
    }
    if root.ticktick-open: Rectangle {
        width: root.width; height: root.height; background: Theme.backdrop;
        TouchArea {
            clicked => { root.ticktick-open = false; root.ticktick-confirm-delete = false; }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    root.ticktick-open = false; root.ticktick-confirm-delete = false;
                }
            }
        }
        ticktick-editor := Panel {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(parent.width - 40px, 470px); height: min(parent.height - 40px, root.ticktick-create ? 512px : 730px);
            background: Theme.sheet; border-radius: Theme.radius-sheet; border-color: Theme.border; border-width: Theme.border-width;
            TouchArea { width: parent.width; height: parent.height; }
            VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    OrbitText { text: root.ticktick-create ? "New task" : "Task details"; color: Theme.text; font-size: Theme.type-title; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    AddOption { label: "Cancel"; option-width: 72px; clicked => { root.ticktick-open = false; root.ticktick-confirm-delete = false; } }
                }
                task-scroll := ScrollView {
                    vertical-stretch: 1; min-height: 0px;
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    content-height: task-fields.preferred-height;
                    task-fields := VerticalLayout {
                        width: task-scroll.visible-width; height: self.preferred-height;
                        alignment: start; spacing: Theme.space-3;
                AddField { label: "Title"; placeholder: "What needs doing?"; text <=> root.ticktick-title; enabled: !root.ticktick-loading; }
                VerticalLayout {
                    alignment: start; spacing: 4px;
                    OrbitText { text: "List"; color: Theme.text; font-size: Theme.type-control; }
                    SettingsSelect { label: "List"; width: task-scroll.visible-width; model: root.ticktick-project-names; current-index <=> root.ticktick-project-index; enabled: root.ticktick-projects.length > 0 && !root.ticktick-loading; }
                }
                if !root.ticktick-create: OrbitText { text: "Currently in " + root.ticktick-list-name(root.ticktick-projects,root.ticktick-edit-project); color: Theme.secondary; font-size: Theme.type-hint; }
                AddField { label: "Notes (optional)"; placeholder: "Add notes"; text <=> root.ticktick-content; multiline: true; enabled: !root.ticktick-loading; }
                if !root.ticktick-create: AddField { label: "Description"; placeholder: "Add a task description"; text <=> root.ticktick-desc; multiline: true; enabled: !root.ticktick-loading; }
                if !root.ticktick-create: HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout { alignment: start; spacing: 4px; OrbitText { text: "Priority"; color: Theme.text; font-size: Theme.type-control; } SettingsSelect { label: "Priority"; width: min(180px, (task-scroll.visible-width - 12px) / 2); model: ["None", "Low", "Medium", "High"]; current-index <=> root.ticktick-priority; enabled: !root.ticktick-loading; } }
                    AddField { label: "Tags · comma separated"; placeholder: "work, urgent"; text <=> root.ticktick-tags; enabled: !root.ticktick-loading; }
                }
                if !root.ticktick-create: HorizontalLayout {
                    spacing: 10px;
                    AddField { label: "Due date · YYYY-MM-DD"; placeholder: "YYYY-MM-DD or blank"; text <=> root.ticktick-due-date; enabled: !root.ticktick-loading; }
                    VerticalLayout {
                        Rectangle { vertical-stretch: 1; }
                        AddOption { label: "Today"; option-width: 76px; enabled: !root.ticktick-loading; clicked => { root.ticktick-due-date = root.ticktick-current-date(); } }
                    }
                }
                if root.ticktick-form-error != "": OrbitText { text: root.ticktick-form-error; color: Theme.error; font-size: Theme.type-hint; wrap: word-wrap; }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    AddOption { label: root.ticktick-create ? "Add task" : "Save changes"; option-width: 112px; primary: true; enabled: !root.ticktick-loading && root.ticktick-title != "" && root.ticktick-projects.length > 0; clicked => {
                        root.ticktick-form-error = "";
                        root.save-ticktick-task(root.ticktick-edit-id,root.ticktick-projects[root.ticktick-project-index].id,root.ticktick-edit-project,root.ticktick-title,root.ticktick-content,root.ticktick-desc,root.ticktick-priority-value(root.ticktick-priority),root.ticktick-tags,root.ticktick-due-date);
                    } }
                    Rectangle { horizontal-stretch: 1; }
                    if !root.ticktick-create: AddOption { label: root.ticktick-confirm-delete ? "Delete forever" : "Delete"; option-width: root.ticktick-confirm-delete ? 122px : 82px; destructive: true; enabled: !root.ticktick-loading; clicked => {
                        if root.ticktick-confirm-delete { root.delete-ticktick-task(root.ticktick-edit-id,root.ticktick-edit-project); root.ticktick-confirm-delete = false; }
                        else { root.ticktick-confirm-delete = true; }
                    } }
                }
            }
        }
    }



    if root.search-context: Rectangle {
        width: root.width; height: root.height;
        TouchArea { clicked => { root.search-context = false; } }
        Panel {
            x: min(root.context-x,root.width - self.width); y: min(root.context-y,root.height - self.height);
            width: 200px; height: 104px;
            VerticalLayout { padding: 8px; spacing: 4px;
                MenuOption { label: "Pin"; width: 184px; enabled: !root.layout-locked && !root.busy && (root.dock-items.length < 15 || root.search-context-item.pinned); clicked => { root.save-result(root.search-context-item,round((root.width / 2px - CanvasState.pan-x) / CanvasState.zoom),round((root.height / 2px - CanvasState.pan-y) / CanvasState.zoom),true); } }
                MenuOption { label: "Add to Canvas"; width: 184px; enabled: !root.layout-locked && !root.busy; clicked => { root.save-result(root.search-context-item,round((root.width / 2px - CanvasState.pan-x) / CanvasState.zoom),round((root.height / 2px - CanvasState.pan-y) / CanvasState.zoom),false); } }
