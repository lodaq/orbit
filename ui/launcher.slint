                    AddOption { add-style: root.editing < 0; type-tile: true; option-width: max(72px, (root.sheet-content-width - 40px) / 6); icon-present: true; icon: @image-url("assets/add-group.svg"); label: "Folder"; selected: root.item-type == "Folder"; clicked => { root.add-item("Folder"); } }
