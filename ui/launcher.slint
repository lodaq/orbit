        root.save-search-result(item.page,item.index,item.folder-app-index,page,target,pin);
    }
    function begin-search-drag(item: AppTile, index: int, x: length, y: length) {
        root.begin-drag(index,false,x,y);
        root.drag-from-search = true;
        root.search-drag-item = item;
        root.drag-item = item;
        root.drag-item.span-x = root.item-size + root.grid-gap;
        root.drag-item.span-y = root.item-size + root.grid-gap;
        root.grab-x = root.item-size * 0.5px;
        root.grab-y = root.item-size * 0.5px;
