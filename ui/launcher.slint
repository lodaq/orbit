                    AddOption { add-style: root.editing < 0; source-tab: true; label: "Installed apps"; option-width: 132px; selected: root.app-source == "Installed apps"; clicked => { root.installed-filter = ""; root.filter-installed-apps(""); root.app-source-changed("Installed apps"); } }
