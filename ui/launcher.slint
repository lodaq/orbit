export { RobotWorkbench, RobotChoice, RobotActivity, RobotProvider, RobotResource } from "robot-workbench.slint";
import { RobotWorkbench, RobotPanel } from "robot-workbench.slint";
export { CanvasState } from "canvas.slint";
import { CanvasState } from "canvas.slint";
export { TextDirection } from "controls.slint";
export { KeyboardNavigation } from "controls.slint";
import { OrbitText, TextDirection, KeyboardNavigation } from "controls.slint";
export { AzanSettings } from "azan-settings.slint";
import { AzanSettings, AzanSettingsSheet } from "azan-settings.slint";
import { Theme } from "theme.slint";
import { Panel, MenuOption, AddItemRow, SettingsAddButton, SettingsButton, SettingsField, SettingsCard, SettingsTitle, SettingsDescription, SettingsNav, SettingsTabGroup, SettingsTab, SettingsSwitch, SettingsToggle, SettingsChip, SettingsStepper, SettingsSelect, AddOption, AddField, SmoothCaret, Kbd } from "controls.slint";
import "fonts/inter.ttf";
export { WidgetDataEntry, WidgetView, LocalWidgets } from "local-widget.slint";
import { WidgetDataEntry, WidgetView, LocalWidgets, LocalWidget } from "local-widget.slint";
import { Palette, ScrollView, Slider } from "std-widgets.slint";

export struct CompletedReference { id: string, date: string, title: string, done: bool }
export struct CanvasFrameView { id: string, name: string, keys: string, x: float, y: float, width: float, height: float, count: int }
export struct InkSample { x: float, y: float }
export struct CanvasInk { id: string, x: float, y: float, width: float, height: float, path: string, samples: [InkSample], color: color, size: float, opacity: float, dimmed: bool }

export struct ShortcutEntry { action: int, keys: string }
export struct ShortcutGroup { action: int, entries: [ShortcutEntry] }

export struct FolderPreview {
    icon: image,
    icon-present: bool,
    letter: string,
}

export struct AppTile {
    annotation: int, annotation-ratio: float, annotation-color: color, annotation-color-name: string, annotation-size: float, annotation-opacity: float,
    robot: string,
    row: int, col: int, span-x: int, span-y: int, widget: bool, widget-kind: int, widget-text: string, widget-min: int, widget-max: int, ticktick: bool, ticktick-next: bool,
    ticktick-project-id: string,
    min-span-x: int, min-span-y: int, max-span-x: int, max-span-y: int,
    text-icon: bool,
    id: string,
    name: string,
    source: int,
    folder-id: string,
    pinned: bool,
    artwork: string,
    letter: string,
    icon: image,
    command: string,
    url: string,
    path: string,
    parent-path: string,
    icon-value: string,
    custom: bool,
    icon-present: bool,
    app: bool,
    website: bool,
    file: bool,
    directory: bool,
    folder: bool,
    preview-icons: [FolderPreview],
}



export struct InstalledAppTile {
    command: string,
    id: string,
    name: string,
    letter: string,
    icon: image,
    icon-present: bool,
}

export struct ActionChoice {
    id: string,
    name: string,
}
export struct UserActionChoice { id: string, name: string, kind: string, source: string, tokens: string, description: string, referenced: bool }
export struct ScriptChoice { id: string, name: string, path: string }
export struct PrefixChoice { id: string, name: string, token: string, action-id: string, action-name: string, action-index: int }
export struct PrefixMatch { action-id: string, name: string, query: string, query-length: int, badge-width: int }
export struct SearchHistoryEntry { text: string, prefix-id: string, prefix-name: string, prefix-width: length }

export struct TickTickProject { id: string, name: string, inbox: bool }
export struct TickTickView { id: string, name: string, heading: bool, rtl: bool }
export struct TickTickTask { rtl: bool, tag-names: string, id: string, project-id: string, list: string, title: string, content: string, desc: string, created-time: string, due: string, due-date: string, day: int, done: bool, priority: int, tags: string, details: string, focus-notes: string, focus-notes-rtl: bool }
export struct ToastItem { id: int, level: int, message: string, pulse: int }

component FocusTaskBody inherits Rectangle {
    in property <TickTickTask> task;
    in property <bool> compact;
    in property <bool> expanded;
    out property <length> content-height: content.preferred-height;
    height: self.content-height;
    content := VerticalLayout {
        padding: 0px; spacing: 16px;
        OrbitText {
            text: root.task.title; color: Theme.text;
            font-family: root.task.rtl ? "Amiri" : "Inter";
            font-size: root.compact ? (root.task.rtl ? 24px : 18px) : (root.task.rtl ? 30px : Theme.focus-title-size);
            font-weight: 600; wrap: word-wrap;
            horizontal-alignment: root.task.rtl ? right : left;
        }
        if root.task.priority > 0 || root.task.due != "": HorizontalLayout {
            spacing: 10px; alignment: root.task.rtl ? end : start;
            if root.task.priority > 0: Rectangle {
                height: 26px; width: priority-label.preferred-width + 20px; border-radius: 13px;
                property <color> accent: root.task.priority == 5 ? Theme.priority-high : root.task.priority == 3 ? Theme.priority-medium : Theme.priority-low;
                background: self.accent.with-alpha(0.12);
                priority-label := OrbitText {
                    x: 10px; height: parent.height;
                    text: root.task.priority == 5 ? "High priority" : root.task.priority == 3 ? "Medium priority" : "Low priority";
                    color: parent.accent; font-size: Theme.type-hint; font-weight: 600; vertical-alignment: center;
                }
            }
            if root.task.due != "": OrbitText { text: root.task.due; color: Theme.secondary; font-size: Theme.type-control; vertical-alignment: center; }
        }
        if root.task.tags != "": OrbitText {
            text: root.task.tags; color: Theme.focus; font-size: Theme.type-control; wrap: word-wrap;
            horizontal-alignment: root.task.rtl ? right : left;
        }
        if root.expanded || root.task.focus-notes != "": OrbitText {
            text: root.expanded ? root.task.details : root.task.focus-notes; color: Theme.secondary;
            font-family: (!root.expanded && root.task.focus-notes-rtl) ? "Amiri" : "Inter";
            font-size: (!root.expanded && root.task.focus-notes-rtl) ? 18px : Theme.type-body; wrap: word-wrap;
            horizontal-alignment: TextDirection.is-rtl(self.text) ? right : left;
        }
    }
}

component ToastCard inherits Rectangle {
    in property <ToastItem> item;
    in property <length> available-width;
    in property <int> depth: 0;
    in property <bool> expanded: false;
    callback dismissed(int);
    callback hover-changed(bool);

    property <bool> is-front: depth == 0;
    property <bool> interactive: expanded || is-front;
    property <color> status-color: item.level == 3 ? Theme.error : item.level == 2 ? Theme.warning : item.level == 1 ? Theme.success : Theme.focus;

    width: min(340px, available-width);
    height: 44px;
    background: Theme.widget-surface.with-alpha(0.94);
    border-width: Theme.border-width;
    border-color: interactive ? Theme.border : Theme.separator;
    border-radius: 14px;
    drop-shadow-color: Theme.surface-shadow;
    drop-shadow-blur: interactive ? 16px : 4px;
    drop-shadow-offset-y: interactive ? 4px : 2px;
    opacity: expanded ? 1.0 : is-front ? 1.0 : depth == 1 ? 0.82 : 0.60;
    transform-scale-x: expanded ? 1.0 : is-front ? 1.0 : depth == 1 ? 0.94 : 0.88;
    transform-scale-y: self.transform-scale-x;
    transform-origin: { x: self.width / 2, y: self.height };

    animate y { duration: 200ms; easing: ease-out; }
    animate transform-scale-x { duration: 200ms; easing: ease-out; }
    animate opacity { duration: 180ms; easing: ease-out; }

    Rectangle {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: root.status-color.with-alpha(0.16);
        border-width: 1px;
        border-color: root.status-color.with-alpha(0.3);
        OrbitText {
            text: root.item.level == 1 ? "✓" : root.item.level == 0 ? "i" : "!";
            color: root.status-color;
            font-size: 11px * Theme.font-scale;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    OrbitText {
        x: 42px;
        y: 0px;
        width: parent.width - 42px - (root.interactive ? 34px : 12px);
        height: parent.height;
        text: root.item.message;
        color: Theme.text;
        font-size: Theme.type-control;
        font-weight: 500;
        horizontal-alignment: TextDirection.is-rtl(self.text) ? right : left;
        overflow: elide;
        vertical-alignment: center;
    }

    card-touch := TouchArea {
        y: root.expanded ? -8px : 0px;
        height: root.expanded ? parent.height + 8px : parent.height;
        mouse-cursor: pointer;
        changed has-hover => { root.hover-changed(self.has-hover); }
        clicked => { root.dismissed(root.item.id); }
    }

    if root.interactive: Rectangle {
        x: parent.width - self.width - 8px;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: close-touch.has-hover ? #FFFFFF18 : transparent;
        animate background { duration: 100ms; easing: ease-out; }

        OrbitText {
            text: "×";
            color: close-touch.has-hover ? Theme.text : Theme.secondary;
            font-size: 14px * Theme.font-scale;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        close-touch := TouchArea {
            mouse-cursor: pointer;
            changed has-hover => { root.hover-changed(self.has-hover); }
            clicked => { root.dismissed(root.item.id); }
        }
    }
}

component ItemIcon inherits Rectangle {
    in property <AppTile> item;
    in property <bool> dock;
    background: transparent;
    border-radius: self.width * 0.25;
    Image {
        width: parent.width; height: parent.height;
        source: item.robot != "" ? @image-url("assets/robot.svg") : item.text-icon ? @image-url("assets/letter.svg") : dock && item.artwork == "website" ? @image-url("assets/dock-website.svg")
            : dock && item.artwork == "file" ? @image-url("assets/dock-file.svg")
            : dock && item.artwork == "command" ? @image-url("assets/dock-command.svg")
            : dock && item.artwork == "directory" ? @image-url("assets/dock-directory.svg")
            : dock && item.artwork == "browser" ? @image-url("assets/dock-browser.svg")
            : item.artwork == "action" ? @image-url("assets/action.svg")
            : item.icon-present ? item.icon
            : item.website ? @image-url("assets/website.svg")
            : item.file ? @image-url("assets/file.svg")
            : item.directory ? @image-url("assets/directory.svg")
            : item.folder ? @image-url("assets/folder-empty.svg")
            : @image-url("assets/letter.svg");
        image-fit: contain;
    }
    if (item.app || item.text-icon) && !item.icon-present && item.artwork != "action": OrbitText { text: item.letter; color: Theme.text; font-size: parent.width * (item.text-icon ? 0.32 : 0.4); horizontal-alignment: center; vertical-alignment: center; }
    if item.folder && item.preview-icons.length == 0: OrbitText {
        text: "Empty"; color: Theme.text; font-size: parent.width * 0.16;
        horizontal-alignment: center; vertical-alignment: center;
    }
    for index in item.preview-icons.length: Rectangle {
        x: parent.width * (mod(index, 2) == 0 ? 0.16 : 0.55);
        y: parent.height * (index < 2 ? 0.16 : 0.55);
        width: parent.width * 0.29; height: self.width;
        border-radius: self.width * 0.22; background: Theme.folder-preview;
        if item.preview-icons[index].icon-present: Image {
            width: parent.width; height: parent.height;
            source: item.preview-icons[index].icon; image-fit: contain;
        }
        if !item.preview-icons[index].icon-present: Image {
            width: parent.width; height: parent.height;
            source: @image-url("assets/letter.svg"); image-fit: contain;
        }
        if !item.preview-icons[index].icon-present: OrbitText {
            text: item.preview-icons[index].letter; color: Theme.text;
            font-size: parent.width * 0.56;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
}

component ItemTile inherits Rectangle {
    in property <[AppTile]> items;
    in property <int> index;
    in property <[TickTickTask]> ticktick-tasks;
    in property <int> ticktick-total-count;
    in property <length> ticktick-scroll-offset;
    in property <length> ticktick-scroll-shift;
    in property <string> ticktick-list-name;
    in property <int> ticktick-header-hover;
    in property <bool> focus-complete-hover;
    in property <bool> focus-open-hover;
    in property <bool> focus-details-hover;
    in property <bool> focus-expanded;
    in property <length> ticktick-focus-scroll;
    in property <string> ticktick-status;
    in property <bool> ticktick-connected;
    in property <bool> ticktick-refreshing;
    in property <bool> ticktick-error;
    in property <bool> ticktick-pulse;
    in property <int> ticktick-next-completion-sequence;
    private property <bool> ticktick-next-completion-flash;
    private property <int> ticktick-visible-count: max(1,floor((self.height - 68px) / 36px));
    private property <length> ticktick-max-scroll: max(0px,(ticktick-total-count - ticktick-visible-count) * 36px);
    in property <bool> pressed;
    in property <bool> hovered;
    in property <bool> selected: false;
    in property <bool> folder-preview: false;
    in property <bool> layout-locked;
    in property <bool> resize-active;
    in property <AppTile> drag-preview-item;
    width: 128px;
    height: 128px;
    background: index < items.length && items[index].widget && !items[index].ticktick ? Theme.widget-background : transparent;
    border-radius: index < items.length && items[index].widget ? Theme.radius-widget : Theme.radius-control;
    border-width: index < items.length && items[index].widget ? Theme.border-width : 0px;
    border-color: Theme.separator;
    changed ticktick-next-completion-sequence => { if ticktick-next-completion-sequence > 0 { ticktick-next-completion-flash = true; completion-flash-timer.restart(); } }
    completion-flash-timer := Timer { running: root.ticktick-next-completion-flash; interval: 420ms; triggered => { root.ticktick-next-completion-flash = false; } }
    private property <length> item-icon-size: min(self.width * 0.75, self.height - 36px);
    private property <length> item-content-top: (self.height - item-icon-size - Theme.space-1 - 16px) / 2;
    if index < items.length && !items[index].widget && items[index].annotation == 0: Rectangle {
        x: (parent.width - self.width) / 2;
        width: root.item-icon-size + 2 * root.item-content-top;
        // The label line box includes space below the visible letters.
        height: parent.height - Theme.space-1;
        background: root.pressed ? Theme.press-overlay : root.hovered ? Theme.hover-overlay : transparent;
        border-radius: Theme.radius-control;
    }
    if index < items.length && !items[index].widget && items[index].annotation == 0: Rectangle {
        x: (parent.width - self.width) / 2; y: root.item-content-top;
        width: root.item-icon-size; height: self.width;
        border-radius: Theme.radius-sheet;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale-x: root.pressed ? 96% : 100%;
        transform-scale-y: self.transform-scale-x;
        animate transform-scale-x { duration: root.pressed ? 0ms : Theme.control-release; easing: ease-out; }
        animate transform-scale-y { duration: root.pressed ? 0ms : Theme.control-release; easing: ease-out; }
        if index < items.length && !folder-preview: ItemIcon { width: parent.width; height: parent.height; item: items[index]; }
        if index < items.length && folder-preview && !items[index].folder: ItemIcon {
            x: 4px; y: 8px; width: parent.width * 0.42; height: self.width; item: items[index];
        }
        if index < items.length && folder-preview && !items[index].folder: ItemIcon {
            x: parent.width * 0.52; y: 8px; width: parent.width * 0.42; height: self.width; item: drag-preview-item;
        }
        if index < items.length && folder-preview && items[index].folder: ItemIcon { width: parent.width; height: parent.height; item: items[index]; }
        if index < items.length && folder-preview && items[index].folder: ItemIcon {
            x: parent.width - 30px; y: parent.height - 30px; width: 28px; height: 28px; item: drag-preview-item;
        }
    }
    if index < items.length && items[index].annotation > 0: Rectangle {
        width: parent.width; height: parent.height;
        opacity: items[index].annotation-opacity;
        background: items[index].annotation == 1 ? (items[index].annotation-color-name == "#e8e5ef" ? #ffe39a : items[index].annotation-color) : transparent;
        border-radius: 2px;
        if items[index].annotation == 3: Image { width: parent.width; height: parent.height; source: items[index].icon; image-fit: contain; }
        if items[index].annotation != 3: OrbitText {
            x: 16px; y: 12px; width: parent.width - 32px; height: parent.height - 24px;
            text: items[index].name; color: items[index].annotation == 1 ? #1d1d1d : items[index].annotation-color; font-size: items[index].annotation-size * 1px;
            wrap: word-wrap; vertical-alignment: items[index].annotation == 1 ? center : top;
            horizontal-alignment: TextDirection.is-rtl(self.text) ? right : left;
        }
    }
    if index < items.length && items[index].widget && !items[index].ticktick: OrbitText { x: 16px; y: 12px; width: parent.width - (items[index].widget-kind == 16 ? 80px : 32px); height: 24px; text: items[index].name; color: Theme.text; font-size: Theme.type-body; font-weight: 600; overflow: elide; }
    if index < items.length && items[index].ticktick && !items[index].ticktick-next: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: Theme.widget-background;
        border-width: Theme.border-width; border-color: Theme.widget-border; border-radius: Theme.radius-widget;
        clip: true;
        Rectangle {
            x: 8px; y: 8px; width: parent.width - 100px; height: 32px;
            border-radius: Theme.radius-control;
            background: root.ticktick-header-hover == 1 ? (root.pressed ? Theme.press-overlay : Theme.hover-overlay) : transparent;
            OrbitText { x: 8px; width: parent.width - 30px; height: parent.height; text: ticktick-list-name; color: Theme.text; font-size: Theme.type-body; font-weight: 600; vertical-alignment: center; overflow: elide; }
            Path { x: parent.width - 18px; y: 14px; width: 8px; height: 4px; commands: "M 0 0 L 4 4 L 8 0"; fill: transparent; stroke: Theme.secondary; stroke-width: 1.5px; }
        }
        for button in 2: Rectangle {
            x: parent.width - 82px + button * 38px; y: 8px; width: 32px; height: 32px;
            border-radius: Theme.radius-control;
            background: root.ticktick-header-hover == button + 2 ? (root.pressed ? Theme.press-overlay : Theme.selection) : Theme.hover-overlay;
            border-width: Theme.border-width; border-color: Theme.widget-border;
            if button == 0: Path {
                x: 10px; y: 10px; width: 12px; height: 12px;
                commands: "M 6 0 L 6 12 M 0 6 L 12 6";
                fill: transparent; stroke: Theme.text; stroke-width: 1.7px;
            }
            if button == 1: Rectangle {
                x: 9px; y: 14.5px; width: 14px; height: 3px;
                for dot in 3: Rectangle { x: dot * 5.5px; width: 3px; height: 3px; border-radius: 1.5px; background: Theme.secondary; }
            }
        }
        Rectangle { x: 12px; y: 44px; width: parent.width - 24px; height: 1px; background: Theme.separator; }
        if !ticktick-refreshing && ticktick-tasks.length == 0: OrbitText {
            x: 14px; y: 56px; width: parent.width - 28px; height: parent.height - 68px;
            text: ticktick-error ? ticktick-status : !ticktick-connected ? "Connect TickTick in Settings" : "No tasks in this list";
            color: Theme.secondary; font-size: Theme.type-control; wrap: word-wrap; vertical-alignment: top;
        }
        for row in 3: Rectangle {
            visible: ticktick-refreshing && 96px + row * 36px < parent.height;
            x: 14px; y: 60px + row * 36px; width: (parent.width - 28px) * (row == 1 ? 0.62 : 0.84); height: 16px;
            border-radius: 4px; background: Theme.focus; opacity: ticktick-pulse ? 0.18 : 0.08;
            animate opacity { duration: 350ms; }
        }
        Rectangle {
            x: 0px; y: 52px; width: parent.width; height: max(0px,parent.height - 52px);
            background: transparent; clip: true;
            for task[row] in ticktick-tasks: Rectangle {
                visible: !ticktick-refreshing;
                x: 12px; y: row * 36px - ticktick-scroll-shift; width: parent.width - 24px; height: 36px;
                Rectangle { y: 35px; width: parent.width; height: 1px; background: Theme.separator; }
                property <color> priority-color: task.priority == 5 ? Theme.priority-high : task.priority == 3 ? Theme.priority-medium : task.priority == 1 ? Theme.priority-low : Theme.secondary;
                Rectangle {
                    x: task.rtl ? parent.width - 19px : 2px; y: 10px; width: 15px; height: 15px;
                    border-radius: 5px; border-width: 1.5px; border-color: priority-color;
                    background: task.done ? priority-color : priority-color.with-alpha(0.1);
                    if task.done: Path { x: 3px; y: 4px; width: 9px; height: 7px; commands: "M 0 3 L 3 6 L 9 0"; fill: transparent; stroke: Theme.sheet; stroke-width: 1.5px; }
                }
                Rectangle {
                    x: task.rtl ? (task.due == "" ? 2px : 76px) : 27px; y: 1px;
                    width: parent.width - (task.due == "" ? 31px : 105px); height: 33px; clip: true;
                    OrbitText {
                        width: parent.width; height: parent.height; text: task.title;
                        color: task.done ? Theme.secondary : Theme.text;
                        font-family: task.rtl ? "Amiri" : "Inter";
                        font-size: task.rtl ? 16px : Theme.type-control;
                        horizontal-alignment: task.rtl ? right : left;
                        overflow: elide; vertical-alignment: center;
                    }
                }
                if task.due != "": OrbitText { x: task.rtl ? 0px : parent.width - 72px; y: 1px; width: 70px; height: 33px; text: task.due; color: Theme.secondary; font-size: 11px * Theme.font-scale; horizontal-alignment: task.rtl ? left : right; vertical-alignment: center; }

            }
        }
        if !ticktick-refreshing && ticktick-max-scroll > 0px: scroll-track := Rectangle {
            x: parent.width - 9px; y: 52px; width: 4px; height: max(0px,parent.height - 64px);
            border-radius: 2px; background: Theme.focus.with-alpha(0.188);
            Rectangle {
                width: parent.width;
                height: min(parent.height,max(24px,parent.height * root.ticktick-visible-count / root.ticktick-total-count));
                y: (parent.height - self.height) * root.ticktick-scroll-offset / root.ticktick-max-scroll;
                border-radius: 2px; background: Theme.focus.with-alpha(0.72);
            }
        }
    }
    if index < items.length && items[index].ticktick-next: focus-card := Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: Theme.widget-background; border-radius: Theme.radius-widget; border-width: Theme.border-width; border-color: Theme.widget-border;
        clip: true;
        property <bool> compact: self.height <= 220px;
        property <length> body-top: self.compact ? 52px : 88px;
        property <length> body-height: max(0px,self.height - self.body-top - (self.compact ? 16px : 76px));
        property <color> accent: ticktick-tasks.length == 0 ? Theme.focus : ticktick-tasks[0].priority == 5 ? Theme.priority-high : ticktick-tasks[0].priority == 3 ? Theme.priority-medium : ticktick-tasks[0].priority == 1 ? Theme.priority-low : Theme.focus;
        OrbitText { x: 24px; y: 16px; width: parent.width - 104px; height: 22px; text: "Focus task"; color: Theme.secondary; font-size: Theme.type-control; font-weight: 600; vertical-alignment: center; }
        if !compact && ticktick-tasks.length > 0: OrbitText {
            x: 24px; y: 42px; width: parent.width - 104px; height: 20px;
            text: ticktick-list-name; color: Theme.focus; font-size: Theme.type-control; overflow: elide; vertical-alignment: center;
        }
        if ticktick-refreshing: Rectangle {
            x: 24px; y: parent.body-top; width: parent.width - 112px; height: 24px;
            border-radius: 6px; background: Theme.focus; opacity: ticktick-pulse ? 0.16 : 0.08;
            animate opacity { duration: 350ms; }
        }
        if !ticktick-refreshing && ticktick-tasks.length == 0: OrbitText {
            x: 24px; y: parent.body-top; width: parent.width - 48px; height: parent.body-height;
            text: ticktick-error ? ticktick-status : !ticktick-connected ? "Connect TickTick in Settings" : "No tasks for today";
            color: Theme.text; font-size: Theme.type-body; wrap: word-wrap; vertical-alignment: top;
        }
        if !ticktick-refreshing && ticktick-tasks.length > 0: Rectangle {
            x: parent.width - (parent.compact ? 56px : 68px); y: parent.compact ? 12px : 16px; width: parent.compact ? 32px : 44px; height: self.width;
            border-radius: self.width / 2; border-width: 1.5px; border-color: parent.accent;
            background: root.focus-complete-hover ? (root.pressed ? parent.accent.with-alpha(0.3) : parent.accent.with-alpha(0.18)) : parent.accent.with-alpha(0.08);
            Path { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 16px; height: 12px; commands: "M 0 6 L 5 11 L 16 0"; fill: transparent; stroke: parent.border-color; stroke-width: 2px; }
        }
        if !ticktick-refreshing && ticktick-tasks.length > 0: Rectangle {
            x: 24px; y: parent.body-top; width: parent.width - 48px; height: parent.body-height;
            Flickable {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                interactive: false; content-width: self.width;
                content-height: focus-body.content-height; content-y: -min(ticktick-focus-scroll,max(0px,self.content-height - self.height));
                focus-body := FocusTaskBody { width: parent.width; task: ticktick-tasks[0]; compact: focus-card.compact; expanded: root.focus-expanded; }
            }
            if focus-body.content-height > focus-card.body-height: Rectangle {
                x: parent.width + 14px; y: 0px; width: 3px; height: parent.height; border-radius: 2px; background: Theme.separator;
                Rectangle {
                    width: parent.width; height: min(parent.height,max(20px,parent.height * parent.height / focus-body.content-height));
                    y: (parent.height - self.height) * ticktick-focus-scroll / max(1px,focus-body.content-height - parent.height);
                    border-radius: 2px; background: Theme.focus.with-alpha(0.6);
                }
            }
        }
        if !compact && !ticktick-refreshing && ticktick-tasks.length > 0: Rectangle {
            x: 24px; y: parent.height - 56px; width: parent.width - 184px; height: 36px;
            border-radius: Theme.radius-control;
            background: root.focus-open-hover ? (root.pressed ? Theme.press-overlay : Theme.selection) : Theme.hover-overlay;
            OrbitText { x: 12px; width: parent.width - 42px; height: parent.height; text: "Open task"; color: Theme.text; font-size: Theme.type-control; font-weight: 500; vertical-alignment: center; }
            Path { x: parent.width - 24px; y: 13px; width: 10px; height: 10px; commands: "M 0 5 L 10 5 M 5 0 L 10 5 L 5 10"; fill: transparent; stroke: Theme.secondary; stroke-width: 1.5px; }
        }
        if !compact && !ticktick-refreshing && ticktick-tasks.length > 0: OrbitText {
            x: parent.width - 144px; y: parent.height - 56px; width: 88px; height: 36px;
            text: root.focus-expanded ? "Hide details" : "Details"; color: root.focus-details-hover ? Theme.text : Theme.secondary;
            opacity: root.focus-details-hover && root.pressed ? 0.65 : 1;
            font-size: Theme.type-control; horizontal-alignment: center; vertical-alignment: center;
        }
        Rectangle {
            width: parent.width; height: parent.height; border-radius: Theme.radius-widget; background: Theme.success;
            opacity: ticktick-next-completion-flash ? 0.1 : 0;
            animate opacity { duration: Theme.control-release; easing: ease-out; }
        }
    }
    if index < items.length && (items[index].widget || items[index].annotation == 3) && !root.layout-locked: Rectangle {
        x: parent.width - 32px; y: parent.height - 32px; width: 28px; height: 28px;
        border-radius: 14px;
        background: root.resize-active ? Theme.selection : root.hovered ? Theme.hover-overlay : transparent;
        Path {
            x: 6px; y: 6px; width: 16px; height: 16px;
            commands: "M 3 13 L 7 13 Q 13 13 13 7 L 13 3";
            fill: transparent; stroke: root.resize-active || root.hovered ? Theme.focus : Theme.secondary.with-alpha(0.4);
            stroke-width: 2px;
        }
    }
    if index < items.length && !items[index].widget && items[index].annotation == 0: OrbitText {
        y: items[index].widget ? parent.height - 28px : root.item-content-top + root.item-icon-size + Theme.space-1;
        x: 6px;
        width: parent.width - 12px;
        height: items[index].widget ? 24px : 16px;
        vertical-alignment: center;
        text: folder-preview ? (items[index].folder ? "Add to folder" : "Create folder") : items[index].name;
        color: Theme.text;
        font-size: folder-preview ? 14px : min(14px, max(10px, min(parent.width - 12px, parent.height) * 0.105));
        horizontal-alignment: center;
        overflow: elide;
    }
    if root.selected: Rectangle {
        width: parent.width; height: parent.height;
        border-width: 2px; border-radius: Theme.radius-control;
        border-color: Theme.selection-border;
        background: Theme.selection.with-alpha(0.08);
    }
}

component DockTile inherits Rectangle {
    in property <AppTile> item;
    in property <bool> enabled;
    in property <bool> recent;
    // Pointer x in the window; far away while the pointer is outside the dock.
    in property <length> pointer-x: -10000px;
    // False when the pointer is not over a dock icon, so a tile can tell that it was left for good.
    in property <bool> pointer-on-tiles: false;
    callback gesture(int,length,length);
    callback open();
    callback context-menu(bool, string, length, length);
    callback pointer-left();
    callback hover-entered(string, string, length);
    callback hover-moved(length);
    callback hover-left(string);
    background: transparent;
    accessible-role: button; accessible-label: item.name; accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.open(); } }

    // The macOS dock magnifies the icon under the pointer and its neighbours, with a smooth falloff.
    private property <length> center-x: self.absolute-position.x + self.width / 2;
    private property <float> pointer-distance: min(1.0, abs(self.center-x - root.pointer-x) / 170px);
    private property <float> pointer-falloff: (1.0 - self.pointer-distance) * (1.0 - self.pointer-distance) * (1.0 + 2.0 * self.pointer-distance);
    private property <float> hover-scale: 1.0 + 0.6 * self.pointer-falloff;
    // Magnified icons spread apart, as in the macOS dock: each icon moves by the room the icons before it take.
    private property <float> spread-distance: root.pointer-on-tiles ? clamp((self.center-x - root.pointer-x) / 170px, -1.0, 1.0) : 0.0;
    private property <float> spread-reach: abs(self.spread-distance);
    private property <float> spread-amount: (self.spread-distance < 0 ? -1.0 : 1.0)
        * (self.spread-reach - self.spread-reach * self.spread-reach * self.spread-reach + self.spread-reach * self.spread-reach * self.spread-reach * self.spread-reach / 2);
    private property <length> icon-center-x: self.center-x + root.spread-amount * 72px;
    private property <bool> hovered: dock-touch.has-hover;

    changed hovered => {
        // Keep a pointer that moved into a neighbour; clear one that left this slot or the dock.
        if !self.hovered && (!root.pointer-on-tiles || abs(self.center-x - root.pointer-x) < self.width / 2) {
            root.pointer-left();
        }
        if self.hovered {
            root.hover-entered(root.item.id, root.item.name, self.icon-center-x);
        } else {
            root.hover-left(root.item.id);
        }
    }
    ItemIcon {
        x: (parent.width - 48px) / 2 + root.spread-amount * 72px; y: parent.height - 56px; width: 48px; height: 48px; item: item; dock: true;
        animate x { duration: 80ms; easing: ease-out; }
        // Grow upward from the dock's bottom edge, as the macOS dock does.
        transform-origin: { x: self.width / 2, y: self.height };
        transform-scale-x: root.hover-scale * (dock-touch.pressed ? 0.94 : 1.0); transform-scale-y: self.transform-scale-x;
        animate transform-scale-x { duration: dock-touch.pressed ? 0ms : 80ms; easing: ease-out; }
        animate transform-scale-y { duration: dock-touch.pressed ? 0ms : 80ms; easing: ease-out; }
    }
    dock-touch := TouchArea {
        mouse-cursor: pointer; enabled: root.enabled;

        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.gesture(1,self.absolute-position.x + self.mouse-x,self.absolute-position.y + self.mouse-y);
                root.hover-entered(root.item.id, root.item.name, root.icon-center-x);
            }
            if event.kind == PointerEventKind.cancel { root.gesture(3,0px,0px); }
            if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down { root.gesture(0,self.absolute-position.x + self.mouse-x,self.absolute-position.y + self.mouse-y); }
                if event.kind == PointerEventKind.up { root.gesture(2,self.absolute-position.x + self.mouse-x,self.absolute-position.y + self.mouse-y); }
            }
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.context-menu(root.recent, root.item.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

export component Launcher inherits Window {
    callback load-widget-data();
    callback save-widget-data(string, string, string, string);
    callback load-local-widgets([AppTile],bool);
    callback record-widget-completions([CompletedReference]);
    callback choose-widget-audio();
    callback restore-widget-word(string);
    in-out property <string> widget-data-resource;
    changed items => { root.load-local-widgets(root.items,false); }
    callback delete-widget-data(string);
    in-out property <bool> widget-data-busy;
    in-out property <int> widget-data-category;
    in-out property <int> widget-data-page;
    in-out property <int> widget-data-count;
    in-out property <string> widget-data-search;
    pure callback widget-data-characters(string) -> int;
    in-out property <[int]> widget-data-counts;
    in-out property <[string]> widget-data-storage-labels;
    in-out property <[float]> widget-data-storage-fractions;
    in-out property <string> widget-data-summary;
    in-out property <string> widget-data-status;
    in-out property <string> widget-data-error;
    in-out property <[WidgetDataEntry]> widget-data-entries;
    in-out property <bool> widget-data-editing;
    in-out property <string> widget-data-delete-id;
    private property <string> widget-data-id;
    private property <string> widget-data-content;
    private property <string> widget-data-attribution;

    pure callback folder-target([AppTile],AppTile,int,int,int,int) -> int;
    pure callback hit-cell([AppTile],int,int) -> int;
    pure callback preview-valid([AppTile],string,int,int,int,int) -> bool;
    pure callback selection-has([string], string) -> bool;
    pure callback selection-toggle([string], string) -> [string];
    pure callback marquee-select([AppTile],[CanvasInk],float,float,float,float,[string],bool) -> [string];
    pure callback ink-view([InkSample], int, int, float) -> CanvasInk;
    pure callback preview-erase([CanvasInk], float, float, float, float) -> [CanvasInk];
    pure callback frame-index([CanvasFrameView], string) -> int;
    callback add-widget(int,int,int,bool);
    callback duplicate-widget(string);
    callback resize-item(string,int,int);
    private property <int> placing-widget: -1;
    private property <bool> widget-placement-target;
    private property <int> widget-placement-x;
    private property <int> widget-placement-y;
    private property <int> placing-width: 2 * root.item-size + root.grid-gap;
    private property <int> placing-height: 2 * root.item-size + root.grid-gap;
    private property <bool> widget-placement-valid: root.widget-placement-target
        && root.preview-valid(root.items,"@widget-preview",root.widget-placement-x,root.widget-placement-y,root.placing-width + root.grid-gap,root.placing-height + root.grid-gap);
    private property <length> grab-x;
    private property <length> grab-y;
    private property <int> focused-item: 0;
    private property <bool> keyboard-grid;
    private property <string> dock-hovered-id;
    private property <string> dock-hovered-name;
    private property <length> dock-hovered-x: -10000px;
    private property <bool> dock-tooltip-visible;
    private property <bool> show-dock-tooltip: root.dock-tooltip-visible && root.dock-hovered-name != "" && !root.dragging && root.dock-context == "" && !root.sheet && !root.alert && !root.folder-open && !root.settings;

    dock-tooltip-timer := Timer {
        interval: 50ms;
        running: false;
        triggered => {
            if root.dock-hovered-id != "" && !root.dragging && root.dock-context == "" && !root.sheet && !root.alert && !root.folder-open && !root.settings {
                root.dock-tooltip-visible = true;
            }
            self.stop();
        }
    }

    function dock-hover-entered(id: string, name: string, x: length) {
        if root.dock-hovered-id != id {
            root.dock-hovered-id = id;
            root.dock-hovered-name = name;
            root.dock-hovered-x = x;
            root.dock-tooltip-visible = false;
            dock-tooltip-timer.start();
        } else {
            root.dock-hovered-x = x;
        }
    }

    function dock-hover-moved(x: length) {
        root.dock-hovered-x = x;
    }

    function dock-hover-left(id: string) {
        if root.dock-hovered-id == id {
            root.dock-hovered-id = "";
            root.dock-hovered-name = "";
            root.dock-tooltip-visible = false;
            dock-tooltip-timer.stop();
        }
    }

    function dock-clear-hover() {
        root.dock-hovered-id = "";
        root.dock-hovered-name = "";
        root.dock-tooltip-visible = false;
        dock-tooltip-timer.stop();
    }

    private property <int> dock-source-index: -1;
    out property <bool> grid-navigation: !RobotWorkbench.visible && !root.search-context && !root.ai-active && canvas-focus.has-focus && !root.canvas-context && !root.settings && !root.sheet && !root.folder-open && !root.alert && !root.picker && !root.ticktick-open && !root.frame-editor && !root.annotation-editor;
    out property <bool> frame-shortcuts: !RobotWorkbench.visible && !root.canvas-context && root.context-index < 0 && root.frame-context-id == "" && !root.tool-active && !root.marquee-active && !root.panning && !root.dragging && root.home-visible && !root.busy && !root.sheet && !root.folder-open && !root.alert && !root.picker && !root.ticktick-open && !root.frame-editor && !root.annotation-editor && !root.search-context;
    out property <bool> canvas-shortcuts: root.frame-shortcuts && canvas-focus.has-focus;
    in-out property <bool> can-undo;
    in-out property <bool> can-redo;
    in-out property <bool> can-paste;
    callback edit-canvas(int, [string], float, float);
    callback pinch-canvas(float);
    pinch-canvas(delta) => {
        if root.launcher-visible && root.frame-shortcuts && AzanSettings.widget-id == "" {
            root.zoom-canvas(1 + delta);
        }
    }
    callback zoom-canvas(float);
    zoom-canvas(factor) => {
        CanvasState.zoom-at(root.width / 2px, root.height / 2px, factor);
        root.view-dirty = true;
        canvas-save-timer.start(); canvas-save-timer.restart();
    }
    callback canvas-command(int);
    canvas-command(command) => {
        if root.layout-locked && command != 3 { return; }
        root.flush-canvas();
        root.set-tool(root.tool-mode);
        root.edit-canvas(command, root.selected-ids,
            root.world-x(root.width / 2) / 1px, root.world-y(root.height / 2) / 1px);
    }
    callback select-tool(int);
    select-tool(mode) => { root.set-tool(mode); }
    private property <string> active-frame-id;
    callback cycle-frame(int);
    cycle-frame(direction) => {
        if root.frames.length == 0 { return; }
        let current = root.frame-index(root.frames, root.active-frame-id);
        let next = current < 0 ? (direction > 0 ? 0 : root.frames.length - 1)
            : min(root.frames.length - 1, max(0, current + direction));
        root.fit-frame-view(root.frames[next].id);
    }
    pure callback next-grid-item([AppTile],int,int) -> int;
    callback move-grid(int);
    move-grid(direction) => {
        root.keyboard-grid = true;
        root.focused-item = root.next-grid-item(root.items,root.focused-item,direction);
        if root.focused-item >= 0 && root.focused-item < root.items.length {
            let item = root.items[root.focused-item];
            root.reveal-item(item.col,item.row,item.span-x,item.span-y);
        }
    }
    callback activate-grid();
    activate-grid => { root.selected-ids = []; if root.focused-item >= 0 && root.focused-item < root.items.length { root.begin-drag(root.focused-item,false,0px,0px); root.end-drag(); } }
    callback context-focused();
    context-focused => { if root.focused-item >= 0 && root.focused-item < root.items.length { root.context-index = root.focused-item; RobotWorkbench.common-actions = []; if root.items[root.focused-item].robot != "" { RobotWorkbench.context-actions(root.items[root.focused-item].robot); } root.context-x = (CanvasState.pan-x + root.items[root.focused-item].col * CanvasState.zoom) * 1px; root.context-y = (CanvasState.pan-y + root.items[root.focused-item].row * CanvasState.zoom) * 1px; } }
    private property <bool> snapping;
    snap-timer := Timer { interval: 210ms; triggered => { root.snapping = false; self.stop(); } }
    animate drag-x { duration: root.snapping ? 200ms : 0ms; easing: ease-out; }
    animate drag-y { duration: root.snapping ? 200ms : 0ms; easing: ease-out; }
    private property <float> drag-scale: 1;
    animate drag-scale { duration: 160ms; easing: ease-out; }

    private property <bool> resizing;
    private property <int> resize-width;
    private property <int> resize-height;
    private property <bool> resize-valid: root.preview-valid(root.items,root.drag-item.id,root.drag-item.col,root.drag-item.row,root.resize-width,root.resize-height);
    private property <bool> drag-from-dock;
    private property <bool> on-dock: root.dragging && root.drag-y >= dock.absolute-position.y && root.drag-y <= dock.absolute-position.y + dock.height && root.drag-x >= dock.x && root.drag-x <= dock.x + dock.width;
    private property <int> dock-target: min(root.dock-items.length,max(0,floor((root.drag-x - dock-scroll.absolute-position.x + dock-scroll.content-x) / dock.slot-width) - root.recent-items.length));
    private property <bool> placement-valid: root.preview-valid(root.items,root.drag-item.id,root.drop-x,root.drop-y,root.drag-item.span-x,root.drag-item.span-y);
    private property <bool> panning;
    private property <bool> view-dirty;
    private property <float> pan-origin-x;
    private property <float> pan-origin-y;
    private property <length> pan-start-x;
    private property <length> pan-start-y;
    in-out property <int> font-size: 12;
    callback save-font-size(int);
    changed font-size => { Theme.font-size = root.font-size; }
    in-out property <color> ink-color-value: #e8e5ef;
    private property <string> ink-color: "#e8e5ef";
    in-out property <float> ink-size: 2.5;
    in-out property <float> text-size: 24;
    in-out property <float> ink-opacity: 1;
    in-out property <bool> annotation-editor;
    in-out property <string> annotation-error;
    private property <string> annotation-id;
    private property <string> annotation-text;
    private property <int> annotation-kind: 1;
    private property <int> annotation-x;
    private property <int> annotation-y;
    callback save-annotation(string,string,int,string,float,float,float,float);
    callback style-selection([string],string,float,float);
    laser-timer := Timer { interval: 70ms; triggered => {
        if root.ink-draft.length > 1 { root.ink-draft.remove(0); }
        else { root.ink-draft = []; self.stop(); }
    } }
    in-out property <[string]> selected-ids;
    in-out property <[CanvasFrameView]> frames;
    in-out property <[CanvasInk]> ink-strokes;
    in-out property <int> tool-mode: 0;
    in-out property <bool> ctrl-held;
    in-out property <bool> shift-held;
    private property <bool> marquee-active;
    private property <bool> marquee-additive;
    private property <[string]> marquee-selection;
    private property <length> marquee-start-x;
    private property <length> marquee-start-y;
    private property <length> marquee-end-x;
    private property <length> marquee-end-y;
    private property <[InkSample]> ink-draft;
    private property <[InkSample]> erase-draft;
    private property <[string]> erase-item-targets;
    pure callback preview-erase-items([AppTile],[string],float,float,float,float) -> [string];
    private property <[CanvasInk]> erase-preview;
    private property <bool> erase-preview-active;
    private property <bool> tool-active;
    callback add-ink([InkSample], string, float, float, int);
    callback erase-ink([InkSample]);
    callback ink-finished();
    ink-finished => {
        root.ink-draft = [];
        root.erase-preview-active = false;
        root.erase-item-targets = [];
        root.busy = false;
    }
    callback save-frame(string,string,string,[string]);
    callback delete-frame(string);
    callback frame-saved();
    callback frame-save-failed(string);
    callback fit-frame(string);
    callback fit-frame-action(string,float,float);
    in-out property <bool> frame-editor;
    private property <string> frame-edit-id;
    private property <string> frame-name-draft;
    in-out property <string> frame-keys-draft;
    in-out property <bool> frame-recording;
    private property <string> frame-error;
    private property <string> frame-context-id;
    callback set-add-position(float,float);
    callback show-all-items(float,float);
    callback reveal-item(int,int,int,int);
    reveal-item(col,row,width,height) => {
        let left = CanvasState.pan-x + col * CanvasState.zoom;
        let top = CanvasState.pan-y + row * CanvasState.zoom;
        let right = left + width * CanvasState.zoom;
        let bottom = top + height * CanvasState.zoom;
        let available-width = max(1,root.width / 1px - 48);
        let available-height = max(1,root.height / 1px - 266);
        let dx = left < 24 || width * CanvasState.zoom > available-width ? 24 - left : max(0,right - root.width / 1px + 24) * -1;
        let dy = top < 110 || height * CanvasState.zoom > available-height ? 110 - top : max(0,bottom - root.height / 1px + 156) * -1;
        if dx != 0 || dy != 0 {
            CanvasState.pan-x += dx; CanvasState.pan-y += dy;
            root.view-dirty = true; canvas-save-timer.start(); canvas-save-timer.restart();
        }
    }
    canvas-save-timer := Timer { interval: 300ms; triggered => { root.flush-canvas(); } }
    pure function world-x(x: length) -> length { return (x / 1px - CanvasState.pan-x) / CanvasState.zoom * 1px; }
    pure function world-y(y: length) -> length { return (y / 1px - CanvasState.pan-y) / CanvasState.zoom * 1px; }
    // The larger drag decides the size, so a diagonal or straight drag both work.
    function resize-delta(x: length, y: length) -> float {
        let dx = (x - root.drag-start-x) / 1px / CanvasState.zoom;
        let dy = (y - root.drag-start-y) / 1px / CanvasState.zoom;
        return abs(dx) >= abs(dy) ? dx : dy;
    }
    function flush-canvas() {
        canvas-save-timer.stop();
        if root.view-dirty {
            root.view-dirty = false;
            CanvasState.save-view(CanvasState.pan-x,CanvasState.pan-y,CanvasState.zoom);
        }
    }
    in-out property <bool> canvas-scrolling;
    in-out property <bool> canvas-scroll-gesture;
    canvas-scroll-timer := Timer {
        interval: 250ms; running: false;
        triggered => { root.canvas-scrolling = false; canvas-scroll-timer.stop(); }
    }
    callback continue-canvas-scroll(float, float) -> bool;
    continue-canvas-scroll(dx, dy) => {
        if !root.canvas-scrolling { return false; }
        if !root.frame-shortcuts || root.ctrl-held || AzanSettings.widget-id != "" {
            root.canvas-scrolling = false;
            return false;
        }
        root.wheel-canvas(0px, 0px, dx * 1px, dy * 1px);
        return true;
    }
    function wheel-canvas(x: length, y: length, dx: length, dy: length) {
        if root.dragging || root.panning || root.tool-active { return; }
        if root.ctrl-held {
            CanvasState.zoom-at(x / 1px, y / 1px, pow(1.0015, dy / 1px * root.canvas-speed));
        } else if root.shift-held {
            CanvasState.pan-x += (dy + dx) / 1px * root.canvas-speed;
        } else {
            CanvasState.pan-x += dx / 1px * root.canvas-speed;
            CanvasState.pan-y += dy / 1px * root.canvas-speed;
        }
        if !root.ctrl-held {
            root.canvas-scrolling = true;
            if root.canvas-scroll-gesture { canvas-scroll-timer.stop(); }
            else { canvas-scroll-timer.start(); canvas-scroll-timer.restart(); }
        }
        root.view-dirty = true;
        canvas-save-timer.start(); canvas-save-timer.restart();
    }
    function cancel-canvas() {
        root.canvas-scrolling = false;
        root.canvas-scroll-gesture = false;
        canvas-scroll-timer.stop();
        if root.panning { CanvasState.pan-x = root.pan-origin-x; CanvasState.pan-y = root.pan-origin-y; }
