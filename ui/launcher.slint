                root.resize-height = max(1,round(root.resize-width * root.drag-item.annotation-ratio));
                return;
            }
            root.resize-width = min(root.drag-item.max-span-x,max(root.drag-item.min-span-x,round(root.drag-item.span-x + (x - root.drag-start-x) / 1px / CanvasState.zoom)));
            root.resize-height = min(root.drag-item.max-span-y,max(root.drag-item.min-span-y,round(root.drag-item.span-y + (y - root.drag-start-y) / 1px / CanvasState.zoom)));
