                    }
                    else if event.text == "\n" && root.english-active && root.english-suggestion-selection >= 0 { root.english-apply(root.english-suggestion-selection); accept; }
                    else if event.text == "\n" { if self.text != "" || root.activated-prefix-id != "" { root.run-activated-prefix(); } accept; }
                    else if event.text == Key.Tab {
                        let matched = root.match-prefix(root.search-text);
