                width: parent.width; alignment: start; spacing: 8px;
                HorizontalLayout { height: max(24px,english-status-text.preferred-height); spacing: 8px;
                    english-status-text := OrbitText { horizontal-stretch: 1; wrap: word-wrap; text: root.english-error != "" ? root.english-error : root.english-status != "" ? root.english-status : root.english-loading ? "Preparing English assistance…" : ""; color: Theme.secondary; font-size: Theme.type-hint; overflow: elide; vertical-alignment: center; }
                    if !root.english-loading && root.english-error != "": AddOption { label: "Retry"; focus-on-click: false; height: 24px; option-width: 60px; clicked => { root.english-retry(); } }
                }
                if root.english-completion != "": HorizontalLayout {
                    height: max(28px, completion-label.preferred-height); spacing: 8px;
                    completion-label := OrbitText { horizontal-stretch: 1; text: "Autocomplete · " + root.english-completion-label; color: Theme.text; wrap: word-wrap; font-size: Theme.type-control; }
                    AddOption { label: "Accept word"; focus-on-click: false; height: 24px; option-width: 112px; clicked => { root.accept-next-word(); } }
                    if root.shortcut-hints[13] != "": Kbd { label: root.shortcut-hints[13]; }
                }
                if root.english-suggestions.length > 0: OrbitText { text: "Suggestions"; color: Theme.text; font-size: Theme.type-control; font-weight: 600; }
                for text[index] in root.english-suggestions: Rectangle {
                    private property <bool> selected: root.english-suggestion-selection == index;
                    changed selected => {
                        if self.selected {
                            if self.y + english-scroll.content-y < 0px { english-scroll.content-y = -self.y; }
                            else if self.y + self.height + english-scroll.content-y > english-scroll.height {
                                english-scroll.content-y = -min(self.y, self.y + self.height - english-scroll.height);
                            }
                        }
                    }
                    height: max(44px,suggestion-text.preferred-height + 20px);
                    background: suggestion-hit.pressed || self.selected ? Theme.selection : suggestion-hit.has-hover ? Theme.raised : Theme.field; border-radius: Theme.radius-control;
                    suggestion-text := OrbitText { x: 12px; y: 10px; width: parent.width - suggestion-kbd.width - 36px; text: text; wrap: word-wrap; color: Theme.text; font-size: Theme.type-body; }
                    suggestion-kbd := Kbd { x: parent.width - self.width - 12px; y: (parent.height - self.height) / 2; label: "Ctrl+" + (index + 1); }
                    suggestion-hit := TouchArea { mouse-cursor: pointer; clicked => { root.english-apply(index); } }
                }
                if root.english-grammar-checked: OrbitText { text: "Grammar feedback"; color: Theme.text; font-size: Theme.type-control; font-weight: 600; }
                if root.english-grammar-checked && root.english-issues.length == 0: OrbitText { text: "No English mistakes found"; color: Theme.secondary; font-size: Theme.type-control; }
                for issue[index] in root.english-issues: Rectangle {
                    height: grammar-content.preferred-height + 20px;
                    background: correction-hit.pressed ? Theme.selection : correction-hit.has-hover ? Theme.raised : Theme.field; border-radius: Theme.radius-control;
                    grammar-content := VerticalLayout {
                        x: 12px; y: 10px; width: parent.width - 24px; spacing: 6px;
                        OrbitText { text: issue.original + " → " + (issue.replacement == "" ? "Remove" : issue.replacement); wrap: word-wrap; color: Theme.focus; font-size: Theme.type-body; }
