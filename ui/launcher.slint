        background: transparent;
        TouchArea {
            clicked => { root.page-context = false; root.context-index = -1; root.dock-context = ""; root.context-id = ""; }
            pointer-event(event) => { if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { root.page-context = false; root.context-index = -1; root.dock-context = ""; root.context-id = ""; } }
        }
        Rectangle {
            x: max(0px, min(root.context-x, parent.width - self.width));
            y: max(0px, min(root.context-y, parent.height - self.height));
            width: 200px; height: min(parent.height - 16px, context-options.preferred-height);
            background: Theme.sheet; border-radius: Theme.radius-sheet; border-width: 1px; border-color: Theme.border;
            drop-shadow-color: Theme.surface-shadow;
            drop-shadow-blur: Theme.surface-shadow-blur;
            drop-shadow-offset-y: 8px;
            context-options := VerticalLayout {
                padding: 8px; spacing: 4px;
                if root.page-context: MenuOption { width: 184px; label: "Add item"; enabled: !root.layout-locked; clicked => { root.add-item("App"); } }
                if root.page-context && root.current-page < root.page-count: MenuOption { width: 184px; label: "Add page"; enabled: !root.layout-locked && root.page-count < 9 && !root.busy; clicked => { root.page-context = false; root.busy = true; root.add-page(); } }
                if root.page-context && root.current-page < root.page-count: MenuOption { width: 184px; label: "Move page left"; enabled: !root.layout-locked && root.current-page > 0 && !root.busy; clicked => { root.page-context = false; root.busy = true; root.reorder-page(-1); } }
                if root.page-context && root.current-page < root.page-count: MenuOption { width: 184px; label: "Move page right"; enabled: !root.layout-locked && root.current-page + 1 < root.page-count && !root.busy; clicked => { root.page-context = false; root.busy = true; root.reorder-page(1); } }
                if root.page-context && root.current-page < root.page-count: MenuOption { width: 184px; label: "Delete page"; destructive: true; enabled: !root.layout-locked && root.page-count > 1 && !root.busy; clicked => { root.page-context = false; root.confirm-delete-page(); } }
                if root.context-index >= 0 && root.items[root.context-index].ticktick && !root.items[root.context-index].ticktick-next: MenuOption { width: 184px; label: "New task"; clicked => { root.open-ticktick-create(root.items[root.context-index].ticktick-project-id); root.context-index = -1; } }
                if root.context-index >= 0 && root.items[root.context-index].widget: MenuOption { width: 184px; label: "Duplicate"; enabled: !root.layout-locked; clicked => { root.busy = true; root.duplicate-widget(root.items[root.context-index].id); root.context-index = -1; } }
                if root.context-index >= 0 && root.items[root.context-index].widget: MenuOption { width: 184px; label: "Resize · wider";
                    enabled: !root.layout-locked && root.preview-valid(root.items,root.items[root.context-index].id,root.items[root.context-index].row * grid.columns + root.items[root.context-index].col,root.items[root.context-index].span-x + 1,root.items[root.context-index].span-y,grid.columns,grid.rows);
                    clicked => { root.busy = true; root.widget-action(root.items[root.context-index].id,root.items[root.context-index].span-x + 1,root.items[root.context-index].span-y); root.context-index = -1; } }
                if root.context-index >= 0 && root.items[root.context-index].widget: MenuOption { width: 184px; label: "Resize · taller";
                    enabled: !root.layout-locked && root.preview-valid(root.items,root.items[root.context-index].id,root.items[root.context-index].row * grid.columns + root.items[root.context-index].col,root.items[root.context-index].span-x,root.items[root.context-index].span-y + 1,grid.columns,grid.rows);
                    clicked => { root.busy = true; root.widget-action(root.items[root.context-index].id,root.items[root.context-index].span-x,root.items[root.context-index].span-y + 1); root.context-index = -1; } }
                if root.context-index >= 0 && root.items[root.context-index].widget: MenuOption { width: 184px; label: "Resize · smaller";
                    enabled: !root.layout-locked && (root.items[root.context-index].span-x > root.items[root.context-index].min-span-x || root.items[root.context-index].span-y > root.items[root.context-index].min-span-y)
                        && root.preview-valid(root.items,root.items[root.context-index].id,root.items[root.context-index].row * grid.columns + root.items[root.context-index].col,max(root.items[root.context-index].min-span-x,root.items[root.context-index].span-x - 1),max(root.items[root.context-index].min-span-y,root.items[root.context-index].span-y - 1),grid.columns,grid.rows);
                    clicked => { root.busy = true; root.widget-action(root.items[root.context-index].id,max(root.items[root.context-index].min-span-x,root.items[root.context-index].span-x - 1),max(root.items[root.context-index].min-span-y,root.items[root.context-index].span-y - 1)); root.context-index = -1; } }
                if root.context-index >= 0 && !root.items[root.context-index].widget: MenuOption { width: 184px; label: root.items[root.context-index].folder ? "Rename" : "Edit"; clicked => {
                    root.edit-item(root.context-index);
                } }
                if root.context-index >= 0 && !root.items[root.context-index].widget: MenuOption { width: 184px; label: root.items[root.context-index].pinned ? "Unpin" : "Pin"; enabled: !root.layout-locked; clicked => { root.busy = true; root.pin-item(root.context-index); root.context-index = -1; } }
                if root.context-index >= 0: MenuOption { width: 184px; label: "Move to Page"; enabled: !root.layout-locked; clicked => { root.move-id = root.items[root.context-index].id; root.move-page = root.current-page; root.context-index = -1; } }
                if root.context-index >= 0: MenuOption { width: 184px; label: "Delete"; destructive: true; enabled: !root.layout-locked; clicked => {
                    root.editing = root.context-index;
                    root.app-name = root.items[root.context-index].name;
                    root.context-index = -1;
                    root.banner = ""; root.alert = true;
                    cancel-delete.focus();
                } }
                if root.dock-context == "pinned": MenuOption { width: 184px; label: "Unpin"; enabled: !root.layout-locked; clicked => { root.busy = true; root.unpin-dock-item(root.context-id); root.dock-context = ""; } }
                if root.dock-context == "recent": MenuOption { width: 184px; label: "Remove from Recent"; clicked => { root.busy = true; root.remove-recent-item(root.context-id); root.dock-context = ""; } }
            }
        }
    }
    if AzanSettings.widget-id != "": AzanSettingsSheet { width: root.width; height: root.height; }
    Rectangle {
        x: page.absolute-position.x; y: page.absolute-position.y;
        width: page.width; height: page.height; clip: true;
        visible: canvas-view.visible;
        canvas-view := CanvasView {
            private property <bool> previewing: root.page-dragging && root.page-vertical && root.current-page < root.page-count && root.page-drag-offset > 0px;
            visible: root.home-visible && CanvasState.enabled && (root.canvas-active || self.previewing || (root.transitioning && root.transition-from == root.page-count));
            opacity: self.previewing ? min(1,abs(root.page-drag-offset) / 96px) : 1;
            x: 0px; y: (root.transitioning && root.page-vertical
                ? root.transition-start + (-root.transition-direction * root.page-span - root.transition-start) * root.transition-progress
                    + (root.canvas-active ? root.transition-direction * root.page-span : 0px) : self.previewing ? root.page-drag-offset - root.page-span : 0px);
            width: parent.width; height: parent.height;
            active: root.canvas-active && !root.busy && !CanvasState.saving && !root.transitioning && !root.sheet && !root.folder-open && !root.alert && !root.picker;
            locked: root.layout-locked;
            add-box => { root.item-type = "Box"; CanvasState.error = ""; root.sheet = true; }
            back => { root.change-vertical-page(1); }
        }
    }
    if root.sheet && root.item-type == "Box": CanvasSheet {
        width: root.width; height: root.height;
        center-x: page.width / 2px; center-y: page.height / 2px;
        close => { root.sheet = false; page-focus.focus(); }
    }
    // Keeping the sheet instantiated preserves field focus while editing.
    sheet-backdrop := Rectangle {
        width: root.width; height: root.height;
        visible: root.sheet && root.item-type != "Box";
        opacity: root.sheet ? 1 : 0;
        animate opacity { duration: 120ms; easing: ease-out; }
        background: Theme.backdrop;
        TouchArea { enabled: !root.picker && !root.alert; clicked => { root.close-top-layer(); } }
        Panel {
            x: (parent.width - self.width) / 2;
            y: root.editing < 0 ? max(16px, (parent.height - min(760px, parent.height - 32px)) / 2) : (parent.height - self.height) / 2;
            width: min(560px, max(288px, parent.width - (parent.width >= 600px ? 48px : 32px)));
            height: min(root.editing >= 0 ? (root.item-type == "Website" ? 480px : root.item-type == "File" || root.item-type == "Directory" ? 336px : (root.custom && root.item-type == "App" ? 420px : 280px)) : (352px + max(100px, sheet-content.preferred-height) + (root.item-type == "App" ? 56px : 0px)), min(parent.height - 32px, 760px));
            animate height { duration: 180ms; easing: ease-out; }
            background: root.editing < 0 ? Theme.add-sheet : Theme.sheet;
            border-width: 1px;
            border-color: root.editing < 0 ? Theme.add-border : Theme.border;
            border-radius: Theme.radius-sheet;
            drop-shadow-color: Theme.surface-shadow;
            drop-shadow-blur: Theme.surface-shadow-blur;
            drop-shadow-offset-y: 8px;
            if root.editing < 0: Rectangle {
                x: 1px; y: parent.height - 88px; width: parent.width - 2px; height: 68px;
                background: Theme.add-footer;
            }
            TouchArea { }
            VerticalLayout {
                padding: root.editing < 0 ? 24px : 16px;
                spacing: root.editing < 0 ? 20px : 16px;
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        spacing: 6px; horizontal-stretch: 1;
                        OrbitText {
                            text: root.editing < 0 ? "Add item" : ("Edit " + root.item-type);
                            color: Theme.text; font-size: Theme.type-title; font-weight: 600;
                            vertical-alignment: center;
                        }
                        if root.editing < 0: OrbitText {
                            text: "Pick a type, then fill in the details.";
                            color: Theme.add-secondary; font-size: Theme.type-control;
                        }
                    }
                    AddOption { add-style: root.editing < 0;
                        label: "×";
                        width: 40px;
                        height: 40px;
                        accessible-label: "Close the top layer";
                        clicked => { root.close-top-layer(); }
                    }
                }
                if root.editing < 0: FlexboxLayout {
                    flex-wrap: wrap;
                    spacing: 8px;
                    AddOption { add-style: root.editing < 0; type-tile: true; option-width: max(72px, (root.sheet-content-width - 40px) / 6); icon-present: true; icon: @image-url("assets/add-window.svg"); label: "App"; selected: root.item-type == "App"; clicked => { root.add-item("App"); } }
                    AddOption { add-style: root.editing < 0; type-tile: true; option-width: max(72px, (root.sheet-content-width - 40px) / 6); icon-present: true; icon: @image-url("assets/add-globe.svg"); label: "Website"; selected: root.item-type == "Website"; clicked => { root.add-item("Website"); } }
                    AddOption { add-style: root.editing < 0; type-tile: true; option-width: max(72px, (root.sheet-content-width - 40px) / 6); icon-present: true; icon: @image-url("assets/add-file.svg"); label: "File"; selected: root.item-type == "File"; clicked => { root.add-item("File"); } }
                    AddOption { add-style: root.editing < 0; type-tile: true; option-width: max(72px, (root.sheet-content-width - 40px) / 6); icon-present: true; icon: @image-url("assets/add-dir.svg"); label: "Directory"; selected: root.item-type == "Directory"; clicked => { root.add-item("Directory"); } }
                    AddOption { add-style: root.editing < 0; type-tile: true; option-width: max(72px, (root.sheet-content-width - 40px) / 6); icon-present: true; icon: @image-url("assets/add-group.svg"); label: "Folder"; selected: root.item-type == "Folder"; clicked => { root.add-item("Folder"); } }
                    AddOption { add-style: root.editing < 0; type-tile: true; option-width: max(72px, (root.sheet-content-width - 40px) / 6); icon-present: true; icon: @image-url("assets/add-widgets.svg"); label: "Widgets"; selected: root.item-type == "Widgets"; clicked => { root.add-item("Widgets"); } }
                }
                if root.item-type == "App" && root.editing < 0: FlexboxLayout {
                    flex-wrap: wrap;
                    spacing: 8px;
                    AddOption { add-style: root.editing < 0; source-tab: true; label: "Custom command"; option-width: 148px; selected: root.app-source == "Custom command"; clicked => { root.app-source-changed("Custom command"); } }
                    AddOption { add-style: root.editing < 0; source-tab: true; label: "Actions"; selected: root.app-source == "Actions"; clicked => { root.app-source-changed("Actions"); } }
                    AddOption { add-style: root.editing < 0; source-tab: true; label: "Installed apps"; option-width: 132px; selected: root.app-source == "Installed apps"; clicked => { root.installed-filter = ""; root.filter-installed-apps(""); root.app-source-changed("Installed apps"); } }
                }
                sheet-scroll := Flickable {
                    interactive: true;
                    vertical-stretch: 1;
                    min-height: 100px;
                    content-width: self.width;
                    content-height: sheet-content.preferred-height;
                    sheet-content := VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                        height: self.preferred-height;
                        spacing: 12px;
                        if root.item-type == "App" && root.editing < 0 && root.app-source == "Actions": VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: 8px;
                            for action[index] in root.actions: VerticalLayout {
                                spacing: 6px;
                                if index == 0 || index == 4 || index == 8: OrbitText { text: index == 0 ? "System" : index == 4 ? "Audio" : "Media"; color: Theme.add-secondary; font-size: Theme.type-hint; font-weight: 600; height: 26px; }
                                AddItemRow {
                                    label: action.name; icon-present: true; icon: index == 0 ? @image-url("assets/add-lock.svg") : index == 1 ? @image-url("assets/add-shot.svg") : index == 2 ? @image-url("assets/add-moon.svg") : index == 3 ? @image-url("assets/add-logout.svg") : index == 4 ? @image-url("assets/add-vol-up.svg") : index == 5 ? @image-url("assets/add-vol-down.svg") : index == 6 ? @image-url("assets/add-mute.svg") : index == 7 ? @image-url("assets/add-mic-off.svg") : index == 8 ? @image-url("assets/add-play.svg") : index == 9 ? @image-url("assets/add-next.svg") : @image-url("assets/add-previous.svg");
                                    enabled: !root.busy;
                                    clicked => { root.busy = true; root.sheet-operation = "adding"; root.sheet-status = "Adding…"; root.add-system-action(action.id); }
                                }
                            }
                        }
                        if root.item-type == "App" && root.editing < 0 && root.app-source == "Installed apps": VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                AddField { add-style: true; label: "";
                                    text <=> root.installed-filter;
                                    placeholder: "Filter installed apps";
                                    enabled: !root.busy;
                                    horizontal-stretch: 1;
                                    edited => { root.filter-installed-apps(root.installed-filter); }
                                }
                            AddOption { add-style: root.editing < 0;
                                label: root.busy && root.sheet-operation == "refreshing" ? "Refreshing…" : "Refresh"; accessible-label: "Refresh search locations";
                                option-width: 112px;
                                enabled: !root.busy;
                                clicked => {
                                    root.busy = true;
                                    root.sheet-operation = "refreshing";
                                    root.sheet-status = "Refreshing… Cached apps stay available.";
                                    root.refresh-installed-apps();
                                }
                            }

                            }
                            OrbitText {
                                text: root.installed-status == "" ? (root.installed-apps-loaded ? "0 apps · Cached inventory" : "No cached apps. Refresh.") : root.installed-status;
                                color: Theme.secondary;
                                font-size: Theme.type-hint;

                            }
                            if root.installed-apps.length == 0 && root.installed-filter == "": OrbitText {
                                text: root.installed-apps-loaded ? "No items found" : "Refresh to load the list.";
                                color: Theme.secondary;
                                font-size: Theme.type-body;

                            }
                            if root.installed-filter != "" && !root.installed-apps-match: OrbitText {
                                text: "No items match this filter.";
                                color: Theme.secondary;
                                font-size: Theme.type-body;
                            }
                            VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                                spacing: 8px;
                                for app in root.installed-apps: AddItemRow {
                                    label: app.name; description: app.command; letter: app.letter;
                                    icon: app.icon; icon-present: app.icon-present;
                                    enabled: !root.busy;
                                    clicked => {
                                        root.busy = true;
                                        root.sheet-operation = "adding";
                                        root.sheet-status = "Adding…";
                                        root.add-installed-app(app.id);
                                    }
                                }
                            }
                        }
                        if root.item-type == "App" && root.custom && (root.editing >= 0 || root.app-source == "Custom command"): VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: root.editing < 0 ? 20px : 12px;
                            custom_name_field := AddField { add-style: root.editing < 0;
                                width: root.sheet-content-width;
                                label: "Name";
                                placeholder: "e.g. Terminal";
                                text <=> root.app-name;
                                error: root.name-error;
                                enabled: !root.busy;
                                edited => { root.name-error = ""; }
                                accepted => { custom_command_field.focus(); }
                            }
                            custom_command_field := AddField { add-style: root.editing < 0;
                                width: root.sheet-content-width;
                                label: "Command";
                                placeholder: "e.g. foot --title Terminal";
                                text <=> root.command;
                                error: root.command-error;
                                enabled: !root.busy;
                                multiline: true;
                                edited => { root.command-error = ""; }
                                accepted => { root.submit-form(); }
                            }
                            if root.editing < 0: OrbitText { text: "Enter the full command, including any arguments."; color: Theme.add-secondary; font-size: Theme.type-hint; wrap: word-wrap; }
                            HorizontalLayout {
                                width: root.sheet-content-width; height: 48px; spacing: 12px; alignment: start;
                                Rectangle {
                                    width: 48px; height: 48px; border-radius: Theme.radius-preview; background: Theme.selection;
                                    if root.icon-preview-present: Image { width: 48px; height: 48px; source: root.icon-preview; image-fit: contain; }
                                    if !root.icon-preview-present: OrbitText { text: root.icon-letter != "" ? root.icon-letter : root.app-name == "" ? "?" : root.first-letter(root.app-name); color: Theme.focus; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                AddOption { add-style: root.editing < 0; label: "Change icon"; option-width: 136px; height: 48px; enabled: !root.busy; clicked => { root.open-icon(root.icon-value, root.app-name); } }
                            }
                        }
                        if root.item-type == "App" && !root.custom && root.editing >= 0: VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: root.editing < 0 ? 20px : 12px;
                            AddField { add-style: root.editing < 0;
                                width: root.sheet-content-width;
                                label: "Name";
                                placeholder: "e.g. Terminal";
                                text <=> root.app-name;
                                error: root.name-error;
                                enabled: !root.busy;
                                edited => { root.name-error = ""; }
                                accepted => { root.submit-form(); }
                            }
                            HorizontalLayout {
                                width: root.sheet-content-width; height: 48px; spacing: 12px; alignment: start;
                                Rectangle {
                                    width: 48px; height: 48px; border-radius: Theme.radius-preview; background: Theme.selection;
                                    if root.icon-preview-present: Image { width: 48px; height: 48px; source: root.icon-preview; image-fit: contain; }
                                    if !root.icon-preview-present: OrbitText { text: root.icon-letter != "" ? root.icon-letter : root.app-name == "" ? "?" : root.first-letter(root.app-name); color: Theme.focus; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                AddOption { add-style: root.editing < 0; label: "Change icon"; option-width: 136px; height: 48px; enabled: !root.busy; clicked => { root.open-icon(root.icon-value, root.app-name); } }
                            }
                        }
                        if root.item-type == "Website": VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: root.editing < 0 ? 20px : 12px;
                            website_name_field := AddField { add-style: root.editing < 0;
                                width: root.sheet-content-width; label: "Name"; placeholder: "e.g. Work"; text <=> root.app-name; error: root.name-error; enabled: !root.busy; edited => { root.name-error = ""; } accepted => { website_url_field.focus(); } }
                            website_url_field := AddField { add-style: root.editing < 0;
                                width: root.sheet-content-width; label: "URL"; placeholder: "https://example.com"; text <=> root.url-or-path; error: root.url-error; enabled: !root.busy; edited => { root.website-url-changed(); } accepted => { root.submit-form(); } }
                            HorizontalLayout {
                                height: 44px; spacing: 8px; alignment: start;
                                AddOption { add-style: root.editing < 0; label: "Automatic"; selected: root.website-auto-icon; enabled: !root.busy; clicked => { root.website-auto-icon = true; root.website-url-changed(); } }
                                AddOption { add-style: root.editing < 0; label: "Custom icon"; selected: !root.website-auto-icon; option-width: 116px; enabled: !root.busy; clicked => { root.open-icon(root.icon-value, root.app-name); } }
                            }
                            HorizontalLayout {
                                height: 48px; spacing: 12px; alignment: start;
                                Rectangle {
                                    width: 48px; height: 48px; border-radius: Theme.radius-control; background: Theme.add-selected;
                                    if root.icon-preview-present: Image { width: 48px; height: 48px; source: root.icon-preview; image-fit: contain; }
                                    if !root.icon-preview-present: OrbitText { text: root.website-icon-loading ? "…" : root.icon-letter != "" ? root.icon-letter : root.app-name == "" ? "?" : root.first-letter(root.app-name); color: Theme.add-focus; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                OrbitText { text: root.website-auto-icon ? root.website-icon-status : "Custom icon"; color: Theme.add-secondary; font-size: Theme.type-hint; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                                if !root.website-auto-icon: AddOption { add-style: root.editing < 0; label: "Change icon"; option-width: 120px; enabled: !root.busy; clicked => { root.open-icon(root.icon-value, root.app-name); } }
                                if root.website-auto-icon && !root.website-icon-loading && root.valid-url(root.url-or-path): AddOption { add-style: root.editing < 0; label: "Retry"; option-width: 64px; enabled: !root.busy; clicked => { root.website-url-changed(); } }
                            }
                        }
                        if root.item-type == "Widgets": VerticalLayout {
                            width: root.sheet-content-width; alignment: start; spacing: Theme.space-3;
                            OrbitText {
                                width: root.sheet-content-width;
                                text: "Auto finds a free spot. Place lets you choose.";
                                color: Theme.secondary; font-size: Theme.type-control; wrap: word-wrap;
                            }
                            gallery := Rectangle {
                                width: root.sheet-content-width;
                                property <int> columns: self.width >= 440px ? 2 : 1;
                                property <length> card-width: (self.width - (self.columns - 1) * Theme.space-3) / self.columns;
                                height: ceil(13 / self.columns) * (236px + Theme.space-3) - Theme.space-3;
                                for name[index] in ["TickTick Tasks", "TickTick Focus Task", "Random Quote", "Random Fact", "Motivation", "Affirmation", "Vocabulary Builder", "Achievements", "Quran Player", "Azan Reminder", "Habit Tracker", "Remembrances", "Internet Usage"]: Rectangle {
                                    x: mod(index, gallery.columns) * (gallery.card-width + Theme.space-3);
                                    y: floor(index / gallery.columns) * (236px + Theme.space-3);
                                    width: gallery.card-width; height: 236px;
                                    background: Theme.field; border-width: Theme.border-width;
                                    border-color: Theme.border; border-radius: Theme.radius-widget;
                                    OrbitText {
                                        x: Theme.space-3; y: Theme.space-3; width: parent.width - 2 * Theme.space-3; height: 36px;
                                        text: name; color: Theme.text; font-size: Theme.type-body; font-weight: 600; wrap: word-wrap;
                                    }
                                    OrbitText {
                                        x: Theme.space-3; y: 48px; width: parent.width - 2 * Theme.space-3; height: 32px;
                                        text: index == 12 ? "Live vnStat · updates every minute" : index == 11 ? "Morning and evening · follows Azan Reminder" : index >= 2 ? "Local content · Settings → Data" : index == 0 ? "2 × 2 · choose a list" : "4 × 2 · focus task";
                                        color: Theme.secondary; font-size: Theme.type-hint; wrap: word-wrap;
                                    }
                                    Rectangle {
                                        width: min(parent.width - 2 * Theme.space-3, index == 1 ? 144px : index == 8 ? 108px : 72px);
                                        x: (parent.width - self.width) / 2; y: 92px; height: 72px;
                                        background: Theme.widget-surface; border-width: Theme.border-width;
                                        border-color: Theme.separator; border-radius: Theme.radius-control;
                                        OrbitText {
                                            x: Theme.space-2; y: Theme.space-2; width: parent.width - 2 * Theme.space-2; height: parent.height - 2 * Theme.space-2;
                                            text: index == 0 ? "Tasks\n☐ Task" : index == 1 ? "Focus task\n☐ Task" : index == 2 ? "“\nMake room" : index == 3 ? "360°\nA full circle" : index == 4 ? "One small\nstep" : index == 5 ? "I can take\nthis step" : index == 6 ? "curious\nفضولي" : index == 7 ? "Today\n✓ Finished" : index == 8 ? "بِسْمِ اللَّهِ\nQuran 1:1" : index == 9 ? "Next prayer\nSaved times" : index == 10 ? "☐ Read\n☐ Learn" : index == 11 ? "أذكار الصباح\n1 / 25" : "910.12 MiB\n428.61 MiB";
                                            color: Theme.secondary; font-size: Theme.type-hint; wrap: word-wrap; vertical-alignment: center;
                                        }
                                    }
                                    AddOption {
                                        x: Theme.space-3; y: 184px; option-width: (parent.width - 2 * Theme.space-3 - Theme.space-2) / 2;
                                        label: "Auto"; primary: true; accessible-label: "Add " + name + " automatically";
                                        enabled: !root.busy && !root.layout-locked;
                                        clicked => { root.busy = true; root.add-widget(index == 12 ? 20 : 7 + index,-1); root.sheet = false; }
                                    }
                                    AddOption {
                                        x: (parent.width + Theme.space-2) / 2; y: 184px; option-width: (parent.width - 2 * Theme.space-3 - Theme.space-2) / 2;
                                        label: "Place"; accessible-label: "Place " + name; enabled: !root.busy && !root.layout-locked;
                                        clicked => {
                                            root.placing-widget = index == 12 ? 20 : 7 + index;
                                            root.placing-width = (index == 1 ? 4 : index == 8 || index >= 11 ? 3 : 2) * root.item-size + (index == 1 ? 3 : index == 8 || index >= 11 ? 2 : 1) * root.grid-gap;
                                            root.placing-height = (index == 11 ? 5 : 2) * root.item-size + (index == 11 ? 4 : 1) * root.grid-gap;
                                            root.widget-placement-target = -1; root.sheet = false;
                                        }
                                    }
                                }
                            }
                        }
                        if root.item-type == "Folder": folder_name_field := AddField { add-style: root.editing < 0;
                                width: root.sheet-content-width;
                            label: "Name";
                            placeholder: "e.g. Work";
                            text <=> root.app-name;
                            error: root.name-error;
                            enabled: !root.busy;
                            edited => { root.name-error = ""; }
                            accepted => { root.submit-form(); }
                        }
                        if root.item-type == "File" || root.item-type == "Directory": VerticalLayout {
                            width: root.sheet-content-width; alignment: start; spacing: 12px;
                            FlexboxLayout { flex-wrap: wrap; spacing: 8px;
                            AddField { add-style: root.editing < 0;
                                width: root.editing < 0 && root.sheet-content-width >= 420px ? root.sheet-content-width - 156px : root.sheet-content-width;
                                label: "Path";
                                placeholder: root.item-type == "Directory" ? "/home/user/Documents" : "/home/user/Documents/file.pdf";
                                text <=> root.url-or-path;
                                error: root.path-error;
                                enabled: !root.busy;
                                edited => { root.path-error = ""; }
                                accepted => { root.submit-form(); }
                            }
                            VerticalLayout {
                                width: 148px; spacing: 0px; alignment: start;
                                if root.editing < 0 && root.sheet-content-width >= 420px: Rectangle { height: 24px; }
                            AddOption { add-style: root.editing < 0;
                                label: root.busy && root.sheet-operation == "choosing" ? "Choose…" : (root.item-type == "Directory" ? "Choose directory" : "Choose file");
                                option-width: 148px;
                                enabled: !root.busy;
                                clicked => {
                                    root.busy = true;
                                    root.sheet-operation = "choosing";
                                    root.sheet-status = "Choose a path…";
                                    root.choose-path(root.item-type == "Directory");
                                }
                            }
                            }
                            }
                            if root.editing < 0: OrbitText { text: root.item-type == "File" ? "Choose a file, or paste its full path." : "Choose a directory, or paste its full path."; color: Theme.add-secondary; font-size: Theme.type-hint; }
                            HorizontalLayout {
                                width: root.sheet-content-width; height: 48px; spacing: 12px; alignment: start;
                                Rectangle {
                                    width: 48px; height: 48px; border-radius: Theme.radius-preview; background: Theme.selection;
                                    if root.icon-preview-present: Image {
                                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                        width: 40px; height: 40px; source: root.icon-preview; image-fit: contain;
                                    }
                                    if !root.icon-preview-present: OrbitText { text: root.icon-letter != "" ? root.icon-letter : root.app-name == "" ? "?" : root.first-letter(root.app-name); color: Theme.focus; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                AddOption { add-style: root.editing < 0; label: "Change icon"; option-width: 136px; height: 48px; enabled: !root.busy; clicked => { root.open-icon(root.icon-value, root.app-name); } }
                            }
                        }
                        if root.sheet-status != "": OrbitText {
                            text: (root.sheet-operation == "adding" || root.sheet-operation == "saving" || root.sheet-operation == "refreshing") ? "◌ " + root.sheet-status : "! " + root.sheet-status;
                            color: root.sheet-operation == "adding" || root.sheet-operation == "saving" || root.sheet-operation == "refreshing" ? Theme.focus : Theme.error;
                            font-size: Theme.type-hint;
                            wrap: word-wrap;

                        }
                    }
                }
                if root.editing < 0: Rectangle { height: 1px; background: Theme.add-border; }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1;
                        if root.editing < 0: OrbitText { width: parent.width; height: parent.height; text: root.item-type == "App" && root.app-source == "Custom command" ? "Enter a name and a command to save." : root.item-type == "Website" ? "Enter a name and a URL to save." : root.item-type == "Folder" ? "Enter a name to save." : ""; color: Theme.add-secondary; font-size: Theme.type-hint; wrap: word-wrap; vertical-alignment: center; }
                    }
                    AddOption { add-style: root.editing < 0;
                        label: "Cancel";
                        enabled: !root.busy;
                        clicked => { root.close-top-layer(); }
                    }
                    if root.item-type == "Website" || root.item-type == "Folder" || root.item-type == "File" || root.item-type == "Directory" || (root.item-type == "App" && (root.editing >= 0 || root.app-source == "Custom command")): AddOption { add-style: root.editing < 0;
                        label: root.busy && root.sheet-operation == "saving" ? "Saving…" : "Save";
                        primary: true;
                        enabled: !root.busy && !(root.item-type == "Website" && root.website-auto-icon && root.website-icon-loading) && (root.editing >= 0 || (root.item-type == "File" || root.item-type == "Directory" ? root.valid-name(root.url-or-path) : root.valid-name(root.app-name) && (root.item-type == "Website" ? root.valid-url(root.url-or-path) : root.item-type == "App" && root.custom ? root.valid-command(root.command) : true)));
                        clicked => { root.submit-form(); }
                    }
                }
            }
        }
    }
    if root.picker: Rectangle {
        width: root.width; height: root.height; background: Theme.backdrop;
        TouchArea { clicked => { root.close-top-layer(); } }
        Panel {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(560px, parent.width - 32px); height: min(420px, parent.height - 32px);
            background: Theme.sheet; border-width: Theme.border-width; border-color: Theme.border; border-radius: Theme.radius-sheet;
            TouchArea { }
            VerticalLayout {
                padding: Theme.space-6; spacing: Theme.space-4;
                HorizontalLayout {
                    OrbitText { text: "Icon"; color: Theme.text; font-size: Theme.type-title; font-weight: 600; vertical-alignment: center; }
                    AddOption { label: "×"; option-width: 40px; accessible-label: "Close the top layer"; clicked => { root.close-top-layer(); } }
                }
                HorizontalLayout {
                    spacing: 8px; alignment: start;
                    AddOption { label: "Letter"; option-width: 80px; selected: root.icon-mode == "Letter"; clicked => { root.icon-mode = "Letter"; root.icon-error = ""; } }
                    AddOption { label: "SVG"; option-width: 72px; selected: root.icon-mode == "SVG"; clicked => { root.icon-mode = "SVG"; root.icon-error = ""; } }
                    AddOption { label: "URL"; option-width: 72px; enabled: false; }
                    AddOption { label: "Choose icon"; option-width: 128px; selected: root.icon-mode == "Choose icon"; clicked => { root.icon-mode = "Choose icon"; root.icon-error = ""; } }
                }
                VerticalLayout {
                    alignment: start; spacing: 8px;
                    if root.icon-mode == "Letter": AddField {
                        width: parent.width;
                        label: "Letter"; placeholder: "A, AB, or an emoji"; text <=> root.letter-draft;
                    }
                    if root.icon-mode == "Letter": OrbitText { text: "1–2 characters, including emojis"; color: Theme.secondary; font-size: Theme.type-hint; }
                    if root.icon-mode == "SVG": AddField {
                        width: parent.width;
                        label: "SVG"; placeholder: "Paste SVG markup"; multiline: true; text <=> root.svg-draft;
                    }
                    if root.icon-mode == "Choose icon": AddOption { label: root.icon-busy ? "Choosing…" : "Choose icon"; option-width: 144px; enabled: !root.icon-busy; clicked => { root.icon-busy = true; root.choose-icon(root.icon-session); } }
                    if root.icon-mode == "Choose icon": OrbitText { text: root.icon-file-draft == "" ? "PNG, JPEG, SVG or ICO" : root.icon-file-draft; color: Theme.secondary; font-size: Theme.type-hint; overflow: elide; }
                    if root.icon-error != "": OrbitText { text: root.icon-error; color: Theme.error; font-size: Theme.type-hint; wrap: word-wrap; }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    AddOption { label: "Cancel"; clicked => { root.close-top-layer(); } }
                    Rectangle { horizontal-stretch: 1; }
                    AddOption { label: root.icon-busy ? "Saving…" : "Save"; primary: true; enabled: !root.icon-busy;
                        clicked => { root.icon-busy = true; root.save-icon(root.icon-mode, root.icon-mode == "Letter" ? root.letter-draft : root.icon-mode == "SVG" ? root.svg-draft : root.icon-file-draft, root.icon-session); }
                    }
                }
            }
        }
    }
    folder-backdrop := Rectangle {
        width: root.width; height: root.height;
        visible: root.folder-open || root.folder-closing;
        opacity: root.folder-open && !root.drag-outside-folder ? 1 : 0;
        animate opacity { duration: Theme.folder-transition; easing: ease-out; }
        background: Theme.backdrop;
        TouchArea { enabled: root.folder-open; clicked => { root.close-folder-view(); } }
        folder-panel := Panel {
            x: root.folder-open ? (parent.width - self.width) / 2 : grid.absolute-position.x + root.items[root.folder-index].col * grid.tile-size + (root.item-size * 1px - self.width) * 0.5;
            y: root.folder-open ? (parent.height - self.height) / 2 : grid.absolute-position.y + root.items[root.folder-index].row * grid.tile-size + (root.item-size * 1px - self.height) * 0.5;
            width: root.folder-open ? min(560px, parent.width - 32px) : 128px;
            height: root.folder-open ? min(60px + ceil(root.folder-items.length / folder-grid.columns) * folder-grid.row-step, parent.height - 48px) : 128px;
            animate x { duration: Theme.folder-transition; easing: ease-out; }
            animate y { duration: Theme.folder-transition; easing: ease-out; }
            transform-scale-x: root.folder-open ? 100% : 0%;
            transform-scale-y: root.folder-open ? 100% : 0%;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            animate transform-scale-x { duration: Theme.folder-transition; easing: ease-out; }
            animate transform-scale-y { duration: Theme.folder-transition; easing: ease-out; }
            background: Theme.sheet; border-radius: Theme.radius-sheet;
            border-width: 1px; border-color: Theme.border;
            TouchArea { enabled: root.folder-open; }
            VerticalLayout {
                visible: root.folder-open || root.folder-closing;
                opacity: root.folder-open && !root.drag-outside-folder ? 1 : 0;
                animate opacity { duration: Theme.folder-transition; easing: ease-out; }
                padding: 16px; spacing: 16px;
                OrbitText { height: 28px; text: root.folder-name; color: Theme.text; font-size: Theme.type-title; font-weight: 600; overflow: elide; }
                folder-scroll := Flickable {
                    mouse-drag-pan-enabled: false;
                    content-width: self.width;
                    content-height: folder-grid.height;
                    folder-grid := Rectangle {
                        width: parent.width;
                        property <length> row-step: 112px + root.grid-gap * 1px;
                        property <int> columns: max(1, floor((self.width + root.grid-gap * 1px) / self.row-step));
                        property <length> column-step: (self.width + root.grid-gap * 1px) / self.columns;
                        height: max(0px, ceil(root.folder-items.length / self.columns) * self.row-step - root.grid-gap * 1px);
                        for index in root.folder-items.length: Rectangle {
                            property <int> compact-index: index - (index > root.drag-index ? 1 : 0);
                            property <int> position: root.dragging && root.drag-from-folder && !root.drag-outside-folder && root.drop-target >= 0
                                ? self.compact-index + (self.compact-index >= root.drop-target ? 1 : 0) : index;
                            x: mod(self.position, folder-grid.columns) * folder-grid.column-step;
                            y: floor(self.position / folder-grid.columns) * folder-grid.row-step;
                            width: folder-grid.column-step - root.grid-gap * 1px; height: 112px;
                            border-radius: Theme.radius-control;
                            property <bool> hovered: root.folder-open && folder-input.has-hover
                                && floor(folder-input.mouse-y / folder-grid.row-step) * folder-grid.columns + floor(folder-input.mouse-x / folder-grid.column-step) == self.position
                                && mod(folder-input.mouse-x, folder-grid.column-step) < folder-grid.column-step - root.grid-gap * 1px
                                && mod(folder-input.mouse-y, 128px) < 112px;
                            background: folder-input.pressed && root.drag-index == index && !root.dragging ? Theme.press-overlay : self.hovered ? Theme.hover-overlay : transparent;
                            opacity: root.dragging && root.drag-from-folder && index == root.drag-index ? 0 : 1;
                            animate x { duration: 120ms; easing: ease-out; }
                            animate y { duration: 120ms; easing: ease-out; }
                            ItemIcon {
                                x: (parent.width - self.width) / 2; y: 8px;
                                width: 64px; height: 64px; item: root.folder-items[index];
                            }
                            OrbitText {
                                x: 8px; y: 80px; width: parent.width - 16px; height: 20px;
                                text: root.folder-items[index].name; color: Theme.text; font-size: Theme.type-control;
                                horizontal-alignment: center; vertical-alignment: center; overflow: elide;
                            }
                        }
                    }
                    folder-input := TouchArea {
                        y: -folder-scroll.content-y;
                        width: parent.width; height: parent.height;
                        enabled: root.folder-open && !root.busy;
                        pointer-event(event) => {
                            let x = self.absolute-position.x + self.mouse-x;
                            let y = self.absolute-position.y + self.mouse-y;
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                let dx = x - folder-grid.absolute-position.x;
                                let dy = y - folder-grid.absolute-position.y;
                                let index = floor(dy / folder-grid.row-step) * folder-grid.columns + floor(dx / folder-grid.column-step);
                                root.begin-drag(index >= 0 && index < root.folder-items.length ? index : -1, true, x, y);
                            }
                            if event.kind == PointerEventKind.move { root.move-drag(x, y); }
                            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left { root.move-drag(x,y); root.end-drag(); }

                        }
                    }
                }
            }
        }
    }
    if root.resizing: Rectangle {
        x: grid.absolute-position.x + root.drag-item.col * grid.tile-size + root.grid-gap * 0.5px;
        y: grid.absolute-position.y + root.drag-item.row * grid.tile-size + root.grid-gap * 0.5px;
        width: root.resize-width * grid.tile-size - root.grid-gap * 1px; height: root.resize-height * grid.tile-size - root.grid-gap * 1px;
        border-width: 3px; border-radius: Theme.radius-preview; border-color: root.resize-valid ? Theme.placement-valid : Theme.placement-invalid;
        background: Theme.placement-valid.with-alpha(0.094);
    }
    alert-backdrop := Rectangle {
        width: root.width; height: root.height;
        visible: root.alert;
        opacity: root.alert ? 1 : 0;
        animate opacity { duration: 120ms; easing: ease-out; }
        background: Theme.backdrop;
        TouchArea { enabled: !root.busy; clicked => { root.alert = false; } }
        Panel {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(360px, parent.width - 32px); height: root.banner == "" ? 190px : 250px;
            background: Theme.sheet; border-radius: Theme.radius-sheet; border-width: 1px; border-color: Theme.border;
            drop-shadow-color: Theme.surface-shadow;
            drop-shadow-blur: Theme.surface-shadow-blur;
            drop-shadow-offset-y: 8px;
            TouchArea { }
            VerticalLayout {
                padding: 24px; spacing: 16px;
                OrbitText {
                    text: root.items[root.editing].folder ? ("Delete folder '" + root.app-name + "'? Its apps will move to the page.")
                        : ("Delete '" + root.app-name + "' from Orbit?");
                    color: Theme.text; font-size: 17px; wrap: word-wrap;
                }
                if root.banner != "": OrbitText { text: root.banner; color: Theme.error; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 12px;
                    cancel-delete := AddOption { label: "Cancel"; enabled: !root.busy; clicked => { root.alert = false; } }
                    AddOption {
                        label: "Delete"; destructive: true; enabled: !root.layout-locked && !root.busy;
                        clicked => { root.busy = true; root.delete-item(root.editing); }
                    }
                }
            }
        }
    }
    for toast[row] in root.toast-items: ToastCard {
        depth: root.toast-items.length - row - 1;
        expanded: root.toasts-hovered;
        x: Theme.space-4;
        y: root.height - Theme.space-4 - self.height - (root.toasts-hovered ? (self.depth * 52px) : (self.depth == 0 ? 0px : self.depth == 1 ? 10px : 18px));
        available-width: root.width - 2 * Theme.space-4;
        item: toast;
        hover-changed(hovered) => { root.toast-card-hovered(hovered); }
        dismissed(id) => { root.dismiss-toast(id); }
    }
    if (root.dragging || root.snapping) && !root.resizing: Rectangle {
        x: root.drag-x - root.grab-x * root.drag-scale;
        y: root.drag-y - root.grab-y * root.drag-scale;
        // Folder children have no page rectangle; size the preview from the folder tile.
        width: (root.drag-from-folder ? folder-grid.column-step - root.grid-gap * 1px : root.drag-item.span-x * 1px - root.grid-gap * 1px) * root.drag-scale;
        height: (root.drag-from-folder ? 112px : root.drag-item.span-y * 1px - root.grid-gap * 1px) * root.drag-scale;
        Rectangle {
            x: 0px; y: 6px; width: parent.width; height: parent.height;
            border-radius: root.drag-item.widget ? Theme.radius-widget : Theme.radius-sheet; background: Theme.launcher-background;
            opacity: root.dragging ? 0.38 : 0;
            animate opacity { duration: 160ms; easing: ease-out; }
        }
        PageTile {
            width: parent.width; height: parent.height; items: [root.drag-item]; index: 0; hovered: true;
            opacity: root.merge-ready ? 0.72 : 1;
            animate opacity { duration: 180ms; easing: ease-out; }
        }
        if root.drag-item.widget: LocalWidget {
            x: 16px; y: 48px;
            width: max(0px, parent.width - 32px);
            height: max(0px, parent.height - (root.drag-item.widget-kind == 18 || root.drag-item.widget-kind == 19 ? 60px : 84px));
            widget-id: root.drag-item.id;
            enabled: false;
        }
        if root.drag-item.widget: Rectangle {
            width: parent.width; height: parent.height;
            border-width: 2px; border-radius: Theme.radius-widget;
            border-color: root.placement-valid && root.reorder-ready ? Theme.placement-valid : Theme.placement-invalid;
            background: transparent;
        }
    }
}
