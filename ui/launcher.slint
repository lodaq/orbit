                Rectangle { horizontal-stretch: 1; }
                AddOption { label: "Copy"; option-width: 84px; enabled: root.ai-answer != ""; clicked => { ai-answer-field.select-all(); ai-answer-field.copy(); } }
            }
        }
    }
    english-panel := Panel {
        visible: !(root.drag-from-search && root.dragging) && !root.ai-active && root.english-active && (root.english-loading || root.english-error != "" || root.english-status != "" || root.english-suggestions.length > 0 || root.english-grammar-checked);
        x: search-bar.x; y: search-bar.y + search-bar.height + 12px;
