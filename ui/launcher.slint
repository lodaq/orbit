    callback focus-search();
    callback page-key(int);
    focus-search => { if !root.sheet && !root.folder-open && root.context-index < 0 && root.dock-context == "" { root.settings = false; search-input.focus(); } }
    page-key(direction) => { if !root.ai-active && !root.sheet && !root.folder-open && root.search-text == "" && !root.settings && root.context-index < 0 && root.dock-context == "" { root.change-page(root.current-page + direction); } }

