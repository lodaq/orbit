    function tool-pointer(event: PointerEvent, x: length, y: length) {
        if root.busy { return; }
        if root.layout-locked && root.tool-mode >= 2 && root.tool-mode != 9 { return; }
        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
            root.flush-canvas();
            root.cancel-drag();
            root.canvas-context = false;
            root.context-index = -1;
            root.frame-context-id = "";
            if root.tool-mode == 1 {
                root.pan-origin-x = CanvasState.pan-x; root.pan-origin-y = CanvasState.pan-y;
                root.pan-start-x = x; root.pan-start-y = y; root.panning = true;
            } else if root.tool-mode >= 4 && root.tool-mode <= 6 {
                root.annotation-id = ""; root.annotation-kind = root.tool-mode == 4 ? 1 : root.tool-mode == 5 ? 2 : 3;
                root.annotation-text = ""; root.annotation-error = "";
                root.annotation-x = round(root.world-x(x) / 1px); root.annotation-y = round(root.world-y(y) / 1px);
                if root.tool-mode == 6 { root.busy = true; root.save-annotation("","Image",3,root.ink-color,root.text-size,root.ink-opacity,root.annotation-x,root.annotation-y); }
                else { root.annotation-editor = true; }
            } else if (root.tool-mode == 2 || root.tool-mode >= 7) {
                laser-timer.stop();
                root.ink-draft = [{ x: root.world-x(x) / 1px, y: root.world-y(y) / 1px }];
                root.tool-active = true;
            } else if root.tool-mode == 3 {
                root.erase-draft = [{ x: root.world-x(x) / 1px, y: root.world-y(y) / 1px }];
                root.erase-preview = root.preview-erase(root.ink-strokes, root.world-x(x) / 1px, root.world-y(y) / 1px, root.world-x(x) / 1px, root.world-y(y) / 1px);
                root.erase-item-targets = root.preview-erase-items(root.items, [], root.world-x(x) / 1px,root.world-y(y) / 1px,root.world-x(x) / 1px,root.world-y(y) / 1px);
                root.erase-preview-active = true;
