        }
        if !root.dragging {
            if (!root.drag-from-dock && root.drag-index >= (root.drag-from-folder ? root.folder-items.length : root.items.length))
                || (sqrt((x - root.drag-start-x)*(x - root.drag-start-x)/1px/1px + (y - root.drag-start-y)*(y - root.drag-start-y)/1px/1px) < 6) { return; }
