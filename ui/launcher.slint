        root.drag-index = index;
        root.drag-from-folder = folder;
        root.drag-start-x = x; root.drag-start-y = y;
        root.drag-x = x; root.drag-y = y;
        if index >= 0 && index < (folder ? root.folder-items.length : root.items.length) {
            root.drag-item = folder ? root.folder-items[index] : root.items[index];
            root.grab-x = folder ? (x - folder-grid.absolute-position.x - mod(index, folder-grid.columns) * folder-grid.column-step) * CanvasState.zoom
                : x - (CanvasState.pan-x + (root.drag-item.col + root.grid-gap / 2) * CanvasState.zoom) * 1px;
            root.grab-y = folder ? (y - folder-grid.absolute-position.y - floor(index / folder-grid.columns) * folder-grid.row-step) * CanvasState.zoom
                : y - (CanvasState.pan-y + (root.drag-item.row + root.grid-gap / 2) * CanvasState.zoom) * 1px;
