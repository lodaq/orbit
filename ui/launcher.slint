            y: 19px; width: 1px; height: 52px; background: #a6b1ed26;
        }
    }
    if root.on-dock: Rectangle {
        x: dock.x + (root.recent-items.length + root.dock-target) * dock.slot-width;
        y: dock.y + 8px; width: 4px; height: dock.height - 16px;
        background: !root.drag-item.widget && (root.dock-items.length < 8 || root.drag-item.pinned) ? #71ddcf : #ee9a8b;
    }
    Image { x: 48px; y: root.height - 22px; width: 105px; height: 15px; source: @image-url("assets/page-hint.svg"); }
    Image { x: root.width - 160px; y: root.height - 21px; width: 112px; height: 13px; source: @image-url("assets/close-hint.svg"); }
    if root.search-text != "" && !root.settings: Flickable {
        x: (root.width - self.width) / 2; y: 104px; width: min(1316px, root.width - 96px); height: root.height - 238px;
        content-y <=> root.search-offset;
        content-height: max(self.height, ceil(root.search-results.length / root.search-columns) * 164px);
        for item[index] in root.search-results: Rectangle {
            x: mod(index, root.search-columns) * (parent.width / root.search-columns) + 6px;
            y: floor(index / root.search-columns) * 164px;
            width: parent.width / root.search-columns - 12px; height: 152px;
            background: index == root.search-selection ? #a8b3ff26 : result-hit.has-hover ? #ffffff0c : transparent;
            border-width: index == root.search-selection ? 2px : 0px;
            border-color: #a8b3ff99; border-radius: 16px;
            ItemIcon { x: (parent.width - 80px) / 2; y: 10px; width: 80px; height: 80px; item: item; }
            Text { x: 8px; y: 98px; height: 24px; width: parent.width - 16px; text: item.name; color: #e0e3f4; font-size: 13px; horizontal-alignment: center; overflow: elide; }
            if item.page < 0: Text {
                y: 126px; width: parent.width; height: 18px;
                text: item.page == -1 ? "Actions" : item.page == -2 ? "Installed apps" : item.page == -3 ? "File" : "Directory";
                color: #a7adc7; font-size: 11px; horizontal-alignment: center;
            }
            result-hit := TouchArea { mouse-cursor: pointer; enabled: !root.busy; clicked => { root.search-selection = index; root.activate-search-selection(); } }
        }
        if root.search-results.length == 0: Text { text: "No items found"; color: #a7adc7; }
    }
    if root.settings: Rectangle {
        x: 48px; y: 112px;
        width: root.width - 96px; height: root.height - 192px;
        background: #20243b; border-color: #a6b1ed26; border-width: 1px; border-radius: 20px;
        VerticalLayout {
            padding: 28px; spacing: 16px;
            HorizontalLayout {
                Text { text: "Settings"; font-size: 24px; color: #e0e3f4; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Esc to close"; color: #7881a4; font-size: 12px; vertical-alignment: center; }
            }
            HorizontalLayout {
                spacing: 8px;
                AddOption { label: "General"; selected: !root.shortcuts-tab; clicked => { root.shortcuts-tab = false; root.shortcut-recording = false; } }
                AddOption { label: "Shortcuts"; selected: root.shortcuts-tab; clicked => { root.shortcuts-tab = true; } }
            }
            if root.page-count > 1 && !root.shortcuts-tab: HorizontalLayout {
                AddOption { label: "Move page left"; option-width: 150px; enabled: root.current-page > 0; clicked => { root.busy = true; root.reorder-page(-1); } }
                AddOption { label: "Move page right"; option-width: 150px; enabled: root.current-page + 1 < root.page-count; clicked => { root.busy = true; root.reorder-page(1); } }
            }
            if root.banner != "": Text { text: root.banner; color: Theme.error; wrap: word-wrap; }
            if !root.shortcuts-tab: VerticalLayout {
            horizontal-stretch: 1; vertical-stretch: 1;
            spacing: 16px;
            HorizontalLayout {
                spacing: 10px;
                AddOption { label: "Delete page"; option-width: 132px; destructive: true; enabled: root.page-count > 1 && !root.busy; clicked => { root.confirm-delete-page(); } }
                AddOption { label: "Add page"; option-width: 132px; enabled: root.page-count < 9 && !root.busy; clicked => { root.busy = true; root.add-page(); root.settings = false; } }
                AddOption { label: "Refresh installed apps"; option-width: 190px; enabled: !root.busy; clicked => { root.busy = true; root.refresh-installed-apps(); } }
                AddOption { label: "Export data"; option-width: 132px; enabled: !root.busy; clicked => { root.busy = true; root.data-busy = true; root.data-status = ""; root.transfer-data(false); } }
                AddOption { label: "Import data"; option-width: 132px; enabled: !root.busy; clicked => { root.busy = true; root.data-busy = true; root.data-status = ""; root.transfer-data(true); } }
            }
            if root.data-status != "": Text { text: root.data-status; color: Theme.secondary; wrap: word-wrap; font-size: 12px; }
            HorizontalLayout {
                spacing: 12px;
                Text { text: "Page margin (px)"; color: Theme.text; vertical-alignment: center; }
                SpinBox { minimum: 0; maximum: 64; value <=> root.page-margin; }
                Text { text: "Home Screen > Grid Cell Size"; color: Theme.text; vertical-alignment: center; }
                Slider { minimum: 80; maximum: 240; value: root.item-size; changed(value) => { root.item-size = round(value / 8) * 8; } }
                Text { text: root.item-size + " px"; color: Theme.text; }
                AddOption { label: "Reset to default"; option-width: 144px; clicked => { root.item-size = 128; } }
                AddOption { label: "Save"; enabled: !root.busy; clicked => { root.busy = true; root.saved-size = root.item-size; root.saved-margin = root.page-margin; root.save-appearance(root.page-margin, root.item-size,grid.columns,grid.rows); } }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 12px;
                PageTile { width: root.item-size * 1px; height: self.width; items: root.items; index: 0; }
                Text { text: "Live preview · " + grid.columns + " columns × " + grid.rows + " rows. Save reflows displaced items; Back cancels unsaved sizing."; wrap: word-wrap; color: Theme.secondary; }
            }
            Text { text: root.installed-status; color: #a7adc7; }
            HorizontalLayout {
                horizontal-stretch: 1; vertical-stretch: 1; spacing: 20px;
                VerticalLayout {
                    width: (root.width - 172px) / 2; horizontal-stretch: 1; spacing: 10px; alignment: start;
                    Text { text: "File search paths"; color: #e0e3f4; font-size: 16px; font-weight: 600; }
                    for path[index] in root.file-search-paths: HorizontalLayout {
                        min-height: 40px; spacing: 8px; horizontal-stretch: 1;
                        Text { min-width: 250px; text: path; color: #a7adc7; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        AddOption { label: "Edit"; option-width: 64px; enabled: !root.busy; clicked => { root.search-path-directory = false; root.search-path-index = index; root.search-path-draft = path; root.search-path-editor = true; } }
                        AddOption { label: "Delete"; option-width: 72px; destructive: true; enabled: !root.busy; clicked => { root.busy = true; root.delete-search-path(false, index); } }
                    }
                    AddOption { label: "Add file path"; option-width: 144px; enabled: !root.busy; clicked => { root.search-path-directory = false; root.search-path-index = -1; root.search-path-draft = ""; root.search-path-editor = true; } }
                }
                VerticalLayout {
                    width: (root.width - 172px) / 2; horizontal-stretch: 1; spacing: 10px; alignment: start;
                    Text { text: "Directory search paths"; color: #e0e3f4; font-size: 16px; font-weight: 600; }
                    for path[index] in root.directory-search-paths: HorizontalLayout {
                        min-height: 40px; spacing: 8px; horizontal-stretch: 1;
                        Text { min-width: 250px; text: path; color: #a7adc7; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        AddOption { label: "Edit"; option-width: 64px; enabled: !root.busy; clicked => { root.search-path-directory = true; root.search-path-index = index; root.search-path-draft = path; root.search-path-editor = true; } }
                        AddOption { label: "Delete"; option-width: 72px; destructive: true; enabled: !root.busy; clicked => { root.busy = true; root.delete-search-path(true, index); } }
                    }
                    AddOption { label: "Add directory path"; option-width: 176px; enabled: !root.busy; clicked => { root.search-path-directory = true; root.search-path-index = -1; root.search-path-draft = ""; root.search-path-editor = true; } }
                }
            }
            if root.search-path-editor: Rectangle {
                height: 116px; border-radius: 12px; background: #ffffff08;
                VerticalLayout {
                    padding: 12px; spacing: 8px;
                    AddField {
                        label: root.search-path-directory ? "Directory search path" : "File search path";
                        placeholder: "/home/user/Documents"; text <=> root.search-path-draft;
                        accepted => { root.busy = true; root.save-search-path(root.search-path-directory, root.search-path-index, root.search-path-draft); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        AddOption { label: "Cancel"; option-width: 80px; enabled: !root.busy; clicked => { root.search-path-editor = false; } }
                        AddOption { label: "Save"; option-width: 80px; primary: true; enabled: !root.busy; clicked => { root.busy = true; root.save-search-path(root.search-path-directory, root.search-path-index, root.search-path-draft); } }
                    }
                }
            }
            }
            if root.shortcuts-tab: VerticalLayout {
                spacing: 16px;
                Text { text: "Choose an action, then record its shortcut. Changes are saved automatically."; color: Theme.secondary; font-size: 13px; }
                Flickable {
                    vertical-stretch: 1; content-height: root.shortcut-groups.length * 60px; content-width: self.width;
                    for group[index] in root.shortcut-groups: Rectangle {
                        y: index * 60px; width: parent.width; height: 52px;
                        background: #ffffff05; border-radius: 8px;
                        Text { x: 12px; width: 260px; height: parent.height; vertical-alignment: center; text: root.shortcut-actions[group.action]; color: Theme.text; font-size: 14px; }
                        Flickable {
                            x: 270px; width: parent.width - 370px; height: parent.height;
                            content-width: max(self.width, group.entries.length * 360px); content-height: self.height;
                            HorizontalLayout {
                                spacing: 8px; width: max(group.entries.length * 360px, 200px); height: parent.height;
                                if group.entries.length == 0: Text { text: "No shortcut assigned"; color: Theme.secondary; vertical-alignment: center; }
                                for binding in group.entries: HorizontalLayout {
                                    spacing: 6px; alignment: center; height: parent.height;
                                    Text { text: binding.keys; color: #a8b3ff; vertical-alignment: center; }
                                    AddOption { label: "Change"; option-width: 76px; enabled: !root.busy; clicked => { root.shortcut-action = binding.action; root.shortcut-existing = binding.keys; root.shortcut-draft = binding.keys; root.shortcut-editor = true; } }
                                    AddOption { label: root.shortcut-delete-action == binding.action && root.shortcut-delete-keys == binding.keys ? "Confirm" : "Delete"; option-width: 76px; destructive: true; enabled: !root.busy; clicked => { if root.shortcut-delete-action == binding.action && root.shortcut-delete-keys == binding.keys { root.busy = true; root.shortcut-delete-action = -1; root.delete-shortcut(binding.action, binding.keys); } else { root.shortcut-delete-action = binding.action; root.shortcut-delete-keys = binding.keys; } } }
                                }
                            }
                        }
                        AddOption { x: parent.width - 78px; y: 4px; label: "Add"; option-width: 64px; enabled: !root.busy; clicked => { root.shortcut-action = group.action; root.shortcut-existing = ""; root.shortcut-draft = ""; root.shortcut-editor = true; } }
                    }
                }
                Text { text: "Toggle Orbit is configured in Hyprland. Text editing uses the text field’s shortcuts. Mouse: click to open, right-click for actions, drag to move items, wheel to scroll, Shift + wheel to switch pages."; color: Theme.secondary; font-size: 12px; wrap: word-wrap; }
                if root.shortcut-editor: HorizontalLayout {
                    spacing: 12px;
                    ComboBox { model: root.shortcut-actions; current-index <=> root.shortcut-action; }
                    AddOption { label: root.shortcut-recording ? "Press shortcut…" : root.shortcut-draft == "" ? "Record shortcut" : root.shortcut-draft; option-width: 220px; clicked => { root.shortcut-recording = true; } }
                    AddOption { label: "Cancel"; clicked => { root.shortcut-editor = false; root.shortcut-recording = false; } }
                    AddOption { label: "Save"; primary: true; enabled: !root.busy && !root.shortcut-recording && root.shortcut-draft != ""; clicked => { root.busy = true; root.save-shortcut(root.shortcut-action, root.shortcut-existing, root.shortcut-draft); } }
                }
                AddOption { label: "Add shortcut"; option-width: 144px; enabled: !root.busy; clicked => { root.shortcut-delete-action = -1; root.shortcut-action = 0; root.shortcut-existing = ""; root.shortcut-draft = ""; root.shortcut-editor = true; } }
            }
            HorizontalLayout {
                AddOption { label: "Back"; option-width: 96px; clicked => { root.search-path-editor = false; root.settings = false; } }
            }
        }
    }

    if root.move-id != "": Rectangle {
        width: root.width; height: root.height; background: #00000070;
        TouchArea { clicked => { root.move-id = ""; } }
        Rectangle {
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            width: 400px; height: 180px; background: Theme.sheet; border-radius: 16px;
            VerticalLayout {
                padding: 24px; spacing: 12px;
                Text { text: "Move to Page"; color: Theme.text; font-size: 20px; }
                ComboBox { model: root.page-names; current-index <=> root.move-page; }
                HorizontalLayout {
                    AddOption { label: "Cancel"; clicked => { root.move-id = ""; } }
                    AddOption { label: "Move"; primary: true; clicked => { root.busy = true; root.move-item(root.move-id,root.move-page); root.move-id = ""; } }
                }
            }
        }
    }
    if root.page-delete-confirm: Rectangle {
        width: root.width; height: root.height; background: #00000080;
        TouchArea { clicked => { root.page-delete-confirm = false; } }
        Rectangle {
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            width: 500px; height: 190px; background: Theme.sheet; border-radius: 16px; border-width: 1px; border-color: Theme.border;
            VerticalLayout {
                padding: 24px; spacing: 16px;
                Text { text: "Delete page " + (root.current-page + 1) + "?"; font-size: 20px; color: Theme.text; }
                Text { text: "Its items will move to " + (root.current-page == 0 ? "the next page." : "the previous page."); wrap: word-wrap; color: Theme.secondary; }
                HorizontalLayout {
                    spacing: 12px;
                    AddOption { label: "Cancel"; clicked => { root.page-delete-confirm = false; } }
                    AddOption { label: "Delete page"; option-width: 132px; destructive: true; enabled: !root.busy; clicked => { root.page-delete-confirm = false; root.busy = true; root.delete-page(); } }
                }
            }
        }
    }
    if root.context-index >= 0 || root.dock-context != "": Rectangle {
        width: root.width; height: root.height;
        background: #00000050;
        TouchArea { clicked => { root.context-index = -1; root.dock-context = ""; root.context-id = ""; } }
        Rectangle {
            x: min(root.context-x, parent.width - self.width);
            y: min(root.context-y, parent.height - self.height);
            width: 200px; height: root.context-index >= 0 ? (root.items[root.context-index].widget ? 294px : 198px) : 64px;
            background: Theme.sheet; border-radius: 16px; border-width: 1px; border-color: Theme.border;
            VerticalLayout {
                padding: 12px; spacing: 8px;
                if root.context-index >= 0 && root.items[root.context-index].widget: AddOption { width: 176px; label: "Refresh text"; clicked => { root.busy = true; root.widget-action(root.items[root.context-index].id,true,1,1); root.context-index = -1; } }
                if root.context-index >= 0 && root.items[root.context-index].widget: AddOption { width: 176px; label: "Resize · wider"; clicked => { root.busy = true; root.widget-action(root.items[root.context-index].id,false,root.items[root.context-index].span-x + 1,root.items[root.context-index].span-y); root.context-index = -1; } }
                if root.context-index >= 0 && root.items[root.context-index].widget: AddOption { width: 176px; label: "Resize · taller"; clicked => { root.busy = true; root.widget-action(root.items[root.context-index].id,false,root.items[root.context-index].span-x,root.items[root.context-index].span-y + 1); root.context-index = -1; } }
                if root.context-index >= 0 && root.items[root.context-index].widget: AddOption { width: 176px; label: "Resize · smaller"; clicked => { root.busy = true; root.widget-action(root.items[root.context-index].id,false,max(1,root.items[root.context-index].span-x - 1),max(1,root.items[root.context-index].span-y - 1)); root.context-index = -1; } }
                if root.context-index >= 0 && !root.items[root.context-index].widget: AddOption { width: 176px; label: root.items[root.context-index].folder ? "Rename" : "Edit"; clicked => {
                    root.edit-item(root.context-index);
                } }
                if root.context-index >= 0 && !root.items[root.context-index].widget: AddOption { width: 176px; label: root.items[root.context-index].pinned ? "Unpin" : "Pin"; clicked => { root.busy = true; root.pin-item(root.context-index); root.context-index = -1; } }
                if root.context-index >= 0: AddOption { width: 176px; label: "Move to Page"; clicked => { root.move-id = root.items[root.context-index].id; root.move-page = root.current-page; root.context-index = -1; } }
                if root.context-index >= 0: AddOption { width: 176px; label: "Remove from Home"; clicked => {
                    root.editing = root.context-index;
                    root.app-name = root.items[root.context-index].name;
                    root.context-index = -1;
                    root.banner = ""; root.alert = true;
                    cancel-delete.focus();
                } }
                if root.dock-context == "pinned": AddOption { width: 176px; label: "Unpin"; clicked => { root.busy = true; root.unpin-dock-item(root.context-id); root.dock-context = ""; } }
                if root.dock-context == "recent": AddOption { width: 176px; label: "Remove from Recent"; clicked => { root.busy = true; root.remove-recent-item(root.context-id); root.dock-context = ""; } }
            }
        }
    }
    // Keeping the sheet instantiated preserves field focus while editing.
    sheet-backdrop := Rectangle {
        width: root.width; height: root.height;
        visible: root.sheet;
        opacity: root.sheet ? 1 : 0;
        animate opacity { duration: 120ms; easing: ease-out; }
        background: Theme.backdrop;
        TouchArea { enabled: !root.picker && !root.alert; clicked => { root.close-top-layer(); } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(560px, max(288px, parent.width - (parent.width >= 600px ? 48px : 32px)));
            height: min(root.editing >= 0 ? (root.item-type == "File" || root.item-type == "Directory" ? 336px : (root.custom && root.item-type == "App" ? 420px : 280px)) : (200px + max(100px, sheet-content.preferred-height) + (root.item-type == "App" ? 56px : 0px)), min(parent.height - 32px, 760px));
            background: Theme.sheet;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 16px;
            TouchArea { }
            VerticalLayout {
                padding: 16px;
                spacing: 16px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.editing < 0 ? "Add item" : ("Edit " + root.item-type);
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    AddOption {
                        label: "×";
                        width: 40px;
                        height: 40px;
                        accessible-label: "Close the top layer";
                        clicked => { root.close-top-layer(); }
                    }
                }
                if root.editing < 0: FlexboxLayout {
                    flex-wrap: wrap;
                    spacing: 8px;
                    AddOption { label: "App"; selected: root.item-type == "App"; clicked => { root.add-item("App"); } }
                    AddOption { label: "Website"; selected: root.item-type == "Website"; clicked => { root.add-item("Website"); } }
                    AddOption { label: "File"; selected: root.item-type == "File"; clicked => { root.add-item("File"); } }
                    AddOption { label: "Directory"; selected: root.item-type == "Directory"; clicked => { root.add-item("Directory"); } }
                    AddOption { label: "Folder"; selected: root.item-type == "Folder"; clicked => { root.add-item("Folder"); } }
                    AddOption { label: "Widgets"; selected: root.item-type == "Widgets"; clicked => { root.add-item("Widgets"); } }
                }
                if root.item-type == "App" && root.editing < 0: FlexboxLayout {
                    flex-wrap: wrap;
                    spacing: 8px;
                    AddOption { label: "Custom command"; option-width: 148px; selected: root.app-source == "Custom command"; clicked => { root.app-source-changed("Custom command"); } }
                    AddOption { label: "Actions"; selected: root.app-source == "Actions"; clicked => { root.app-source-changed("Actions"); } }
                    AddOption { label: "Installed apps"; option-width: 132px; selected: root.app-source == "Installed apps"; clicked => { root.installed-filter = ""; root.filter-installed-apps(""); root.app-source-changed("Installed apps"); } }
                }
                sheet-scroll := Flickable {
                    interactive: true;
                    vertical-stretch: 1;
                    min-height: 100px;
                    content-width: self.width;
                    content-height: sheet-content.preferred-height;
                    sheet-content := VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                        height: self.preferred-height;
                        spacing: 12px;
                        if root.item-type == "App" && root.editing < 0 && root.app-source == "Actions": VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: 8px;
                            for action in root.actions: AddOption {
                                label: action.name; trailing: "+"; full-width: true;
                                available-width: root.sheet-content-width; enabled: !root.busy;
                                clicked => { root.busy = true; root.sheet-operation = "adding"; root.sheet-status = "Adding…"; root.add-system-action(action.id); }
                            }
                        }
                        if root.item-type == "App" && root.editing < 0 && root.app-source == "Installed apps": VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: 8px;
                            AddOption {
                                label: "Refresh installed apps";
                                option-width: 220px;
