                                color: Theme.secondary;
                                font-size: 14px;

                            }
                            if root.installed-filter != "" && !root.installed-apps-match: Text {
                                text: "No items match this filter.";
                                color: Theme.secondary;
                                font-size: 14px;
                            }
                            VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                                spacing: 8px;
                                for app in root.installed-apps: AddOption {
                                                                        label: app.name;
                                    icon: app.icon; icon-present: app.icon-present;
                                    trailing: root.busy && root.sheet-operation == "adding" ? "Adding…" : "+";
                                    full-width: true; available-width: root.sheet-content-width;
                                    enabled: !root.busy;
                                    clicked => {
                                        root.busy = true;
                                        root.sheet-operation = "adding";
                                        root.sheet-status = "Adding…";
                                        root.add-installed-app(app.id);
                                    }
                                }
                            }
                        }
                        if root.item-type == "App" && root.custom && (root.editing >= 0 || root.app-source == "Custom command"): VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: 12px;
                            custom_name_field := AddField {
                                width: root.sheet-content-width;
                                label: "Name";
                                placeholder: "e.g. Terminal";
                                text <=> root.app-name;
                                error: root.name-error;
                                enabled: !root.busy;
                                edited => { root.name-error = ""; }
                                accepted => { custom_command_field.focus(); }
                            }
                            custom_command_field := AddField {
                                width: root.sheet-content-width;
                                label: "Command";
                                placeholder: "e.g. foot --title Terminal";
                                text <=> root.command;
                                error: root.command-error;
                                enabled: !root.busy;
                                multiline: true;
                                edited => { root.command-error = ""; }
                                accepted => { root.submit-form(); }
                            }
                            HorizontalLayout {
                                width: root.sheet-content-width; height: 48px; spacing: 12px; alignment: start;
                                Rectangle {
                                    width: 48px; height: 48px; border-radius: 12px; background: Theme.selection;
                                    if root.icon-preview-present: Image { width: 48px; height: 48px; source: root.icon-preview; image-fit: contain; }
                                    if !root.icon-preview-present: Text { text: root.icon-letter != "" ? root.icon-letter : root.app-name == "" ? "?" : root.first-letter(root.app-name); color: Theme.focus; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                AddOption { label: "Change icon"; option-width: 136px; height: 48px; enabled: !root.busy; clicked => { root.open-icon(root.icon-value, root.app-name); } }
                            }
                        }
                        if root.item-type == "App" && !root.custom && root.editing >= 0: VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: 12px;
                            AddField {
                                width: root.sheet-content-width;
                                label: "Name";
                                placeholder: "e.g. Terminal";
                                text <=> root.app-name;
                                error: root.name-error;
                                enabled: !root.busy;
                                edited => { root.name-error = ""; }
                                accepted => { root.submit-form(); }
                            }
                            HorizontalLayout {
                                width: root.sheet-content-width; height: 48px; spacing: 12px; alignment: start;
                                Rectangle {
                                    width: 48px; height: 48px; border-radius: 12px; background: Theme.selection;
                                    if root.icon-preview-present: Image { width: 48px; height: 48px; source: root.icon-preview; image-fit: contain; }
                                    if !root.icon-preview-present: Text { text: root.icon-letter != "" ? root.icon-letter : root.app-name == "" ? "?" : root.first-letter(root.app-name); color: Theme.focus; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                AddOption { label: "Change icon"; option-width: 136px; height: 48px; enabled: !root.busy; clicked => { root.open-icon(root.icon-value, root.app-name); } }
                            }
                        }
                        if root.item-type == "Website": VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: 12px;
                            website_name_field := AddField {
                                width: root.sheet-content-width; label: "Name"; placeholder: "e.g. Work"; text <=> root.app-name; error: root.name-error; enabled: !root.busy; edited => { root.name-error = ""; } accepted => { website_url_field.focus(); } }
                            website_url_field := AddField {
                                width: root.sheet-content-width; label: "URL"; placeholder: "https://example.com"; text <=> root.url-or-path; error: root.url-error; enabled: !root.busy; edited => { root.url-error = ""; } accepted => { root.submit-form(); } }
                        }
                        if root.item-type == "Widgets": VerticalLayout {
                            width: root.sheet-content-width;
                            alignment: start;
                            spacing: 8px;
                            Text { width: root.sheet-content-width; text: "Widget Gallery · place automatically"; color: Theme.text; font-size: 18px; }
                            for name[index] in ["Random Quote · 2×2", "Random Fact · 2×2", "Random Word · 2×1", "Motivation · 2×1", "Random Number · 2×1"]: AddOption {
                                width: root.sheet-content-width; label: name; full-width: true; available-width: root.sheet-content-width;
                                clicked => { root.busy = true; root.add-widget(index); root.sheet = false; }
                            }
                        }
                        if root.item-type == "Folder": folder_name_field := AddField {
                                width: root.sheet-content-width;
                            label: "Name";
                            placeholder: "e.g. Work";
                            text <=> root.app-name;
                            error: root.name-error;
                            enabled: !root.busy;
                            edited => { root.name-error = ""; }
                            accepted => { root.submit-form(); }
                        }
                        if root.item-type == "File" || root.item-type == "Directory": VerticalLayout {
                            width: root.sheet-content-width; alignment: start; spacing: 12px;
                            AddField {
                                width: root.sheet-content-width;
                                label: "Path";
                                placeholder: root.item-type == "Directory" ? "/home/user/Documents" : "/home/user/Documents/file.pdf";
                                text <=> root.url-or-path;
                                error: root.path-error;
                                enabled: !root.busy;
                                edited => { root.path-error = ""; }
                                accepted => { root.submit-form(); }
                            }
                            AddOption {
                                label: root.busy && root.sheet-operation == "choosing" ? "Choose…" : (root.item-type == "Directory" ? "Choose directory" : "Choose file");
                                option-width: 148px;
                                enabled: !root.busy;
                                clicked => {
                                    root.busy = true;
                                    root.sheet-operation = "choosing";
                                    root.sheet-status = "Choose a path…";
                                    root.choose-path(root.item-type == "Directory");
                                }
                            }
                            HorizontalLayout {
                                width: root.sheet-content-width; height: 48px; spacing: 12px; alignment: start;
                                Rectangle {
                                    width: 48px; height: 48px; border-radius: 12px; background: Theme.selection;
                                    if root.icon-preview-present: Image {
                                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                        width: 40px; height: 40px; source: root.icon-preview; image-fit: contain;
                                    }
                                    if !root.icon-preview-present: Text { text: root.icon-letter != "" ? root.icon-letter : root.app-name == "" ? "?" : root.first-letter(root.app-name); color: Theme.focus; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                AddOption { label: "Change icon"; option-width: 136px; height: 48px; enabled: !root.busy; clicked => { root.open-icon(root.icon-value, root.app-name); } }
                            }
                        }
                        if root.sheet-status != "": Text {
                            text: (root.sheet-operation == "adding" || root.sheet-operation == "saving" || root.sheet-operation == "refreshing") ? "◌ " + root.sheet-status : "! " + root.sheet-status;
                            color: root.sheet-operation == "adding" || root.sheet-operation == "saving" || root.sheet-operation == "refreshing" ? Theme.focus : Theme.error;
                            font-size: 12px;
                            wrap: word-wrap;

                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    AddOption {
                        label: root.editing < 0 ? "Cancel" : "Delete";
